
config zapret2wizard 'main'
	option enabled '1'
	option debug '0'
	option scripts '1'
	option postnat '1'
	option enable_ipv6 '0'
	option filter_ttl_expired_icmp '1'
	option flowoffload 'donttouch'
	option mode_filter 'none'
	option quic_mode 'auto'
	option desync_mark '0x40000000'
	option desync_mark_postnat '0x20000000'
	option qnum '300'
	option ws_user 'daemon'
	option nfqws_ports_tcp '80,443,853,1024-65535'
	option nfqws_ports_udp '53,80,88,443,1024-65535'
	option nfqws_tcp_pkt_out '25'
	option nfqws_tcp_pkt_in '5'
	option nfqws_udp_pkt_out '5'
	option nfqws_udp_pkt_in '3'
	option lua_gc '600'
	option ctrack_timeouts '60:300:60:60'
	option set_maxelem '522288'
	option gzip_lists '1'
	option mdig_threads '30'
	option autohostlist_retrans_threshold '3'
	option autohostlist_fail_threshold '3'
	option autohostlist_fail_time '60'
	option autohostlist_debuglog '0'
	option autohostlist_incoming_maxseq '4096'
	option autohostlist_retrans_maxseq '32768'
	option autohostlist_retrans_reset '1'
	option autohostlist_udp_in '1'
	option autohostlist_udp_out '4'

config list 'list_hosts_auto'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_auto.txt'

config list 'list_hosts_user'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_user.txt'

config list 'list_hosts_user_exclude'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_user_exclude.txt'

config list 'list_hosts_youtube'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_youtube.txt'

config list 'list_hosts_discord'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_discord.txt'

config list 'list_hosts_instagram'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_instagram.txt'

config list 'list_hosts_twitch'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_twitch.txt'

config list 'list_hosts_x'
	option path '/etc/zapret2wizard/ipset/zapret_hosts_x.txt'

config blob 'blob_stun'
	option path '/usr/share/zapret2wizard/fake/stun.bin'
	option enabled '1'

config blob 'blob_quic_initial_dbankcloud_ru'
	option path '/usr/share/zapret2wizard/fake/quic_initial_dbankcloud_ru.bin'
	option enabled '1'

config blob 'blob_quic_google'
	option path '/usr/share/zapret2wizard/fake/quic_initial_www_google_com.bin'
	option enabled '1'

config blob 'blob_tls_clienthello_gosuslugi_ru'
	option path '/usr/share/zapret2wizard/fake/tls_clienthello_gosuslugi_ru.bin'
	option enabled '1'

config blob 'blob_tls_clienthello_sberbank_ru'
	option path '/usr/share/zapret2wizard/fake/tls_clienthello_sberbank_ru.bin'
	option enabled '1'

config blob 'blob_tls_clienthello_t2_ru'
	option path '/usr/share/zapret2wizard/fake/tls_clienthello_t2_ru.bin'
	option enabled '1'

config blob 'blob_tls_clienthello_vk_com'
	option path '/usr/share/zapret2wizard/fake/tls_clienthello_vk_com.bin'
	option enabled '1'

config blob 'blob_tls_clienthello_www_google_com'
	option path '/usr/share/zapret2wizard/fake/tls_clienthello_www_google_com.bin'
	option enabled '1'

config blob 'blob_tls_clienthello_www_4pda_to'
	option path '/usr/share/zapret2wizard/fake/tls_clienthello_www_4pda_to.bin'
	option enabled '1'

config strategy 'BlockcheckW_YouTube'
	option enabled '1'
	option port '443'
	option protocol 'tcp'
	list filter_l3 'ipv4'
	list filter_l7 'tls'
	list hostlist 'list_hosts_youtube'
	list hostlist_exclude 'list_hosts_user_exclude'
	option script '--payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5'

config strategy 'BlockcheckW_Discord'
	option enabled '1'
	option port '443'
	option protocol 'tcp'
	list filter_l3 'ipv4'
	list filter_l7 'tls'
	list filter_l7 'discord'
	list hostlist 'list_hosts_discord'
	option script '--out-range=-s34228 --payload=tls_client_hello --in-range=-s5556 --lua-desync=circular:fails=3:maxtime=20 --in-range=x --lua-desync=hostfakesplit:host=gosuslugi.ru:tcp_ts=-60000:strategy=1 --lua-desync=multisplit:pos=1:seqovl=1:strategy=2 --lua-desync=multidisorder:pos=1,midsld,1220:strategy=3'

config strategy 'BlockcheckW_Discord_Voice'
	option enabled '1'
	option port '50000-65535,19294-19344'
	option protocol 'udp'
	list filter_l3 'ipv4'
	list filter_l7 'discord'
	list filter_l7 'stun'
	option script '--payload=discord_ip_discovery,stun --lua-desync=circular:fails=3:maxtime=20 --lua-desync=fake:blob=blob_stun:repeats=2:strategy=1 --lua-desync=udplen:increment=2:strategy=2 --lua-desync=fake:blob=blob_stun:repeats=4:strategy=3'

config strategy 'BlockcheckW_X'
	option enabled '1'
	option port '443'
	option protocol 'tcp'
	list filter_l3 'ipv4'
	list filter_l7 'tls'
	list hostlist 'list_hosts_x'
	option script '--out-range=-s34228 --payload=tls_client_hello --in-range=-s5556 --lua-desync=circular:fails=3:maxtime=20 --in-range=x --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2:strategy=1 --lua-desync=multisplit:pos=1,midsld:strategy=1 --lua-desync=multidisorder:pos=1,midsld,1220:strategy=2 --lua-desync=multisplit:pos=1:seqovl=1:strategy=3 --lua-desync=hostfakesplit:host=google.com:tcp_ts=-60000:strategy=4'

config strategy 'BlockcheckW_Instagram'
	option enabled '1'
	option port '443'
	option protocol 'tcp'
	list filter_l3 'ipv4'
	list filter_l7 'tls'
	list hostlist 'list_hosts_instagram'
	option script '--out-range=-s34228 --payload=tls_client_hello --in-range=-s5556 --lua-desync=circular:fails=3:maxtime=20 --in-range=x --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2:strategy=1 --lua-desync=multisplit:pos=1,midsld:strategy=1 --lua-desync=multidisorder:pos=1,midsld,1220:strategy=2 --lua-desync=multisplit:pos=1:seqovl=1:strategy=3 --lua-desync=hostfakesplit:host=google.com:tcp_ts=-60000:strategy=4'
