#!/bin/sh
# fw4 пересоздаёт свои таблицы при каждом reload/restart firewall, и наши
# правила «эти домены не заворачивать в туннель» исчезают. Возвращаем их
# в фоне, чтобы не задерживать сам reload.
[ -x /usr/bin/blockcheckw-helper ] || exit 0
( sleep 2; /usr/bin/blockcheckw-helper bypass_sync enable >/dev/null 2>&1 ) &
exit 0
