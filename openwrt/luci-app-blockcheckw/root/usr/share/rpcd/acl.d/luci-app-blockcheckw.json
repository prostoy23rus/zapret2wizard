{
	"luci-app-blockcheckw": {
		"description": "Grant access to Zapret2Wizard automated scanner and Zapret2 integration",
		"read": {
			"ubus": {
				"file": [
					"list",
					"read",
					"stat",
					"remove",
					"exec",
					"write"
				],
				"uci": [
					"get",
					"state"
				],
				"service": [
					"list"
				]
			},
			"uci": [
				"zapret2",
				"zapret2wizard",
				"*"
			],
			"file": {
				"/usr/bin/blockcheckw": [
					"exec"
				],
				"/usr/bin/blockcheckw-helper": [
					"exec"
				],
				"/usr/bin/circular-builder.lua": [
					"exec"
				],
				"/tmp/blockcheckw_status.json": [
					"read"
				],
				"/tmp/blockcheckw_run.log": [
					"read"
				],
				"/tmp/blockcheckw_scan.json": [
					"read"
				],
				"/tmp/blockcheckw_vanilla.txt": [
					"read"
				],
				"/tmp/blockcheckw_circular.txt": [
					"read"
				],
				"/usr/share/blockcheckw/*": [
					"read",
					"list"
				],
				"/etc/config/zapret2": [
					"read"
				],
				"/etc/config/zapret2wizard": [
					"read"
				],
				"/etc/zapret2wizard/*": [
					"read",
					"list"
				],
				"/tmp/blockcheckw_*": [
					"read",
					"write",
					"remove"
				],
				"/etc/zapret2wizard/genomes.json": [
					"read"
				],
				"/tmp/bcw_evolve.log": [
					"read"
				],
				"/tmp/bcw_evolve.running": [
					"read"
				],
				"/etc/init.d/zapret2wizard": [
					"exec"
				]
			}
		},
		"write": {
			"ubus": {
				"file": [
					"exec",
					"write",
					"remove"
				],
				"uci": [
					"add",
					"apply",
					"changes",
					"commit",
					"delete",
					"order",
					"rename",
					"set",
					"get",
					"state"
				]
			},
			"uci": [
				"zapret2",
				"zapret2wizard"
			],
			"file": {
				"/usr/bin/blockcheckw-helper": [
					"exec"
				],
				"/etc/config/zapret2": [
					"read",
					"write"
				],
				"/tmp/blockcheckw_*": [
					"read",
					"write",
					"remove"
				],
				"/etc/config/zapret2wizard": [
					"read",
					"write"
				],
				"/etc/zapret2wizard/*": [
					"read",
					"list",
					"write"
				],
				"/usr/share/blockcheckw/*": [
					"read",
					"list"
				],
				"/tmp/bcw_import.json": [
					"write",
					"read"
				],
				"/etc/init.d/zapret2wizard": [
					"exec"
				]
			}
		}
	}
}
