                single_total=$(printf '%s' "$_s" | grep -o '"total":[0-9]*' | cut -d: -f2)
                [ -n "$single_ok" ] || single_ok=0
                [ -n "$single_total" ] || single_total=3
                stab_single="$single_ok/$single_total"
            fi

            # Решение службы: когда Circular реально нужен, а когда это лишний риск.
            local need_circ="0"
            case "$do_circular" in
                0) circular_reason="circular выключен" ;;
                force) need_circ=1; circular_reason="включён принудительно" ;;
                *)
                    if [ "$apply_ok" != "1" ]; then
                        need_circ=1; circular_reason="одиночная не прошла проверку"
                    elif [ "$single_ok" -lt "$single_total" ]; then
                        need_circ=1; circular_reason="одиночная нестабильна ($stab_single)"
                    else
                        circular_reason="одиночная стабильна ($stab_single) — связка не нужна"
                    fi
                    ;;
            esac

            if [ "$need_circ" = "1" ]; then
                write_status "running" 93 "Сборка Circular-связки: $circular_reason"
                lua "$CIRCULAR_BUILDER" "$OUTPUT_SCAN" 2 15 4 loop tls_client_hello "$target" > "$OUTPUT_CIRCULAR" 2>> "$LOG_FILE"
                local circ_text=$(tr '\n' ' ' < "$OUTPUT_CIRCULAR" 2>/dev/null)
                circular_members=$(printf '%s' "$circ_text" | grep -o 'strategy=[0-9]*' | sort -u | wc -l)
                circular_members=$(printf '%s' "$circular_members" | tr -d ' ')
                [ -n "$circular_members" ] || circular_members=0
                if [ "$circular_members" -ge 2 ]; then
                    echo "[blockcheckw-helper] Circular: $circular_members техники ($circular_reason)" >> "$LOG_FILE"
                    local circ_res circ_rc
                    circ_res=$(cmd_apply --target "$target" --script "$circ_text" 2>/dev/null)
                    circ_rc=$?
                    if [ "$circ_rc" = 0 ] && bcw_apply_accepted "$circ_res" "$target" "$circ_text"; then
                        local _c=$(cmd_stability "$target" 3 2>/dev/null)
                        local circ_ok=$(printf '%s' "$_c" | grep -o '"ok":[0-9]*' | cut -d: -f2)
                        local circ_total=$(printf '%s' "$_c" | grep -o '"total":[0-9]*' | cut -d: -f2)
                        [ -n "$circ_ok" ] || circ_ok=0
                        [ -n "$circ_total" ] || circ_total=3
                        stab_circ="$circ_ok/$circ_total"
                        if [ "$circ_ok" -ge "$single_ok" ]; then
                            circular_used="1"
                            apply_ok="1"
                            apply_res="$circ_res"
                            circular_reason="связка $circular_members техник: $stab_circ (одиночная $stab_single)"
                        else
                            circular_reason="связка хуже ($stab_circ), оставлена одиночная ($stab_single)"
                        fi
                    else
                        circular_reason="связка не прошла проверку"
                    fi
                else
                    circular_reason="меньше двух независимых техник — связка невозможна"
                fi
            fi

            # Попытка связки затирает конфиг: если связку не оставили,
            # возвращаем проверенную одиночную стратегию.
            if [ "$need_circ" = "1" ] && [ "$circular_used" != "1" ] && [ -n "$best_single" ]; then
                apply_ok="0"
                local back
                back=$(cmd_apply --target "$target" --script "$best_single" 2>/dev/null)
                local back_rc=$?
                if [ "$back_rc" = 0 ] && bcw_apply_accepted "$back" "$target" "$best_single"; then
                    apply_ok="1"
                    apply_res="$back"
                fi
            fi

            if [ "$apply_ok" = "1" ]; then
                local rec_recipe="$best_single"
                [ "$circular_used" = "1" ] && rec_recipe="$circ_text"
                if [ -n "$rec_recipe" ]; then
                    local rec_ms=$(cmd_test "$target" "" 2>/dev/null | awk -F'"time_sec":"' '{if (NF>1) {split($2,a,"\""); print int(a[1]*1000)}}' | head -1)
                    [ -n "$rec_ms" ] || rec_ms=0
                    local rec_json=$(mem put "$domain" "$(domain_ip "$domain")" "$rec_recipe" 1 "$rec_ms")
                    echo "[blockcheckw-helper] Memory L1/L2(ewma=${rec_ms}ms): $rec_json" >> "$LOG_FILE"
                fi
                # Приложение YouTube использует отдельный SNI youtubei.googleapis.com;
                # если он закрыт — добавляем отдельный профиль YTApi (проверено на МТС).
                case "$target" in
                    preset_youtube|youtube) cmd_fix_ytapi >/dev/null 2>&1 || true ;;
                esac
                apply_info=",\"auto_applied\":true,\"tried_candidates\":$tried,\"circular_used\":$circular_used,\"circular_members\":$circular_members"
                [ -n "$stab_single" ] && apply_info="$apply_info,\"stability_single\":\"$stab_single\""
                [ -n "$stab_circ" ] && apply_info="$apply_info,\"stability_circular\":\"$stab_circ\""
                apply_info="$apply_info,\"circular_reason\":\"$circular_reason\""
            elif [ "$tried" -gt 0 ]; then
                [ -n "${best_single:-}" ] && mem ban "$domain" "$best_single" "применение не подтвердилось" >/dev/null 2>&1 || true
                [ -n "${circ_text:-}" ] && mem ban "$domain" "$circ_text" "circular не прошла проверку" >/dev/null 2>&1 || true
                if [ -s "$cfg_backup" ]; then
                    cp -f "$cfg_backup" "/etc/config/$cfg_pkg"
                    rm -f /tmp/blockcheckw_apply_result.json
                    echo "[blockcheckw-helper] Проверка не прошла — прежняя конфигурация восстановлена" >> "$LOG_FILE"
                    ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
                    wait_dpi_ready 20
                    apply_restored="1"
                fi
                if [ "$apply_restored" = "1" ]; then
                    apply_info=",\"apply_warning\":\"Стратегия не подтвердила трафик, прежняя конфигурация возвращена\",\"tried_candidates\":$tried"
                else
                    apply_info=",\"apply_warning\":\"Стратегия записана, но трафик не подтвердился\",\"tried_candidates\":$tried"
                fi
            else
                apply_info=",\"apply_warning\":\"В отчёте не нашлось стратегии для применения\""
            fi
            rm -f "$cfg_backup"
        fi

        local dns_err=$(grep -E 'DNS resolve failed|no IPv4 addresses found|DNS resolution error' "$LOG_FILE" 2>/dev/null | tail -n 1)
        if [ -n "$dns_err" ]; then
            write_status "error" 0 "Ошибка DNS: $dns_err" ",\"strategies\":[]"
            echo "[blockcheckw-helper] Scan failed with DNS error: $dns_err" >> "$LOG_FILE"
        elif [ "$found_count" -gt 0 ]; then
            local final_msg="Найдено рабочих стратегий: $found_count"
            if [ "$auto_apply" = "1" ]; then
                if [ "$apply_ok" = "1" ]; then
                    final_msg="$final_msg (применена и проверена в Zapret2)"
                elif [ "$apply_restored" = "1" ]; then
                    final_msg="$final_msg (применение не подтвердилось, прежняя настройка возвращена)"
                elif [ -n "$apply_res" ]; then
                    final_msg="$final_msg (применена, но полный тест не пройден)"
                fi
            fi
            save_results "$target" "$strats_json"
            write_status "done" 100 "$final_msg" ",\"strategies\":$strats_json,\"scan_found\":$found_count,\"tried\":$found_count$apply_info"
            echo "[blockcheckw-helper] Finished successfully. Found $found_count working strategies." >> "$LOG_FILE"
            history_add "scan_done" "$(metric_target_key "$target")" "Найдено рабочих стратегий: $found_count"
            [ "$apply_ok" = "1" ] && history_add "apply" "$(metric_target_key "$target")" "Стратегия применена и проверена в Zapret2"
        else
            if [ "$exit_code" -ne 0 ]; then
                local last_err=$(scan_error_detail "$LOG_FILE" "$exit_code")
                # Самая частая причина на чистом роутере — нет модуля ядра nfnetlink_queue.
                local kmod_err=$(grep -E 'nfq_unbind_pf|nfq_bind_pf|nfq_open\(' "$LOG_FILE" 2>/dev/null | tail -n 1)
                [ -n "$kmod_err" ] && last_err=""
                if [ -z "$last_err" ] && [ -n "$kmod_err" ]; then
                    last_err="Нет модуля ядра nfnetlink_queue. Установите: opkg install kmod-nfnetlink-queue && modprobe nfnetlink_queue"
                fi
                if [ -z "$last_err" ]; then
                    case "$exit_code" in
                        6)
                            # Конкретную причину предполётная проверка уже записала в
                            # status.json ("Проверка перед подбором не прошла: ..."),
                            # показываем её, а не общий текст (issue #6).
                            local _pre=$(grep -o '"phase":"[^"]*"' "$STATUS_FILE" 2>/dev/null | head -n 1 | sed 's/"phase":"//; s/"$//')
                            case "$_pre" in
                                "Проверка перед подбором"*) last_err="$_pre" ;;
                                *) last_err="Предполётная проверка не прошла: нет движка nfqws2, модулей nfqueue или nftables. Запустите blockcheckw-helper doctor" ;;
                            esac
                            ;;
                        *) last_err="Код ошибки $exit_code — запустите blockcheckw-helper doctor для диагностики" ;;
                    esac
                fi
                write_status "error" 0 "Ошибка подбора: $last_err" ",\"strategies\":[]"
                echo "[blockcheckw-helper] Scan failed with exit code $exit_code: $last_err" >> "$LOG_FILE"
            else
                # Новых вариантов нет — но это не значит, что обход не работает:
                # ранее применённая стратегия остаётся в конфиге. Проверяем её.
                _svc_running || _svc_start_bg
                local cur_test=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
                if printf '%s' "$cur_test" | grep -q '"all_ok":true'; then
                    save_results "$target" "[]"
                    write_status "done" 100 "Новых стратегий не найдено — текущая конфигурация уже работает" ",\"strategies\":[],\"current_ok\":true"
                    echo "[blockcheckw-helper] 0 новых, текущая стратегия рабочая" >> "$LOG_FILE"
                else
                    save_results "$target" "[]"
                    write_status "done" 100 "Поиск завершен. Ничего не подошло, попробуйте глубокий скан." ",\"strategies\":[],\"current_ok\":false"
                    echo "[blockcheckw-helper] Scan completed with 0 matches." >> "$LOG_FILE"
                fi
            fi
        fi

        # EXIT cleanup restores runtime before releasing our scan fence.
    ) </dev/null >/dev/null 2>&1 &

    local pid=$!
    echo "$pid" > "$PID_FILE"
    echo '{"status":"started","pid":'"$pid"',"domain":"'"$domain"'","mode":"'"$mode"'","auto_apply":'"$auto_apply"'}'
}

cmd_status() {
    ensure_json
    local is_running=false
    if is_scanner_running; then
        is_running=true
    fi
    # Живой лок подбора важнее эвристики «процесс не найден»: в фазе
    # применения сканер — это shell, а не бинарь blockcheckw, и сторож
    # успевал объявить «done 100%», пока подбор ещё работал.
    local lock_alive=0
    if [ -d /var/run/bcw_scan.lock ]; then
        local _lp=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        if [ -n "$_lp" ] && kill -0 "$_lp" 2>/dev/null; then
            lock_alive=1
        fi
    fi

    lua - "$STATUS_FILE" "$LOG_FILE" "$OUTPUT_SCAN" "$is_running" "$lock_alive" << 'EOF'
local json = require("luci.jsonc")
local status_file = arg[1]
local log_file = arg[2]
local scan_file = arg[3]
local is_running = (arg[4] == "true")
local lock_alive = (arg[5] == "1")

local st = {}
local sf = io.open(status_file, "r")
if sf then
    st = json.parse(sf:read("*a")) or {}
    sf:close()
end

if not st.status then
    st.status = is_running and "running" or "idle"
    st.percent = is_running and 25 or 0
    st.phase = is_running and "Сканирование выполняется..." or "Готов к работе"
    st.strategies = {}
end

-- Process death watchdog: only trigger if really not running and status is stuck in running
if not is_running and not lock_alive and st.status == "running" then
    if (st.strategies and #st.strategies > 0) or st.auto_applied then
        st.status = "done"
        st.percent = 100
        st.phase = "Сканирование завершено"
    else
        local nixio = require("nixio")
        local attr = nixio.fs.stat(status_file)
        local is_stale = true
        if attr and attr.mtime and (os.time() - attr.mtime < 25) then
            is_stale = false
        end
        if is_stale then
            local finished = false
            local lf = io.open(log_file, "r")
            if lf then
                local content = lf:read("*a") or ""
                lf:close()
                if content:find("Summary for") or content:find("OK scan report") or
                   content:find("Finished successfully") or content:find("Auto%-applied strategy") or
                   content:find("Restoring zapret2") or content:find("Scan completed") or
                   content:find("успешно создана") or content:find("working strategies") then
                    finished = true
                end
            end
            if not finished then
                st.status = "error"
                st.phase = "Процесс сканера завершился неожиданно (нехватка RAM или сбой)."
            else
                st.status = "done"
                st.percent = 100
                st.phase = "Сканирование завершено"
            end
            local tmp = status_file .. ".tmp"
            local out = io.open(tmp, "w")
            if out then
                out:write(json.stringify(st))
                out:close()
                os.rename(tmp, status_file)
            end
        end
    end
end

-- Enrich with ISP from log if missing
if not st.isp or st.isp == "" then
    local lf = io.open(log_file, "r")
    if lf then
        for line in lf:lines() do
            local isp_match = line:match("ISP:%s*(.+)")
            if isp_match then
                st.isp = isp_match:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^%s+", "")
                break
            end
        end
        lf:close()
    end
end

-- Провайдер сохраняется cmd_asn/cmd_provider_save: не теряем его при
-- ротации журнала сканирования.
if not st.isp or st.isp == "" then
    local pf = io.open("/etc/zapret2wizard/provider", "r")
    if pf then
        local v = pf:read("*l")
        pf:close()
        if v and v:match("%S") then st.isp = v:gsub("^%s+", ""):gsub("%s+$", "") end
    end
end

-- Enrich with block_type from scan or log if missing
if not st.block_type or st.block_type == "" then
    local scf = io.open(scan_file, "r")
    if scf then
        local sc = json.parse(scf:read("*a")) or {}
        scf:close()
        if sc.block_type then
            st.block_type = sc.block_type
        end
    end
end

if not st.block_type or st.block_type == "" then
    local lf = io.open(log_file, "r")
    if lf then
        local content = lf:read("*a") or ""
        lf:close()
        local bt = content:match('"block_type":%s*"([^"]+)"')
        if bt then
            st.block_type = bt
        elseif content:find("SNI blocked") or content:find("BLOCKED") then
            st.block_type = "sni_blocked"
        elseif content:find("IP blocked") then
            st.block_type = "ip_blocked"
        end
    end
end

if not st.apply_result then
    local arf = io.open("/tmp/blockcheckw_apply_result.json", "r")
    if arf then
        local ar = json.parse(arf:read("*a"))
        arf:close()
        if ar then
            st.apply_result = ar
            if st.auto_applied == nil and ar.success then
                st.auto_applied = true
            end
        end
    end
end

if not st.dpi_fingerprint then
    local dpf = io.open("/tmp/blockcheckw_dpi_fingerprint.json", "r")
    if dpf then
        local dp = json.parse(dpf:read("*a"))
        dpf:close()
        if dp then st.dpi_fingerprint = dp end
    end
end

print(json.stringify(st))
EOF
}

# Запуск подбора в фоне: rpcd/uhttpd не ждут многоминутный скан.
cmd_start_bg() {
    exec 2>>/tmp/bcw_sb_trace.log
    echo "=== $(date +%H:%M:%S) start_bg begin ===" >> /tmp/bcw_sb_trace.log
    # Атомарный засов на время проверки и запуска: два одновременных клика
    # UI иначе успевают проскочить до создания лока подбора и запускают два скана.
    if command -v flock >/dev/null 2>&1; then
        exec 9>/var/run/bcw_start.lock
        if ! flock -n 9; then
            echo '{"ok":false,"error":"Подбор уже запускается"}'
            return 0
        fi
    fi
    set -x
    # Не даём запускать второй подбор: флаг, лок и живые процессы
    if [ -d /var/run/bcw_scan.lock ]; then
        local _p=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null; then
            echo '{"ok":false,"error":"Подбор уже выполняется"}'
            return 0
        fi
    fi
    if ps w | grep -qE '[b]lockcheckw-helper (start|apply) '; then
        echo '{"ok":false,"error":"Подбор уже выполняется"}'
        return 0
    fi
    # Быстрая синхронная проверка: UI сразу получает понятную причину.
    # Несовместимый/чужой nfqws2 (issue #6) — не тупик: запускаем штатное
    # восстановление движка и просим UI дождаться его и повторить подбор.
    if ! scan_preflight --no-reply; then
        case "$BCW_PREFLIGHT_CODE" in
            engine)
                if [ -d /var/run/bcw_engine_repair.lock ]; then
                    echo '{"ok":false,"repairing":true,"error":"Движок nfqws2 уже восстанавливается — дождитесь завершения и повторите подбор"}'
                else
                    ( exec 9>&-; cmd_engine_repair_bg >/dev/null 2>&1 ) || true
                    echo '{"ok":false,"repairing":true,"error":"Движок nfqws2 несовместим с прошивкой или обновлением — автоматически восстанавливаю совместимую версию. Это занимает 1–2 минуты; затем подбор запустится снова."}'
                fi
                ;;
            repairing)
                echo '{"ok":false,"repairing":true,"error":"Движок nfqws2 восстанавливается — дождитесь завершения и повторите подбор"}'
                ;;
            *)
                printf '%s\n' "$BCW_PREFLIGHT_JSON"
                return 1
                ;;
        esac
        return 0
    fi

    local quoted=""
    local a
    for a in "$@"; do
        quoted="$quoted '$a'"
    done
    if command -v setsid >/dev/null 2>&1; then
        : > /tmp/bcw_scan_bg.log
        setsid /bin/sh -c "exec /usr/bin/blockcheckw-helper start$quoted" </dev/null >>/tmp/bcw_scan_bg.log 2>&1 &
    else
        start-stop-daemon -S -b -x /bin/sh -- -c "/usr/bin/blockcheckw-helper start$quoted" >/dev/null 2>&1 \
            || ( /bin/sh -c "/usr/bin/blockcheckw-helper start$quoted" >/dev/null 2>&1 & )
    fi
    set +x
    echo "=== $(date +%H:%M:%S) start_bg end ===" >> /tmp/bcw_sb_trace.log
    echo '{"ok":true,"started":true}'
}

cmd_stop() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill -TERM "$pid" 2>/dev/null
            sleep 1
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    # Не убиваем текущий helper: иначе cleanup/restart ниже не выполнится
    # и служба останется остановленной после «Остановить подбор».
    local _self=$$
    local _p
    for _p in $(ps w 2>/dev/null | awk '/[b]lockcheckw-helper/ {print $1}'); do
        [ "$_p" = "$_self" ] || kill -9 "$_p" 2>/dev/null
    done
    killall -9 blockcheckw 2>/dev/null
    # Keeper-лок мог пережить скан: гасим его явно.
    if [ -d /var/run/bcw_scan.lock ]; then
        local _kp=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        [ -n "$_kp" ] && kill -9 "$_kp" 2>/dev/null
    fi
    rm -f /tmp/blockcheckw.lock
    rm -rf /var/run/bcw_scan.lock 2>/dev/null || true
    rm -f /tmp/bcw_scan_paused /tmp/bcw_paused_services 2>/dev/null || true
    nft delete table inet blockcheckw 2>/dev/null
    # Остановили службу — снимаем и Reject-QUIC, иначе YouTube-видео
    # остаётся без UDP/443 даже при работе другого обхода.
    if uci -q get firewall.reject_quic >/dev/null 2>&1; then
        uci -q set firewall.reject_quic.enabled=0
        uci -q commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    sh /usr/share/zapret2wizard/quic_reject.sh remove >/dev/null 2>&1 || true
    restart_dpi_service
    write_status "idle" 0 "Остановлено пользователем"
    echo '{"status":"stopped"}'
}

GOOD_CONFIG="/etc/zapret2wizard/.last_good_config"

cmd_save_good() {
    local if_missing="$1"
    mkdir -p /etc/zapret2wizard 2>/dev/null || true
    if [ -s "$GOOD_CONFIG" ] && [ "$if_missing" = "--if-missing" ]; then
        echo '{"saved":false,"reason":"exists"}'
        return 0
    fi
    cp -f /etc/config/zapret2wizard "$GOOD_CONFIG" 2>/dev/null || return 1
    chmod 600 "$GOOD_CONFIG" 2>/dev/null || true
    echo '{"saved":true}'
}

# Пост-установочная проверка пакета: дождаться nfqws2/nft, применить DNS-пины,
# проверить резолвер. Вызывается из postinst .ipk/.apk.
cmd_postinstall() {
    local i=0 ok=0
    while [ "$i" -lt 45 ]; do
        if pidof nfqws2 >/dev/null 2>&1 && nft list tables 2>/dev/null | grep -q 'zapret2wizard'; then
            ok=1
            break
        fi
        sleep 1
        i=$((i + 1))
    done
    if [ "$ok" != "1" ]; then
        /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || true
        i=0
        while [ "$i" -lt 30 ]; do
            if pidof nfqws2 >/dev/null 2>&1 && nft list tables 2>/dev/null | grep -q 'zapret2wizard'; then
                ok=1
                break
            fi
            sleep 1
            i=$((i + 1))
        done
    fi
    dns_fix_discord >/dev/null 2>&1 || true
    dns_fix_instagram >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 5 ]; do
        if nslookup www.google.com 127.0.0.1 >/dev/null 2>&1 || nslookup ya.ru 127.0.0.1 >/dev/null 2>&1; then
            break
        fi
        safe_dns_restart >/dev/null 2>&1 || true
        sleep 1
        i=$((i + 1))
    done
    if [ "$ok" = "1" ]; then
        echo '{"ok":true,"engines":"ready"}'
        return 0
    fi
    echo '{"ok":false,"error":"nfqws2/nft не поднялись"}'
    return 1
}

cmd_restore_good() {
    if [ ! -s "$GOOD_CONFIG" ]; then
        echo '{"ok":false,"error":"нет сохранённой рабочей конфигурации"}'
        return 1
    fi
    cp -f "$GOOD_CONFIG" /etc/config/zapret2wizard 2>/dev/null || return 1
    uci -q commit zapret2wizard 2>/dev/null || true
    logger -t zapret2wizard "восстановлена последняя рабочая конфигурация"
    ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
    echo '{"ok":true,"restored":true}'
}

# Клиентский probe через отдельную output-очередь nfqws: проверяет
# стратегию на реальном TLS-соединении, а не только curl с роутера.
probe_resolve() {
    local host="$1" ip="" i=0
    while [ "$i" -lt 6 ]; do
        ip=$(nslookup "$host" 127.0.0.1 2>/dev/null | awk '/^Address: /{print $2}' | grep -E '^[0-9.]+$' | head -n1)
        [ -n "$ip" ] && { echo "$ip"; return 0; }
        # dnsmasq мог перезапускаться вместе со службой — пробуем внешний DNS.
        ip=$(nslookup "$host" 1.1.1.1 2>/dev/null | awk '/^Address: /{print $2}' | grep -E '^[0-9.]+$' | head -n1)
        [ -n "$ip" ] && { echo "$ip"; return 0; }
        i=$((i + 1)); sleep 1
    done
    return 1
}

# Проверка видео-хоста googlevideo через тот же временный nfqws.
# Главная страница YouTube может открываться при стратегии, которая не
# поднимает видеопоток; проверяем TLS/HTTP к реальному googlevideo-хосту.
# Route adapter only: classifier remains transfer_probe.lua; nft/netns ownership stays here.
transfer_client_probe() {
    lua - "$1" "$2" "$3" "$4" "$5" "$6" "$7" << 'EOF'
local json = require("luci.jsonc")
local probe = dofile("/usr/share/zapret2wizard/transfer_probe.lua")
local mode,host,ip,url,min,allow4,ns = arg[1],arg[2],arg[3],arg[4],tonumber(arg[5]) or 1,arg[6],arg[7]
local range_finish = tonumber(arg[8]) or 4194303
local function quote(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
local role = allow4 == "1" and "reachability" or "bounded_data"
local function run(command, limit)
    -- Rewrite only the module's fixed curl token; no route claim from a label alone.
    local prefix = mode == "netns" and ("ip netns exec " .. quote(ns) .. " ") or ""
    command = command:gsub("curl %-q ", function()
        return prefix .. "curl -q -4 --resolve " .. quote(host .. ":443:" .. ip) .. " "
    end, 1)
    local p = io.popen(command, "r"); if not p then return nil,"spawn_failed" end
    local out = p:read(limit + 1); p:close()
    if not out or #out > limit then return nil,"output_truncated" end
    return out
end
local e = probe.probe({url=url, endpoint_id=host, role=role, path_mode=mode,
    range={start=0,finish=range_finish}, timeout_sec=30, max_bytes=8388608},
    {role=role,min_bytes=math.max(1,min),sample_bytes=host == "www.youtube.com" and 262144 or 131072,sample_seconds=0}, {run=run})
local sample_required = role ~= "reachability" and (host == "www.youtube.com" or host:match("googlevideo%.com$") ~= nil)
local ok = e.policy_passed and (role ~= "reachability" or e.http_code < 500) and (not sample_required or e.sample_sufficient)
print(json.stringify({ok=ok,mode=mode,host=host,ip=ip,url=url,code=tostring(e.http_code or "000"),
    bytes=e.bytes_received or 0,min=min,allow_4xx=allow4 == "1",bytes_known=e.bytes_known,
    transfer_verified=e.transfer_verified,data_sample=e.transfer_verified and e.sample_sufficient,
    verification_state=ok and (role == "reachability" and "reachable" or "data_sample") or "unverified",
    playback="unknown",verification_kind=sample_required and "page_sample" or role,budgetcap=8388608,evidence=e}))
EOF
}

# Извлекает прямой URL видеопотока из HTML страницы просмотра YouTube.
# Вход: файл с HTML (ytInitialPlayerResponse содержит signatureCipher/url).
# Выход: полный https://...googlevideo.com/videoplayback?... или пусто.
# Проверка видео-хоста googlevideo через тот же временный nfqws.
# Страница может открываться при стратегии, которая не поднимает сам
# видео-CDN. Полный URL потока curl-ом не проверить: у него не вычислен
# n-параметр (его считает JS плеера), и Google честно отвечает 403 даже
# когда канал открыт. Поэтому проверяем сам видео-хост: TLS-канал до него
# через обход должен отдавать HTTP (у канала нет n-параметра). Это точно
# отличает «канал режется» (000/RST) от «канал жив» (любой HTTP-ответ).
# Объёмный гейт (issue #9): качаем 2-МБ диапазон статики с объявленным
# Content-Length через тот же временный nfqws. Усечение ниже объявленного
# размера = побайтовый кап провайдера; ClientHello-стратегии его не снимают,
# поэтому это единственный способ отличить «канал открыт» от «канал капается».
# $1 — URL, $2 — qnum. Печатает JSON {ok,passes,total,bytes,expected,code,host}.
probe_volume_gate() {
    local url="$1" q="$2" vhost vip out code=000 bytes=0 passes=2 okc=0 i=1 okjson=false reason=""
    vhost=${url#https://}; vhost=${vhost%%/*}
    vip=$(probe_resolve "$vhost") || true
    [ -n "$vip" ] || { echo '{"ok":false,"skipped":"no A","host":"'"$vhost"'"}'; return 1; }
    nft add rule inet bcwprobe out meta mark and 0x40000000 == 0 ip daddr "$vip" tcp dport 443 queue num "$q" bypass 2>/dev/null || true
    nft add rule inet bcwprobe in meta mark and 0x40000000 == 0 ip saddr "$vip" tcp sport 443 queue num "$q" bypass 2>/dev/null || true
    while [ "$i" -le "$passes" ]; do
        out=$(transfer_client_probe output "$vhost" "$vip" "$url" 2097152 0 "" 2097151 2>/dev/null || true)
        code=$(printf '%s' "$out" | sed -n 's/.*"code":"\([0-9]*\)".*/\1/p')
        bytes=$(printf '%s' "$out" | sed -n 's/.*"bytes_received":\([0-9]*\).*/\1/p')
        [ -n "$bytes" ] || bytes=0
        printf '%s' "$out" | grep -q '"ok":true' && okc=$((okc+1))
        i=$((i+1))
    done
    [ "$okc" = "$passes" ] && okjson=true || reason=flow_truncated
    printf '{"ok":%s,"passes":%s,"total":%s,"bytes":%s,"expected":2097152,"code":"%s","host":"%s","reason":"%s"}\n' \
        "$okjson" "$okc" "$passes" "$bytes" "${code:-000}" "$vhost" "$reason"
}

probe_youtube_video_host() {
    local q="$1" pageip="$2" page="/tmp/bcw_yt_video_page.$$" vhost vip out vpath vol_res vol_json
    # Страница тянется через тот же временный nfqws (правила очереди для
    # www.youtube.com уже стоят): если стратегия не поднимает даже базу —
    # видео-хост проверять нечего.
    [ -n "$pageip" ] || pageip=$(probe_resolve www.youtube.com) || true
    [ -n "$pageip" ] || { echo '{"ok":false,"video_error":"no youtube A"}'; return 1; }
    local _ptry
    for _ptry in 1 2; do
        curl -4 -sS -m 25 --resolve "www.youtube.com:443:$pageip" "https://www.youtube.com/watch?v=dQw4w9WgXcQ" -o "$page" 2>/dev/null || true
        [ -s "$page" ] && break
        [ "$_ptry" -lt 2 ] && sleep 3
    done
    [ -s "$page" ] || { rm -f "$page"; echo '{"ok":false,"video_error":"empty page"}'; return 1; }
    vhost=$(grep -o 'https://[A-Za-z0-9._-]*googlevideo\.com/' "$page" 2>/dev/null | head -n1 | sed 's#https://##; s#/$##')
    # Статика плеера с объявленным размером — материал для объёмного гейта.
    vpath=$(grep -o '/s/player/[A-Za-z0-9_-]*/player_ias\.vflset/[A-Za-z0-9_-]*/base\.js' "$page" 2>/dev/null | head -n1)
    rm -f "$page"
    [ -n "$vhost" ] || { echo '{"ok":false,"video_error":"no googlevideo host"}'; return 1; }
    vip=$(probe_resolve "$vhost") || true
    [ -n "$vip" ] || { echo '{"ok":false,"video_host":"'"$vhost"'","video_error":"no video A"}'; return 1; }
    nft add rule inet bcwprobe out meta mark and 0x40000000 == 0 ip daddr "$vip" tcp dport 443 queue num "$q" bypass 2>/dev/null || true
    nft add rule inet bcwprobe in meta mark and 0x40000000 == 0 ip saddr "$vip" tcp sport 443 queue num "$q" bypass 2>/dev/null || true
    local _vtry
    for _vtry in 1 2 3; do
        out=$(transfer_client_probe output "$vhost" "$vip" "https://$vhost/robots.txt" 1 1 "" 2>/dev/null || true)
        case "$out" in *'"ok":true'*) break ;; esac
        [ "$_vtry" -lt 3 ] && sleep 2
    done
    vol_json='{"ok":true,"skipped":"no asset"}'
    if [ -n "$vpath" ]; then
        vol_res=$(probe_volume_gate "https://www.youtube.com$vpath" "$q" 2>/dev/null || true)
        [ -n "$vol_res" ] && vol_json="$vol_res"
    fi
    out=$(lua - "$out" "$vol_json" <<'EOF'
local json = require("luci.jsonc")
local v = json.parse(arg[1]) or {}
local vol = json.parse(arg[2]) or {}
v.volume = vol
if vol and vol.skipped == nil and vol.ok ~= true then v.ok = false end
print(json.stringify(v))
EOF
)
    printf '%s\n' "$out"
    echo "$out" | grep -q '"ok":true'
}

client_probe_output() {
    local target="$1" host="" url="" min=50000 ip out code size pid cmd tpid q=65302 allow4=0
    case "$target" in
        preset_youtubei|ytapi|youtubei.googleapis.com) host="youtubei.googleapis.com"; url="https://youtubei.googleapis.com/"; min=0; allow4=1 ;;
        preset_youtube|youtube) host="www.youtube.com"; url="https://www.youtube.com/"; min=50000 ;;
        preset_discord|discord) host="discord.com"; url="https://discord.com/login"; min=50000 ;;
        preset_instagram|instagram) host="www.instagram.com"; url="https://www.instagram.com/"; min=50000 ;;
        preset_twitch|twitch) host="www.twitch.tv"; url="https://www.twitch.tv/"; min=30000 ;;
        preset_x|x) host="x.com"; url="https://x.com/"; min=10000 ;;
        builtin|general) host="rutracker.org"; url="https://rutracker.org/"; min=0 ;;
        *) host="$target"; url="https://$target/"; min=1000 ;;
    esac
    command -v nft >/dev/null 2>&1 || { echo '{"ok":false,"error":"nft missing"}'; return 1; }
    command -v curl >/dev/null 2>&1 || { echo '{"ok":false,"error":"curl missing"}'; return 1; }
    ip=$(probe_resolve "$host") || true
    [ -n "$ip" ] || { echo '{"ok":false,"host":"'"$host"'","error":"no A record"}'; return 1; }
    pid=$(for c in /proc/[0-9]*/comm; do [ "$(cat "$c" 2>/dev/null)" = nfqws2 ] || continue; p=$(echo "$c" | cut -d/ -f3); tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- '--qnum=300' && { echo "$p"; break; }; done)
    [ -n "$pid" ] || { echo '{"ok":false,"error":"nfqws2 qnum=300 not found"}'; return 1; }
    cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | sed "s/--qnum=300/--qnum=$q/")
    [ -n "$cmd" ] || { echo '{"ok":false,"error":"empty nfqws cmdline"}'; return 1; }
    local _probe_nfq_pid=""
    _probe_qnum_pids() {
        local p
        for p in $(pgrep nfqws2 2>/dev/null); do
            tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- "--qnum=$q" && echo "$p"
        done
    }
    _probe_cleanup() {
        nft delete table inet bcwprobe 2>/dev/null || true
        [ -n "$tpid" ] && kill "$tpid" 2>/dev/null || true
        [ -n "$_probe_nfq_pid" ] && kill -9 "$_probe_nfq_pid" 2>/dev/null || true
        # setsid-обёртка убивала только себя, а nfqws2 оставался жить и держал
        # очередь: следующая проба не могла привязаться, правила bypass
        # пропускали трафик мимо стратегии, и проверки висели на таймаутах.
        local _p
        for _p in $(pgrep nfqws2 2>/dev/null); do
            tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null | grep -q -- "--qnum=$q" && kill -9 "$_p" 2>/dev/null
        done
        rm -rf /tmp/bcw_probe.lock 2>/dev/null || true
    }
    if [ -d /tmp/bcw_probe.lock ]; then
        local _pp=$(cat /tmp/bcw_probe.lock/pid 2>/dev/null)
        local _now=$(date +%s 2>/dev/null || echo 0)
        local _mt=$(stat -c %Y /tmp/bcw_probe.lock 2>/dev/null || echo 0)
        local _age=$((_now - _mt))
        # Лок «занят» только если владелец жив, это не мы и лок свежий:
        # иначе (умерший PID, PID переиспользован, лок от нашего же шелла) —
        # снимаем. Раньше очистка звала `rm -f` на каталог, лок оставался
        # навсегда и каждая следующая проверка падала с `probe busy` —
        # из-за этого эволюция давала 0 рабочих стратегий (#11).
        if [ -n "$_pp" ] && [ "$_pp" != "$$" ] && kill -0 "$_pp" 2>/dev/null && [ "${_age:-999}" -lt 180 ]; then
            echo '{"ok":false,"error":"probe busy"}'; return 1
        fi
        rm -rf /tmp/bcw_probe.lock
    fi
    if ! mkdir /tmp/bcw_probe.lock 2>/dev/null; then
        echo '{"ok":false,"error":"probe busy"}'; return 1
    fi
    echo $$ > /tmp/bcw_probe.lock/pid 2>/dev/null || true
    trap '_probe_cleanup' EXIT INT TERM
    nft delete table inet bcwprobe 2>/dev/null || true
    # Страховка от утёкшего nfqws от предыдущей пробы: иначе bind на ту же
    # очередь падает, правила уходят в bypass, и все проверки висят.
    for _p in $(_probe_qnum_pids); do kill -9 "$_p" 2>/dev/null; done
    setsid /bin/sh -c "exec $cmd" </dev/null >/tmp/bcw_probe.nfq.log 2>&1 &
    tpid=$!
    sleep 1
    _probe_nfq_pid=$(_probe_qnum_pids | head -n 1)
    if [ -z "$_probe_nfq_pid" ]; then
        _probe_cleanup
        echo '{"ok":false,"error":"temp nfqws failed to bind"}'
        return 1
    fi
    nft add table inet bcwprobe 2>/dev/null || { _probe_cleanup; echo '{"ok":false,"error":"nft table"}'; return 1; }
    nft add chain inet bcwprobe out '{ type filter hook output priority -150; policy accept; }' 2>/dev/null || true
    nft add chain inet bcwprobe in '{ type filter hook input priority -150; policy accept; }' 2>/dev/null || true
    nft add rule inet bcwprobe out meta mark and 0x40000000 == 0 ip daddr "$ip" tcp dport 443 queue num "$q" bypass 2>/dev/null || true
    nft add rule inet bcwprobe in meta mark and 0x40000000 == 0 ip saddr "$ip" tcp sport 443 queue num "$q" bypass 2>/dev/null || true
    sleep 1
    out=$(transfer_client_probe output "$host" "$ip" "$url" "$min" "$allow4" "")
    # Видео-CDN и объёмный гейт — обязательные части проверки YouTube:
    # страница открывается и при стратегии, которая не поднимает видеопоток
    # и не снимает побайтовый кап провайдера (issue #9).
    local video_res='{"ok":true}' vol_res='{"ok":true,"skipped":"n/a"}'
    if [ "$target" = "preset_youtube" ] || [ "$target" = "youtube" ]; then
        video_res=$(probe_youtube_video_host "$q" "$ip" 2>/dev/null || true)
        [ -n "$video_res" ] || video_res='{"ok":false,"video_error":"no video probe result"}'
    elif [ "$target" = "preset_discord" ] || [ "$target" = "discord" ]; then
        vol_res=$(probe_volume_gate "https://stable.dl2.discordapp.net/distro/app/stable/win/x86/1.0.9059/DiscordSetup.exe" "$q" 2>/dev/null || true)
        [ -n "$vol_res" ] || vol_res='{"ok":false,"skipped":"no volume probe result"}'
    fi
    _probe_cleanup
    trap - EXIT INT TERM
    out=$(lua - "$out" "$video_res" "$vol_res" <<'EOF'
local json = require("luci.jsonc")
local out = json.parse(arg[1]) or {}
local v = json.parse(arg[2]) or {}
local vol = json.parse(arg[3]) or {}
if out and v then
    out.video = v
    if v.ok ~= true then out.ok = false end
    local volobj = v.volume or vol
    if volobj then
        out.volume = volobj
        if volobj.skipped == nil and volobj.ok ~= true then out.ok = false end
    end
end
print(json.stringify(out))
EOF
)
    printf '%s\n' "$out"
    echo "$out" | grep -q '"ok":true'
}

# Точный клиентский путь: временный netns + veth, трафик идёт через
# forward-цепочку и реальную очередь nfqws. Требует kmod-veth.
client_probe_netns() {
    local target="$1" host="" url="" min=50000 ip out code size allow4=0
    [ "$2" = "--allow-4xx" ] && allow4=1
    case "$target" in
        preset_youtubei|ytapi|youtubei.googleapis.com) host="youtubei.googleapis.com"; url="https://youtubei.googleapis.com/"; min=0; allow4=1 ;;
        preset_youtube|youtube) host="www.youtube.com"; url="https://www.youtube.com/"; min=50000 ;;
        preset_discord|discord) host="discord.com"; url="https://discord.com/login"; min=50000 ;;
        preset_instagram|instagram) host="www.instagram.com"; url="https://www.instagram.com/"; min=50000 ;;
        preset_twitch|twitch) host="www.twitch.tv"; url="https://www.twitch.tv/"; min=30000 ;;
        preset_x|x) host="x.com"; url="https://x.com/"; min=10000 ;;
        builtin|general) host="rutracker.org"; url="https://rutracker.org/"; min=0 ;;
        *) host="$target"; url="https://$target/"; min=1000 ;;
    esac
    command -v ip >/dev/null 2>&1 || { echo '{"ok":false,"error":"ip missing"}'; return 1; }
    ip=$(probe_resolve "$host") || true
    [ -n "$ip" ] || { echo '{"ok":false,"host":"'"$host"'","error":"no A record"}'; return 1; }
    NS=bcwprobe; VH=veth-bcwp; VN=veth-bcn
    _netns_cleanup() {
        local h
        for h in $(nft -a list chain inet fw4 forward 2>/dev/null | awk '/bcwprobe/{print $NF}'); do nft delete rule inet fw4 forward handle "$h" 2>/dev/null || true; done
        for h in $(nft -a list chain inet fw4 input 2>/dev/null | awk '/bcwprobe/{print $NF}'); do nft delete rule inet fw4 input handle "$h" 2>/dev/null || true; done
        nft delete table ip bcwprobe_nat 2>/dev/null || true
        ip netns del "$NS" 2>/dev/null || true
        ip link del "$VH" 2>/dev/null || true
    }
    _netns_cleanup
    if ! ip netns add "$NS" 2>/dev/null; then
        echo '{"ok":false,"mode":"netns","error":"netns unsupported"}'; return 1
    fi
    if ! ip link add "$VH" type veth peer name "$VN" 2>/dev/null; then
        _netns_cleanup
        echo '{"ok":false,"mode":"netns","error":"veth unsupported (install kmod-veth)"}'; return 1
    fi
    trap '_netns_cleanup' EXIT INT TERM
    ip link set "$VN" netns "$NS" 2>/dev/null || true
    ip addr add 10.99.99.1/24 dev "$VH" 2>/dev/null || true
    ip link set "$VH" up 2>/dev/null || true
    ip netns exec "$NS" ip addr add 10.99.99.2/24 dev "$VN" 2>/dev/null || true
    ip netns exec "$NS" ip link set "$VN" up 2>/dev/null || true
    ip netns exec "$NS" ip link set lo up 2>/dev/null || true
    ip netns exec "$NS" ip route add default via 10.99.99.1 2>/dev/null || true
    nft insert rule inet fw4 input ip saddr 10.99.99.0/24 accept comment bcwprobe 2>/dev/null || true
    nft insert rule inet fw4 forward ip saddr 10.99.99.0/24 accept comment bcwprobe 2>/dev/null || true
    nft add table ip bcwprobe_nat 2>/dev/null || true
    nft add chain ip bcwprobe_nat post '{ type nat hook postrouting priority 100; policy accept; }' 2>/dev/null || true
    nft add rule ip bcwprobe_nat post ip saddr 10.99.99.0/24 masquerade 2>/dev/null || true
    out=$(transfer_client_probe netns "$host" "$ip" "$url" "$min" "$allow4" "$NS")
    _netns_cleanup
    trap - EXIT INT TERM
    printf '%s\n' "$out"
    echo "$out" | grep -q '"ok":true'
}

cmd_apply_bg() {
    rm -f /tmp/bcw_apply_done /tmp/bcw_apply_result.json /tmp/bcw_apply_err.log 2>/dev/null || true
    # Маркер старта: по нему apply_status отличает «идёт» от «не запустился».
    : > /tmp/bcw_apply_started
    # Отдельная сессия + закрытие унаследованных fd 3..9: иначе LuCI fs.exec
    # держит pipe/ждёт процесс и UI получает XHR timeout.
    if command -v setsid >/dev/null 2>&1; then
        setsid sh -c '
            exec 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&-;
            /usr/bin/blockcheckw-helper apply "$@" >/tmp/bcw_apply_result.json 2>/tmp/bcw_apply_err.log;
            echo done >/tmp/bcw_apply_done
        ' bcw "$@" </dev/null >/dev/null 2>&1 &
    else
        sh -c '
            exec 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&-;
            /usr/bin/blockcheckw-helper apply "$@" >/tmp/bcw_apply_result.json 2>/tmp/bcw_apply_err.log;
            echo done >/tmp/bcw_apply_done
        ' bcw "$@" </dev/null >/dev/null 2>&1 &
    fi
    echo '{"success":true,"started":true}'
}

cmd_apply_status() {
    if [ -f /tmp/bcw_apply_done ]; then
        rm -f /tmp/bcw_apply_started 2>/dev/null || true
        cat /tmp/bcw_apply_result.json 2>/dev/null || echo '{"success":false,"error":"пустой результат apply"}'
    elif [ -f /tmp/bcw_apply_started ]; then
        echo '{"pending":true}'
    else
        echo '{"pending":false,"success":false,"error":"apply не запускался"}'
    fi
}

# ============================================================================
# issue #12: перебор ВСЕХ найденных стратегий (A) и история конфигураций (B)
# ============================================================================

# ---------- A) Перебор всех найденных стратегий ----------
# Применяет по очереди стратегии из сохранённых результатов поиска,
# останавливается на первой подтверждённой, провалившиеся уходят в бан.
# Прогресс пишется в /tmp/bcw_apply_all.state для UI.
cmd_apply_all() {
    local target="" limit=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --limit) limit="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [ -n "$target" ] || { echo '{"success":false,"error":"missing --target"}'; return 1; }
    if scan_busy; then echo '{"success":false,"error":"идёт подбор — перебор недоступен"}'; return 1; fi
    if ! mkdir /var/run/bcw_applyall.lock 2>/dev/null; then
        echo '{"success":false,"error":"перебор уже идёт"}'; return 1
    fi
    # state-файл НЕ удаляем: UI читает финальный результат (applied/failed/stopped).
    trap 'rm -rf /var/run/bcw_applyall.lock /tmp/bcw_apply_all.current 2>/dev/null' EXIT INT TERM
    rm -f /tmp/bcw_apply_all.stop
    local dom=$(target_domain "$target")
    [ -n "$dom" ] || dom="$target"
    local args_list
    args_list=$(cmd_results "$target" | lua -e 'local j=require("luci.jsonc"); local s=io.read("*a"); local ok,d=pcall(j.parse,s); if not ok or not d then return end; for _,x in ipairs(d.strategies or {}) do local a=(type(x)=="table" and x.args) or x; if type(a)=="string" and a:sub(1,2)=="--" then print(a) end end' 2>/dev/null)
    local total
    total=$(printf '%s\n' "$args_list" | grep -c '^--')
    total=${total:-0}
    [ "$total" -gt 0 ] || { echo '{"success":false,"error":"нет сохранённых результатов поиска — сначала запустите поиск"}'; return 1; }
    [ "$limit" -gt 0 ] && [ "$limit" -lt "$total" ] && total=$limit
    printf 'target=%s\nindex=0\ntotal=%s\nresult=running\n' "$target" "$total" > /tmp/bcw_apply_all.state
    local idx=0 cand res
    while IFS= read -r cand; do
        [ -n "$cand" ] || continue
        idx=$((idx + 1))
        [ "$limit" -gt 0 ] && [ "$idx" -gt "$limit" ] && break
        if [ -f /tmp/bcw_apply_all.stop ]; then
            printf 'target=%s\nindex=%s\ntotal=%s\nresult=stopped\nmessage=остановлено пользователем (проверено %s из %s)\n' "$target" "$idx" "$total" "$((idx - 1))" "$total" > /tmp/bcw_apply_all.state
            echo "[blockcheckw-helper] apply_all: остановлено пользователем" >> "$LOG_FILE" 2>/dev/null || true
            return 0
        fi
        printf '%s' "$cand" > /tmp/bcw_apply_all.current
        printf 'target=%s\nindex=%s\ntotal=%s\nresult=running\n' "$target" "$idx" "$total" > /tmp/bcw_apply_all.state
        echo "[blockcheckw-helper] apply_all: кандидат $idx/$total — $cand" >> "$LOG_FILE" 2>/dev/null || true
        res=$(cmd_apply --target "$target" --script "$cand" 2>/dev/null)
        if printf '%s' "$res" | grep -q '"accepted":true'; then
            local ms
            ms=$(cmd_test "$target" "" 2>/dev/null | awk -F'"time_sec":"' '{if (NF>1) {split($2,a,"\""); print int(a[1]*1000)}}' | head -1)
            [ -n "$ms" ] || ms=0
            mem put "$dom" "$(domain_ip "$dom")" "$cand" 1 "$ms" >/dev/null 2>&1 || true
            printf 'target=%s\nindex=%s\ntotal=%s\nresult=applied\nmessage=применена и проверена (кандидат %s из %s)\n' "$target" "$idx" "$total" "$idx" "$total" > /tmp/bcw_apply_all.state
            rm -f /tmp/bcw_apply_all.current
            echo "[blockcheckw-helper] apply_all: успех на кандидате $idx/$total" >> "$LOG_FILE" 2>/dev/null || true
            return 0
        fi
        mem ban "$dom" "$cand" "перебор всех: не подтвердилась" >/dev/null 2>&1 || true
    done <<APPLYLIST
$args_list
APPLYLIST
    rm -f /tmp/bcw_apply_all.current
    printf 'target=%s\nindex=%s\ntotal=%s\nresult=failed\nmessage=ни одна из %s не подтвердилась; прежняя конфигурация сохранена\n' "$target" "$total" "$total" "$total" > /tmp/bcw_apply_all.state
    echo "[blockcheckw-helper] apply_all: ни одна из $total не подтвердилась" >> "$LOG_FILE" 2>/dev/null || true
    return 0
}

cmd_apply_all_bg() {
    rm -f /tmp/bcw_apply_all.state /tmp/bcw_apply_all.current /tmp/bcw_apply_all.stop /tmp/bcw_apply_all.done 2>/dev/null || true
    if command -v setsid >/dev/null 2>&1; then
        setsid sh -c '/usr/bin/blockcheckw-helper apply_all "$@" >/tmp/bcw_apply_all.log 2>&1; echo done >/tmp/bcw_apply_all.done' bcw "$@" </dev/null >/dev/null 2>&1 &
    else
        sh -c '/usr/bin/blockcheckw-helper apply_all "$@" >/tmp/bcw_apply_all.log 2>&1; echo done >/tmp/bcw_apply_all.done' bcw "$@" </dev/null >/dev/null 2>&1 &
    fi
    sleep 1
    echo '{"success":true,"started":true}'
}

cmd_apply_all_status() {
    local running=0
    [ -d /var/run/bcw_applyall.lock ] && running=1
    lua - "$running" /tmp/bcw_apply_all.state /tmp/bcw_apply_all.current <<'LUA'
local j = require("luci.jsonc")
local running = arg[1] == "1"
local st, cur = {}, ""
local f = io.open(arg[2], "r")
if f then for line in f:lines() do local k, v = line:match("^(%w+)=(.*)$"); if k then st[k] = v end end f:close() end
local cf = io.open(arg[3], "r")
if cf then cur = cf:read("*a") or ""; cf:close() end
if not running and st.result == "running" then st.result = "interrupted"; st.message = "перебор прерван (служба/процесс остановлены)" end
print(j.stringify({running = running, target = st.target, index = tonumber(st.index) or 0,
    total = tonumber(st.total) or 0, result = st.result or "", message = st.message or "", current = cur}))
LUA
}

cmd_apply_all_stop() {
    : > /tmp/bcw_apply_all.stop 2>/dev/null || true
    echo '{"ok":true,"stopping":true}'
}

# ---------- B) История проверенных (хороших) конфигураций ----------
cmd_good_history_add() {
    local tgt="$1" sec="$2" script="$3" code="$4" bytes="$5"
    [ -n "$script" ] || return 1
    local dir="/etc/zapret2wizard/good_history"
    mkdir -p "$dir" 2>/dev/null || return 1
    local ts=$(date +%s) id="${ts}_$$"
    cp -f "/etc/config/$(_strategy_pkg)" "$dir/cfg-$id.uci" 2>/dev/null || true
    chmod 600 "$dir/cfg-$id.uci" 2>/dev/null || true
    lua - "$dir" "$id" "$ts" "$tgt" "$sec" "$script" "$code" "$bytes" <<'LUA' >/dev/null 2>&1
local j = require("luci.jsonc")
local dir, id, ts, tgt, sec, script, code, bytes = arg[1], arg[2], arg[3], arg[4], arg[5], arg[6], arg[7], arg[8]
local f = io.open(dir .. "/entry-" .. id .. ".json", "w")
if not f then return end
f:write(j.stringify({id = id, ts = tonumber(ts), target = tgt, section = sec, script = script, http_code = code, bytes = tonumber(bytes) or 0}))
f:close()
-- пересобрать entries.json: последние 10, без дублей target+script
local entries = {}
local p = io.popen("ls -1 " .. dir .. "/entry-*.json 2>/dev/null")
if p then for path in p:lines() do local h = io.open(path, "r"); if h then local ok, d = pcall(j.parse, h:read("*a")); h:close(); if ok and d and d.id then entries[#entries + 1] = d end end end p:close() end
table.sort(entries, function(a, b) return (a.ts or 0) > (b.ts or 0) end)
local seen, kept = {}, {}
for _, e in ipairs(entries) do local key = (e.target or "") .. "|" .. (e.script or ""); if not seen[key] then seen[key] = true; kept[#kept + 1] = e end end
local keep = {}
for i = 1, math.min(#kept, 10) do keep[kept[i].id] = true end
for _, e in ipairs(entries) do
    if not keep[e.id] then
        os.remove(dir .. "/entry-" .. e.id .. ".json")
        os.remove(dir .. "/cfg-" .. e.id .. ".uci")
    end
end
local out = {}
for i = 1, math.min(#kept, 10) do out[#out + 1] = kept[i] end
local w = io.open(dir .. "/entries.json", "w")
if w then w:write(j.stringify({entries = out})); w:close() end
LUA
    return 0
}

cmd_good_history_list() {
    local dir="/etc/zapret2wizard/good_history"
    if [ -s "$dir/entries.json" ]; then
        cat "$dir/entries.json"
    else
        echo '{"entries":[]}'
    fi
}

cmd_good_history_restore() {
    local id="$1"
    case "$id" in
        ""|*[!0-9_]*) echo '{"ok":false,"error":"некорректный id"}'; return 1 ;;
    esac
    local dir="/etc/zapret2wizard/good_history"
    [ -s "$dir/cfg-$id.uci" ] || { echo '{"ok":false,"error":"конфигурация не найдена"}'; return 1; }
    cp -f "$dir/cfg-$id.uci" "/etc/config/$(_strategy_pkg)" || { echo '{"ok":false,"error":"не удалось скопировать"}'; return 1; }
    uci -q commit "$(_strategy_pkg)" 2>/dev/null || true
    /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
    ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
    logger -t zapret2wizard "восстановлена конфигурация из истории: $id"
    echo '{"ok":true,"restored":true,"id":"'"$id"'"}'
}

# ---------- B) Сравнение текущей стратегии с кандидатом ----------
cmd_strategy_compare() {
    local target="" args=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --args) args="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [ -n "$args" ] || { echo '{"ok":false,"error":"no args"}'; return 1; }
    local sec=$(_strategy_section "$target")
    local cur=""
    [ -n "$sec" ] && cur=$(uci -q get "$(_strategy_pkg).$sec.script" 2>/dev/null)
    local last='{}'
    [ -s /tmp/blockcheckw_apply_result.json ] && last=$(cat /tmp/blockcheckw_apply_result.json 2>/dev/null)
    lua - "$args" "$cur" "$last" <<'LUA'
local j = require("luci.jsonc")
local args, cur, last = arg[1], arg[2], arg[3]
local function h(s)
    local x = 5381
    for i = 1, #s do x = (x * 31 + s:byte(i)) % 2147483647 end
    return string.format("%08x", math.floor(x))
end
local recipes = {}
local f = io.open("/etc/zapret2wizard/strategy_memory.json", "r")
if f then local ok, d = pcall(j.parse, f:read("*a")); f:close(); if ok and d and d.recipes then recipes = d.recipes end end
local function mem_for(s) local r = recipes[h(s)]; return {ok = (r and r.ok) or 0, fail = (r and r.fail) or 0, ewma = (r and r.ewma) or 0, best = (r and r.best) or 0} end
local ok, d = pcall(j.parse, last)
if not ok then d = nil end
local last_apply = nil
if d and d.target then
    last_apply = {target = d.target, all_ok = d.all_ok, http_code = d.http_code, rolled_back = d.rolled_back, message = d.message}
end
print(j.stringify({ok = true, current = {script = cur or "", memory = mem_for(cur or ""), last_apply = last_apply},
    candidate = {args = args, memory = mem_for(args)}}))
LUA
}


cmd_apply() {
    if ! mkdir /var/run/bcw_apply_runtime.lock 2>/dev/null; then
        engine_reply 0 "Применение стратегии уже выполняется"; return 1
    fi
    (
        trap 'rmdir /var/run/bcw_apply_runtime.lock 2>/dev/null || true' EXIT
        trap 'exit 1' INT TERM HUP
        cmd_apply_impl "$@"
    )
}

cmd_apply_impl() {
    if [ -d /var/run/bcw_engine_repair.lock ]; then
        engine_reply 0 "Дождитесь завершения проверки движка после обновления"
        return 1
    fi
    local target=""
    local script_text=""
    local script_file=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --script) script_text="$2"; shift 2 ;;
            --file) script_file="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -n "$script_file" ] && [ -f "$script_file" ]; then
        script_text=$(cat "$script_file")
    fi

    cmd_save_good >/dev/null 2>&1 || true
    # Иногда в файл попадает целая строка лога blockcheck2 вида
    # "curl_test_https_tls12 ipv4 discord.com : nfqws2 --payload=...". Оставляем только аргументы.
    case "$script_text" in
        *" : nfqws2 "*) script_text="${script_text##* : nfqws2 }" ;;
    esac
    script_text=$(printf '%s' "$script_text" | tr '\n\r\t' '   ' | tr -s ' ' | sed 's/^ //; s/ $//')

    # Неполная стратегия (обрывок вроде "--payload=tls_client_hello") ломает обход.
    if [ -n "$script_text" ] && ! printf '%s' "$script_text" | grep -q -- '--lua-desync\|--new\|--filter'; then
        echo '{"success":false,"error":"Стратегия неполная: нет --lua-desync"}'
        return 1
    fi

    if [ -z "$target" ] || [ -z "$script_text" ]; then
        echo '{"success":false,"error":"Missing --target or --script argument"}'
        return 1
    fi
    case "$target" in
        preset_youtube|youtube|preset_discord|discord|preset_instagram|instagram|preset_youtubei|ytapi|preset_x|x|preset_twitch|twitch|builtin|general) ;;
        *) echo '{"success":false,"error":"поддерживаются только YouTube, Discord, Instagram, YouTube API, X, Twitch и встроенные хосты"}'; return 1 ;;
    esac

    # Backup zapret2 config
    local ts=$(date +%Y%m%d_%H%M%S)
    local _bpkg=$(_strategy_pkg)
    cp -f "/etc/config/$_bpkg" "/etc/config/$_bpkg.bak.$ts" 2>/dev/null || true

    # Снимок конфигов для авто-отката: apply меняет обе возможные секции.
    local rb_dir="/tmp/bcw_apply_rollback"
    rm -rf "$rb_dir"; mkdir -p "$rb_dir"
    local _rpkg
    for _rpkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$_rpkg" ] && cp -f "/etc/config/$_rpkg" "$rb_dir/$_rpkg"
    done

    # Map target to base strategy section
    local base_sec=""
    local port="443"
    local l7="tls"
    local hostlist=""
    local test_url=""

    case "$target" in
        preset_youtubei|ytapi)
            ensure_preset_hostlist "preset_youtubei"
            base_sec="YTApi"
            port="443"
            l7="tls"
            hostlist="ytapi_hostlist"
            test_url="https://youtubei.googleapis.com/"
            ;;
        preset_youtube|youtube)
            base_sec="BlockcheckW_YouTube"
            port="443"
            l7="tls"
            hostlist="list_hosts_youtube"
            test_url="https://googlevideo.com"
            ;;
        preset_discord|discord)
            base_sec="BlockcheckW_Discord"
            port="443"
            l7="tls discord"
            hostlist="list_hosts_discord"
            test_url="https://discord.com"
            ;;
        preset_twitch|twitch)
            base_sec="BlockcheckW_Twitch"
            port="443"
            l7="tls"
            hostlist="list_hosts_twitch"
            test_url="https://twitch.tv"
            ;;
        preset_x|x)
            base_sec="BlockcheckW_X"
            port="443"
            l7="tls"
            hostlist="list_hosts_x"
            test_url="https://x.com"
            ;;
        preset_instagram|instagram)
            base_sec="BlockcheckW_Instagram"
            port="443"
            l7="tls"
            hostlist="list_hosts_instagram"
            test_url="https://gateway.instagram.com"
            ;;
        tcp16)
            base_sec="BlockcheckW_TCP16"
            port="443"
            l7="tls"
            hostlist="list_hosts_discord"
            test_url="https://discord.com"
            ;;
        builtin|general)
            base_sec="BlockcheckW_General"
            port="80,443"
            l7="tls http"
            hostlist="list_hosts_user"
            test_url="https://rutracker.org"
            ;;
        *)
            local safe_t=$(echo "$target" | tr -c 'a-zA-Z0-9_' '_')
            base_sec="BlockcheckW_$safe_t"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://$target"
            ;;
    esac

    # Всегда пишем в базовую секцию: старые нумерованные отключаются ниже,
    # иначе конфиг разрастается, а интерфейс показывает устаревшую стратегию.
    local sec_name="$base_sec"
    local pkg=$(_strategy_pkg)

    # Disable previously active strategies for this target to prevent desync/filter conflicts,
    # keeping all older strategies safely stored in /etc/config/zapret2 & /etc/config/zapret2wizard
    for pkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$pkg" ] || continue
        uci -q set "$pkg.$base_sec.enabled=0"
        for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.$base_sec\_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
            uci -q set "$pkg.$s.enabled=0"
        done
        if [ "$base_sec" = "BlockcheckW_YouTube" ] || [ "$base_sec" = "MyTube" ]; then
            uci -q set "$pkg.MyTube.enabled=0"
            uci -q set "$pkg.Youtube_circular.enabled=0"
            for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.(MyTube_|BlockcheckW_YouTube_)" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                uci -q set "$pkg.$s.enabled=0"
            done
        elif [ "$base_sec" = "BlockcheckW_Discord" ]; then
            uci -q set "$pkg.Discord_circular.enabled=0"
            uci -q set "$pkg.BlockcheckW_Discord_Voice.enabled=0"
            for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.BlockcheckW_Discord_Voice_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                uci -q set "$pkg.$s.enabled=0"
            done
        elif [ "$base_sec" = "BlockcheckW_General" ]; then
            uci -q set "$pkg.Routerich_circular.enabled=0"
        fi

        # Create new strategy section
        uci set "$pkg.$sec_name=strategy"
        uci set "$pkg.$sec_name.enabled=1"
        uci set "$pkg.$sec_name.port=$port"
        uci set "$pkg.$sec_name.protocol=tcp"
        uci -q delete "$pkg.$sec_name.filter_l3"
        uci -q delete "$pkg.$sec_name.filter_l7"
        uci -q delete "$pkg.$sec_name.hostlist"
        uci -q delete "$pkg.$sec_name.hostlist_exclude"
        uci add_list "$pkg.$sec_name.filter_l3=ipv4"
        for proto in $l7; do
            uci add_list "$pkg.$sec_name.filter_l7=$proto"
        done
        uci add_list "$pkg.$sec_name.hostlist=$hostlist"
        uci add_list "$pkg.$sec_name.hostlist_exclude=list_hosts_user_exclude"
        if [ "$target" = "preset_youtubei" ] || [ "$target" = "ytapi" ]; then
            # API уже обрабатывает YTApi: убираем его из основной YouTube-секции.
            ensure_preset_hostlist "preset_youtubei"
            uci -q set "$pkg.ytapi_hostlist=hostlist" 2>/dev/null || true
            uci -q set "$pkg.ytapi_hostlist.path=/etc/zapret2wizard/ipset/zapret_hosts_ytapi.txt" 2>/dev/null || true
            _uci_add_list_unique "$pkg.BlockcheckW_YouTube.hostlist_exclude" ytapi_hostlist
        fi
        uci set "$pkg.$sec_name.script=$script_text"

        if [ "$base_sec" = "BlockcheckW_Discord" ]; then
            uci -q set "$pkg.blob_stun.enabled=1"
            local v_idx=$(echo "$sec_name" | grep -oE '_[0-9]+$')
            voice_sec_name="BlockcheckW_Discord_Voice${v_idx}"

            uci set "$pkg.$voice_sec_name=strategy"
            uci set "$pkg.$voice_sec_name.enabled=1"
            uci set "$pkg.$voice_sec_name.port=50000-65535,19294-19344"
            uci set "$pkg.$voice_sec_name.protocol=udp"
            _uci_add_list_unique "$pkg.$voice_sec_name.hostlist_exclude" list_hosts_user_exclude
            uci -q delete "$pkg.$voice_sec_name.filter_l3"
            uci -q delete "$pkg.$voice_sec_name.filter_l7"
            uci add_list "$pkg.$voice_sec_name.filter_l3=ipv4"
            uci add_list "$pkg.$voice_sec_name.filter_l7=discord"
            uci add_list "$pkg.$voice_sec_name.filter_l7=stun"
            uci set "$pkg.$voice_sec_name.script=--payload=discord_ip_discovery,stun --lua-desync=circular:fails=3:maxtime=20 --lua-desync=fake:blob=blob_stun:repeats=2:strategy=1 --lua-desync=udplen:increment=2:strategy=2 --lua-desync=fake:blob=blob_stun:repeats=4:strategy=3"
        fi
    done

    sync_uci_commit

    # Restart DPI service
    restart_dpi_service

    # Ждём, пока служба реально поднимется: иначе тест всегда падает
    local _w=0
    while [ "$_w" -lt 25 ]; do
        if _svc_running && nft list table inet zapret2wizard >/dev/null 2>&1; then
            break
        fi
        sleep 1
        _w=$((_w + 1))
    done
    sleep 2
    local zapret_running=$(get_dpi_service_status)

    # Test connectivity with curl (Multi-Domain and Data Flow validation)
    local curl_status=0
    local http_code="000"
    local all_ok_val=false
    local multi_res=""
    local client_probe_res='{}'
    local _try
    if [ "$target" = "preset_youtubei" ] || [ "$target" = "ytapi" ]; then
        # API reachability is explicit; unavailable client validation cannot accept a candidate.
        for _try in 1 2 3; do
            client_probe_res=$(client_probe_netns "$target" --allow-4xx 2>/dev/null)
            if echo "$client_probe_res" | grep -q '"ok":true'; then
                curl_status=1
                http_code=$(echo "$client_probe_res" | sed -n 's/.*"code":"\([0-9]*\)".*/\1/p')
                [ -n "$http_code" ] || http_code=200
                break
            fi
            sleep 2
        done
        if [ "$curl_status" = "1" ]; then
            all_ok_val=true
        else
            all_ok_val=false
            http_code="000"
        fi
        multi_res='{"overall_status":"client-api","all_ok":'"$all_ok_val"'}'
    else
        for _try in 1 2 3; do
            multi_res=$(cmd_test "$target" "$test_url" 2>/dev/null)
            if echo "$multi_res" | grep -q '"all_ok":true'; then
                break
            fi
            sleep 3
        done
        if [ -n "$multi_res" ]; then
            if echo "$multi_res" | grep -q '"accessible":true'; then
                curl_status=1
            fi
            if echo "$multi_res" | grep -q '"all_ok":true'; then
                all_ok_val=true
            fi
            local extracted_code=$(echo "$multi_res" | grep -o '"http_code":"[^"]*"' | head -n 1 | cut -d'"' -f4)
            [ -n "$extracted_code" ] && http_code="$extracted_code"
        fi

        # Клиентский probe: тот же nfqws, но проверка идёт через output-очередь
        # с полным телом ответа. Роутерный cmd_test этого не видит.
        if [ "$all_ok_val" = "true" ]; then
            client_probe_res=$(client_probe_output "$target" 2>/dev/null)
            if ! echo "$client_probe_res" | grep -q '"ok":true'; then
                all_ok_val=false
            fi
        fi
    fi

    # Если трафик не подтвердился — возвращаем конфиг, который был до apply.
    local rolled_back=false
    local out_msg="Новая запись стратегии ($sec_name) успешно создана в Zapret2, активирована и проверена!"
    if [ "$all_ok_val" != "true" ]; then
        local _restored=0
        for _rpkg in zapret2 zapret2wizard; do
            if [ -f "$rb_dir/$_rpkg" ]; then
                cp -f "$rb_dir/$_rpkg" "/etc/config/$_rpkg"
                uci -q commit "$_rpkg" 2>/dev/null || true
                _restored=1
            fi
        done
        if [ "$_restored" = "1" ]; then
            restart_dpi_service
            local _rw=0
            while [ "$_rw" -lt 20 ]; do
                if _svc_running && nft list table inet zapret2wizard >/dev/null 2>&1; then
                    break
                fi
                sleep 1
                _rw=$((_rw + 1))
            done
            rolled_back=true
            out_msg="Стратегия не подтвердила трафик — прежняя конфигурация восстановлена"
        fi
    fi
    rm -rf "$rb_dir"

    local accepted_recipe_json=null
    if [ "$all_ok_val" = "true" ]; then
        accepted_recipe_json=$(lua - "$script_text" << 'LUA'
local json = require("luci.jsonc")
print(json.stringify(arg[1]))
LUA
)
        [ -n "$accepted_recipe_json" ] || { accepted_recipe_json=null; all_ok_val=false; }
    fi
    local res_json=$(cat <<EOF
{
  "success": $all_ok_val,
  "request_handled": true,
  "accepted": $all_ok_val,
  "accepted_recipe": $accepted_recipe_json,
  "verification_state": "$([ "$all_ok_val" = "true" ] && echo requirements_passed || echo unverified)",
  "playback": "unknown",
  "budgetcap": 8388608,
  "message": "$out_msg",
  "target": "$target",
  "section": "$sec_name",
  "zapret2_status": "$zapret_running",
  "test_url": "$test_url",
  "http_code": "$http_code",
  "connected": $([ "$curl_status" = "1" ] && echo "true" || echo "false"),
  "all_ok": $all_ok_val,
  "rolled_back": $rolled_back,
  "multi_domain": ${multi_res:-"{}"},
  "client_probe": ${client_probe_res:-"{}"}
}
EOF
)
    if [ "$all_ok_val" = "true" ]; then
        # История проверенных конфигураций (issue #12): чтобы к рабочей
        # стратегии можно было вернуться и сравнить её с кандидатом.
        local _hist_bytes=0
        _hist_bytes=$(printf '%s' "$res_json" | lua -e 'local s=io.read("*a"); local ok,d=pcall(require("luci.jsonc").parse,s); local b=0; if ok and d then local function t(v) if type(v)=="number" and v>b then b=v end end; local md=d.multi_domain or {}; for _,e in ipairs(md.endpoints or {}) do t(e.size_bytes) end; local cp=d.client_probe or {}; t(cp.bytes); if cp.volume then t(cp.volume.bytes) end; if cp.video then t(cp.video.bytes) end end; print(b)' 2>/dev/null)
        [ -n "$_hist_bytes" ] || _hist_bytes=0
        cmd_good_history_add "$target" "${sec_name:-}" "$script_text" "${http_code:-}" "$_hist_bytes" >/dev/null 2>&1 || true
    fi
    echo "$res_json" > /tmp/blockcheckw_apply_result.json
    echo "$res_json"
    [ "$all_ok_val" = "true" ]
}

cmd_activate() {
    local target=""
    local section=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --section) section="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$section" ]; then
        echo '{"success":false,"error":"Missing --section argument"}'
        return 1
    fi

    if ! uci -q get "$pkg.$section" >/dev/null; then
        echo "{\"success\":false,\"error\":\"Strategy section '$section' not found in zapret2\"}"
        return 1
    fi

    local base_sec=""
    case "$target" in
        preset_youtubei|ytapi|youtubei) base_sec="YTApi" ;;
        preset_youtube|youtube) base_sec="BlockcheckW_YouTube" ;;
        preset_discord|discord) base_sec="BlockcheckW_Discord" ;;
        preset_twitch|twitch) base_sec="BlockcheckW_Twitch" ;;
        preset_x|x) base_sec="BlockcheckW_X" ;;
        preset_instagram|instagram) base_sec="BlockcheckW_Instagram" ;;
        tcp16) base_sec="BlockcheckW_TCP16" ;;
        builtin|general) base_sec="BlockcheckW_General" ;;
        *)
            if [ -n "$target" ]; then
                base_sec="BlockcheckW_$(echo "$target" | tr -c 'a-zA-Z0-9_' '_')"
            else
                base_sec=$(echo "$section" | sed -E 's/_[0-9]+$//')
            fi
            ;;
    esac

    # Disable all other sections for this target in both configs
    for pkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$pkg" ] || continue
        if [ -n "$base_sec" ]; then
            uci -q set "$pkg.$base_sec.enabled=0"
            for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.$base_sec\_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                uci -q set "$pkg.$s.enabled=0"
            done
            if [ "$base_sec" = "BlockcheckW_YouTube" ] || [ "$base_sec" = "MyTube" ]; then
                uci -q set "$pkg.MyTube.enabled=0"
                uci -q set "$pkg.Youtube_circular.enabled=0"
                for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.(MyTube_|BlockcheckW_YouTube_)" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                    uci -q set "$pkg.$s.enabled=0"
                done
            fi
            if [ "$base_sec" = "BlockcheckW_Discord" ]; then
                uci -q set "$pkg.Discord_circular.enabled=0"
                uci -q set "$pkg.BlockcheckW_Discord_Voice.enabled=0"
                for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.BlockcheckW_Discord_Voice_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                    uci -q set "$pkg.$s.enabled=0"
                done
            fi
            [ "$base_sec" = "BlockcheckW_General" ] && uci -q set "$pkg.Routerich_circular.enabled=0"
        fi

        # Enable target section
        uci set "$pkg.$section.enabled=1"

        # Synchronize Discord VoiceFlow strategy
        if [ "$base_sec" = "BlockcheckW_Discord" ]; then
            uci -q set "$pkg.blob_stun.enabled=1"
            local v_idx=$(echo "$section" | grep -oE '_[0-9]+$')
            local target_voice="BlockcheckW_Discord_Voice${v_idx}"
            if uci -q get "$pkg.$target_voice" >/dev/null; then
                uci set "$pkg.$target_voice.enabled=1"
            elif uci -q get "$pkg.BlockcheckW_Discord_Voice" >/dev/null; then
                uci set "$pkg.BlockcheckW_Discord_Voice.enabled=1"
            fi
        fi
    done

    sync_uci_commit
    restart_dpi_service
    sleep 1
    local zapret_running=$(get_dpi_service_status)

    echo "{\"success\":true,\"message\":\"Стратегия $section успешно активирована в Zapret2Wizard!\",\"section\":\"$section\",\"zapret2_status\":\"$zapret_running\"}"
}

cmd_delete_strategy() {
    local section="$1"
    if [ -z "$section" ]; then
        echo '{"success":false,"error":"Missing section name"}'
        return 1
    fi
    for pkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$pkg" ] || continue
        uci -q delete "$pkg.$section"
    done
    sync_uci_commit
    restart_dpi_service
    echo "{\"success\":true,\"message\":\"Запись $section удалена.\"}"
}

cmd_test_impl() {
    local target_or_url="${1:-preset_youtube}"
    local custom_url="$2"

    lua - "$target_or_url" "$custom_url" "$PRESETS_FILE" << 'EOF'
local json = require("luci.jsonc")
local arg1 = arg[1] or "preset_youtube"
local arg2 = arg[2] or ""
local presets_file = arg[3]

local p = arg1:gsub("^preset_", "")
local preset_key = "preset_" .. p
if arg1 == "builtin" or arg1 == "general" then preset_key = "builtin" end

local pf = io.open(presets_file, "r")
local presets_data = {}
if pf then
    presets_data = json.parse(pf:read("*a")) or {}
    pf:close()
end

local preset_obj = presets_data.presets and (presets_data.presets[preset_key] or presets_data.presets[arg1])
local endpoints = {}

if preset_obj and preset_obj.validation_endpoints and #preset_obj.validation_endpoints > 0 then
    for _, ep in ipairs(preset_obj.validation_endpoints) do
        table.insert(endpoints, {
            name = ep.name,
            url = ep.url,
            range = ep.range or "0-16383",
            type = ep.type or "http",
            host = ep.host,
            port = ep.port,
            allow_4xx = (ep.allow_4xx == true),
            optional = (ep.optional == true)
        })
    end
else
    local test_url = (arg2 and arg2 ~= "") and arg2 or (preset_obj and (preset_obj.test_url or preset_obj.domain)) or arg1
    if not test_url:match("^https?://") then
        test_url = "https://" .. test_url
    end
    local host_label = test_url:gsub("^https?://", ""):gsub("/.*$", "")
    table.insert(endpoints, { name = "Основной узел (" .. host_label .. ")", url = test_url, range = "0-32767", type = "http" })
end

local results = {}
local total_ok = 0
local req_total, req_ok = 0, 0
local main_ok = false
local total_speed_kbs = 0

for idx, ep in ipairs(endpoints) do
    -- Необязательные проверки (например, API youtubei) видны в списке,
    -- но не валят общий статус: иначе стратегия YouTube не могла бы
    -- примениться, пока не починен отдельный профиль YTApi.
    local required = (ep.optional ~= true)
    if required then req_total = req_total + 1 end
    if ep.type == "stun" then
        local nixio = require("nixio")
        local t0 = nixio.nanotime and nixio.nanotime() or 0
        local host = ep.host or "stun.l.google.com"
        local port = tonumber(ep.port) or 19302
        local ai = nixio.getaddrinfo(host, "inet")
        local ip = ai and ai[1] and ai[1].address
        local s_ok = false
        local dt_ms = 0
        local s_code = "000"
        if ip then
            local s = nixio.socket("inet", "dgram")
            if s then
                s:setopt("socket", "rcvtimeo", 2)
                local req = string.char(0x00, 0x01, 0x00, 0x00, 0x21, 0x12, 0xa4, 0x42,
                                        0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c)
                s:sendto(req, ip, port)
                local buf = s:recvfrom(512)
                dt_ms = nixio.nanotime and math.floor((nixio.nanotime() - t0) / 1000000) or 15
                s:close()
                if buf and #buf >= 20 then
                    local b1, b2, b3, b4, b5, b6, b7, b8 = buf:byte(1, 8)
                    if b1 == 0x01 and b2 == 0x01 and b5 == 0x21 and b6 == 0x12 and b7 == 0xa4 and b8 == 0x42 then
                        s_ok = true
                        s_code = "STUN-200"
                    else
                        s_ok = true
                        s_code = "STUN-OK"
                    end
                else
                    s_code = "TIMEOUT"
                end
            else
                s_code = "SOCK-ERR"
            end
        else
            s_code = "DNS-FAIL"
        end

        if s_ok then
            total_ok = total_ok + 1
            if required then req_ok = req_ok + 1 end
            if idx == 1 then main_ok = true end
        end

        table.insert(results, {
            name = ep.name,
            url = ep.url or ("stun://" .. host .. ":" .. port),
            http_code = s_code,
            accessible = s_ok,
            data_flow = s_ok,
            size_bytes = s_ok and 32 or 0,
            speed_kbs = 0,
            time_sec = string.format("%.3f", dt_ms / 1000),
            required = required
        })
    else
        -- Main page_sample: YouTube >=1.2 MiB (past reported 1 MiB cap), Discord >=128 KiB; not playback.
        -- auxiliary objects require complete positive data; auth/root probes reachability only.
        local probe = dofile("/usr/share/zapret2wizard/transfer_probe.lua")
        local main_sample = idx == 1 and (preset_key == "preset_youtube" or preset_key == "preset_discord")
        local reach_only = ep.allow_4xx or (ep.url or ""):match("^https://manifest%.googlevideo%.com/?$")
        local role = reach_only and "reachability" or "bounded_data"
        local ra, rb = tostring(ep.range or "0-16383"):match("^(%d+)%-(%d+)$")
        local requested = {start = tonumber(ra) or 0, finish = tonumber(rb) or 16383}
        if main_sample then requested = {start=0, finish=4194303} end
        -- Главная страница YouTube не отдаёт Range на динамическом HTML и
        -- штатно завершается (close-delimited) после ~1 МБ тела: полная
        -- передача засчитывается от 256 КБ. Жёсткий порог 1.2 МиБ остаётся
        -- для потоковых/CDN-узлов (googlevideo), которые проверяются
        -- отдельными пробами (transfer_client_probe / test.googlevideo).
        local sample_min = 131072
        if preset_key == "preset_youtube" and idx == 1 then sample_min = 262144 end
        local evidence = probe.probe({url=ep.url, endpoint_id=ep.name, role=role,
            path_mode="router", range=requested, timeout_sec=30, max_bytes=8388608},
            {role=role, min_bytes=1, sample_bytes=sample_min, sample_seconds=0})
        local data_sample = evidence.transfer_verified and evidence.sample_sufficient
        local is_ok = evidence.policy_passed and (not reach_only or evidence.http_code < 500) and (not main_sample or data_sample)
        local speed_kbs = math.floor((evidence.speed_bytes_per_sec or 0) / 1024)
        total_speed_kbs = total_speed_kbs + speed_kbs
        if is_ok then
            total_ok = total_ok + 1
            if required then req_ok = req_ok + 1 end
            if idx == 1 then main_ok = true end
        end
        table.insert(results, {
            name=ep.name, url=ep.url, http_code=tostring(evidence.http_code or "000"),
            accessible=is_ok, data_flow=evidence.transfer_verified,
            truncated=evidence.completeness == "incomplete",
            stall_reason=(main_sample and evidence.transfer_verified and not data_sample) and "insufficient_sample" or evidence.reason,
            size_bytes=evidence.bytes_received or 0, bytes_known=evidence.bytes_known,
            speed_kbs=speed_kbs, time_sec=string.format("%.2f", evidence.elapsed_sec or 0),
            role=role, required=required, data_sample=data_sample, data_sample_min_bytes=sample_min,
            verification_kind=main_sample and "page_sample" or role,
            verification_state=is_ok and (reach_only and "reachable" or "data_sample") or "unverified",
            playback="unknown", budgetcap=evidence.max_bytes, evidence=evidence
        })
    end
end

local has_truncated = false
for _, r in ipairs(results) do
    if r.truncated and r.required ~= false then has_truncated = true end
end

local all_ok = (req_ok == req_total and req_total > 0)
local overall_status = "unknown"
local status_msg = "Проверка не подтвердила требуемую передачу данных; причина сети и воспроизведение неизвестны."
if all_ok then
    overall_status = "optimal"
    status_msg = "Проверенные HTTP/данные и отдельные протокольные требования выполнены (" .. req_ok .. "/" .. req_total .. "). Воспроизведение не проверялось."
elseif has_truncated or main_ok then
    overall_status = "degraded"
    status_msg = "Часть требований не подтверждена: полученные байты и завершение указаны ниже. Это не диагноз DPI."
end

local avg_speed = (#endpoints > 0) and math.floor(total_speed_kbs / #endpoints) or 0

local resp = {
    target = arg1,
    url = (endpoints[1] and endpoints[1].url) or "",
    http_code = (results[1] and results[1].http_code) or "000",
    accessible = main_ok,
    all_ok = all_ok,
    schema_version = 1, verification_state = all_ok and "requirements_passed" or "unverified",
    playback = "unknown", budgetcap = 8388608, data_sample_min_bytes = (preset_key == "preset_youtube" and 262144) or 131072,
    overall_status = overall_status,
    message = status_msg,
    avg_speed_kbs = avg_speed,
    endpoints = results
}

print(json.stringify(resp))
EOF
}

# Нормализует идентификатор цели к ключу сервиса в интерфейсе.
metric_target_key() {
    case "$1" in
        preset_youtube|youtube) echo "youtube" ;;
        preset_discord|discord) echo "discord" ;;
        preset_instagram|instagram) echo "instagram" ;;
        preset_x|x) echo "x" ;;
        preset_twitch|twitch) echo "twitch" ;;
        builtin|general|user) echo "general" ;;
        *) echo "$1" ;;
    esac
}

# Домен, по которому проверяется/запоминается сервис.
target_domain() {
    case "$1" in
        preset_youtube|youtube) echo "www.youtube.com" ;;
        preset_discord|discord) echo "discord.com" ;;
        preset_twitch|twitch) echo "twitch.tv" ;;
        preset_x|x) echo "x.com" ;;
        preset_instagram|instagram) echo "gateway.instagram.com" ;;
        builtin|general) echo "rutracker.org" ;;
        *) echo "" ;;
    esac
}

# Записывает результат проверки в tests.json и строку в историю.
record_test_metrics() {
    local raw="$1"
    local key=$(metric_target_key "${2:-unknown}")
    [ -n "$raw" ] || return 0
    local tmp="/tmp/.bcw_test_$$.json"
    printf '%s' "$raw" > "$tmp" 2>/dev/null || return 0
    lua - "$METRICS_FILE" "$HISTORY_FILE" "$key" "$HISTORY_LIMIT" "$tmp" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local metrics_file, history_file, key, limit, raw_file = arg[1], arg[2], arg[3], tonumber(arg[4]) or 200, arg[5]
local raw = ""
local rf = io.open(raw_file, "r")
if rf then raw = rf:read("*a") or ""; rf:close() end
local resp = json.parse(raw)
if not resp or type(resp) ~= "table" then return end

local f = io.open(metrics_file, "r")
local store = {}
if f then store = json.parse(f:read("*a")) or {}; f:close() end
if type(store) ~= "table" then store = {} end

local total_size = 0
if type(resp.endpoints) == "table" then
    for _, ep in ipairs(resp.endpoints) do total_size = total_size + (tonumber(ep.size_bytes) or 0) end
end
store[key] = {
    time = os.time(),
    status = resp.overall_status or "unknown",
    code = tostring(resp.http_code or ""),
    size = total_size,
    speed = tonumber(resp.avg_speed_kbs or 0) or 0
}
local out = io.open(metrics_file, "w")
if out then out:write(json.stringify(store)); out:close() end

local size_kb = math.floor((store[key].size or 0) / 1024)
local st = store[key].status
local text = (st == "optimal" and "проверка пройдена" or (st == "degraded" and "частично доступно" or "недоступно"))
    .. (size_kb > 0 and (" · " .. size_kb .. " КБ") or "")

local line = json.stringify({ t = os.time(), type = "test", target = key, status = st, text = text })
local h = io.open(history_file, "a")
if h then h:write(line, "\n"); h:close() end

-- подрезаем историю, чтобы файл не рос бесконечно
local hf = io.open(history_file, "r")
if hf then
    local lines = {}
    for l in hf:lines() do if l ~= "" then table.insert(lines, l) end end
    hf:close()
    if #lines > limit then
        local trimmed = io.open(history_file, "w")
        if trimmed then
            for i = #lines - limit + 1, #lines do trimmed:write(lines[i], "\n") end
            trimmed:close()
        end
    end
end
EOF
    rm -f "$tmp" 2>/dev/null || true
}

# Универсальная запись события в историю: history_add <type> <target> <text>
history_add() {
    local etype="${1:-event}" etarget="${2:-}" etext="${3:-}"
    lua - "$HISTORY_FILE" "$etype" "$etarget" "$etext" "$HISTORY_LIMIT" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local file, etype, etarget, etext, limit = arg[1], arg[2], arg[3], arg[4], tonumber(arg[5]) or 200
local line = json.stringify({ t = os.time(), type = etype, target = etarget, text = etext })
local h = io.open(file, "a")
if h then h:write(line, "\n"); h:close() end
local hf = io.open(file, "r")
if hf then
    local lines = {}
    for l in hf:lines() do if l ~= "" then table.insert(lines, l) end end
    hf:close()
    if #lines > limit then
        local trimmed = io.open(file, "w")
        if trimmed then
            for i = #lines - limit + 1, #lines do trimmed:write(lines[i], "\n") end
            trimmed:close()
        end
    end
end
EOF
}

cmd_test() {
    ensure_dpi_service
    local out vres merged
    out=$(cmd_test_impl "$@")
    # YouTube: роутерные пробы видят сырую сеть и не проверяют стратегию,
    # а видео-CDN блокируется провайдером чаще базы. Добавляем клиентский
    # probe (временный nfqws с текущей стратегией): страница + реальный
    # видеопоток googlevideo. Без него «оптимально» могло значить
    # «видео не работает».
    case "${1:-}" in
        preset_youtube|youtube|preset_discord|discord)
            vres=$(client_probe_output "${1:-}" 2>/dev/null || true)
            if [ -n "$vres" ] && ! printf '%s' "$vres" | grep -q '"error":"probe busy"'; then
                merged=$(lua - "$out" "$vres" <<'EOF'
local json = require("luci.jsonc")
local out = json.parse(arg[1])
local v = json.parse(arg[2])
if out and v then
    out.client_probe = v
    local vid = v.video or {}
    local has_video = next(vid) ~= nil
    local vol = (vid.volume and not vid.volume.skipped) and vid.volume
        or ((v.volume and not v.volume.skipped) and v.volume or nil)
    if type(out.endpoints) == "table" and has_video then
        table.insert(out.endpoints, {
            name = "Видео-хост googlevideo (через обход)",
            url = "https://" .. tostring(vid.host or "googlevideo.com"),
            http_code = vid.code or (vid.ok == true and "200" or "000"),
            accessible = vid.ok == true,
            data_sample = false,
            role = "reachability",
            required = true,
            verification_state = vid.ok == true and "reachable" or "unverified",
            verification_kind = "reachability",
            playback = vid.ok == true and "unknown" or "blocked",
            size_bytes = vid.bytes or 0,
            stall_reason = vid.ok == true and "transfer_complete" or (vid.video_error or "video_host_unreachable")
        })
    end
    if type(out.endpoints) == "table" and vol then
        table.insert(out.endpoints, {
            name = "Объёмный гейт (2×2 МБ статика)",
            url = "https://" .. tostring(vol.host or ""),
            http_code = vol.code or "000",
            accessible = vol.ok == true,
            data_sample = vol.ok == true,
            role = "bounded_data",
            required = true,
            verification_state = vol.ok == true and "data_sample" or "unverified",
            playback = "unknown",
            size_bytes = vol.bytes or 0,
            stall_reason = vol.ok == true and "transfer_complete" or "volume_capped"
        })
    end
    if vid.ok ~= true and has_video then
        out.all_ok = false
        out.overall_status = "degraded"
        out.message = "Видео-хост googlevideo не отвечает через обход: " ..
            tostring(vid.video_error or ("код " .. (vid.code or "000"))) ..
            ". Видео не заработает, пока канал до видео-CDN режется."
    elseif vol and vol.ok ~= true then
        out.all_ok = false
        out.overall_status = "degraded"
        out.message = "Канал открывается, но поток рвётся по объёму (" ..
            tostring(vol.bytes or 0) .. " из " .. tostring(vol.expected or 0) ..
            " байт): это побайтовый кап провайдера. Против этого DPI стратегий нет —",
            " помогает только смена пути/протокола или ожидание."
    elseif v.ok ~= true then
        out.all_ok = false
        out.overall_status = "degraded"
        out.message = "Клиентская проверка через обход не пройдена."
    elseif vol and out.all_ok == true then
        out.message = "Видео-хост и объёмный поток подтверждены через обход (воспроизведение не проверялось)."
    end
    out = json.stringify(out)
end
print(out)
EOF
)
                [ -n "$merged" ] && out="$merged"
            fi
            ;;
    esac
    # Метрики печатаем ПЕРВЫМИ: все вызывающие берут `cmd_test | tail -1`
    # и ждут JSON проверки. Раньше последней строкой шла запись истории,
    # из-за чего selftest и стабильность всегда видели 000/неудачу.
    record_test_metrics "$out" "${1:-preset_youtube}"
    printf '%s\n' "$out"
}

# Серия независимых проверок одного и того же канала. Один удачный curl ещё
# не значит «стабильно»: DPI может пропускать через раз. Именно по этой
# серии служба решает, нужна ли Circular-связка.
# Возвращает {"ok":N,"total":M}.
cmd_stability() {
    local target="${1:-preset_youtube}"
    local rounds="${2:-3}"
    local i=1 ok=0 total=0
    while [ "$i" -le "$rounds" ]; do
        local one=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
        total=$((total + 1))
        if printf '%s' "$one" | grep -q '"all_ok":true'; then
            ok=$((ok + 1))
        fi
        i=$((i + 1))
    done
    printf '{"ok":%d,"total":%d,"target":"%s"}\n' "$ok" "$total" "$target"
}

# Отдаёт метрики последних проверок и журнал событий одним JSON.
cmd_metrics() {
    lua - "$METRICS_FILE" "$HISTORY_FILE" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local mf, hf = arg[1], arg[2]
local tests = {}
local f = io.open(mf, "r")
if f then tests = json.parse(f:read("*a")) or {}; f:close() end
if type(tests) ~= "table" then tests = {} end

local history = {}
local h = io.open(hf, "r")
if h then
    for l in h:lines() do
        if l ~= "" then
            local o = json.parse(l)
            if o then table.insert(history, o) end
        end
    end
    h:close()
end

local out = {}
local start = math.max(1, #history - 59)
for i = #history, start, -1 do table.insert(out, history[i]) end
print(json.stringify({ tests = tests, history = out }))
EOF
}

cmd_speedtest() {
    local target_or_url="preset_youtube"
    local custom_url=""

    if [ "$1" = "--target" ]; then
        target_or_url="${2:-preset_youtube}"
        custom_url="$3"
    else
        target_or_url="${1:-preset_youtube}"
        custom_url="$2"
    fi

    lua - "$target_or_url" "$custom_url" "$PRESETS_FILE" << 'EOF'
local json = require("luci.jsonc")
local arg1 = arg[1] or "preset_youtube"
local arg2 = arg[2] or ""
local presets_file = arg[3]

local p = arg1:gsub("^preset_", "")
local preset_key = "preset_" .. p
if arg1 == "builtin" or arg1 == "general" then preset_key = "builtin" end

local pf = io.open(presets_file, "r")
local presets_data = {}
if pf then
    presets_data = json.parse(pf:read("*a")) or {}
    pf:close()
end

local preset_obj = presets_data.presets and (presets_data.presets[preset_key] or presets_data.presets[arg1])

local test_endpoint = "https://dl.google.com/chrome/install/ChromeStandaloneSetup64.exe"
local test_range = "0-2097151" -- 2 MB chunk from Google Edge CDN
local test_name = "HTTP-образец загрузки (не видеопоток)"
local fallback_endpoint = ""
local fallback_range = ""

if preset_key == "preset_youtube" then
    -- test.googlevideo.com больше не резолвится (NXDOMAIN): берём полную
    -- страницу www.youtube.com — сервер игнорирует Range и отдаёт ~0.9 МБ,
    -- побайтовый кап ~1 МБ виден как недобор до порога образца.
    test_endpoint = "https://www.youtube.com/"
    test_range = ""
    test_name = "Полная страница www.youtube.com (не воспроизведение видео)"
    fallback_endpoint = "https://dl.google.com/chrome/install/ChromeStandaloneSetup64.exe"
    fallback_range = "0-2097151"
elseif preset_key == "preset_discord" then
    test_endpoint = "https://stable.dl2.discordapp.net/distro/app/stable/win/x86/1.0.9059/DiscordSetup.exe"
    test_range = "0-2097151"
    test_name = "Discord Media & Updates CDN (2 МБ чанк)"
    fallback_endpoint = "https://cdn.discordapp.com/embed/avatars/0.png"
elseif preset_key == "preset_twitch" then
    test_endpoint = "https://www.twitch.tv"
    test_range = ""
    test_name = "Twitch Portal & Streams (220 КБ поток)"
elseif preset_key == "preset_x" then
    test_endpoint = "https://pbs.twimg.com/profile_images/1683325380441128960/yRsRRjGO_400x400.jpg"
    test_range = ""
    test_name = "X / Twitter CDN (Медиапоток)"
    fallback_endpoint = "https://x.com"
elseif preset_key == "preset_instagram" then
    test_endpoint = "https://www.instagram.com/static/images/ico/favicon.ico/36b35e95d3cb.ico"
    test_range = ""
    test_name = "Instagram Web & CDN (Медиапоток)"
    fallback_endpoint = "https://gateway.instagram.com"
else
    local custom = (arg2 and arg2 ~= "") and arg2 or (preset_obj and (preset_obj.test_url or preset_obj.domain)) or arg1
    if not custom:match("^https?://") then custom = "https://" .. custom end
    test_endpoint = custom
    test_range = "0-1048575"
    test_name = "Пользовательский узел (" .. custom:gsub("^https?://", ""):gsub("/.*$", "") .. ")"
end

local probe = dofile("/usr/share/zapret2wizard/transfer_probe.lua")
local function do_curl(ep, rg, attempt)
    local a,b = tostring(rg or ""):match("^(%d+)%-(%d+)$")
    return probe.probe({url=ep, endpoint_id=ep:match("^https?://([^/]+)"), attempt_id=attempt,
        role="bounded_data", path_mode="router", range=a and {start=tonumber(a),finish=tonumber(b)} or nil,
        timeout_sec=30, max_bytes=8388608},
        {role="bounded_data", min_bytes=1, sample_bytes=preset_key == "preset_youtube" and 600000 or 131072, sample_seconds=0})
end
-- Synthetic SNI/Host rewrites are not the named endpoint: probe its actual URL.
local primary = do_curl(test_endpoint, test_range, "primary")
local fallback = nil
if not (primary.transfer_verified and primary.sample_sufficient) and fallback_endpoint ~= "" then
    fallback = do_curl(fallback_endpoint, fallback_range, "fallback")
end
local attempts = probe.attempts(primary, fallback)
local is_success = primary.transfer_verified and primary.sample_sufficient
attempts.success = is_success -- application sample policy, not merely complete tiny object
local code = tostring(primary.http_code or "000")
local size = primary.bytes_received or 0
local speed = primary.speed_bytes_per_sec or 0
local total_time = primary.elapsed_sec or 0
local speed_kbs = math.floor(speed / 1024)
local speed_mbs = math.floor((speed / (1024 * 1024)) * 100) / 100
local speed_mbps = math.floor((speed * 8 / 1000000) * 10) / 10
local latency_ms = math.floor((primary.connect_sec or 0) * 1000)
local ttfb_ms = 0 -- legacy numeric field; knownness below explicitly false
local rating = "unknown"
local rating_badge = "neutral"
local rating_title = is_success and "Образец данных подтверждён" or "Передача не подтверждена"
local throttled = false
local verdict = "Ограниченный образец HTTP, не тест ёмкости канала или воспроизведения. Скорость ограничена бюджетом проверки."


local ggc_info = nil -- Mapping diagnostics are not transfer/playback evidence.


local result = {
    success = is_success,
    schema_version = 1, playback = "unknown", verification_state = is_success and "data_sample" or "unverified",
    primary = primary, fallback = fallback, attempts = attempts,
    bytes_known = primary.bytes_known, speed_known = primary.speed_bytes_per_sec ~= nil,
    elapsed_known = primary.elapsed_sec ~= nil, connect_known = primary.connect_sec ~= nil,
    ttfb_known = false, budgetcap = primary.max_bytes, speed_cap_bytes_per_sec = primary.speed_cap_bytes_per_sec,
    target = arg1,
    test_endpoint = test_endpoint,
    test_name = test_name,
    http_code = code,
    size_bytes = size,
    size_mb = string.format("%.2f", size / (1024 * 1024)),
    speed_kbs = speed_kbs,
    speed_mbs = speed_mbs,
    speed_mbps = speed_mbps,
    total_time_sec = string.format("%.2f", total_time),
    latency_ms = latency_ms,
    ttfb_ms = ttfb_ms,
    rating = rating,
    rating_badge = rating_badge,
    rating_title = rating_title,
    throttled = throttled,
    verdict = verdict,
    ggc_mapping = ggc_info
}

print(json.stringify(result))
EOF
}

# Включает/выключает обход для сервиса, не удаляя стратегию.
# toggle_service <target> -> {"success":true,"enabled":0|1}
cmd_toggle_service() {
    local target="${1:-}"
    local base_sec=""
    case "$target" in
        preset_youtubei|ytapi|youtubei) base_sec="YTApi" ;;
        preset_youtube|youtube) base_sec="BlockcheckW_YouTube" ;;
        preset_discord|discord) base_sec="BlockcheckW_Discord" ;;
        preset_twitch|twitch) base_sec="BlockcheckW_Twitch" ;;
        preset_x|x) base_sec="BlockcheckW_X" ;;
        preset_instagram|instagram) base_sec="BlockcheckW_Instagram" ;;
        builtin|general|user) base_sec="BlockcheckW_General" ;;
        *) printf '{"success":false,"error":"Unknown target: %s"}\n' "$target"; return 1 ;;
    esac

    # Сначала наша конфигурация: на роутере может остаться старый
    # /etc/config/zapret2 от пакета zapret2, и toggle менял не тот файл.
    local pkg="zapret2wizard"
    [ -f /etc/config/zapret2wizard ] || pkg="zapret2"

    local sections=$(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.${base_sec}(_[0-9]+)?=" | cut -d'.' -f2 | cut -d'=' -f1)
    if [ "$base_sec" = "BlockcheckW_Discord" ]; then
        local voice=$(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.BlockcheckW_Discord_Voice(_[0-9]+)?=" | cut -d'.' -f2 | cut -d'=' -f1)
        sections="$sections $voice"
    fi

    if [ -z "$sections" ]; then
        printf '{"success":false,"error":"No strategy for %s"}\n' "$target"
        return 1
    fi

    local any_on=0 s
    for s in $sections; do
        [ "$(uci -q get "$pkg.$s.enabled")" = "1" ] && any_on=1
    done

    local new_state=1
    [ "$any_on" = "1" ] && new_state=0

    for s in $sections; do
        uci -q set "$pkg.$s.enabled=$new_state"
        if [ -f /etc/config/zapret2wizard ] && [ "$pkg" = "zapret2" ]; then
            uci -q set "zapret2wizard.$s.enabled=$new_state"
        fi
    done

    uci commit "$pkg" 2>/dev/null || true
    [ -f /etc/config/zapret2wizard ] && uci commit zapret2wizard 2>/dev/null || true

    # Toggle должен быть атомарным: фоновый restart при быстрых
    # переключениях оставлял службу с 0 движков. Перезапускаем и ждём
    # готовности; один toggle обычно занимает 2-5 секунд.
    [ -x /usr/share/zapret2wizard/uci2config ] && /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
    /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || true
    if ! wait_dpi_ready 25; then
        _svc_start_bg
        wait_dpi_ready 20 || true
    fi
    history_add "toggle" "$(metric_target_key "$target")" "$([ "$new_state" = "1" ] && echo 'Обход включён' || echo 'Обход выключен')"

    printf '{"success":true,"target":"%s","enabled":%s,"section":"%s"}\n' "$target" "$new_state" "$base_sec"
}

# Проверка конфликтов: чужие DPI-службы, посторонние движки, автозапуск.
# --- Конфликты с чужими обходами -------------------------------------------
# Наша служба не должна делить forward/queue/marks с другим zapret. Эти
# функции только собирают факты; решение (disable/remove/keep) — за командой
# conflicts_resolve и интерфейсом.
_conflict_service_names() {
    echo "zapret2 zapret zapret-manager blockcheck"
}

_conflict_engine_pid_list() {
    local c p cmd name
    for c in /proc/[0-9]*/comm; do
        [ -r "$c" ] || continue
        name=$(cat "$c" 2>/dev/null)
        case "$name" in nfqws|nfqws2) ;; *) continue ;; esac
        p=${c#/proc/}; p=${p%/comm}
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        case "$cmd" in
            *zapret2wizard*|*--uid=65534*) continue ;;
        esac
        echo "$p"
    done
}

_conflict_table_list() {
    local fam name
    nft list tables 2>/dev/null | while read -r _ fam name; do
        [ "$name" = "zapret2wizard" ] && continue
        case "$name" in zapret|zapret2|blockcheck|byedpi|ciadpi) ;; *) continue ;; esac
        nft list table "$fam" "$name" 2>/dev/null | grep -q 'queue' && echo "$fam $name"
    done
}

_conflict_pkg_list() {
    if command -v opkg >/dev/null 2>&1; then
        opkg list-installed 2>/dev/null | awk '{print $1}'
    elif command -v apk >/dev/null 2>&1; then
        apk info 2>/dev/null
    fi | grep -E '^(zapret2|zapret|zapret-manager|luci-app-zapret2|luci-app-zapret|blockcheck)$' | sort -u
}

cmd_conflicts() {
    local services="" svc run svc_running=0
    # Сторонние init-скрипты могут висеть на procd-локе — ограничиваем
    # время, иначе doctor сам зависает (issue #6: "Ошибка вызова helper").
    local tmo_cmd=""
    command -v timeout >/dev/null 2>&1 && tmo_cmd="timeout 3"
    for svc in zapret2 zapret zapret-manager blockcheck; do
        [ -x "/etc/init.d/$svc" ] || continue
        run=0
        $tmo_cmd /etc/init.d/"$svc" running >/dev/null 2>&1 && run=1
        [ "$run" = "1" ] && svc_running=1
        services="$services{\"name\":\"$svc\",\"running\":$run},"
    done
    services="[${services%,}]"

    local ours=0 foreign=0 scanner=0 c p cmd name
    for c in /proc/[0-9]*/comm; do
        [ -r "$c" ] || continue
        name=$(cat "$c" 2>/dev/null)
        case "$name" in
            nfqws|nfqws2) ;;
            *) continue ;;
        esac
        p=${c#/proc/}
        p=${p%/comm}
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        case "$cmd" in
            *zapret2wizard*) ours=$((ours + 1)) ;;
            *--uid=65534*) scanner=$((scanner + 1)) ;;
            *) foreign=$((foreign + 1)) ;;
        esac
    done

    local table=0 autostart=0
    nft list tables 2>/dev/null | grep -q 'inet zapret2wizard' && table=1
    ls /etc/rc.d/ 2>/dev/null | grep -q 'zapret2wizard' && autostart=1

    local pids tables pkgs disabled_by_us
    pids=$(_conflict_engine_pid_list 2>/dev/null | tr '\n' ' ')
    disabled_by_us=$(cat /etc/zapret2wizard/.disabled_foreign 2>/dev/null | tr '\n' ' ')
    tables=$(_conflict_table_list 2>/dev/null | tr '\n' ';')
    pkgs=$(_conflict_pkg_list 2>/dev/null | tr '\n' ' ')

    local ok=true
    # Чужие движки — информация, а не ошибка: мы их не трогаем.
    [ "$svc_running" -eq 0 ] || ok=false
    [ "$table" -eq 1 ] || ok=false
    [ "$autostart" -eq 1 ] || ok=false

    printf '{"success":true,"services":%s,"engines":{"ours":%s,"foreign":%s,"scanner":%s},"foreign_pids":"%s","tables":"%s","packages":"%s","disabled_by_us":"%s","nft_table":%s,"autostart":%s,"conflict_running":%s,"ok":%s}\n' \
        "$services" "$ours" "$foreign" "$scanner" "$pids" "$tables" "$pkgs" "$disabled_by_us" "$table" "$autostart" "$svc_running" "$ok"
}

cmd_conflicts_resolve() {
    local action="disable" auto=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --action) action="$2"; shift 2 ;;
            --auto) auto=1; shift ;;
            *) shift ;;
        esac
    done
    if [ "$auto" = 1 ]; then
        echo '{"success":false,"error":"automatic foreign conflict mutation retired"}'
        return 1
    fi
    case "$action" in disable|remove|keep) ;; *) action="keep" ;; esac
    # Не удаляем пакеты чужих обходов: они могут владеть nfqws2/kmod,
    # после чего наша служба останется без движка. Только disable.
    [ "$action" = "remove" ] && action="disable"

    local stopped="" disabled="" killed="" removed="" tables_deleted=""
    if [ "$action" != "keep" ]; then
        local svc
        for svc in $(_conflict_service_names); do
            [ -x "/etc/init.d/$svc" ] || continue
            local _was_run=0 _was_en=0
            /etc/init.d/"$svc" running >/dev/null 2>&1 && _was_run=1
            ls /etc/rc.d/S*"$svc" >/dev/null 2>&1 && _was_en=1
            if [ "$_was_run" = "1" ]; then
                /etc/init.d/"$svc" stop >/dev/null 2>&1 || true
                stopped="$stopped $svc"
            fi
            if [ "$_was_run" = "1" ] || [ "$_was_en" = "1" ]; then
                /etc/init.d/"$svc" disable >/dev/null 2>&1 || true
                disabled="$disabled $svc"
            fi
        done

        local p
        for p in $(_conflict_engine_pid_list); do
            kill "$p" >/dev/null 2>&1 || true
            sleep 0.2
            kill -9 "$p" >/dev/null 2>&1 || true
            killed="$killed $p"
        done

        local t
        for t in $(_conflict_table_list); do
            set -- $t
            nft delete table "$1" "$2" >/dev/null 2>&1 && tables_deleted="$tables_deleted $1/$2"
        done

        if [ "$action" = "remove" ]; then
            local pkg
            for pkg in $(_conflict_pkg_list); do
                if command -v opkg >/dev/null 2>&1; then
                    opkg remove --force-depends "$pkg" >/dev/null 2>&1 && removed="$removed $pkg"
                elif command -v apk >/dev/null 2>&1; then
                    apk del "$pkg" >/dev/null 2>&1 && removed="$removed $pkg"
                fi
            done
        fi
    fi

    if [ -n "$disabled" ]; then
        mkdir -p /etc/zapret2wizard 2>/dev/null || true
        printf '%s\n' "$disabled" > /etc/zapret2wizard/.disabled_foreign 2>/dev/null || true
    fi
    if [ "$action" = "remove" ] || [ "$action" = "keep" ]; then
        rm -f /etc/zapret2wizard/.disabled_foreign 2>/dev/null || true
    fi

    local remaining=0 remaining_tables=0
    remaining=$(_conflict_engine_pid_list | wc -l | tr -d ' ')
    remaining_tables=$(_conflict_table_list | wc -l | tr -d ' ')
    printf '{"success":true,"action":"%s","auto":%s,"stopped":"%s","disabled":"%s","killed":"%s","tables":"%s","removed":"%s","remaining_foreign":%s,"remaining_tables":%s}\n' \
        "$action" "$auto" "$stopped" "$disabled" "$killed" "$tables_deleted" "$removed" "$remaining" "$remaining_tables"
}

# Доустановка модулей ядра, без которых nfqws2 не стартует.
# Нужна установщику и кнопке в UI; doctor зовёт modprobe напрямую.
# Только modprobe: безопасно вызывать из postinst, где менеджер пакетов
# держит свой lock (вложенный opkg/apk завис бы или не взял блокировку).
cmd_kmods_modprobe() {
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
    local nfq=0 nftq=0
    [ -e /proc/net/netfilter/nfnetlink_queue ] && nfq=1
    _kmods_nftq_ok && nftq=1
    if [ "$nfq" = "1" ] && [ "$nftq" = "1" ]; then
        echo '{"ok":true}'
    else
        local pkg="opkg install"; command -v apk >/dev/null 2>&1 && pkg="apk add"
        echo "{\"ok\":false,\"nfnetlink_queue\":$nfq,\"nft_queue\":$nftq,\"error\":\"нет модулей: $pkg kmod-nfnetlink-queue kmod-nft-queue && modprobe nfnetlink_queue nft_queue\"}"
    fi
}

# Проверка «правило queue реально работает» (модуль nft_queue жив).
_kmods_nftq_ok() {
    local ok=0
    if nft add table inet bcw_probe_p 2>/dev/null; then
        nft add chain inet bcw_probe_p c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_p c queue num 65000 2>/dev/null && ok=1
        nft delete table inet bcw_probe_p 2>/dev/null || true
    fi
    [ "$ok" = "1" ]
}

# Резервный путь, когда в фиде провайдера нет kmod: берём пакет из
# официального фида OpenWrt под точную версию релиза/target/ядра.
# [rel] [target] [kernel] [dry] — аргументы нужны для тестов резолвера.
_kmods_fetch_official() {
    local rel="${1:-}" tgt="${2:-}" kv="${3:-}" dry="${4:-}"
    if [ -z "$rel" ] && [ -f /etc/openwrt_release ]; then
        rel=$(sed -n "s/^DISTRIB_RELEASE='\(.*\)'/\1/p" /etc/openwrt_release | head -1)
        tgt=$(sed -n "s/^DISTRIB_TARGET='\(.*\)'/\1/p" /etc/openwrt_release | head -1)
    fi
    [ -n "$kv" ] || kv=$(uname -r)
    [ -n "$rel" ] && [ -n "$tgt" ] || return 1
    local base="https://downloads.openwrt.org/releases/$rel/targets/$tgt/kmods"
    local idx dir list pkg file
    idx=$(curl -fsSL -m 20 "$base/" 2>/dev/null) || return 1
    dir=$(printf '%s' "$idx" | grep -oE "href=\"${kv}[^\"/]*/\"" | head -1 | sed 's/^href="//; s/"$//')
    [ -n "$dir" ] || return 1
    echo "[kmods] официальный фид: $base/$dir" >> /tmp/bcw_kmods.log
    [ "$dry" = "dry" ] && echo "$base/$dir"
    list=$(curl -fsSL -m 20 "$base/$dir" 2>/dev/null) || return 1
    for pkg in kmod-nft-queue kmod-nfnetlink-queue; do
        file=$(printf '%s' "$list" | grep -oE "${pkg}[-_][^\"]*\.(apk|ipk)" | head -1)
        [ -n "$file" ] || continue
        [ "$dry" = "dry" ] && echo "$file"
        echo "[kmods] качаю $file" >> /tmp/bcw_kmods.log
        curl -fsSL -m 60 "$base/$dir/$file" -o "/tmp/$file" 2>>/tmp/bcw_kmods.log || continue
        if [ "$dry" != "dry" ]; then
            if command -v apk >/dev/null 2>&1; then
                apk add --allow-untrusted --force-overwrite "/tmp/$file" >>/tmp/bcw_kmods.log 2>&1 || apk fix --allow-untrusted "/tmp/$file" >>/tmp/bcw_kmods.log 2>&1 || tar -xzf "/tmp/$file" -C / >>/tmp/bcw_kmods.log 2>&1 || true
            elif command -v opkg >/dev/null 2>&1; then
                opkg install --force-reinstall --force-depends --force-overwrite "/tmp/$file" >>/tmp/bcw_kmods.log 2>&1 || true
            fi
        fi
        rm -f "/tmp/$file"
    done
    [ "$dry" = "dry" ] && return 0
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
}

cmd_kmods_install() {
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
    local need_nfq=0 need_nftq=0
    [ -e /proc/net/netfilter/nfnetlink_queue ] || need_nfq=1
    if nft add table inet bcw_probe_i 2>/dev/null; then
        nft add chain inet bcw_probe_i c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_i c queue num 65000 2>/dev/null || need_nftq=1
        nft delete table inet bcw_probe_i 2>/dev/null || true
    else
        need_nftq=1
    fi
    if [ "$need_nfq" = "1" ] || [ "$need_nftq" = "1" ]; then
        # Менеджер пакетов может залипнуть на сети: ограничиваем 90 секундами.
        (
            if command -v apk >/dev/null 2>&1; then
                apk add --no-cache kmod-nfnetlink-queue kmod-nft-queue || { apk update && apk add --no-cache kmod-nfnetlink-queue kmod-nft-queue; }
            elif command -v opkg >/dev/null 2>&1; then
                opkg install --force-reinstall kmod-nfnetlink-queue kmod-nft-queue || {
                    opkg update && opkg install kmod-nfnetlink-queue kmod-nft-queue
                }
            fi
        ) >>/tmp/bcw_kmods.log 2>&1 &
        local ipid=$!
        ( sleep 90; kill -9 "$ipid" 2>/dev/null ) &
        local wpid=$!
        wait "$ipid" 2>/dev/null
        kill "$wpid" 2>/dev/null
        modprobe nfnetlink_queue 2>/dev/null || true
        modprobe nft_queue 2>/dev/null || true
    fi
    # Если в фиде провайдера пакета нет — пробуем официальный фид OpenWrt.
    if [ ! -e /proc/net/netfilter/nfnetlink_queue ] || ! _kmods_nftq_ok; then
        _kmods_fetch_official
    fi
    cmd_kmods_modprobe
}

cmd_kmods_install_bg() {
    rm -f /tmp/bcw_kmods.done
    ( /usr/bin/blockcheckw-helper kmods_install >/tmp/bcw_kmods.log 2>&1; echo done >/tmp/bcw_kmods.done ) &
    echo $! > /tmp/bcw_kmods.pid
    echo '{"ok":true,"started":true,"log":"/tmp/bcw_kmods.log"}'
}

cmd_kmods_status() {
    local running=0 nfq=0 nftq=0 pid=$(cat /tmp/bcw_kmods.pid 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && running=1
    [ -e /proc/net/netfilter/nfnetlink_queue ] && nfq=1
    if nft add table inet bcw_probe_s 2>/dev/null; then
        nft add chain inet bcw_probe_s c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_s c queue num 65000 2>/dev/null && nftq=1
        nft delete table inet bcw_probe_s 2>/dev/null || true
    fi
    local logt=$(tail -n 2 /tmp/bcw_kmods.log 2>/dev/null | tr '\n' ' ' | tr -d '"')
    printf '{"running":%d,"nfnetlink_queue":%d,"nft_queue":%d,"log":"%s"}\n' "$running" "$nfq" "$nftq" "$logt"
}

# Проверка QUIC-пути (UDP/443) без QUIC-клиента: Version Negotiation.
# DNS-оптимизация: уникальные rr*.googlevideo.com идут через DoH-прокси
# (dns-failsafe сначала ждёт медленный upstream ~1 c, из-за чего Shorts
# стартуют с задержкой). Трогаем только если DoH реально слушает 5053.
# Направить домен в локальный DoH-прокси (https-dns-proxy на 127.0.0.1#5053).
# Провайдер отдаёт NXDOMAIN на заблокированные домены, и без этой записи
# клиенты не могут даже открыть сайт, хотя DPI-обход уже настроен.
# Второй DoH-резолвер (cloudflare) на 5055: штатный https-dns-proxy может
# сам фильтровать домены (xbox-dns.ru отдавал NXDOMAIN на instagram.com).
dns_doh_cloudflare_port() {
    # Discovery only: another package owns resolver creation and configuration.
    netstat -ln 2>/dev/null | grep -q '127.0.0.1:5055' || return 1
    echo 5055
}

dns_doh_ensure() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns dns_doh_ensure_locked "$@"
}
dns_doh_ensure_locked() {
    local dom="$1" port=5053 out
    [ -n "$dom" ] || return 0
    case "$dom" in *[!a-zA-Z0-9.-]*) return 0 ;; esac
    uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || return 0
    netstat -ln 2>/dev/null | grep -q '127.0.0.1:5053' || return 0
    if uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/"; then return 0; fi
    bcw_lifecycle_dns_add server "/$dom/127.0.0.1#5053" || return 1
    uci commit dhcp 2>/dev/null || return 0
    safe_dns_restart >/dev/null 2>&1 || true
    # Если штатный DoH сам фильтрует домен — переключаем на cloudflare.
    out=$(nslookup -type=a "$dom" 127.0.0.1 2>&1)
    case "$out" in
        *"can't find"*|*NXDOMAIN*|*SERVFAIL*)
            local alt
            alt=$(dns_doh_cloudflare_port)
            if [ -n "$alt" ]; then
                uci del_list dhcp.@dnsmasq[0].server="/$dom/127.0.0.1#5053" 2>/dev/null || true
                bcw_lifecycle_dns_add server "/$dom/127.0.0.1#$alt" || return 1
                uci commit dhcp 2>/dev/null || true
                safe_dns_restart >/dev/null 2>&1 || true
                port="$alt"
            fi
            ;;
    esac
    echo "[blockcheckw-helper] DNS: $dom через DoH (127.0.0.1#$port)" >> "$LOG_FILE" 2>/dev/null || true
}

dns_doh_base() {
    echo "$1" | awk -F. '{ if (NF > 2) print $(NF-1) "." $NF; else print $0 }'
}

# Часть IP Instagram заблокирована на уровне сети: DNS (через DoH) отдаёт
# такой адрес, и сайт висит, хотя DPI-обход работает. Проверяем адреса и
# закрепляем рабочий для www.instagram.com через host-record dnsmasq.
dns_pin_host() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns dns_pin_host_owned "$@"
}
dns_pin_host_owned() {
    local host="$1" ip="$2" norestart="${3:-}"
    bcw_lifecycle_dns_add address "/$host/$ip" && uci -q commit dhcp || return 1
    [ "$norestart" = norestart ] || safe_dns_restart >/dev/null 2>&1
}

dns_ip_works() {
    local host="$1" ip="$2" code
    code=$(curl -4 -sk -o /dev/null -m 6 -w '%{http_code}' --resolve "$host:443:$ip" "https://$host/" 2>/dev/null)
    case "$code" in 2*|3*) return 0 ;; *) return 1 ;; esac
}

# Пул кандидатов вместо магического IP. Проверяем полный ответ (размер тела),
# а не только заголовок: битые edge отдают 200 и обрываются на 16–19 КБ.
# Динамические A-записи из 1.1.1.1 идут первыми, статические — fallback.
dns_pin_pool() {
    local host="$1" url="$2" min="$3" ip out code size best="" dyn seen=" "
    shift 3
    dyn=$(nslookup "$host" 1.1.1.1 2>/dev/null | awk '/^Address: /{print $2}' | grep -E '^[0-9.]+$' | head -8)
    for ip in $dyn "$@"; do
        case "$seen" in *" $ip "*) continue ;; esac
        seen="$seen$ip "
        out=$(curl -4 -sk -o /dev/null -m 7 --resolve "$host:443:$ip" -w '%{http_code} %{size_download}' "$url" 2>/dev/null)
        code=${out%% *}; size=${out##* }
        case "$code" in 2*|3*) ;; *) continue ;; esac
        [ -n "$size" ] && [ "$size" -ge "$min" ] 2>/dev/null || continue
        best="$ip"; break
    done
    if [ -n "$best" ]; then
        dns_pin_host "$host" "$best"
        echo "$best"
        return 0
    fi
    echo "[blockcheckw-helper] DNS: нет живого edge для $host, оставляем прежний" >> "$LOG_FILE" 2>/dev/null || true
    return 1
}

dns_fix_discord() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns dns_fix_discord_locked "$@"
}
dns_fix_discord_locked() {
    uci -q get zapret2wizard.BlockcheckW_Discord.enabled 2>/dev/null | grep -q '^1$' || return 0
    # 162.159.136.232 стабильно отдаёт полный login/gateway через nfqws.
    # 162.159.135.232 на части сетей отдаёт только ~15 КБ (обрезанный ответ),
    # поэтому pool с роутерной проверкой выбирал нерабочий для клиента edge.
    local ip="162.159.136.232"
    dns_pin_host "discord.com" "$ip" norestart
    dns_pin_host "discordapp.com" "$ip" norestart
    dns_pin_host "gateway.discord.gg" "$ip" norestart
    safe_dns_restart >/dev/null 2>&1 || true
    return 0
}

dns_fix_instagram() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns dns_fix_instagram_locked "$@"
}
dns_fix_instagram_locked() {
    uci -q get zapret2wizard.BlockcheckW_Instagram.enabled 2>/dev/null | grep -q '^1$' || return 0
    # Проверка curl с роутера идёт мимо forward-очереди nfqws и часто
    # забраковывает рабочий для клиентов edge. Для Instagram используем
    # проверенную пару Meta-адресов; при смене сети — health/scan.
    local ip="57.144.248.34" cdn="157.240.224.63"
    dns_pin_host "www.instagram.com" "$ip" norestart
    dns_pin_host "instagram.com" "$ip" norestart
    dns_pin_host "i.instagram.com" "$ip" norestart
    dns_pin_host "cdninstagram.com" "$cdn" norestart
    # Global AAAA filtering remains user-owned.
    safe_dns_restart >/dev/null 2>&1 || true
    return 0
}

# Fallback без DoH: нестандартные порты публичных резолверов (идея tachyon-desync
# clean DNS). Провайдер часто перехватывает UDP/53, но 1253/5353 проходят.
dns_alt_ensure() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns dns_alt_ensure_locked "$@"
}
dns_alt_ensure_locked() {
    local dom="$1" srv out
    [ -n "$dom" ] || return 1
    case "$dom" in *[!a-zA-Z0-9.-]*) return 1 ;; esac
    out=$(nslookup "$dom" 127.0.0.1 2>&1)
    case "$out" in *"can't find"*|*NXDOMAIN*|*SERVFAIL*|"") ;; *) return 0 ;; esac
    for srv in "77.88.8.8#1253" "208.67.222.222#5353"; do
        uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/$srv" && return 0
        bcw_lifecycle_dns_add server "/$dom/$srv" || continue
        uci commit dhcp 2>/dev/null || true
        safe_dns_restart >/dev/null 2>&1 || true
        if nslookup "$dom" 127.0.0.1 2>&1 | grep -q "Name:"; then
            echo "[blockcheckw-helper] DNS: $dom через $srv (без DoH)" >> "$LOG_FILE" 2>/dev/null || true
            return 0
        fi
        uci del_list dhcp.@dnsmasq[0].server="/$dom/$srv" 2>/dev/null || true
        uci commit dhcp 2>/dev/null || true
    done
    return 1
}
# Проверка достижимости IP и подмена googlevideo на рабочий Google-edge.
# GGC-адреса вида 87.245.x у части провайдеров не отвечают, из-за чего
# YouTube-плеер зависает на старте (SYN без ответа).
_gv_ip_reachable() {
    local ip="$1" code
    [ -n "$ip" ] || return 1
    code=$(curl -4 -s -o /dev/null -m 4 --resolve "redirector.googlevideo.com:443:$ip" -w '%{http_code}' https://redirector.googlevideo.com/ 2>/dev/null)
    [ -n "$code" ] && [ "$code" != "000" ]
}

default_instagram_script() {
    printf '%s\n' '--out-range=-s34228 --payload=tls_client_hello --in-range=-s5556 --lua-desync=circular:fails=3:maxtime=20 --in-range=x --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2:strategy=1 --lua-desync=multisplit:pos=1,midsld:strategy=1 --lua-desync=multidisorder:pos=1,midsld,1220:strategy=2 --lua-desync=multisplit:pos=1:seqovl=1:strategy=3 --lua-desync=hostfakesplit:host=google.com:tcp_ts=-60000:strategy=4'
}
cmd_ensure_instagram() {
    uci -q get zapret2wizard.BlockcheckW_Instagram >/dev/null 2>&1 && return 0
    uci -q set zapret2wizard.BlockcheckW_Instagram=strategy
    uci -q set zapret2wizard.BlockcheckW_Instagram.enabled=1
    uci -q set zapret2wizard.BlockcheckW_Instagram.port=443
    uci -q set zapret2wizard.BlockcheckW_Instagram.protocol=tcp
    uci -q add_list zapret2wizard.BlockcheckW_Instagram.filter_l3=ipv4
    uci -q add_list zapret2wizard.BlockcheckW_Instagram.filter_l7=tls
    uci -q add_list zapret2wizard.BlockcheckW_Instagram.hostlist=list_hosts_instagram
    _uci_add_list_unique zapret2wizard.BlockcheckW_Instagram.hostlist_exclude list_hosts_user_exclude
    uci -q set zapret2wizard.BlockcheckW_Instagram.script="$(default_instagram_script)"
    uci -q commit zapret2wizard
    logger -t zapret2wizard "Instagram strategy restored"
}

cmd_prune_services() {
    # Раньше здесь удалялись все стратегии, кроме четырёх захардкоженных.
    # Это уничтожало легитимные BlockcheckW_X/Twitch/YTApi/QUIC и DNS-пины
    # Instagram при каждом старте службы. Автоматически не удаляем ни одну
    # зарегистрированную стратегию: чистка выполняется только явной командой.
    echo '{"pruned":true,"preserved":true}'
}

cmd_fix_defaults() {
    local marker="/etc/zapret2wizard/.strategy_0341"
    [ -f "$marker" ] && { echo '{"skipped":"done"}'; return 0; }
    local cur changed=0
    cur=$(uci -q get zapret2wizard.BlockcheckW_YouTube.script 2>/dev/null)
    if [ -n "$cur" ]; then
        case "$cur" in
            *fakeddisorder*) ;;
            *"hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000:strategy=1"*|*"circular:fails=3:maxtime=20"*)
                uci -q set zapret2wizard.BlockcheckW_YouTube.script="--payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5"
                changed=1
                logger -t zapret2wizard "YouTube strategy migrated to fakeddisorder"
                ;;
        esac
    fi
    cur=$(uci -q get zapret2wizard.BlockcheckW_Discord.script 2>/dev/null)
    if [ -n "$cur" ]; then
        case "$cur" in
            *hostfakesplit:host=gosuslugi.ru*) ;;
            *"circular:fails=3:maxtime=20"*|*"multidisorder:pos=midsld"*)
                uci -q set zapret2wizard.BlockcheckW_Discord.script="--payload=tls_client_hello --lua-desync=hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000"
                changed=1
                logger -t zapret2wizard "Discord strategy migrated to hostfakesplit"
                ;;
        esac
    fi
    [ "$changed" = "1" ] && uci -q commit zapret2wizard
    mkdir -p /etc/zapret2wizard 2>/dev/null || true
    touch "$marker" 2>/dev/null || true
    echo '{"fixed":true}'
}

cmd_gv_clear() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns cmd_gv_clear_locked "$@"
}
cmd_gv_clear_locked() {
    bcw_lifecycle_dns_cleanup || return 1
    printf '{"cleared":%s}\n' "${BCW_LIFECYCLE_DNS_CHANGED:-0}"
}

cmd_gv_fix() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns cmd_gv_fix_locked "$@"
}
cmd_gv_fix_locked() {
    bcw_lifecycle_dns_cleanup || return 1
    echo '{"ok":true,"source":"normal-dns","preserved_unknown":true}'
}

cmd_optimize_dns() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run dns cmd_optimize_dns_locked "$@"
}
cmd_optimize_dns_locked() {
    local changed=0 entry dom cs
    # Serialization belongs to lifecycle policy transaction, not a second lock.
    uci -q show dhcp >/dev/null 2>&1 || return 1
    if ! netstat -ln 2>/dev/null | grep -q '127.0.0.1:5053'; then
        # DoH нет: чиним DNS для заблокированных домен через альтернативные порты.
        local alt=0 d
        for d in instagram.com cdninstagram.com discord.com twitch.tv x.com; do
            dns_alt_ensure "$d" && alt=1
        done
        # Даже без DoH нельзя выходить раньше пина Instagram: иначе DNS
        # провайдера отдаёт 127.0.0.1 и сайт «висит» при рабочей стратегии.
        dns_fix_discord >/dev/null 2>&1 || true
        dns_fix_instagram >/dev/null 2>&1 || true
        echo "{\"changed\":$alt}"
        return 0
    fi
    for dom in googlevideo.com ytimg.com ggpht.com; do
        entry="/$dom/127.0.0.1#5053"
        if ! uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/"; then
            bcw_lifecycle_dns_add server "$entry" || continue
            changed=1
        fi
    done
    # Домены, которые провайдер режет по DNS (NXDOMAIN): без DoH-записи
    # клиент не откроет их даже с рабочей стратегией.
    for dom in instagram.com cdninstagram.com discord.com twitch.tv x.com; do
        out=$(nslookup "$dom" 127.0.0.1 2>&1)
        case "$out" in
            *"can't find"*|*NXDOMAIN*|*SERVFAIL*|*"no address"*)
                if ! uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/"; then
                    bcw_lifecycle_dns_add server "/$dom/127.0.0.1#5053" || continue
                    changed=1
                fi
                ;;
        esac
    done
    # Global dnsmasq cache size remains user-owned.
    if [ "$changed" = "1" ]; then
        uci commit dhcp
        safe_dns_restart >/dev/null 2>&1 || true
    fi
    dns_fix_discord >/dev/null 2>&1 || true
    dns_fix_instagram >/dev/null 2>&1 || true
    echo "{\"changed\":$changed}"
}

cmd_quic_probe() {
    local ips
    ips=$(nslookup www.youtube.com 2>/dev/null | awk '/^Address: /{print $2}' | head -3 | tr '\n' ' ')
    [ -n "$ips" ] || ips="142.250.74.138 172.217.117.4"
    lua /usr/share/zapret2wizard/quicprobe.lua "$ips" >/dev/null 2>&1
}

# Политика QUIC:
#   auto   — разрешаем, если QUIC реально проходит, иначе reject с быстрым ICMP;
#   allow  — не трогаем UDP/443;
#   reject — режем UDP/443, приложение быстро падает на TCP;
#   fake   — не режем, а подмешиваем fake QUIC Initial (blob Google) перед
#            настоящим. Это техника Flowseal: DPI видит «чужой» Initial,
#            а реальный QUIC продолжает работать. Если не помогло — reject.
cmd_quic_mode() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run policy cmd_quic_mode_locked "$@"
}
cmd_quic_mode_locked() {
    local mode="${1:-$(uci -q get zapret2wizard.main.quic_mode 2>/dev/null || echo auto)}"
    [ -n "$mode" ] || mode="auto"
    case "$mode" in
        allow|reject|fake|auto) ;;
        *) mode="auto" ;;
    esac
    # Явный аргумент — сразу сохраняем в UCI, чтобы режим пережил reboot.
    if [ -n "${1:-}" ] && command -v uci >/dev/null 2>&1; then
        uci -q set zapret2wizard.main.quic_mode="$mode"
        uci -q commit zapret2wizard
    fi
    local want=1 fake=0 restart=0
    local blob="${BCW_QUIC_BLOB:-/usr/share/zapret2wizard/fake/quic_initial_www_google_com.bin}"
    case "$mode" in
        allow) want=0 ;;
        reject) want=1 ;;
        fake)
            if [ -f "$blob" ] && command -v uci >/dev/null 2>&1; then
                want=0; fake=1
            else
                want=1; mode="reject"
            fi
            ;;
        *)
            # auto: для активной YouTube-стратегии QUIC не лечится desync
            # (служба режет только TCP), поэтому по умолчанию reject.
            if uci -q get zapret2wizard.BlockcheckW_YouTube >/dev/null 2>&1 || \
               uci -q get zapret2wizard.youtube >/dev/null 2>&1 || \
               uci -q get zapret2wizard.BlockcheckW_General >/dev/null 2>&1; then
                want=1
            else
                cmd_quic_probe && want=0 || want=1
            fi
            ;;
    esac

    local cur=$(uci -q get firewall.reject_quic.enabled 2>/dev/null)
    [ -n "$cur" ] || cur=1
    if [ "$want" != "$cur" ] && uci -q get firewall.reject_quic >/dev/null 2>&1; then
        uci set firewall.reject_quic.enabled="$want"
        uci commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    # Штатное fw4-правило стоит после established и не режет уже открытые
    # QUIC-потоки. Держим раннюю таблицу bcw_quic (priority -10).
    if [ "$want" = "1" ]; then
        sh /usr/share/zapret2wizard/quic_reject.sh apply >/dev/null 2>&1 || true
    else
        sh /usr/share/zapret2wizard/quic_reject.sh remove >/dev/null 2>&1 || true
    fi

    if command -v uci >/dev/null 2>&1; then
        if [ "$fake" = "1" ]; then
            uci -q set zapret2wizard.blob_quic_google=blob
            uci -q set zapret2wizard.blob_quic_google.path="$blob"
            uci -q set zapret2wizard.blob_quic_google.enabled=1
            uci -q set zapret2wizard.BlockcheckW_QUIC=strategy
            uci -q set zapret2wizard.BlockcheckW_QUIC.enabled=1
            uci -q set zapret2wizard.BlockcheckW_QUIC.port=443
            uci -q set zapret2wizard.BlockcheckW_QUIC.protocol=udp
            _uci_add_list_unique zapret2wizard.BlockcheckW_QUIC.hostlist_exclude list_hosts_user_exclude
            uci -q delete zapret2wizard.BlockcheckW_QUIC.filter_l3
            uci -q add_list zapret2wizard.BlockcheckW_QUIC.filter_l3=ipv4
            uci -q delete zapret2wizard.BlockcheckW_QUIC.filter_l7
            uci -q add_list zapret2wizard.BlockcheckW_QUIC.filter_l7=quic
            uci -q set zapret2wizard.BlockcheckW_QUIC.script='--payload=quic_initial --lua-desync=fake:blob=blob_quic_google:repeats=6'
            uci -q commit zapret2wizard
        elif uci -q get zapret2wizard.BlockcheckW_QUIC >/dev/null 2>&1; then
            # удаляем только свой профиль, чужой QUIC-профиль не трогаем
            case "$(uci -q get zapret2wizard.BlockcheckW_QUIC.script 2>/dev/null)" in
                *quic_initial*)
                    uci -q delete zapret2wizard.BlockcheckW_QUIC
                    uci -q commit zapret2wizard
                    ;;
            esac
        fi
        if [ -x /usr/share/zapret2wizard/uci2config ]; then
            /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
        fi
        if [ "$BCW_QUIC_NO_RESTART" != "1" ] && _svc_running; then
            bcw_lifecycle_init zapret2wizard restart || return 1
            restart=1
        fi
    fi

    sysctl -w net.ipv4.icmp_ratelimit=0 >/dev/null 2>&1 || true
    echo "{\"reject_quic\":$want,\"mode\":\"$mode\",\"fake_quic\":$fake,\"restart\":$restart}"
}

# Приложение YouTube ходит в youtubei.googleapis.com, который МТС блокирует
# отдельным SNI. Если этот хост не открывается, добавляем отдельную секцию
# YTApi со своим desync и исключаем хост из основной секции.
# Подбор/починка отдельного профиля YTApi (youtubei.googleapis.com) — API,
# которым пользуется приложение YouTube. На живых сетях (РТК/AS12389) этот SNI
# режется TLS-фильтром: TCP открывается, handshake — нет. hostfakesplit такой
# фильтр НЕ пробивает (проверено: api=000), а fake ClientHello с белым SNI +
# multidisorder — пробивает (405 за доли секунды). Поэтому:
#   1) если текущий YTApi уже работает — не трогаем (лишние рестарты и риск);
#   2) иначе перебираем стратегии, начиная с fake-SNI-приёма;
#   3) если ни одна не подошла — возвращаем прежний YTApi, а не оставляем
#      заведомо сломанный профиль (именно из-за этого «на ПК работает,
#      на телефоне нет» после эволюции).
cmd_fix_ytapi() {
    local deep="${1:-}"
    local hl_dir=/etc/zapret2wizard/ipset
    local hl="$hl_dir/zapret_hosts_ytapi.txt"
    local main_sec="BlockcheckW_YouTube"
    local prev_script prev_enabled
    prev_script=$(uci -q get zapret2wizard.YTApi.script 2>/dev/null)
    prev_enabled=$(uci -q get zapret2wizard.YTApi.enabled 2>/dev/null)

    _ytapi_probe() {
        # Годность проверяем тем же путём, что и пользовательская проверка:
        # одна проба может соврать на волне DPI, поэтому две попытки.
        local r i
        for i in 1 2; do
            r=$(cmd_test preset_youtubei 2>/dev/null | tail -n 1)
            case "$r" in *'"all_ok":true'*) return 0 ;; esac
            sleep 2
        done
        return 1
    }
    _ytapi_write() {
        uci -q set zapret2wizard.YTApi=strategy
        uci -q set zapret2wizard.YTApi.enabled=1
        uci -q set zapret2wizard.YTApi.port=443
        uci -q set zapret2wizard.YTApi.protocol=tcp
        uci -q delete zapret2wizard.YTApi.filter_l3
        uci -q delete zapret2wizard.YTApi.filter_l7
        uci -q delete zapret2wizard.YTApi.hostlist
        uci -q add_list zapret2wizard.YTApi.filter_l3=ipv4
        uci -q add_list zapret2wizard.YTApi.filter_l7=tls
        _uci_add_list_unique "zapret2wizard.YTApi.hostlist" ytapi_hostlist
        _uci_add_list_unique "zapret2wizard.YTApi.hostlist_exclude" list_hosts_user_exclude
        uci -q set zapret2wizard.YTApi.script="$1"
        uci -q commit zapret2wizard
        /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
        /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || true
        wait_dpi_ready 15
    }
    _ytapi_json() {
        lua - "$1" "$2" <<'YTJSON' 2>/dev/null
local j = require("luci.jsonc")
local ok = arg[1] == "1"
local o = { success = ok }
if arg[2] and arg[2] ~= "" then o.strategy = arg[2] end
if not ok then o.error = "youtubei остался закрыт" end
print(j.stringify(o))
YTJSON
    }

    printf 'youtubei.googleapis.com\n' > "$hl" 2>/dev/null || return 1
    uci -q set zapret2wizard.ytapi_hostlist=hostlist
    uci -q set zapret2wizard.ytapi_hostlist.path="$hl"
    uci -q delete zapret2wizard.$main_sec.hostlist_exclude
    uci -q add_list zapret2wizard.$main_sec.hostlist_exclude=list_hosts_user_exclude
    _uci_add_list_unique "zapret2wizard.$main_sec.hostlist_exclude" ytapi_hostlist

    # Уже работает — не трогаем (важно: не переписывать рабочую YTApi).
    if [ "$prev_enabled" = "1" ] && [ -n "$prev_script" ] && _ytapi_probe; then
        _ytapi_json 1 "$prev_script"
        return 0
    fi

    local forum="--out-range=-s34228 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1 --lua-desync=fake:blob=blob_tls_clienthello_www_google_com:optional:tcp_seq=-10000:tcp_ack=-66000:badsum:tls_mod=rnd,dupsid,sni=rzd.ru:repeat=4"
    local main_script cand tried=0
    main_script=$(uci -q get zapret2wizard.$main_sec.script 2>/dev/null)
    for cand in "$forum" "$main_script" \
        '--payload=tls_client_hello --lua-desync=hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000' \
        '--payload=tls_client_hello --lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000' \
        '--payload=tls_client_hello --lua-desync=multisplit:pos=1,sniext+1:seqovl=1'; do
        [ -n "$cand" ] || continue
        tried=$((tried + 1))
        echo "[blockcheckw-helper] YTApi: пробую кандидата $tried" >> "$LOG_FILE" 2>/dev/null || true
        _ytapi_write "$cand"
        if _ytapi_probe; then
            logger -t zapret2wizard "YTApi: подобрана стратегия $cand"
            _ytapi_json 1 "$cand"
            return 0
        fi
    done

    # Если быстрые кандидаты не подошли — при --deep запускаем точечный
    # подбор (scan) для youtubei: волны DPI меняют рабочий приём, а скан
    # перебирает весь корпус техник и сам применяет победителя.
    if [ "$deep" = "--deep" ]; then
        local deep_stamp=/tmp/bcw_ytapi_deep.stamp
        local _now=$(date +%s 2>/dev/null || echo 0)
        local _prev=$(cat "$deep_stamp" 2>/dev/null || echo 0)
        if [ $(( _now - _prev )) -gt 600 ]; then
            echo "[blockcheckw-helper] YTApi: быстрые кандидаты не подошли — точечный подбор (scan)" >> "$LOG_FILE" 2>/dev/null || true
            echo "$_now" > "$deep_stamp" 2>/dev/null || true
            timeout 420 /usr/bin/blockcheckw-helper start --target preset_youtubei --auto-apply 1 --workers 2 >>"$LOG_FILE" 2>&1 || true
            if _ytapi_probe; then
                local found
                found=$(uci -q get zapret2wizard.YTApi.script 2>/dev/null)
                logger -t zapret2wizard "YTApi: подобрана стратегия сканом: $found"
                _ytapi_json 1 "$found"
                return 0
            fi
        fi
    fi

    # Ничего не подошло: восстанавливаем прежний профиль (если был) —
    # не оставляем заведомо сломанную конфигурацию.
    if [ -n "$prev_script" ]; then
        _ytapi_write "$prev_script"
    else
        uci -q del_list zapret2wizard.$main_sec.hostlist_exclude=ytapi_hostlist 2>/dev/null || true
        uci -q set zapret2wizard.YTApi.enabled=0
        uci -q commit zapret2wizard
        /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
        /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || true
        wait_dpi_ready 15
    fi
    _ytapi_json 0 ""
    return 1
}

# При старте службы: если YouTube-стратегия включена, а API закрыт и профиля
# YTApi нет — создаём его. Lock защищает от рекурсии (fix_ytapi перезапускает
# службу, а restart снова вызывает ensure_ytapi).
cmd_ensure_ytapi() {
    local code
    [ -f /tmp/bcw_ytapi.lock ] && return 0
    # Уже есть профиль (в том числе disabled после неудачного подбора) —
    # не перезапускаем службу повторно при каждом старте: это давало цикл
    # restart → ensure_ytapi → fix_ytapi → restart.
    uci -q get zapret2wizard.YTApi >/dev/null 2>&1 && return 0
    [ -f /tmp/bcw_ytapi.attempted ] && return 0
    uci -q get zapret2wizard.BlockcheckW_YouTube.enabled 2>/dev/null | grep -q '^1$' || return 0
    code=$(_yt_probe https://youtubei.googleapis.com/ 2>/dev/null | awk '{print $1}')
    [ "$code" = "000" ] || [ -z "$code" ] || return 0
    : > /tmp/bcw_ytapi.lock
    : > /tmp/bcw_ytapi.attempted
    cmd_fix_ytapi >/dev/null 2>&1 || true
    rm -f /tmp/bcw_ytapi.lock
    return 0
}

# nfqws2 ищет Lua рядом с собой: /opt/zapret2/nfq2/nfqws2 → /opt/zapret2/lua.
# Установщик кладёт файлы в /usr/share/zapret2wizard/lua, поэтому здесь
# делаем раскладку /opt/zapret2/lua идемпотентно: симлинк на каталог, а если
# там уже реальный каталог (остался от старой установки) — симлинки на файлы.
LUA_SRC_DIR=/usr/share/zapret2wizard/lua
ensure_lua_layout() {
    local src="$LUA_SRC_DIR" f dst
    [ -d "$src" ] || return 0
    mkdir -p /opt/zapret2/nfq2 2>/dev/null || true
    # Цель зависит от того, где лежит движок: /opt/zapret2/... → /opt/zapret2/lua
    for dst in /opt/zapret2/lua; do
        if [ -L "$dst" ]; then
            [ "$(readlink "$dst")" = "$src" ] || ln -sfn "$src" "$dst" 2>/dev/null || true
        elif [ -d "$dst" ]; then
            for f in "$src"/*.lua; do
                [ -f "$f" ] && ln -sf "$f" "$dst/$(basename "$f")" 2>/dev/null || true
            done
        else
            ln -sfn "$src" "$dst" 2>/dev/null || true
        fi
    done
    chmod 755 /opt /opt/zapret2 /opt/zapret2/nfq2 2>/dev/null || true
    chmod 755 /usr/share/zapret2wizard /usr/share/zapret2wizard/lua 2>/dev/null || true
    chmod 755 /opt/zapret2/lua 2>/dev/null || true
    chmod 644 "$src"/*.lua 2>/dev/null || true
}

cmd_ensure_lua() {
    ensure_lua_layout
    if [ -r /opt/zapret2/lua/zapret-lib.lua ]; then
        echo '{"ok":true,"path":"/opt/zapret2/lua"}'
        return 0
    fi
    echo '{"ok":false,"error":"/opt/zapret2/lua/zapret-lib.lua недоступен"}'
    return 1
}

# Авто-калибровка TTL для фейковых пакетов (идея tachyon-desync AutoTTL):
# фейк должен пройти транзитный узел ТСПУ, но умереть до сервера. Оцениваем
# дистанцию хопов и берём TTL на 1–2 меньше, чтобы сервер не получил фейк.
# Диагностика/тест fallback-резолвера: dns_alt <домен>.
cmd_dns_alt() {
    local d="${1:-instagram.com}"
    if dns_alt_ensure "$d"; then
        printf '{"ok":true,"domain":"%s"}\n' "$d"
    else
        printf '{"ok":false,"domain":"%s"}\n' "$d"
    fi
}

cmd_ttl_probe() {
    local domain="${1:-www.youtube.com}"
    local ip="" hops="" ttl t=2
    ip=$(nslookup -type=a "$domain" 127.0.0.1 2>/dev/null | sed -n "s/Address: //p" | tail -1)
    [ -n "$ip" ] || ip=$(nslookup "$domain" 2>/dev/null | sed -n "s/Address: //p" | tail -1)
    if [ -n "$ip" ] && command -v traceroute >/dev/null 2>&1; then
        hops=$(traceroute -n -m 12 -q 1 -w 2 "$ip" 2>/dev/null | awk 'NF >= 2 && $1 ~ /^[0-9]+$/ { h = $1 } END { print h }')
    fi
    if [ -z "$hops" ] && [ -n "$ip" ] && command -v ping >/dev/null 2>&1; then
        while [ "$t" -le 12 ]; do
            if ping -c1 -W1 -t "$t" "$ip" >/dev/null 2>&1; then hops="$t"; break; fi
            t=$((t + 1))
        done
    fi
    [ -n "$hops" ] || hops=6
    ttl=$((hops - 2))
    [ "$ttl" -lt 2 ] && ttl=2
    [ "$ttl" -gt 9 ] && ttl=9
    printf '{"ok":true,"domain":"%s","ip":"%s","hops":%s,"fake_ttl":%s}\n' "$domain" "${ip:-}" "$hops" "$ttl"
}
cmd_doctor() {
    local ok=1
    local checks=""
    local quiet=0
    [ "$1" = "--json" ] && quiet=1

    add_check() {
        local name="$1" state="$2" detail="$3" hint="$4"
        [ "$state" = "1" ] || ok=0
        if [ "$quiet" = "0" ]; then
            printf '  %-28s %s  %s\n' "$name" "$([ "$state" = "1" ] && echo OK || echo FAIL)" "$detail"
            if [ "$state" != "1" ] && [ -n "$hint" ]; then
                printf '      → %s\n' "$hint"
            fi
        fi
        local entry
        entry=$(lua - "$name" "$state" "$detail" "$hint" << 'DOCTORJSON'
local json = require("luci.jsonc")
print(json.stringify({name = arg[1], ok = arg[2] == "1", detail = arg[3], hint = arg[4]}))
DOCTORJSON
)
        checks="$checks$entry,"
    }

    local arch=$(uname -m)
    if [ "$quiet" = "0" ]; then
        echo "=== Zapret2Wizard doctor ==="
        echo "  платформа: $arch, версия $(grep -o '"version": *"[^"]*"' /usr/share/blockcheckw/version.json 2>/dev/null | head -1 | cut -d'"' -f4)"
    fi

    if command -v nft >/dev/null 2>&1; then add_check "nftables" 1 "$(command -v nft)" ""; else add_check "nftables" 0 "nft не найден" "Установите nftables (пакет nftables)"; fi

    # Без nfnetlink_queue nfqws2 падает с "nfq_unbind_pf(AF_INET): Invalid argument",
    # а без nft_queue нельзя добавить правило queue. На чистых роутерах этих
    # kmod-пакетов часто нет — проверяем и подсказываем, что доустановить.
    modprobe nfnetlink_queue >/dev/null 2>&1 || true
    modprobe nft_queue >/dev/null 2>&1 || true
    local kmod_add="opkg install"
    command -v apk >/dev/null 2>&1 && kmod_add="apk add"
    if [ -e /proc/net/netfilter/nfnetlink_queue ]; then
        add_check "модуль nfnetlink_queue" 1 "загружен" ""
    else
        add_check "модуль nfnetlink_queue" 0 "не загружен — nfqws2 не запустится" "$kmod_add kmod-nfnetlink-queue; modprobe nfnetlink_queue"
    fi
    local q_ok=0
    if nft add table inet bcw_probe_q 2>/dev/null; then
        nft add chain inet bcw_probe_q c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_q c queue num 65000 2>/dev/null && q_ok=1
        nft delete table inet bcw_probe_q 2>/dev/null || true
    fi
    if [ "$q_ok" = "1" ]; then
        add_check "модуль nft_queue" 1 "очередь nftables доступна" ""
    else
        add_check "модуль nft_queue" 0 "правило queue недоступно" "$kmod_add kmod-nft-queue; modprobe nft_queue"
    fi

    local eng_ours=0 ec en
    for ec in /proc/[0-9]*/comm; do
        [ -r "$ec" ] || continue
        en=$(cat "$ec" 2>/dev/null)
        case "$en" in nfqws2|nfqws) ;; *) continue ;; esac
        local ep=${ec#/proc/}; ep=${ep%/comm}
        case "$(tr '\0' ' ' < "/proc/$ep/cmdline" 2>/dev/null)" in
            *zapret2wizard*) eng_ours=$((eng_ours + 1)) ;;
        esac
    done
    if [ "$eng_ours" -ge 1 ]; then
        add_check "наши движки" 1 "$eng_ours запущено" ""
    elif [ -d /var/run/bcw_scan.lock ]; then
        add_check "наши движки" 1 "подбор идёт на своей очереди" ""
    else
        add_check "наши движки" 0 "ни один экземпляр nfqws2 не запущен" "Перезапустите службу и проверьте лог: logread | grep -i nfqws | tail -20"
    fi

    local fo=$(uci -q get firewall.@defaults[0].flow_offloading)
    local fohw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
    if [ "$fo" = "1" ] || [ "$fohw" = "1" ]; then
        add_check "flow offloading" 0 "включён — обход не будет работать" "Перезапустите службу: /etc/init.d/zapret2wizard restart"
    else
        add_check "flow offloading" 1 "отключён" ""
    fi

    # Проверяем именно тот ABI/опции/Lua, которые нужны сканеру, а не chmod +x.
    # Жёсткий бюджет: чужой/старый движок не должен задерживать doctor до RPC-таймаута.
    local _eng_tmo_prev="${BCW_ENGINE_TIMEOUT:-}"
    BCW_ENGINE_TIMEOUT=3
    if engine_load && bcw_engine_check && bcw_engine_check "${BCW_ENGINE_ROOT:-}/opt/zapret2/nfq2/nfqws2" "${BCW_ENGINE_ROOT:-}/opt/zapret2/lua"; then
        add_check "движок nfqws2" 1 "/usr/bin и /opt: filter-mark и Lua совместимы" ""
    else
        add_check "движок nfqws2" 0 "${BCW_ENGINE_ERROR:-модуль проверки недоступен}" "Нажмите «Починить движок» или выполните: blockcheckw-helper engine_repair"
    fi
    if [ -n "$_eng_tmo_prev" ]; then BCW_ENGINE_TIMEOUT="$_eng_tmo_prev"; else unset BCW_ENGINE_TIMEOUT; fi

    # nfqws2 из /opt/zapret2/nfq2 ищет zapret-lib.lua в /opt/zapret2/lua.
    # Без этого сканер падает на предполётной проверке (exit code 6).
    ensure_lua_layout
    if [ -r /opt/zapret2/lua/zapret-lib.lua ]; then
        add_check "lua-библиотеки" 1 "/opt/zapret2/lua" ""
    else
        add_check "lua-библиотеки" 0 "нет /opt/zapret2/lua/zapret-lib.lua" "Перезапустите службу или выполните install.sh: nfqws2 не найдёт Lua"
    fi

    # Память стратегий (L1 домен / L2 /24 / бан-маска): просто показываем размер.
    local mem_stats=$(mem stats 2>/dev/null)
    local mem_domains=$(printf '%s' "$mem_stats" | sed -n 's/.*"domains":\([0-9]*\).*/\1/p')
    [ -n "$mem_domains" ] || mem_domains=0
    local mem_banned=$(printf '%s' "$mem_stats" | sed -n 's/.*"banned":\([0-9]*\).*/\1/p')
    [ -n "$mem_banned" ] || mem_banned=0
    add_check "память стратегий" 1 "$mem_domains доменов, $mem_banned банов" ""

    if [ -x /usr/bin/blockcheckw ]; then add_check "сканер blockcheckw" 1 "$(/usr/bin/blockcheckw --version 2>/dev/null | head -1)" ""; else add_check "сканер blockcheckw" 0 "бинарник не найден" "Переустановите службу через install.sh"; fi

    if [ -f /etc/config/zapret2wizard ]; then add_check "конфигурация" 1 "/etc/config/zapret2wizard" ""; else add_check "конфигурация" 0 "нет /etc/config/zapret2wizard" "Запустите /etc/init.d/zapret2wizard restart — файл создаётся при старте"; fi

    local strategies=$(uci show zapret2wizard 2>/dev/null | grep -c '=strategy')
    add_check "стратегии в конфиге" 1 "$strategies шт." ""

    if _svc_running; then
        add_check "служба" 1 "работает" ""
    elif [ -d /var/run/bcw_scan.lock ]; then
        add_check "служба" 1 "идёт подбор — служба приостановлена" ""
    else
        add_check "служба" 0 "остановлена" "Запустите: /etc/init.d/zapret2wizard start"
    fi

    if nft list tables 2>/dev/null | grep -q 'inet zapret2wizard'; then add_check "nft-таблица" 1 "inet zapret2wizard" ""; else add_check "nft-таблица" 0 "отсутствует" "Служба не установила правила — проверьте лог: logread -e zapret2wizard"; fi

    if ls /etc/rc.d/ 2>/dev/null | grep -q zapret2wizard; then add_check "автозапуск" 1 "включён" ""; else add_check "автозапуск" 0 "выключен" "Включите: /etc/init.d/zapret2wizard enable"; fi

    local _tmo_c=""
    command -v timeout >/dev/null 2>&1 && _tmo_c="timeout 5"
    local foreign=$($_tmo_c blockcheckw-helper conflicts 2>/dev/null | grep -o '"foreign":[0-9]*' | cut -d: -f2)
    add_check "чужие движки" 1 "${foreign:-0} шт. — не трогаем" ""

    checks="[${checks%,}]"
    printf '{"ok":%s,"arch":"%s","checks":%s}\n' "$([ "$ok" = "1" ] && echo true || echo false)" "$arch" "$checks"
    [ "$ok" = "1" ]
}

# Один владелец проверки/замены движка: общий модуль, также используемый install/init.
engine_load() {
    local module="${BCW_ENGINE_ROOT:-}/usr/share/zapret2wizard/engine.sh"
    if [ ! -r "$module" ]; then
        BCW_ENGINE_ERROR="нет общего модуля проверки движка; обновите службу"
        return 1
    fi
    . "$module"
}

engine_reply() {
    lua - "$1" "$2" << 'ENGINEJSON'
local json = require("luci.jsonc")
print(json.stringify({success = arg[1] == "1", error = arg[1] ~= "1" and arg[2] or nil,
    message = arg[1] == "1" and arg[2] or nil}))
ENGINEJSON
}

cmd_install_engine() {
    cmd_engine_repair
}

engine_repair_state() {
    local tmp
    tmp=$(mktemp /tmp/bcw-engine-state.XXXXXX) || return 1
    lua - "$1" "$2" > "$tmp" << 'REPAIRSTATE'
local j = require("luci.jsonc")
print(j.stringify({state = arg[1], success = arg[1] == "done", error = arg[1] == "error" and arg[2] or nil,
    message = arg[2]}))
REPAIRSTATE
    mv -f "$tmp" /tmp/bcw_engine_repair.json
}

cmd_engine_repair() {
    local token="${1:-}"
    if [ -z "$token" ]; then
        if ! mkdir /var/run/bcw_engine_repair.lock 2>/dev/null; then
            engine_reply 0 "Проверка движка уже выполняется"; return 1
        fi
        token="$$-$(date +%s)"
        printf '%s\n' "$token" > /var/run/bcw_engine_repair.lock/token
    elif [ "$(cat /var/run/bcw_engine_repair.lock/token 2>/dev/null)" != "$token" ]; then
        engine_reply 0 "Проверка движка потеряла владение операцией"; return 1
    fi
    # Обе стороны сначала берут свой засов, затем перепроверяют чужой:
    # ни подбор, ни применение не могут войти после этой точки.
    if [ -d /var/run/bcw_scan.lock ] || [ -d /var/run/bcw_apply_runtime.lock ]; then
        engine_repair_state error "Дождитесь завершения подбора или применения стратегии"
        rm -rf /var/run/bcw_engine_repair.lock
        return 1
    fi
    engine_repair_state running "Проверяю совместимость движка и Lua"
    echo $$ > /var/run/bcw_engine_repair.lock/pid
    (
        local work was_running=0 changed=0 committed=0 rollback_ok=1 f
        work=$(mktemp -d /tmp/bcw-engine-repair.XXXXXX) || exit 1
        # nfqws2 drops privileges to nobody: staged Lua must be traversable/readable,
        # otherwise a downloaded compatible engine is always rejected (issue #6).
        chmod 755 "$work" || exit 1
        trap 'rm -rf "$work"' EXIT
        _svc_running && was_running=1
        # Бэкап включает оба пути и Lua; конфиг пользователя не трогаем.
        if [ -e /usr/bin/nfqws2 ] || [ -L /usr/bin/nfqws2 ]; then
            cp -Pp /usr/bin/nfqws2 "$work/nfqws2" || exit 1
        fi
        if [ -L /usr/share/zapret2wizard/lua ]; then
            engine_repair_state error "Каталог Lua службы является внешней ссылкой; автоматическая замена отменена"
            exit 1
        fi
        [ ! -e /usr/share/zapret2wizard/lua ] || cp -RPp /usr/share/zapret2wizard/lua "$work/lua" || exit 1
        if [ -e /opt/zapret2/lua ] || [ -L /opt/zapret2/lua ]; then
            cp -RPp /opt/zapret2/lua "$work/scanner-lua" || exit 1
        fi
        if [ -e /opt/zapret2/nfq2/nfqws2 ] || [ -L /opt/zapret2/nfq2/nfqws2 ]; then
            cp -Pp /opt/zapret2/nfq2/nfqws2 "$work/legacy" || exit 1
        fi
        engine_repair_cleanup() {
            if [ "$changed" = "1" ] && [ "$committed" != "1" ]; then
                if [ -e "$work/nfqws2" ] || [ -L "$work/nfqws2" ]; then
                    cp -Pp "$work/nfqws2" /usr/bin/nfqws2.rollback && mv -f /usr/bin/nfqws2.rollback /usr/bin/nfqws2 || rollback_ok=0
                else
                    rm -f /usr/bin/nfqws2
                fi
                rm -f /opt/zapret2/nfq2/nfqws2
                [ ! -e "$work/legacy" ] && [ ! -L "$work/legacy" ] || cp -Pp "$work/legacy" /opt/zapret2/nfq2/nfqws2 || rollback_ok=0
                # Восстанавливаем весь набор, включая отсутствие новых файлов и старые ссылки.
                rm -rf /usr/share/zapret2wizard/lua /opt/zapret2/lua
                [ ! -d "$work/lua" ] || cp -RPp "$work/lua" /usr/share/zapret2wizard/lua || rollback_ok=0
                if [ -e "$work/scanner-lua" ] || [ -L "$work/scanner-lua" ]; then
                    cp -RPp "$work/scanner-lua" /opt/zapret2/lua || rollback_ok=0
                fi
                [ "$was_running" != "1" ] || { BCW_ENGINE_ONLY=1 BCW_INTERNAL_STOP=1 timeout -s KILL 30 /etc/init.d/zapret2wizard restart >/dev/null 2>&1 && wait_dpi_ready 25; } || rollback_ok=0
            fi
            if [ "$rollback_ok" = "1" ]; then
                rm -rf "$work"
            else
                engine_repair_state error "Не удалось полностью восстановить runtime; резервная копия: $work"
            fi
            # Освобождение выполняется единожды внешним владельцем token.
        }
        trap engine_repair_cleanup EXIT
        trap 'engine_repair_state error "Проверка движка прервана; выполнен откат"; exit 1' INT TERM HUP
        engine_repair_state running "Проверяю совместимость движка, Lua и пути сканера"
        # Older updaters may omit helper modules: deliver them before continuing.
        for f in transfer_probe.lua hostlist_io.sh; do
            fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/$f" "$work/$f" 12 || exit 1
        done
        lua - "$work/transfer_probe.lua" << 'LUA'
assert(loadfile(arg[1]))
LUA
        [ "$?" = 0 ] || exit 1
        sh -n "$work/hostlist_io.sh" || exit 1
        for f in transfer_probe.lua hostlist_io.sh; do
            cp "$work/$f" "/usr/share/zapret2wizard/$f.new" &&
                mv -f "/usr/share/zapret2wizard/$f.new" "/usr/share/zapret2wizard/$f" || exit 1
        done
        # Older updaters can install this helper without its extracted owner.
        if [ ! -r /usr/share/zapret2wizard/lifecycle.sh ]; then
            fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/lifecycle.sh" "$work/lifecycle.sh" 12 &&
                sh -n "$work/lifecycle.sh" && grep -q '^bcw_lifecycle_remove()' "$work/lifecycle.sh" || {
                    engine_repair_state error "Lifecycle module unavailable"; exit 1;
                }
            cp "$work/lifecycle.sh" /usr/share/zapret2wizard/lifecycle.sh.new &&
                mv -f /usr/share/zapret2wizard/lifecycle.sh.new /usr/share/zapret2wizard/lifecycle.sh || exit 1
        fi
        # Старый updater не знал engine.sh. Новый helper сам довозит модуль.
        if ! engine_load || ! command -v bcw_engine_require_timeout >/dev/null 2>&1; then
            fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/engine.sh" "$work/engine.sh" 12 &&
                sh -n "$work/engine.sh" && grep -q '^bcw_engine_ensure()' "$work/engine.sh" || {
                    engine_repair_state error "Не удалось загрузить модуль проверки движка"; exit 1;
                }
            mkdir -p /usr/share/zapret2wizard
            cp "$work/engine.sh" /usr/share/zapret2wizard/engine.sh.new &&
                mv -f /usr/share/zapret2wizard/engine.sh.new /usr/share/zapret2wizard/engine.sh || exit 1
            engine_load || exit 1
        fi
        # Дедлайны должны работать ДО любых замен/отката. На OpenWrt timeout
        # может отсутствовать даже в BusyBox: довозим пакет автоматически.
        bcw_engine_require_timeout || { engine_repair_state error "$BCW_ENGINE_ERROR"; exit 1; }
        # Старый updater мог не довезти init (раньше он был необязательным).
        # Не допускаем автоматический restart через init с DNS/миграционными хуками.
        if ! grep -q 'BCW_ENGINE_ONLY' /etc/init.d/zapret2wizard 2>/dev/null; then
            fetch_file "openwrt/luci-app-blockcheckw/root/etc/init.d/zapret2wizard" "$work/initd" 12 &&
                sh -n "$work/initd" && grep -q 'BCW_ENGINE_ONLY' "$work/initd" || {
                    engine_repair_state error "Не удалось загрузить init для безопасного обновления движка"; exit 1;
                }
            cp -p /etc/init.d/zapret2wizard /etc/init.d/zapret2wizard.engine-backup || exit 1
            chmod 755 "$work/initd"
            cp "$work/initd" /etc/init.d/zapret2wizard.new &&
                mv -f /etc/init.d/zapret2wizard.new /etc/init.d/zapret2wizard || exit 1
        fi
        if bcw_engine_check; then
            changed=1
            bcw_engine_ensure || { engine_repair_state error "$BCW_ENGINE_ERROR"; exit 1; }
            [ "$BCW_ENGINE_CHANGED" = "1" ] || changed=0
        else
            # Валидируем скачанный движок именно с полным новым набором Lua.
            mkdir -p "$work/new-lua"
            for f in zapret-lib.lua zapret-antidpi.lua zapret-auto.lua zapret-obfs.lua zapret-pcap.lua zapret-tests.lua zapret-wgobfs.lua; do
                fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/lua/$f" "$work/new-lua/$f" 12 || {
                    engine_repair_state error "Не удалось загрузить совместимый набор Lua ($f); прежний движок сохранён"; exit 1;
                }
            done
            # Same dropped-uid requirement as production Lua directories.
            chmod 755 "$work/new-lua" && chmod 644 "$work/new-lua/"*.lua || exit 1
            changed=1
            BCW_ENGINE_LUA_DIR="$work/new-lua"
            bcw_engine_ensure || { engine_repair_state error "$BCW_ENGINE_ERROR"; exit 1; }
            unset BCW_ENGINE_LUA_DIR
            mkdir -p /usr/share/zapret2wizard/lua
            for f in "$work/new-lua/"*.lua; do
                cp "$f" "/usr/share/zapret2wizard/lua/$(basename "$f").new" &&
                    mv -f "/usr/share/zapret2wizard/lua/$(basename "$f").new" "/usr/share/zapret2wizard/lua/$(basename "$f")" || exit 1
            done
        fi
        local engine_changed="$changed"
        changed=1 # Lua-layout reconciliation is also covered by rollback.
        ensure_lua_layout
        bcw_engine_check && bcw_engine_check /opt/zapret2/nfq2/nfqws2 /opt/zapret2/lua || {
            engine_repair_state error "$BCW_ENGINE_ERROR"; exit 1;
        }
        if [ "$engine_changed" = "1" ] && [ "$was_running" = "1" ]; then
            BCW_ENGINE_ONLY=1 BCW_INTERNAL_STOP=1 timeout -s KILL 30 /etc/init.d/zapret2wizard restart >/dev/null 2>&1 && wait_dpi_ready 25 || {
                engine_repair_state error "Обновлённый движок не поднял службу; восстановлен прежний комплект"; exit 1;
            }
        fi
        committed=1
        engine_repair_state done "Движок и Lua совместимы; служба и сканер используют единый nfqws2"
        engine_reply 1 "Движок проверен и готов к подбору"
    )
    local rc=$?
    # Ошибки бэкапа/IO до установки trap тоже освобождают засов и не оставляют
    # статус running/success от предыдущей операции.
    if [ "$rc" -ne 0 ] && ! grep -q '"state":"error"' /tmp/bcw_engine_repair.json 2>/dev/null; then
        engine_repair_state error "Не удалось завершить проверку движка; смотрите журнал проверки"
    fi
    if [ "$(cat /var/run/bcw_engine_repair.lock/token 2>/dev/null)" = "$token" ]; then
        rm -f /tmp/bcw_engine_repair.pid
        rm -rf /var/run/bcw_engine_repair.lock
    fi
    return "$rc"
}

cmd_engine_repair_bg() {
    local token
    # Только победитель mkdir публикует статус и запускает worker.
    if ! mkdir /var/run/bcw_engine_repair.lock 2>/dev/null; then
        engine_reply 1 "Проверка движка уже выполняется"
        return 0
    fi
    token="$$-$(date +%s)"
    printf '%s\n' "$token" > /var/run/bcw_engine_repair.lock/token
    engine_repair_state running "Запущена проверка движка после обновления"
    if command -v setsid >/dev/null 2>&1; then
        setsid /usr/bin/blockcheckw-helper engine_repair "$token" </dev/null >/tmp/bcw_engine_repair.log 2>&1 &
    else
        /usr/bin/blockcheckw-helper engine_repair "$token" </dev/null >/tmp/bcw_engine_repair.log 2>&1 &
    fi
    echo $! > /tmp/bcw_engine_repair.pid
    engine_reply 1 "Совместимость движка проверяется в фоне"
}

cmd_engine_repair_status() {
    if [ -s /tmp/bcw_engine_repair.json ]; then
        cat /tmp/bcw_engine_repair.json
    else
        printf '{"state":"idle","success":false}\n'
    fi
}

scan_error_detail() {
    local log="$1" code="$2" detail
    detail=$(grep -iE 'error|failed|fatal|requires build' "$log" 2>/dev/null | tail -n 1)
    [ -n "$detail" ] || detail="Сканер завершился с кодом $code; смотрите журнал подбора"
    printf '%s\n' "$detail"
}

scan_failure() {
    local detail
    detail=$(scan_error_detail "$2" "$1")
    write_status "error" 0 "Ошибка подбора: $detail" ',"strategies":[]'
    printf '[blockcheckw-helper] Scan failed with exit code %s: %s\n' "$1" "$detail" >> "$2"
}


# Компактный отчёт: состояние службы + живая проверка сервиса.
cmd_selftest() {
    local target="${1:-preset_youtube}"
    local ver=$(grep -o '"version": *"[^"]*"' /usr/share/blockcheckw/version.json 2>/dev/null | head -1 | cut -d'"' -f4)
    local engines=0 c name
    for c in /proc/[0-9]*/comm; do
        [ -r "$c" ] || continue
        name=$(cat "$c" 2>/dev/null)
        case "$name" in nfqws2|nfqws) engines=$((engines + 1)) ;; esac
    done
    # «работает» — только если движки реально есть: pgrep -f ловил обёртки
    # сканера, в чьей командной строке встречалось nfqws2, и врал при 0 движков
    local svc_state="остановлена"
    [ "$engines" -gt 0 ] && svc_state="работает"

    echo "=== Zapret2Wizard selftest ==="
    echo "версия:            ${ver:-?}"
    echo "платформа:         $(uname -m)"
    echo "служба:            $svc_state"
    echo "движки nfqws2:     $engines"
    echo "nft-таблица:       $(nft list tables 2>/dev/null | grep -c 'inet zapret2wizard')"
    echo "стратегий:         $(uci show zapret2wizard 2>/dev/null | grep -c '=strategy')"
    echo "lua-модулей:       $(ls /usr/share/zapret2wizard/lua/*.lua 2>/dev/null | wc -l)"
    echo "fake-блобов:       $(ls /usr/share/zapret2wizard/fake/*.bin 2>/dev/null | wc -l)"
    echo "доменов в списках: $(cat /etc/zapret2wizard/ipset/zapret_hosts_*.txt 2>/dev/null | grep -vc '^#')"
    echo
    local _fo_sw=$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null); [ -n "$_fo_sw" ] || _fo_sw="off"
    local _fo_hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null); [ -n "$_fo_hw" ] || _fo_hw="off"
    echo "flow offloading:   $_fo_sw/$_fo_hw"
    echo
    echo "--- живая проверка ($target) ---"
    local out
    out=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
    local status=$(printf '%s' "$out" | grep -o '"overall_status":"[a-z]*"' | head -1 | cut -d'"' -f4)
    # Служба могла ещё подниматься после restart/установки — один повтор через 3 с.
    if [ "$status" != "optimal" ] && [ "$engines" -gt 0 ]; then
        sleep 3
        out=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
        status=$(printf '%s' "$out" | grep -o '"overall_status":"[a-z]*"' | head -1 | cut -d'"' -f4)
    fi
    local code=$(printf '%s' "$out" | grep -o '"http_code":"[0-9]*"' | head -1 | cut -d'"' -f4)
    local size=$(printf '%s' "$out" | grep -o '"size_bytes":[0-9]*' | head -1 | cut -d: -f2)
    echo "статус:            ${status:-нет ответа}"
    echo "http-код:          ${code:-?}"
    echo "получено байт:     ${size:-0}"
    echo
    echo "--- контроль: обычный сайт и DNS ---"
    local ctrl_code ctrl_time
    ctrl_code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' https://ya.ru 2>/dev/null || echo 000)
    echo "ya.ru (контроль):  ${ctrl_code}"
    local yt_ip
    yt_ip=$(nslookup www.youtube.com 2>/dev/null | awk '/^Address: /{print $2; exit}')
    echo "DNS youtube.com:   ${yt_ip:-не резолвится}"
    case "$yt_ip" in
        0.0.0.0|127.*|8.6.*|8.47.*) echo "                   ВНИМАНИЕ: похоже на подмену DNS провайдером" ;;
    esac

    echo "--- ошибки движка ---"
    logread 2>/dev/null | grep -iE 'nfqws|zapret2wizard' | tail -5 || echo "(нет записей)"
    logread 2>/dev/null | grep -iE 'lua|blob|no such file' | tail -4 || true

    echo "--- последние строки лога ---"
    tail -n 6 /tmp/blockcheckw_run.log 2>/dev/null || echo "(лог пуст)"
}

# Матрица «класс ТСПУ»: 9 базовых приёмов desync (как в tspu-class-test).
# Показывает, какие механики провайдер пропускает, и подсказывает класс блокировки.
cmd_class() {
    local target="${1:-preset_youtube}"
    local sec="" domain=""
    case "$target" in
        preset_discord|discord) sec="BlockcheckW_Discord"; domain="discord.com" ;;
        builtin|user) sec="BlockcheckW_General"; domain="rutracker.org" ;;
        *) sec="BlockcheckW_YouTube"; domain="www.youtube.com" ;;
    esac

    local backup=$(uci -q get "zapret2wizard.$sec.script")
    local n=0 passed=0 name args res passed_list=""
    echo "=== Класс ТСПУ: $domain ==="
    while IFS='|' read -r name args; do
        [ -n "$name" ] || continue
        n=$((n + 1))
        printf '%s\n' "$args" > /tmp/bcw_class.txt
        res=$(cmd_apply --target "$target" --file /tmp/bcw_class.txt 2>/dev/null)
        if printf '%s' "$res" | grep -q '"all_ok":true'; then
            passed=$((passed + 1))
            passed_list="$passed_list $n"
            echo "  OK   $n. $name"
        else
            echo "  --   $n. $name"
        fi
    done <<'CLASSLIST'
1. multidisorder midsld|--payload=tls_client_hello --lua-desync=multidisorder:pos=midsld
2. multisplit midsld|--payload=tls_client_hello --lua-desync=multisplit:pos=midsld
3. multidisorder sld|--payload=tls_client_hello --lua-desync=multidisorder:pos=sld
4. fake (autottl)|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:ip_autottl=-2,3-20:repeats=6
5. fake + multisplit|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=6 --lua-desync=multisplit:pos=midsld
6. fake + multidisorder|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=6 --lua-desync=multidisorder:pos=midsld
7. fakeddisorder|--payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5
8. rst (autottl)|--payload=tls_client_hello --lua-desync=rst:ip_autottl=-2,3-20
9. fake (tcp_md5)|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=6
CLASSLIST

    if [ -n "$backup" ]; then
        printf '%s\n' "$backup" > /tmp/bcw_class.txt
        cmd_apply --target "$target" --file /tmp/bcw_class.txt >/dev/null 2>&1
    fi
    rm -f /tmp/bcw_class.txt
    echo "--- прошло: $passed из $n ---"
    if [ "$passed" -eq 0 ]; then
        echo "Ни один приём не прошёл: вероятен блок по IP или по отпечатку клиента."
        echo "Проверьте: DNS не подменён (selftest), VPN выключен, домен резолвится."
    elif printf '%s' "$passed_list" | grep -qE ' (5|6|7) '; then
        echo "Класс: нужны фейки вместе с нарезкой. Рабочие варианты: fakeddisorder, fake+multisplit, fake+multidisorder."
    elif printf '%s' "$passed_list" | grep -qE ' (1|2|3) '; then
        echo "Класс: ТСПУ не собирает сегменты. Достаточно нарезки: multidisorder или multisplit по midsld."
    elif printf '%s' "$passed_list" | grep -qE ' (4|8|9) '; then
        echo "Класс: ТСПУ реагирует на поддельные пакеты. Стратегия: fake с ip_autottl или rst."
    fi
}

# Сетевая классификация в духе dpi-checkers: что именно мешает —
# CIDR-whitelist, обрезка на 16 КБ, подмена DNS или интернета нет вовсе.
# Дешёвые проверки, без внешних API: только curl/nslookup.
_net_code() {
    command -v curl >/dev/null 2>&1 || { echo 000; return; }
    # curl печатает код и при ошибке (000), поэтому "|| echo 000" нельзя:
    # получалось "000\n000", и вызов считался успешным.
    curl -4 -s -o /dev/null -m 6 -w '%{http_code}' "$1" 2>/dev/null
}

_net_dns() {
    nslookup "$1" "$2" 2>/dev/null | awk '
        /^Name:/ { s=1; next }
        s && /^Address[ \t]*[0-9]*:/ { print $3 }
        s && /^Address:/ { print $2 }
    ' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | sort -u
}

cmd_netcheck() {
    local wl=0 rg=0 code blocking=none dns=unknown advice="ok"
    local l="" p="" common="" bytes=0
    if ! command -v curl >/dev/null 2>&1; then
        echo '{"ok":false,"error":"curl not installed"}'
        return 1
    fi
    for u in https://max.ru/ https://ya.ru/ https://vk.ru/; do
        code=$(_net_code "$u")
        [ "$code" != "000" ] && wl=1
    done
    for u in https://github.com/ https://www.google.com/ https://ru.wikipedia.org/; do
        code=$(_net_code "$u")
        [ "$code" != "000" ] && rg=1
    done
    if [ "$rg" = "1" ]; then
        blocking=none
    elif [ "$wl" = "1" ]; then
        blocking=cidr_whitelist
    else
        blocking=no_internet
    fi

    # Обрезка ответа на ~16 КБ: качаем диапазон и смотрим, сколько отдали.
    bytes=$(curl -4 -s -o /dev/null -m 15 -r 0-65535 -w '%{size_download}' https://www.youtube.com/ 2>/dev/null)
    case "$bytes" in ''|*[!0-9]*) bytes=0 ;; *) bytes=$((bytes + 0)) ;; esac
    if [ "$blocking" = "none" ] && [ "$bytes" -gt 0 ] && [ "$bytes" -lt 60000 ]; then
        blocking=throttle_16k
    fi

    # Подмена DNS: локальный резолвер против 1.1.1.1 (best effort).
    l=$(_net_dns www.youtube.com 127.0.0.1)
    p=$(_net_dns www.youtube.com 1.1.1.1)
    if [ -n "$l" ] && [ -n "$p" ]; then
        common=$(printf '%s\n%s\n' "$l" "$p" | sort | uniq -d)
        if [ -z "$common" ]; then
            dns=spoof
            [ "$blocking" = "none" ] && blocking=dns_spoof
        else
            dns=ok
        fi
    fi

    case "$blocking" in
        none) advice="ok" ;;
        cidr_whitelist) advice="whitelist: обход только по домену/SNI, проверьте стратегию" ;;
        no_internet) advice="нет интернета: WAN/DNS/шлюз" ;;
        throttle_16k) advice="обрезка на 16 КБ: сканер должен проверять полной загрузкой" ;;
        dns_spoof) advice="DNS подменён: включите DoH/DoT и проверьте optimize_dns" ;;
    esac

    printf '{"ok":%s,"blocking":"%s","cidr_whitelist":%s,"regular":%s,"dns":"%s","bytes_16k":%s,"advice":"%s"}\n' \
        "$([ "$blocking" = none ] && echo true || echo false)" \
        "$blocking" "$wl" "$rg" "$dns" "$bytes" "$advice"
}

# Ключ сервиса по имени секции (для интерфейса и отчётов).
_info_sec_key() {
    case "$1" in
        BlockcheckW_YouTube) echo youtube ;;
        BlockcheckW_Discord) echo discord ;;
        BlockcheckW_Discord_Voice) echo discord_voice ;;
        BlockcheckW_Twitch) echo twitch ;;
        BlockcheckW_X) echo x ;;
        BlockcheckW_Instagram) echo instagram ;;
        BlockcheckW_General) echo builtin ;;
        BlockcheckW_User*) echo user ;;
        YTApi) echo youtubei ;;
        *) echo custom ;;
    esac
}

# Резервный сборщик info: работает без Lua-модуля uci (на минимальных сборках
# OpenWrt он отсутствует, и тогда интерфейс показывал нули).
_info_json_shell() {
    local running=$(get_dpi_service_status | head -n 1)
    local ver=$(grep -o '"version": *"[^"]*"' "$VERSION_FILE" 2>/dev/null | head -n 1 | cut -d'"' -f4)
    local svc="" strat="" first_s=1 first_a=1
    for sec in $(uci -q show zapret2wizard 2>/dev/null | sed -n 's/^zapret2wizard\.\([^=]*\)=strategy$/\1/p'); do
        local en_raw=$(uci -q get "zapret2wizard.$sec.enabled")
        local en=false; [ "$en_raw" = "1" ] && en=true
        local script=$(uci -q get "zapret2wizard.$sec.script")
        local port=$(uci -q get "zapret2wizard.$sec.port")
        local proto=$(uci -q get "zapret2wizard.$sec.protocol")
        local l7=$(uci -q get "zapret2wizard.$sec.filter_l7")
        local hl=$(uci -q get "zapret2wizard.$sec.hostlist")
        local key=$(_info_sec_key "$sec")
        local cnt=0
        case "$hl" in
            list_hosts_*)
                local f="/etc/zapret2wizard/ipset/zapret_hosts_${hl#list_hosts_}.txt"
                if [ -f "$f" ]; then cnt=$(grep -vc '^#' "$f" 2>/dev/null); fi
                cnt=${cnt:-0}
                ;;
        esac
        # tr: переносы/табы внутри значения — валидный JSON не позволяет;
        # для аргументов nfqws это пробелы, поэтому нормализуем до sed.
        local esc=$(printf '%s' "$script" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
        local obj="\"$key\":{\"section\":\"$sec\",\"enabled\":$en,\"script\":\"$esc\",\"port\":\"$port\",\"protocol\":\"$proto\",\"filter_l7\":\"$l7\",\"hostlist\":\"$hl\",\"domain_count\":$cnt}"
        local aobj="{\"section\":\"$sec\",\"service_key\":\"$key\",\"enabled\":$en,\"script\":\"$esc\",\"port\":\"$port\",\"protocol\":\"$proto\",\"hostlist\":\"$hl\",\"domain_count\":$cnt}"
        if [ "$first_s" = "1" ]; then svc="$obj"; first_s=0; else svc="$svc,$obj"; fi
        if [ "$first_a" = "1" ]; then strat="$aobj"; first_a=0; else strat="$strat,$aobj"; fi
    done
    local hl_json=$(_hl_info_json)
    hl_json=${hl_json#[}; hl_json=${hl_json%]}
    local nft_ok=false; nft list table inet zapret2wizard >/dev/null 2>&1 && nft_ok=true
    printf '{"zapret2_running":"%s","nft_table":%s,"version":"%s","services":{%s},"all_strategies":[%s],"hostlists":[%s]}\n' \
        "$running" "$nft_ok" "$ver" "$svc" "$strat" "$hl_json"
}

# ASN провайдера (для каталога геномов).
cmd_asn() {
    if [ -f /etc/zapret2wizard/provider ]; then
        local p=$(cat /etc/zapret2wizard/provider 2>/dev/null)
        local a=$(printf '%s' "$p" | grep -o 'AS[0-9][0-9]*' | head -n 1)
        [ -n "$a" ] && { echo "$a"; return 0; }
    fi
    local a=$(lua /usr/share/zapret2wizard/evolve.lua asn /tmp/blockcheckw_status.json 2>/dev/null)
    if [ -z "$a" ] || [ "$a" = "AS0" ]; then
        # status.json может быть без isp/netcheck: добираем ASN внешним API.
        local raw=""
        raw=$(curl -4 -sS -m 5 https://ipinfo.io/org 2>/dev/null)
        [ -n "$raw" ] || raw=$(curl -4 -sS -m 5 https://ipapi.co/asn/ 2>/dev/null)
        a=$(printf '%s' "$raw" | grep -o 'AS[0-9][0-9]*' | head -n 1)
        [ -n "$a" ] && mkdir -p /etc/zapret2wizard 2>/dev/null && printf 'ASN %s
' "$a" > /etc/zapret2wizard/provider 2>/dev/null
    fi
    [ -n "$a" ] || a="AS0"
    echo "$a"
}

# Сохранить провайдера (с ASN), если он есть в отчёте сканера.
cmd_provider_save() {
    local isp=""
    if [ -f /tmp/blockcheckw_status.json ]; then
        isp=$(grep -o '"isp": *"[^"]*"' /tmp/blockcheckw_status.json 2>/dev/null | head -n 1 | cut -d'"' -f4)
    fi
    if [ -n "$isp" ]; then
        mkdir -p /etc/zapret2wizard 2>/dev/null || true
        printf '%s\n' "$isp" > /etc/zapret2wizard/provider
        echo "{\"saved\":true,\"isp\":\"$isp\"}"
    else
        echo '{"saved":false}'
    fi
}

# Забрать геномы из общего каталога по ASN и слить с локальной памятью.
cmd_catalog_fetch() {
    local asn="${1:-}"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"

    [ -n "$asn" ] || asn=$(cmd_asn)
    if [ -z "$asn" ] || [ "$asn" = "AS0" ]; then
        echo '{"ok":false,"error":"не удалось определить ASN провайдера"}'
        return 1
    fi

    local url="https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/genomes/${asn}.json"
    local tmp="/tmp/bcw_catalog.json"
    curl -fsSL -k -m 30 "$url" -o "$tmp" 2>/dev/null || wget -q -O "$tmp" "$url" 2>/dev/null || true

    if [ ! -s "$tmp" ]; then
        local asns=""
        local idx="/tmp/bcw_catalog_index.json"
        curl -fsSL -k -m 20 "https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/genomes/index.json" -o "$idx" 2>/dev/null || true
        if [ -s "$idx" ]; then
            asns=$(lua -e 'local j=require("luci.jsonc"); local f=io.open("/tmp/bcw_catalog_index.json","r"); if not f then return end; local ok,d=pcall(j.parse,f:read("*a")); f:close(); if not ok or not d or not d.providers then return end; local t={}; for k in pairs(d.providers) do t[#t+1]=k end; table.sort(t); print(table.concat(t, ","))' 2>/dev/null)
        fi
        rm -f "$idx"
        echo "{\"ok\":false,\"error\":\"в каталоге пока нет геномов для ${asn}\",\"asn\":\"${asn}\",\"available\":\"${asns}\"}"
        rm -f "$tmp"
        return 1
    fi

    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"
    local res
    res=$(lua "$evo" import "$genomes" "$provider" "$tmp" 2>/dev/null)
    rm -f "$tmp"
    echo "$res"
}

# Экспорт для отправки в каталог: JSON + подсказка куда положить.
cmd_catalog_export() {
    local asn=$(cmd_asn)
    [ -n "$asn" ] || asn="AS0"
    local out="/tmp/bcw_catalog_export.json"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"

    lua "$evo" export "$genomes" "$provider" 1 "$asn" > "$out" 2>/dev/null
    local count=$(grep -o '"count":[0-9]*' "$out" | head -n 1 | cut -d: -f2)
    echo "{\"ok\":true,\"asn\":\"$asn\",\"count\":${count:-0},\"file\":\"$out\",\"target\":\"genomes/${asn}.json\"}"
}

# issue #12: публикация геномов в общий каталог. Готовит файл формата
# genomes/AS<ASN>.json + запись для index.json, отдаёт содержимое в UI.
cmd_catalog_publish() {
    local asn=$(cmd_asn)
    [ -n "$asn" ] || asn="AS0"
    local genomes="/etc/zapret2wizard/genomes.json"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"
    local out="/tmp/bcw_catalog_publish.json"
    lua "$evo" export "$genomes" "$provider" 1 "$asn" > "$out" 2>/dev/null
    if [ ! -s "$out" ]; then
        echo '{"ok":false,"error":"не удалось подготовить файл (нет геномов?)"}'
        return 1
    fi
    local sha=""
    command -v sha256sum >/dev/null 2>&1 && sha=$(sha256sum "$out" 2>/dev/null | cut -d' ' -f1)
    lua - "$out" "$asn" "$provider" "$sha" <<'LUA'
local j = require("luci.jsonc")
local f = io.open(arg[1], "r")
if not f then print(j.stringify({ok = false, error = "нет файла"})); return end
local content = f:read("*a") or ""
f:close()
local ok, d = pcall(j.parse, content)
if not ok or not d then print(j.stringify({ok = false, error = "файл не разобрался как JSON"})); return end
local asn = arg[2]
local provider = arg[3]
local sha = arg[4]
local target = "genomes/" .. asn .. ".json"
local idx = { file = target, provider = provider, count = d.count or 0, exported_at = d.exported_at or os.time() }
print(j.stringify({ ok = true, asn = asn, count = d.count or 0, target = target,
    sha256 = sha, index_entry = idx, content = content, provider = provider }))
LUA
}

# Дневной триггер: если сервис деградировал два замера подряд — эволюция.
cmd_health_tick() {
    [ ! -e /var/run/bcw_service.stopped ] || { echo '{"skipped":true,"reason":"service stopped"}'; return 0; }
    local counter="/etc/zapret2wizard/.health_fail"
    local last="/etc/zapret2wizard/.health_last"
    local now=$(date +%s)

    # не чаще одного авто-прогона в 6 часов
    if [ -f "$last" ]; then
        local prev=$(cat "$last" 2>/dev/null)
        if [ -n "$prev" ] && [ $((now - prev)) -lt 21600 ]; then
            echo '{"skipped":true,"reason":"throttled"}'
            return 0
        fi
    fi

    if scan_busy || [ -f /tmp/bcw_scan_paused ]; then
        echo '{"skipped":true,"reason":"busy"}'
        return 0
    fi

    # Закреплённые IP Instagram/Discord могли умереть: перепроверяем при
    # каждом тике, не дожидаясь ночной эволюции.
    dns_fix_discord >/dev/null 2>&1 || true
    dns_fix_instagram >/dev/null 2>&1 || true

    # Проверяем все включённые сервисы, а не только YouTube: два сбоя
    # подряд по сервису → L1-запись помечается непроверенной, /24 снимается,
    # запускается переобучение именно этого сервиса.
    local any_fail=0 spawned=0 tgt sec cfile n dom mres
    for tgt in preset_youtube preset_discord preset_twitch preset_x preset_instagram; do
        sec=$(_strategy_section "$tgt")
        [ -n "$sec" ] || continue
        uci -q get "zapret2wizard.$sec.enabled" 2>/dev/null | grep -q '^1$' || continue
        if cmd_test "$tgt" "" > /tmp/bcw_health.json 2>/dev/null && grep -q '"all_ok":true' /tmp/bcw_health.json; then
            echo 0 > "/etc/zapret2wizard/.health_fail_${tgt#preset_}"
            continue
        fi
        any_fail=1
        cfile="/etc/zapret2wizard/.health_fail_${tgt#preset_}"
        n=$(cat "$cfile" 2>/dev/null || echo 0)
        n=$((n + 1))
        echo "$n" > "$cfile"
        # Причина отказа — в журнал мониторинга: позволяет отличить
        # ложное срабатывание от реальной деградации стратегии.
        local hreason=$(lua -e 'local j=require("luci.jsonc"); local f=io.open("/tmp/bcw_health.json","r"); if f then local d=j.parse(f:read("*a")); f:close(); if d then print(tostring(d.message or d.overall_status or "без ответа"):gsub("\n"," ")) end end' 2>/dev/null)
        echo "$(date '+%Y-%m-%d %H:%M:%S') $tgt сбой#$n: ${hreason:-нет ответа}" >> /tmp/bcw_health.log 2>/dev/null || true
        if [ "$n" -ge 2 ]; then
            echo 0 > "$cfile"
            dom=$(target_domain "$tgt")
            mres=$(mem fail "$dom")
            echo "[health] $tgt/$dom: $mres" >> /tmp/bcw_evolve.log 2>/dev/null || true
            if [ "$spawned" = "0" ] && ! scan_busy; then
                ( /usr/bin/blockcheckw-helper evolve --target "$tgt" --count 8 --verify 0 --tests 2 --sleep 2 >>/tmp/bcw_evolve.log 2>&1 & ) || true
                spawned=1
            fi
        fi
    done
    rm -f /tmp/bcw_health.json
    if [ "$any_fail" = "0" ]; then
        echo 0 > "$counter"
        echo '{"healthy":true}'
        return 0
    fi
    echo 0 > "$counter"
    echo "$now" > "$last"
    echo "{\"healthy\":false,\"relearn\":$spawned}"
}

# Экспорт рабочих геномов провайдера в JSON (для обмена).
# Кнопка «Очистить» в окне логов: обнуляем сам файл журнала, а не только
# DOM браузера, иначе старые строки возвращаются при следующем опросе.
cmd_clear_logs() {
    : > "$LOG_FILE" 2>/dev/null || true
    echo '{"success":true}'
}

cmd_evolve_export() {
    local min_ok="${1:-1}"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"
    lua "$evo" export "$genomes" "$provider" "$min_ok" 2>/dev/null
}

# Импорт геномов из файла или URL.
cmd_evolve_import() {
    local src="$1"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local tmp="/tmp/bcw_import.json"

    if [ -z "$src" ]; then
        echo '{"ok":false,"error":"укажите файл или URL"}'
        return 1
    fi

    case "$src" in
        http://*|https://*)
            curl -fsSL -k -m 30 "$src" -o "$tmp" 2>/dev/null || wget -q -O "$tmp" "$src" 2>/dev/null || true
            ;;
        *)
            cp -f "$src" "$tmp" 2>/dev/null || true
            ;;
    esac

    if [ ! -s "$tmp" ]; then
        echo '{"ok":false,"error":"не удалось получить файл геномов"}'
        rm -f "$tmp"
        return 1
    fi

    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"
    lua "$evo" import "$genomes" "$provider" "$tmp" 2>/dev/null
    rm -f "$tmp"
}

# ---- Проверка доступности YouTube (без вмешательства в маршрутизацию) ----

# Комплексная проверка «YouTube глазами роутера»: веб, превью, API, CDN.
# Ничего не меняет и не трогает чужие службы — только измеряет.
_yt_probe() {
    # Аудит должен смотреть глазами LAN-клиента: локальный curl роутера
    # обходит postrouting/NFQUEUE и всегда даёт ложный 000.
    local url="$1" host json code bytes
    host=$(printf '%s' "$url" | sed -e 's|^https*://||' -e 's|/.*||')
    [ -n "$host" ] || { printf '000 0 0'; return; }
    local allow=""
    case "$host" in *youtubei.googleapis.com*|*googleapis.com*) allow="--allow-4xx" ;; esac
    json=$(client_probe_netns "$host" $allow 2>/dev/null | tail -1)
    code=$(printf '%s' "$json" | sed -n 's/.*"code":"\([0-9]*\)".*/\1/p')
    bytes=$(printf '%s' "$json" | sed -n 's/.*"bytes":\([0-9][0-9]*\).*/\1/p')
    [ -n "$bytes" ] || bytes=$(printf '%s' "$json" | sed -n 's/.*"bytes":"\([0-9][0-9]*\)".*/\1/p')
    [ -n "$bytes" ] || bytes=0
    if [ -n "$code" ] && [ "$code" != "000" ]; then
        printf '%s %s 0' "$code" "$bytes"
        return
    fi
    # veth может отсутствовать (BUG-04): пробуем output-очередь.
    # Последовательные аудиты одного хоста иногда оставляли stale-lock
    # предыдущего output-зонда, поэтому убираем его перед и после вызова.
    rm -rf /tmp/bcw_probe.lock
    json=$(client_probe_output "$host" 2>/dev/null | tail -1)
    rm -rf /tmp/bcw_probe.lock
    code=$(printf '%s' "$json" | sed -n 's/.*"code":"\([0-9]*\)".*/\1/p')
    bytes=$(printf '%s' "$json" | sed -n 's/.*"bytes":\([0-9][0-9]*\).*/\1/p')
    [ -n "$bytes" ] || bytes=$(printf '%s' "$json" | sed -n 's/.*"bytes":"\([0-9][0-9]*\)".*/\1/p')
    [ -n "$bytes" ] || bytes=0
    if [ -n "$code" ] && [ "$code" != "000" ]; then
        printf '%s %s 0' "$code" "$bytes"
        return
    fi
    printf '000 0 0'
}

# Диагностика: идёт ли домен через туннель (без остановки служб).
cmd_tunnel_check() {
    local d="${1:-youtube.com}" t
    t=$(scan_tunnel_service "$d")
    if [ -n "$t" ]; then
        printf '{"domain":"%s","tunneled":true,"via":"%s"}\n' "$d" "$t"
    else
        printf '{"domain":"%s","tunneled":false}\n' "$d"
    fi
}

cmd_youtube_audit() {
    local score=0 total=0 checks="" name url code bytes sec ok advice="ok" advice_text="всё в порядке"
    local qm qr i=0 _probe_timeout_old="$PROBE_TIMEOUT"
    # Аудит не должен висеть по 25 с на заблокированном API.
    PROBE_TIMEOUT=8
    # Сразу после restart/prepare движки поднимаются не мгновенно: без ожидания
    # аудит честно получает 000 и пугает пользователя ложной ошибкой.
    while [ "$i" -lt 10 ] && [ -z "$(our_engines)" ]; do
        sleep 1
        i=$((i + 1))
    done
    for pair in \
        "www|https://www.youtube.com/" \
        "img|https://i.ytimg.com/vi/dQw4w9WgXcQ/default.jpg" \
        "api|https://youtubei.googleapis.com/" \
        "cdn|https://redirector.googlevideo.com/report_mapping?di=no"; do
        name=${pair%%|*}; url=${pair#*|}
        set -- $(_yt_probe "$url")
        code="$1"; bytes="$2"; sec="$3"
        # На медленном канале первый запрос может не уложиться в таймаут —
        # повторяем один раз, прежде чем считать точку недоступной.
        if [ "$code" = "000" ]; then
            sleep 1
            set -- $(_yt_probe "$url")
            code="$1"; bytes="$2"; sec="$3"
        fi
        total=$((total + 1))
        local point_ok=0 point_reason=""
        if [ "$code" != "000" ] && [ -n "$code" ]; then point_ok=1; fi
        # 16 КБ cap: код 200, тело 14..32 КБ и ожидание — ТСПУ держит поток.
        if [ "$point_ok" = "1" ] && [ "$name" = "www" ]; then
            local b=${bytes:-0} s=${sec:-0}
            if [ "$b" -gt 0 ] && [ "$b" -lt 32768 ] && awk "BEGIN{exit !($s >= 5)}" 2>/dev/null; then
                point_ok=0; point_reason="cap16"
            elif [ "$b" -eq 0 ]; then
                point_ok=0; point_reason="zero_body"
            fi
        fi
        [ "$point_ok" = "1" ] && score=$((score + 1))
        checks="${checks:+$checks,}{\"name\":\"$name\",\"code\":\"$code\",\"bytes\":${bytes:-0},\"time\":${sec:-0},\"ok\":$([ "$point_ok" = "1" ] && echo true || echo false),\"reason\":\"$point_reason\"}"
        [ "$name" = "api" ] && [ "$code" = "000" ] && { advice="fix_ytapi"; advice_text="API YouTube не открывается — примените профиль YTApi"; }
        [ "$name" = "cdn" ] && [ "$code" = "000" ] && { advice="rescan_youtube"; advice_text="CDN YouTube не отвечает — запустите подбор заново"; }
        [ "$name" = "www" ] && [ "$point_reason" = "cap16" ] && { advice="rescan_youtube"; advice_text="ТСПУ обрывает поток YouTube на ~16 КБ — стратегия не держит поток, запустите подбор заново"; }
    done
    PROBE_TIMEOUT="$_probe_timeout_old"
    qm=$(uci -q get zapret2wizard.main.quic_mode); [ -n "$qm" ] || qm=auto
    qr=$(uci -q get firewall.reject_quic.enabled); [ -n "$qr" ] || qr=?
    ok=false
    [ "$score" -ge "$total" ] && ok=true
    printf '{"ok":%s,"score":%s,"total":%s,"advice":"%s","advice_text":"%s","checks":[%s],"quic":{"mode":"%s","reject":%s}}\n' \
        "$ok" "$score" "$total" "$advice" "$advice_text" "$checks" "$qm" "$qr"
}


# Полные аргументы генома (для копирования).
cmd_genome_args() {
    local id="$1"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"
    lua "$evo" args "$genomes" "$provider" "$id" 2>/dev/null
}

# Применить стратегию из генома к выбранному сервису.
cmd_genome_apply() {
    local id="$1"
    local target="${2:-preset_youtube}"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"

    local json=$(lua "$evo" args "$genomes" "$provider" "$id" 2>/dev/null)
    # аргументы без кавычек — берём до первой закрывающей кавычки
    local args=$(printf '%s' "$json" | sed -n 's/.*"args":"\([^"]*\)".*/\1/p')
    [ -n "$args" ] || { echo '{"ok":false,"error":"геном не найден"}'; return 1; }

    case "$target" in
        preset_youtube|youtube) sec="BlockcheckW_YouTube" ;;
        preset_discord|discord) sec="BlockcheckW_Discord" ;;
        preset_x|x)             sec="BlockcheckW_X" ;;
        preset_instagram|instagram) sec="BlockcheckW_Instagram" ;;
        preset_twitch|twitch)   sec="BlockcheckW_Twitch" ;;
        *)                      sec="BlockcheckW_General" ;;
    esac

    local pkg=$(_strategy_pkg)
    uci -q set "$pkg.$sec.script=$args" || { echo '{"ok":false,"error":"нет секции"}'; return 1; }
    uci -q commit "$pkg" || true

    # перезапуск в фоне: не блокируем интерфейс
    _svc_stop
    _svc_start_bg
    echo "{\"ok\":true,\"queued\":true,\"section\":\"$sec\",\"target\":\"$target\"}"
}

# Прочитать стратегию сервиса.
_strategy_section() {
    case "$1" in
        preset_youtube|youtube) echo "BlockcheckW_YouTube" ;;
        preset_discord|discord) echo "BlockcheckW_Discord" ;;
        preset_twitch|twitch) echo "BlockcheckW_Twitch" ;;
        preset_x|x) echo "BlockcheckW_X" ;;
        preset_instagram|instagram) echo "BlockcheckW_Instagram" ;;
        builtin|general|domains) echo "BlockcheckW_General" ;;
        *) echo "" ;;
    esac
}

cmd_strategy_get() {
    local target="$1"
    local sec=$(_strategy_section "$target")
    [ -n "$sec" ] || { echo '{"ok":false}'; return 1; }
    local pkg=$(_strategy_pkg)
    local sc=$(uci -q get "$pkg.$sec.script" 2>/dev/null)
    sc=$(printf '%s' "$sc" | sed 's/\\/\\\\/g; s/"/\\"/g')
    echo "{\"ok\":true,\"section\":\"$sec\",\"script\":\"$sc\"}"
}

# Записать свою стратегию nfqws2 и применить.
cmd_strategy_set() {
    local target="$1"
    shift
    local text="$*"
    # Переносы строк из форумных «простыней» — это просто пробелы между
    # аргументами: без нормализации они попадают в uci и ломают JSON панели.
    text=$(printf '%s' "$text" | tr '\n\r\t' '   ' | tr -s ' ' | sed 's/^ //; s/ $//')
    local sec=$(_strategy_section "$target")
    [ -n "$sec" ] || { echo '{"ok":false,"error":"неизвестный сервис"}'; return 1; }
    if ! printf '%s' "$text" | grep -q -- '--lua-desync\|--new'; then
        echo '{"ok":false,"error":"в стратегии нет --lua-desync"}'
        return 1
    fi
    local pkg=$(_strategy_pkg)
    uci -q set "$pkg.$sec.script=$text" || { echo '{"ok":false,"error":"не удалось записать"}'; return 1; }
    uci -q commit "$pkg" || true
    _svc_stop
    _svc_start_bg
    echo "{\"ok\":true,\"queued\":true,\"section\":\"$sec\"}"
}

# Статус эволюции для LuCI: провайдер, история, топ геномов.
cmd_evolve_status() {
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"
    local out
    out=$(lua "$evo" status "$genomes" "$provider" 2>/dev/null)
    [ -n "$out" ] || out='{"provider":"default","running":false,"history":[],"top":[]}'
    # Возраст журнала: UI продолжает опрос, пока журнал свежий, даже если
    # маркер PID по какой-то причине не читается (страховка от зависшего UI).
    local age=999
    if [ -f /tmp/bcw_evolve.log ]; then
        local mt=$(stat -c %Y /tmp/bcw_evolve.log 2>/dev/null || echo 0)
        [ "${mt:-0}" -gt 0 ] && age=$(( $(date +%s) - mt ))
    fi
    printf '%s' "$out" | sed "s/}$/,\"log_age_sec\":$age}/"
}

# Запуск эволюции в фоне (для кнопки в LuCI).
cmd_evolve_start() {
    local target="${1:-preset_youtube}"
    local confirm="${2:-0}"
    case "$confirm" in 1) ;; *) confirm=0 ;; esac
    rm -f /tmp/bcw_evolve_suggestion.json 2>/dev/null || true
    if [ -f /tmp/bcw_evolve.running ]; then
        local pid=$(cat /tmp/bcw_evolve.running 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo '{"success":false,"error":"Эволюция уже выполняется"}'
            return 1
        fi
        rm -f /tmp/bcw_evolve.running
    fi
    ( /usr/bin/blockcheckw-helper evolve --target "$target" --count 12 --verify 0 --tests 3 --sleep 2 --confirm "$confirm" >/tmp/bcw_evolve.log 2>&1 & ) || true
    sleep 1
    echo '{"success":true,"target":"'"$target"'","confirm":'"$confirm"'}'
}

# issue #12: предложение из эволюции (режим «спросить перед применением»).
cmd_evolve_suggestion() {
    if [ -s /tmp/bcw_evolve_suggestion.json ]; then
        cat /tmp/bcw_evolve_suggestion.json
    else
        echo '{"exists":false}'
    fi
}

cmd_evolve_suggestion_clear() {
    rm -f /tmp/bcw_evolve_suggestion.json 2>/dev/null || true
    echo '{"ok":true,"cleared":true}'
}

cmd_evolve_suggestion_apply() {
    local f="/tmp/bcw_evolve_suggestion.json"
    [ -s "$f" ] || { echo '{"success":false,"error":"нет предложения"} '; return 1; }
    local target args
    target=$(lua -e 'local j=require("luci.jsonc"); local f=io.open("/tmp/bcw_evolve_suggestion.json","r"); if not f then return end; local ok,d=pcall(j.parse,f:read("*a")); f:close(); if ok and d then print(d.target or "") end' 2>/dev/null)
    args=$(lua -e 'local j=require("luci.jsonc"); local f=io.open("/tmp/bcw_evolve_suggestion.json","r"); if not f then return end; local ok,d=pcall(j.parse,f:read("*a")); f:close(); if ok and d then print(d.args or "") end' 2>/dev/null)
    if [ -z "$target" ] || [ -z "$args" ]; then
        echo '{"success":false,"error":"предложение повреждено"}'; return 1
    fi
    rm -f "$f" 2>/dev/null || true
    cmd_apply_bg --target "$target" --script "$args"
}

# Ночное самообучение: один прогон в сутки, цель выбирается по дню.
# Подбор/эволюция/health-тест не должны пересекаться: каждый из них
# останавливает службу и запускает свой сканер.
scan_busy() {
    local p
    if [ -d /var/run/bcw_scan.lock ]; then
        p=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        [ -n "$p" ] || { sleep 1; p=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null); }
        if [ -n "$p" ] && _scan_lock_alive "$p"; then return 0; fi
        [ -n "$p" ] && kill -9 "$p" 2>/dev/null
        rm -rf /var/run/bcw_scan.lock 2>/dev/null
    fi
    if [ -f /tmp/bcw_evolve.running ]; then
        p=$(cat /tmp/bcw_evolve.running 2>/dev/null)
        if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then return 0; fi
        rm -f /tmp/bcw_evolve.running 2>/dev/null
    fi
    ps w 2>/dev/null | grep -qE '[b]lockcheckw-helper (start|apply) ' && return 0
    return 1
}
cmd_evolve_nightly() {
    [ ! -e /var/run/bcw_service.stopped ] || { echo '{"skipped":true,"reason":"service stopped"}'; return 0; }
    local marker="/etc/zapret2wizard/.evolve_last"
    local today=$(date +%Y-%m-%d)
    if [ -f "$marker" ] && [ "$(cat "$marker" 2>/dev/null)" = "$today" ]; then
        echo '{"skipped":true,"reason":"already ran today"}'
        return 0
    fi

    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"

    # «свободный канал»: по дню выбираем сервис с наименьшим числом проверок
    local doy=$(date +%j | sed 's/^0*//')
    local target="preset_youtube"
    case $((doy % 3)) in
        1) target="preset_discord" ;;
        2) target="preset_youtube" ;;
        *) target="preset_youtube" ;;
    esac

    if scan_busy || [ -f /tmp/bcw_scan_paused ]; then
        echo '{"skipped":true,"reason":"busy"}'
        return 0
    fi

    # Адаптивность: если сервис сейчас здоров — ночью не трогаем (кроме воскресенья).
    cmd_test "$target" "" > /tmp/bcw_night_test.json 2>/dev/null
    local healthy=0
    grep -q '"all_ok":true' /tmp/bcw_night_test.json && healthy=1
    rm -f /tmp/bcw_night_test.json
    local dow=$(date +%u)
    if [ "$healthy" = "1" ] && [ "$dow" != "7" ]; then
        echo '{"skipped":true,"reason":"service healthy"}'
        return 0
    fi

    mkdir -p /etc/zapret2wizard 2>/dev/null || true
    echo "$today" > "$marker"

    echo "{\"started\":true,\"target\":\"$target\",\"provider\":\"$provider\",\"healthy\":$healthy}"
    /usr/bin/blockcheckw-helper evolve --target "$target" --count 8 --verify 0 --tests 2 --sleep 2 >>/tmp/bcw_evolve.log 2>&1
}

# Установка cron-задачи ночного самообучения.
cmd_cron_install() {
    local cron_dir="/etc/crontabs"
    local cron_file="$cron_dir/root"
    local line="10 6 * * * /usr/bin/blockcheckw-helper evolve_nightly >/dev/null 2>&1 # bcw-evolve"
    mkdir -p "$cron_dir" 2>/dev/null || true
    touch "$cron_file" 2>/dev/null || true
    # Чистим старые задачи (bypass_sync из 0.19.x, прежнее время эволюции),
    # иначе они продолжают дёргать helper каждые 2 минуты после обновления.
    sed -i '/bcw-bypass/d;/bcw-health/d;/bcw-evolve/d' "$cron_file" 2>/dev/null || true
    echo "$line" >> "$cron_file"
    echo "*/30 * * * * /usr/bin/blockcheckw-helper health_tick >/dev/null 2>&1 # bcw-health" >> "$cron_file"
    /etc/init.d/cron enable >/dev/null 2>&1 || true
    /etc/init.d/cron restart >/dev/null 2>&1 || true
    echo '{"success":true}'
}

# Первый запуск: если стратегий нет — подобрать для YouTube и Discord.
# Empty installation or exactly the generated Instagram profile; read failure is unknown.
autosetup_needed() {
    local cfg sec
    cfg=$(uci -q show zapret2wizard 2>/dev/null) || return 2
    for sec in $(printf '%s\n' "$cfg" | sed -n 's/^zapret2wizard\.\([^.=]*\)=strategy$/\1/p'); do
        [ "$sec" = BlockcheckW_Instagram ] || return 1
        [ "$(uci -q get zapret2wizard.$sec.script)" = "$(default_instagram_script)" ] || return 1
        [ "$(uci -q get zapret2wizard.$sec.enabled)" = 1 ] || return 1
        [ "$(uci -q get zapret2wizard.$sec.port)" = 443 ] || return 1
        [ "$(uci -q get zapret2wizard.$sec.protocol)" = tcp ] || return 1
        [ "$(uci -q get zapret2wizard.$sec.hostlist)" = list_hosts_instagram ] || return 1
    done
    return 0
}
cmd_autosetup() {
    local cfg eligibility=0
    if [ "${1:-}" = --if-needed ]; then
        autosetup_needed; eligibility=$?
        if [ "$eligibility" = 1 ]; then
            echo '{"success":true,"skipped":true,"reason":"existing configuration"}'
            return 0
        elif [ "$eligibility" != 0 ]; then
            echo '{"success":false,"error":"configuration unreadable"}'
            return 1
        fi
    fi
    cfg=$(uci -q show zapret2wizard 2>/dev/null) || { echo '{"success":false,"error":"configuration unreadable"}'; return 1; }
    ensure_all_hostlists >/dev/null 2>&1 || true
    _svc_start_bg
    local log="/tmp/bcw_autosetup.log" target section all_ok=true started=0
    echo "[autosetup] старт $(date)" > "$log"
    for target in preset_youtube preset_discord; do
        case "$target" in preset_youtube) section=BlockcheckW_YouTube ;; *) section=BlockcheckW_Discord ;; esac
        printf '%s\n' "$cfg" | grep -qE "^zapret2wizard\.${section}(_[0-9]+)?=strategy$" && continue
        started=$((started + 1))
        echo "[autosetup] подбор для $target" >> "$log"
        if ! cmd_start --target "$target" --mode smart --circular 1 --auto-apply 1 >> "$log" 2>&1; then
            all_ok=false
            continue
        fi
        local i=0 st=""
        while [ "$i" -lt 80 ]; do
            sleep 15
            i=$((i + 1))
            st=$(grep -o '"status": *"[a-z]*"' "$STATUS_FILE" 2>/dev/null | head -n 1 | sed 's/.*"\([a-z]*\)"$/\1/')
            case "$st" in done|error) break ;; esac
        done
        [ "$st" = done ] && grep -q '"auto_applied":true' "$STATUS_FILE" || all_ok=false
        echo "[autosetup] $target завершён: ${st:-timeout}" >> "$log"
    done
    _svc_start_bg
    local done_n
    cfg=$(uci -q show zapret2wizard 2>/dev/null) || { echo '{"success":false,"error":"configuration unreadable"}'; return 1; }
    done_n=$(printf '%s\n' "$cfg" | grep -c '=strategy$')
    echo "{\"success\":$all_ok,\"strategies\":$done_n,\"started\":$started}"
    [ "$all_ok" = true ]
}

# Эволюционный подбор: синтезирует новые комбинации примитивов zapret2,
# проверяет их и запоминает результаты по провайдеру между запусками.
# Public actions use init/procd; scanner-only _svc_stop remains isolated.
lifecycle_load() {
    local module="${BCW_LIFECYCLE_ROOT:-}/usr/share/zapret2wizard/lifecycle.sh"
    [ -r "$module" ] && . "$module" && return 0
    echo '{"success":false,"ok":false,"error":"lifecycle module missing"}'
    return 1
}
cmd_service() {
    local action="${1:-status}" state
    case "$action" in
        start|restart|stop)
            if scan_busy; then
                echo '{"ok":false,"success":false,"error":"scanner is active"}'
                return 1
            fi
            lifecycle_load || return 1
            if bcw_lifecycle_service "$action"; then
                state=running; [ "$action" != stop ] || state=stopped
                printf '{"ok":true,"success":true,"service":"%s"}\n' "$state"
            else
                printf '{"ok":false,"success":false,"service":"unknown","error":"%s"}\n' "${BCW_LIFECYCLE_ERROR:-lifecycle failed}"
                return 1
            fi
            ;;
        *) get_dpi_service_status | sed 's/^/{"service":"/; s/$/"}/' ;;
    esac
}

# Провайдер для эволюции: активный статус может быть пустым/auto_unknown.
# В этом случае берём реальный ASN, чтобы геномы копились в AS12389, а не
# в необщей секции auto_unknown.
evolve_provider() {
    local p
    p=$(lua /usr/share/zapret2wizard/evolve.lua provider /tmp/blockcheckw_status.json 2>/dev/null)
    case "$p" in
        ""|auto_*|"unknown"|"default")
            p=$(cmd_asn 2>/dev/null)
            ;;
    esac
    [ -n "$p" ] || p="AS0"
    echo "$p"
}

cmd_evolve() (
    local target="preset_youtube" count=16 verify_n=0 tests=3 pause=2 confirm=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --count) count="$2"; shift 2 ;;
            --verify) verify_n="$2"; shift 2 ;;
            --tests) tests="$2"; shift 2 ;;
            --sleep) pause="$2"; shift 2 ;;
            --confirm) confirm="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    case "$confirm" in 1) ;; *) confirm=0 ;; esac

    local domain="www.youtube.com"
    case "$target" in
        preset_discord|discord) domain="discord.com" ;;
        preset_twitch|twitch) domain="twitch.tv" ;;
        preset_x|x) domain="x.com" ;;
        preset_instagram|instagram) domain="instagram.com" ;;
    esac

    local evo="/usr/share/zapret2wizard/evolve.lua"
    if [ ! -f "$evo" ]; then
        echo '{"success":false,"error":"нет evolve.lua - переустановите службу"}'
        return 1
    fi

    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(evolve_provider)
    [ -n "$provider" ] || provider="default"

    local report_run=""
    local corpus scan verified

    # Эволюция тоже останавливает службу и запускает сканер: без лока она',
    # пересекается с ручным подбором (ровно этот баг ловили на живом роутере).
    if scan_busy; then
        echo '{"success":false,"error":"уже идёт подбор или эволюция"}'
        return 1
    fi
    if ! mkdir /var/run/bcw_scan.lock 2>/dev/null; then
        echo '{"success":false,"error":"уже идёт подбор или эволюция"}'
        return 1
    fi
    report_run=$(bcw_report_run_create) || { rmdir /var/run/bcw_scan.lock; return 1; }
    corpus="$report_run/corpus.txt"
    scan="$report_run/scan.json"
    verified="$report_run/verified.txt"
    echo $$ > /var/run/bcw_scan.lock/pid 2>/dev/null || true
    echo $$ > /tmp/bcw_evolve.running 2>/dev/null || true
    trap 'rm -f /tmp/bcw_evolve.running /tmp/bcw_evolve.progress /tmp/bcw_evolve.hb.* /tmp/bcw_evolve_cfg.* 2>/dev/null; rm -rf "$report_run" /var/run/bcw_scan.lock; _svc_running || _svc_start_bg' EXIT
    trap 'exit 1' INT TERM

    # Прогресс для UI и читаемый журнал: [HH:MM:SS] этапы, счётчик кандидатов,
    # ETA и heartbeat, чтобы было видно, что прогон не завис.
    local evo_t0=$(date +%s 2>/dev/null || echo 0)
    local evo_prog="/tmp/bcw_evolve.progress"
    local evo_tag=$(date +%s 2>/dev/null || echo 0)
    local evo_cfg_snap="/tmp/bcw_evolve_cfg.$evo_tag"
    _evo_ts() { date '+%H:%M:%S' 2>/dev/null || echo '--:--:--'; }
    rm -f /tmp/bcw_evolve_suggestion.json 2>/dev/null || true
    _evo_phase() { echo "[$(_evo_ts)] == $* =="; printf 'phase=%s\ndone=\ntotal=\n' "$*" > "$evo_prog" 2>/dev/null || true; }
    _evo_track() { printf 'phase=%s\ndone=%s\ntotal=%s\n' "${1:-}" "${2:-}" "${3:-}" > "$evo_prog" 2>/dev/null || true; }

    echo "=== Эволюционный подбор · $(date '+%d.%m %H:%M:%S') ==="
    echo "  провайдер:  $provider"
    echo "  домен:      $domain"
    echo "  кандидатов: $count, проверка до $verify_n, тестов на стабильность: $tests"
    echo "  Фоновый прогон: страницу закрывать не нужно, журнал обновляется каждые 4 с."
    echo "  Длительность: генерация и TLS-проба ~1–3 мин, затем проверка 2–4 мин на кандидата"
    echo "  (зависит от числа тестов; при 12 кандидатах и 3 тестах — обычно 20–40 минут)."
    _evo_phase "генерация кандидатов (память + подсев последнего поиска)"

    if _svc_running; then
        _svc_stop
    fi
    : > /tmp/bcw_scan_paused

    local gen_out gen_err=/tmp/bcw_evolve_gen.err
    gen_out=$(lua "$evo" gen "$genomes" "$provider" "$corpus" "$domain" "$count" 2>"$gen_err")
    if [ ! -s "$corpus" ]; then
        # один ретрай: генератор мог упасть на кривом геноме в памяти
        sleep 1
        gen_out=$(lua "$evo" gen "$genomes" "$provider" "$corpus" "$domain" "$count" 2>>"$gen_err")
    fi
    local gen_count=$(printf '%s' "$gen_out" | grep -o '"generated":[0-9]*' | head -n 1 | cut -d: -f2)
    local gen_crossed=$(printf '%s' "$gen_out" | grep -o '"crossed":[0-9]*' | head -n 1 | cut -d: -f2)
    local gen_exploit=$(printf '%s' "$gen_out" | grep -o '"exploit":[0-9]*' | head -n 1 | cut -d: -f2)
    [ -n "$gen_count" ] || gen_count=$count
    [ -n "$gen_crossed" ] || gen_crossed=0
    [ -n "$gen_exploit" ] || gen_exploit=0
    if [ ! -s "$corpus" ]; then
        local gerr=$(tail -n 2 "$gen_err" 2>/dev/null | tr '\n' ' ' | tr -d '"')
        echo "  ОШИБКА: не удалось сгенерировать кандидатов"
        [ -n "$gerr" ] && echo "  причина: $gerr"
        echo "[evolve] gen failed: $gerr" >> /tmp/bcw_evolve.log
        _svc_start_bg
        rm -f /tmp/bcw_scan_paused
        return 1
    fi

    # Подсеваем проверенные стратегии из последнего поиска: эволюция не должна
    # стартовать с нуля и обязана иметь заведомо рабочие кандидаты.
    # Текущая применённая стратегия — всегда в корпусе эволюции: это
    # заведомо рабочая база, и отчёт не должен говорить «0 рабочих»,
    # когда в конфиге стоит работающая стратегия (issue #11).
    local applied_script="" _apkg _asec
    _apkg=$(_strategy_pkg)
    _asec=$(_strategy_section "$target")
    [ -n "$_asec" ] && applied_script=$(uci -q get "$_apkg.$_asec.script" 2>/dev/null)
    if [ -s "$OUTPUT_SCAN" ] || [ -n "$applied_script" ]; then
        lua - "$OUTPUT_SCAN" "$corpus" "$corpus.candidates" "$domain" "$applied_script" << 'EVOSEED' 2>/dev/null
local json = require("luci.jsonc")
local scan_path, corpus_path, cand_path, domain, applied = arg[1], arg[2], arg[3], arg[4], arg[5] or ""
local function hash(s)
    local h = 5381
    for i = 1, #s do h = (h * 31 + s:byte(i)) % 2147483647 end
    return string.format("%08x", math.floor(h))
end
local cands = {}
local cf = io.open(cand_path, "r")
if cf then cands = json.parse(cf:read("*a")) or {}; cf:close() end
if type(cands) ~= "table" then cands = {} end
local seen = {}
for _, c in ipairs(cands) do seen[c.args] = true end
local out = io.open(corpus_path, "a")
local function push(a, front)
    if type(a) ~= "string" or a == "" then return false end
    a = a:gsub("^%s+", ""):gsub("%s+$", "")
    if a:sub(1, 2) ~= "--" or seen[a] then return false end
    seen[a] = true
    if out then out:write("curl_test_https_tls13 ipv4 ", domain, " : nfqws2 ", a, "\n") end
    local item = { id = hash(a), args = a }
    if front then table.insert(cands, 1, item) else cands[#cands + 1] = item end
    return true
end
-- применённая стратегия проверяется первой (известная рабочая база)
push(applied, true)
local sf = io.open(scan_path, "r")
if sf then
    local d = json.parse(sf:read("*a")) or {}
    sf:close()
    local added = 0
    for _, s in ipairs(d.strategies or {}) do
        local a = (type(s) == "table" and s.args) or s
        if push(a) then
            added = added + 1
            if added >= 6 then break end
        end
    end
end
if out then out:close() end
local wf = io.open(cand_path, "w")
if wf then wf:write(json.stringify(cands)); wf:close() end
EVOSEED
    fi

    local evo_qnum=$(pick_scan_qnum)
    local evo_home="$report_run/home"
    mkdir "$evo_home" || return 1
    echo "  кандидатов в корпусе: $(wc -l < "$corpus" 2>/dev/null || echo "?")"
    _evo_phase "TLS-проба кандидатов (scan, очередь $evo_qnum) — обычно 1–2 мин"
    BCW_REPORT_DIR="$report_run/evolve" HOME="$evo_home" /usr/bin/blockcheckw --qnum "$evo_qnum" -w 2 scan -d "$domain" -p tls12,tls13 --dns "$(scan_dns_mode "$domain")" \
        --from-file "$corpus" -o "$scan" --auto --timeout 600 >"$report_run/scan.log" 2>&1
    local scan_rc=$?
    [ "$scan_rc" = 0 ] || { echo "  ОШИБКА: проба завершилась с кодом $scan_rc"; return 1; }
    # scan пишет либо JSON, либо текстовый список "--payload=..." — считаем оба
    local scan_found=$(grep -c '^--' "$scan" 2>/dev/null)
    [ "${scan_found:-0}" -eq 0 ] && scan_found=$(grep -o '"args"' "$scan" 2>/dev/null | wc -l)
    echo "[$(_evo_ts)] проба готова: стратегий прошло $scan_found"
    if [ "$scan_found" -eq 0 ]; then
        echo "  ВНИМАНИЕ: проба не нашла рабочих кандидатов — память не пополнится"
    fi

    # issue #9d: по умолчанию проверяем ВСЕХ прошедших пробу (не топ-3):
    # подтверждение включает объёмный гейт, а итог ранжируется по добытым
    # байтам. Ограничиваем 12 кандидатами, чтобы ночной прогон укладывался.
    local verify_n_eff=$verify_n verify_all_stage=0
    if [ "${verify_n_eff:-0}" -le 0 ]; then
        verify_all_stage=1
        verify_n_eff=$scan_found
        [ "$verify_n_eff" -gt 12 ] && verify_n_eff=12
        [ "$verify_n_eff" -lt 1 ] && verify_n_eff=1
    fi
    echo "[$(_evo_ts)] проверка кандидатов: $verify_n_eff (применение + тест + объёмный гейт по очереди)"
    _evo_phase "проверка кандидатов 0/$verify_n_eff"

    local shortlist
    shortlist=$(lua "$evo" shortlist "$corpus.candidates" "$scan" "$verify_n_eff" 2>/dev/null)

    local verified_lines="" applied=0 stable_count=0 best_args="" best_bytes=0
    local tried_total=0 tried_done=0
    [ -n "$shortlist" ] && tried_total=$(printf '%s\n' "$shortlist" | grep -c '|')
    [ "${tried_total:-0}" -gt 0 ] || tried_total=$verify_n_eff
    # Утилиты прогона вынесены в функции: так их можно подменить в офлайн-тестах.
    _timed_apply() {
        local _to="$1"; shift
        if [ "${BCW_EVOLVE_NO_TIMEOUT:-}" = "1" ]; then cmd_apply "$@"; return $?; fi
        timeout "$_to" /usr/bin/blockcheckw-helper apply "$@" 2>/dev/null
    }
    _timed_test() {
        local _to="$1"; shift
        if [ "${BCW_EVOLVE_NO_TIMEOUT:-}" = "1" ]; then cmd_test "$@"; return $?; fi
        timeout "$_to" /usr/bin/blockcheckw-helper test "$@" 2>/dev/null
    }
    # снимок рабочего конфига: кандидат с зависшей проверкой не должен
    # оставлять систему с недоприменённой стратегией
    _evo_cfg_snapshot() { cp -f "/etc/config/$(_strategy_pkg)" "$evo_cfg_snap" 2>/dev/null || true; }
    _evo_cfg_snapshot
    local apply_timeout=300
    while IFS='|' read -r id args; do
        [ -n "$id" ] || continue
        [ -n "$args" ] || continue
        printf '%s\n' "$args" > "$report_run/try.txt"
        tried_done=$((tried_done + 1))
        local cand_t0=$(date +%s 2>/dev/null || echo 0)
        if [ "$tried_done" -le "$tried_total" ]; then
            _evo_track "проверка кандидата $tried_done/$tried_total" "$tried_done" "$tried_total"
        fi
        echo "[$(_evo_ts)] [$tried_done/$tried_total] проверяю: $(printf '%s' "$args" | cut -c1-110)"
        : > /tmp/bcw_evolve.hb.$evo_tag.$tried_done
        ( while [ -f /tmp/bcw_evolve.hb.$evo_tag.$tried_done ]; do sleep 20; [ -f /tmp/bcw_evolve.hb.$evo_tag.$tried_done ] && echo "[$(_evo_ts)] … кандидат $tried_done/$tried_total ещё проверяется ($(( $(date +%s) - cand_t0 ))с)"; done ) &
        local hb_pid=$!
        local res okruns=0 minbytes=0 t=0 apply_rc
        res=$(_timed_apply "$apply_timeout" --target "$target" --file "$report_run/try.txt")
        apply_rc=$?
        rm -f /tmp/bcw_evolve.hb.$evo_tag.$tried_done
        kill "$hb_pid" 2>/dev/null
        wait "$hb_pid" 2>/dev/null
        if [ "$apply_rc" = "124" ] || [ "$apply_rc" = "143" ]; then
            # Проверка кандидата не уложилась в лимит: не вешаем весь прогон.
            # Возвращаем снимок рабочего конфига и идём дальше.
            echo "[$(_evo_ts)] ⏱ кандидат $tried_done/$tried_total не уложился в $apply_timeout с — пропускаю, восстанавливаю конфиг"
            if [ -s "$evo_cfg_snap" ]; then
                cp -f "$evo_cfg_snap" "/etc/config/$(_strategy_pkg)" 2>/dev/null || true
                uci -q commit "$(_strategy_pkg)" 2>/dev/null || true
                /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
            fi
            ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
            wait_dpi_ready 20
            verified_lines="${verified_lines}${id}|0|0|0|0
"
            continue
        fi
        if [ "$apply_rc" != 0 ] || ! bcw_apply_accepted "$res" "$target" "$args"; then
            verified_lines="${verified_lines}${id}|0|0|0|0
"
            echo "[$(_evo_ts)] --   применение не подтверждено за $(( $(date +%s) - cand_t0 ))с · $args"
            continue
        fi
        local b
        b=$(printf '%s' "$res" | grep -o '"size_bytes":[0-9]*' | head -n 1 | cut -d: -f2)
        [ -n "$b" ] && minbytes=$b

        # серия замеров: стабильность важнее одного удачного ответа
        while [ "$t" -lt "$tests" ]; do
            t=$((t + 1))
            local r s
            r=$(_timed_test 240 "$target" "" | tail -n 1)
            s=$(printf '%s' "$r" | grep -o '"size_bytes":[0-9]*' | head -n 1 | cut -d: -f2)
            if printf '%s' "$r" | grep -q '"all_ok":true'; then
                okruns=$((okruns + 1))
                if [ -n "$s" ] && { [ "$minbytes" -eq 0 ] || [ "$s" -lt "$minbytes" ]; }; then
                    minbytes=$s
                fi
            fi
            [ "$t" -lt "$tests" ] && sleep "$pause"
        done

        local stable=0
        [ $((okruns * 2)) -ge "$tests" ] && stable=1
        [ "$stable" = "1" ] && stable_count=$((stable_count + 1))
        verified_lines="${verified_lines}${id}|${stable}|${minbytes}|${tests}|${okruns}
"
        if [ "$stable" = "1" ]; then
            echo "[$(_evo_ts)] OK   ${okruns}/${tests} · ${minbytes} Б за $(( $(date +%s) - cand_t0 ))с · $args"
            # запоминаем лучший стабильный, но продолжаем собирать данные
            if [ "$applied" = "0" ] || [ "$minbytes" -gt "${best_bytes:-0}" ]; then
                applied=1
                best_bytes=$minbytes
                best_args="$args"
            fi
        else
            echo "[$(_evo_ts)] --   ${okruns}/${tests} · ${minbytes} Б за $(( $(date +%s) - cand_t0 ))с · $args"
        fi
    done <<EVOLIST
$shortlist
EVOLIST
    rm -f "$report_run/try.txt"
    printf '%s' "$verified_lines" > "$verified"

    # применяем лучший стабильный кандидат (если он не последний применённый)
    if [ "$applied" = "1" ] && [ -n "$best_args" ]; then
        if [ "$confirm" = "1" ]; then
            # issue #12: режим «спросить перед применением». Кандидаты
            # временно применялись при проверке — возвращаем рабочую
            # конфигурацию прогона и сохраняем предложение для UI.
            if [ -s "$evo_cfg_snap" ]; then
                cp -f "$evo_cfg_snap" "/etc/config/$(_strategy_pkg)" 2>/dev/null || true
                uci -q commit "$(_strategy_pkg)" 2>/dev/null || true
                /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
            fi
            ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
            wait_dpi_ready 20
            lua - "$target" "$best_args" "$best_bytes" "$stable_count" "$tried_total" <<'LUA' > /tmp/bcw_evolve_suggestion.json 2>/dev/null
local j = require("luci.jsonc")
local function h(s) local x = 5381; for i = 1, #s do x = (x * 31 + s:byte(i)) % 2147483647 end; return string.format("%08x", math.floor(x)) end
print(j.stringify({exists = true, target = arg[1], args = arg[2], bytes = tonumber(arg[3]) or 0,
    stable = tonumber(arg[4]) or 0, checked = tonumber(arg[5]) or 0, ts = os.time(), id = h(arg[2] or "")}))
LUA
            echo "[$(_evo_ts)] найдена стратегия — ожидает подтверждения (применение отложено)"
        else
            printf '%s\n' "$best_args" > "$report_run/best.txt"
            local best_res best_rc
            best_res=$(_timed_apply "$apply_timeout" --target "$target" --file "$report_run/best.txt")
            best_rc=$?
            rm -f "$report_run/best.txt"
            if [ "$best_rc" != 0 ] || ! bcw_apply_accepted "$best_res" "$target" "$best_args"; then
                applied=0
                best_args=""
                echo "  ОШИБКА: повторное применение победителя не подтверждено — память не обновлена"
                _svc_start_bg
                rm -f /tmp/bcw_scan_paused
                return 1
            fi
        fi
    fi

    local stats
    stats=$(lua "$evo" update "$genomes" "$provider" "$corpus.candidates" "$scan" "$verified" 2>/dev/null)
    echo "  память: $stats"

    local stats_file="/tmp/bcw_evolve_stats.txt"
    {
        echo "generated=$gen_count"
        echo "crossed=$gen_crossed"
        echo "exploit=$gen_exploit"
        echo "stable=$stable_count"
        echo "applied=$best_args"
    } > "$stats_file"
    lua "$evo" history "$genomes" "$provider" "$stats_file" >/dev/null 2>&1 || true
    rm -f "$stats_file"

    _svc_start_bg
    rm -f /tmp/bcw_scan_paused

    # API приложения YouTube (youtubei) — отдельный SNI и отдельный профиль:
    # после прогона один раз проверяем/чиним, чтобы «на ПК работает,
    # на телефоне нет» не осталось незамеченным.
    if [ "$target" = "preset_youtube" ]; then
        local _ytapi_fix
        _ytapi_fix=$(cmd_fix_ytapi --deep 2>/dev/null | tail -n 1)
        case "$_ytapi_fix" in
            *'"success":true'*) echo "[$(_evo_ts)] API YouTube (youtubei): в порядке" ;;
            *'"success":false'*) echo "[$(_evo_ts)] API YouTube (youtubei): открыть не удалось — видео может идти, приложение YouTube — нет" ;;
        esac
    fi

    local _evo_sec=$(( $(date +%s) - evo_t0 ))
    _evo_phase "готово"
    echo "---"
    echo "Итог: прошло $(( _evo_sec / 60 ))м $(( _evo_sec % 60 ))с; проверено кандидатов $tried_done/$tried_total; стабильных $stable_count."
    if [ "$applied" = "1" ] && [ "$confirm" = "1" ] && [ -s /tmp/bcw_evolve_suggestion.json ]; then
        _evo_phase "ожидает подтверждения"
        echo "Найдена стратегия — ждёт подтверждения в панели (применить или оставить текущую). Память: $genomes"
    elif [ "$applied" = "1" ]; then
        echo "Применена новая стратегия. Память: $genomes"
    else
        echo "Рабочих кандидатов не найдено. Память обновлена."
    fi
)

cmd_info() {
    ensure_dpi_service
    # Списки догружаем в фоне: сеть может быть недоступна, а интерфейс ждать не должен.
    if ! _hostlists_ready 2>/dev/null; then
        if [ ! -f /tmp/bcw_ensuring ]; then
            : > /tmp/bcw_ensuring
            start-stop-daemon -S -b -x /usr/bin/blockcheckw-helper -- ensure_hostlists_bg >/dev/null 2>&1 \
                || ( /usr/bin/blockcheckw-helper ensure_hostlists_bg >/dev/null 2>&1 & )
        fi
    fi
    local zapret_running=$(get_dpi_service_status)

    # На минимальных сборках OpenWrt нет Lua-модуля uci — тогда отчёт собираем через uci CLI.
    if ! lua -e 'require("uci")' >/dev/null 2>&1; then
        _info_json_shell
        return 0
    fi

    BCW_HOSTLISTS_JSON="$(_hl_info_json)" lua -e '
        local uci = require("uci").cursor()
        local json = require("luci.jsonc")

        local res = {
            zapret2_running = "'"$zapret_running"'",
            nft_table = ("'"$(nft list table inet zapret2wizard >/dev/null 2>&1 && echo true || echo false)"'" == "true"),
            services = {}
        }

        local cfg = "zapret2wizard"
        if not uci:get(cfg, "main") then
            cfg = "zapret2"
        end

        local vf = io.open("'"$VERSION_FILE"'", "r")
        if vf then
            local vj = json.parse(vf:read("*a"))
            vf:close()
            if vj then
                res.version = vj.version
                res.changelog = vj.changelog
            end
        end
        if not res.version then res.version = "0.15.12" end

        res.hostlists = json.parse(os.getenv("BCW_HOSTLISTS_JSON") or "[]") or {}

        local all_strats = {}
        uci:foreach(cfg, "strategy", function(s)
            local name = s[".name"]
            if name then
                table.insert(all_strats, {
                    section = name,
                    enabled = (s.enabled == "1" or s.enabled == 1),
                    port = s.port or "443",
                    script = s.script or "",
                    is_circular = (s.script and s.script:find("circular") ~= nil) or false
                })
            end
        end)
        if #all_strats == 0 and cfg ~= "zapret2" then
            uci:foreach("zapret2", "strategy", function(s)
                local name = s[".name"]
                if name then
                    table.insert(all_strats, {
                        section = name,
                        enabled = (s.enabled == "1" or s.enabled == 1),
                        port = s.port or "443",
                        script = s.script or "",
                        is_circular = (s.script and s.script:find("circular") ~= nil) or false
                    })
                end
            end)
        end
        res.all_strategies = all_strats

        local targets = {
            builtin = { base = "BlockcheckW_General", fallback = "Routerich_circular", name = "Встроенные хосты (33)" },
            general = { base = "BlockcheckW_General", fallback = "Routerich_circular", name = "Встроенные хосты (33)" },
            preset_youtube = { base = "BlockcheckW_YouTube", fallback = "MyTube", name = "Предустановленный список YouTube (3)" },
            youtube = { base = "BlockcheckW_YouTube", fallback = "MyTube", name = "YouTube" },
            preset_discord = { base = "BlockcheckW_Discord", fallback = "Discord_circular", name = "Предустановленный список Discord (3)" },
            discord = { base = "BlockcheckW_Discord", fallback = "Discord_circular", name = "Discord" },
            preset_twitch = { base = "BlockcheckW_Twitch", name = "Предустановленный список Twitch (3)" },
            twitch = { base = "BlockcheckW_Twitch", name = "Twitch" },
            preset_x = { base = "BlockcheckW_X", name = "Предустановленный список X (3)" },
            x = { base = "BlockcheckW_X", name = "X (Twitter)" },
            preset_instagram = { base = "BlockcheckW_Instagram", name = "Предустановленный список Instagram (2)" },
            instagram = { base = "BlockcheckW_Instagram", name = "Instagram" },
            preset_youtubei = { base = "YTApi", name = "YouTube API" },
            youtubei = { base = "YTApi", name = "YouTube API" },
            tcp16 = { base = "BlockcheckW_TCP16", name = "Лимит данных (16 КБ)" },
            domains = { base = "BlockcheckW_Custom", name = "Свои домены" },
            custom = { base = "BlockcheckW_Custom", name = "Свои домены" },
            test_strategy = { base = "BlockcheckW_General", name = "Тест стратегии" }
        }

        for key, info in pairs(targets) do
            local base = info.base
            local fallback = info.fallback

            local matching = {}
            for _, st in ipairs(all_strats) do
                if st.section == base or st.section:match("^" .. base .. "_%d+$") then
                    table.insert(matching, st)
                elseif fallback and st.section == fallback then
                    table.insert(matching, st)
                end
            end

            table.sort(matching, function(a, b)
                local num_a = tonumber(a.section:match("_(%d+)$")) or (a.section == base and 1 or 0)
                local num_b = tonumber(b.section:match("_(%d+)$")) or (b.section == base and 1 or 0)
                return num_a > num_b
            end)

            local active = nil
            for _, st in ipairs(matching) do
                if st.enabled then
                    active = st
                    break
                end
            end
            if not active and #matching > 0 then
                active = matching[1]
            end

            local vers = {}
            for _, m in ipairs(matching) do
                table.insert(vers, {
                    section = m.section,
                    enabled = m.enabled,
                    port = m.port,
                    is_circular = m.is_circular,
                    script = m.script
                })
            end

            if active then
                res.services[key] = {
                    section = active.section,
                    name = info.name,
                    enabled = active.enabled,
                    port = active.port,
                    script = active.script,
                    is_circular = active.is_circular,
                    versions_count = #vers,
                    versions = vers
                }
            else
                res.services[key] = {
                    section = base,
                    name = info.name,
                    enabled = false,
                    port = "443",
                    script = "",
                    is_circular = false,
                    versions_count = 0,
                    versions = {}
                }
            end

            if (key == "preset_discord" or key == "discord") and res.services[key] then
                res.services[key].dual_circuit = true
                local voice_active = nil
                for _, st in ipairs(all_strats) do
                    if st.section:match("^BlockcheckW_Discord_Voice") and st.enabled then
                        voice_active = st
                        break
                    end
                end
                if not voice_active then
                    for _, st in ipairs(all_strats) do
                        if st.section:match("^BlockcheckW_Discord_Voice") then
                            voice_active = st
                            break
                        end
                    end
                end
                if voice_active then
                    res.services[key].voice_circuit = {
                        section = voice_active.section,
                        enabled = voice_active.enabled,
                        port = voice_active.port or "50000-65535,19294-19344",
                        protocol = "udp",
                        script = voice_active.script or ""
                    }
                end
            end
        end

        print(json.stringify(res))
    ' 2>/dev/null
}

cmd_logs() {
    local zapret_log=""
    if ubus list log >/dev/null 2>&1; then
        zapret_log=$(logread -e zapret2 2>/dev/null | tail -n 40 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    elif [ -f /var/log/messages ]; then
        zapret_log=$(grep -i zapret2 /var/log/messages 2>/dev/null | tail -n 40 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    fi
    local scan_log=""
    if [ -f "$LOG_FILE" ]; then
        scan_log=$(tail -n 60 "$LOG_FILE" | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    fi
    local daemons=$(ps -w | grep -E 'nfqws2|blockcheckw' | grep -v grep | head -n 10 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')

    cat <<EOF
{
  "scanner_log": "$scan_log",
  "zapret2_log": "$zapret_log",
  "daemons": "$daemons"
}
EOF
}

cmd_check_update() {
    local cur_ver="0.15.12"
    if [ -f "$VERSION_FILE" ]; then
        cur_ver=$(lua -e 'local j = require("luci.jsonc"); local f = io.open("'"$VERSION_FILE"'", "r"); if f then local d = j.parse(f:read("*a")); f:close(); print(d and d.version or "0.15.12"); else print("0.15.12"); end' 2>/dev/null)
    fi

    local tmp_ver="/tmp/bcw_remote_ver.json"
    local tmp_api="/tmp/bcw_remote_api.json"
    rm -f "$tmp_ver" "$tmp_api"

    # 1. GitHub API (не кэшируется CDN, отдаёт актуальный файл напрямую).
    curl -fsSL -k --connect-timeout 4 -m 10 \
        -H "Accept: application/vnd.github.raw" \
        -H "Cache-Control: no-cache" \
        "https://api.github.com/repos/prostoy23rus/zapret2wizard/contents/openwrt/version.json?ref=main&t=$(date +%s)" \
        -o "$tmp_api" 2>/dev/null

    # 2. GitHub Raw с обходом кэша (запасной путь).
    for gh_ip in 185.199.108.133 185.199.111.133 185.199.109.133 185.199.110.133; do
        curl -fsSL -k --connect-timeout 2 -m 4 \
            -H "Cache-Control: no-cache" -H "Pragma: no-cache" \
            --resolve "raw.githubusercontent.com:443:$gh_ip" \
            "https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/openwrt/version.json?_t=$(date +%s)" \
            -o "$tmp_ver" 2>/dev/null
        if [ -s "$tmp_ver" ] && ! head -n 3 "$tmp_ver" | grep -qiE '404|not found|<html>'; then
            break
        fi
        rm -f "$tmp_ver"
    done

    # 3. Если CDN отдал устаревшую версию, а API — свежую, берём API.
    if [ -s "$tmp_api" ] && head -n 3 "$tmp_api" | grep -q '"version"'; then
        local api_v raw_v
        api_v=$(grep -o '"version"[^,]*' "$tmp_api" | head -1 | grep -o '[0-9][0-9.]*')
        raw_v=$(grep -o '"version"[^,]*' "$tmp_ver" 2>/dev/null | head -1 | grep -o '[0-9][0-9.]*')
        if [ -z "$raw_v" ] || [ "$(printf '%s\n%s\n' "$api_v" "$raw_v" | sort -V | tail -1)" = "$api_v" ]; then
            cp -f "$tmp_api" "$tmp_ver"
        fi
    fi
    rm -f "$tmp_api"

    # 2. If direct GitHub was unreachable, purge jsDelivr and fetch via mirrors
    if [ ! -s "$tmp_ver" ]; then
        curl -fsSL -k --connect-timeout 2 -m 3 "https://purge.jsdelivr.net/gh/prostoy23rus/zapret2wizard@main/openwrt/version.json" >/dev/null 2>&1 || true
        fetch_file "openwrt/version.json" "$tmp_ver" 5
    fi

    lua - "$cur_ver" "$tmp_ver" "$VERSION_FILE" << 'EOF'
local json = require("luci.jsonc")
local cur_ver = arg[1] or "0.15.12"
local file = arg[2]
local local_file = arg[3]

local function ver_to_tuple(v)
    local t = {}
    for part in string.gmatch(v or "0", "%d+") do
        table.insert(t, tonumber(part) or 0)
    end
    return t
end

local function is_newer(v1, v0)
    local t1 = ver_to_tuple(v1)
    local t0 = ver_to_tuple(v0)
    local len = math.max(#t1, #t0)
    for i = 1, len do
        local n1 = t1[i] or 0
        local n0 = t0[i] or 0
        if n1 > n0 then return true end
        if n1 < n0 then return false end
    end
    return false
end

local local_cl = {}
local local_date = ""
if local_file then
    local lf = io.open(local_file, "r")
    if lf then
        local ld = json.parse(lf:read("*a"))
        lf:close()
        if ld then
            local_cl = ld.changelog or {}
            local_date = ld.release_date or ""
        end
    end
end

local f = io.open(file, "r")
if not f then
    local res = {
        success = false,
        current_version = cur_ver,
        current_changelog = local_cl,
        current_release_date = local_date,
        changelog = local_cl,
        has_update = false,
        error = "Не удалось связаться с GitHub"
    }
    print(json.stringify(res))
    return
end

local content = f:read("*a")
f:close()

local rem = json.parse(content)
if type(rem) ~= "table" or not rem.version then
    local res = {
        success = false,
        current_version = cur_ver,
        current_changelog = local_cl,
        current_release_date = local_date,
        changelog = local_cl,
        has_update = false,
        error = "Неверный ответ GitHub"
    }
    print(json.stringify(res))
    return
end

local has_update = is_newer(rem.version, cur_ver)
local res = {
    success = true,
    current_version = cur_ver,
    current_changelog = local_cl,
    current_release_date = local_date,
    latest_version = rem.version,
    has_update = has_update,
    changelog = rem.changelog or local_cl,
    release_date = rem.release_date or "",
    repo = rem.repo or "prostoy23rus/zapret2wizard"
}
print(json.stringify(res))
EOF
    rm -f "$tmp_ver"
}

# Свежий version.json: GitHub API не кэшируется, raw — запасной путь.
fetch_remote_version() {
    local dest="$1" api="/tmp/bcw_api_ver.$$"
    rm -f "$api" "$dest"
    curl -fsSL -k --connect-timeout 4 -m 12 \
        -H "Accept: application/vnd.github.raw" \
        -H "Cache-Control: no-cache" \
        "https://api.github.com/repos/prostoy23rus/zapret2wizard/contents/openwrt/version.json?ref=main&t=$(date +%s)" \
        -o "$api" 2>/dev/null
    if [ -s "$api" ] && grep -q '"version"' "$api" 2>/dev/null; then
        cp -f "$api" "$dest"
        rm -f "$api"
        return 0
    fi
    rm -f "$api"
    fetch_file "openwrt/version.json" "$dest" 8
}

cmd_update() {
    local tmp_dir="/tmp/bcw_update_$$"
    mkdir -p "$tmp_dir"
    echo "[blockcheckw-helper] Starting update from $REPO_RAW..." >> "$LOG_FILE"

    # Download updated files via CDN / mirror fallbacks
    local ok=1
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/bin/blockcheckw-helper" "$tmp_dir/blockcheckw-helper" 8 || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/bin/circular-builder.lua" "$tmp_dir/circular-builder.lua" 8 || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/www/luci-static/resources/view/blockcheckw/main.js" "$tmp_dir/main.js" 8 || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/blockcheckw/zapret2_presets.json" "$tmp_dir/zapret2_presets.json" 8 || fetch_file "strategies/zapret2_presets.json" "$tmp_dir/zapret2_presets.json" 8 || ok=0
    fetch_remote_version "$tmp_dir/version.json" || ok=0
    local probe_module
    for probe_module in transfer_probe.lua hostlist_io.sh; do
        fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/$probe_module" "$tmp_dir/$probe_module" 12 || ok=0
    done
    lua - "$tmp_dir/transfer_probe.lua" << 'LUA'
assert(loadfile(arg[1]))
LUA
    [ "$?" = 0 ] || ok=0
    sh -n "$tmp_dir/hostlist_io.sh" || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/lifecycle.sh" "$tmp_dir/lifecycle.sh" 12 || ok=0
    if [ ! -s "$tmp_dir/lifecycle.sh" ] || ! sh -n "$tmp_dir/lifecycle.sh" || ! grep -q '^bcw_lifecycle_remove()' "$tmp_dir/lifecycle.sh"; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"lifecycle module unavailable; update cancelled"}'
        return 1
    fi
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/engine.sh" "$tmp_dir/engine.sh" 12 || ok=0
    if [ ! -s "$tmp_dir/engine.sh" ] || ! sh -n "$tmp_dir/engine.sh" || ! grep -q '^bcw_engine_ensure()' "$tmp_dir/engine.sh"; then
        rm -rf "$tmp_dir"
        engine_reply 0 "Не удалось загрузить модуль совместимости движка; обновление отменено"
        return 1
    fi
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/luci/menu.d/luci-app-blockcheckw.json" "$tmp_dir/menu.json" 8 || true
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/rpcd/acl.d/luci-app-blockcheckw.json" "$tmp_dir/acl.json" 8 || true
    # Служба обновляет и то, что раньше оставалось старым: init.d (хуки мониторинга доступности,
    # modprobe veth) и каталог/классификатор ТСПУ. Без них «Обновить службу»
    # из 0.36.x ставила новый UI, но кнопка класса ТСПУ падала с "каталог не найден".
    fetch_file "openwrt/luci-app-blockcheckw/root/etc/init.d/zapret2wizard" "$tmp_dir/zapret2wizard.initd" 8 || true
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/tspu_catalog.txt" "$tmp_dir/tspu_catalog.txt" 8 || true
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/zapret2wizard/tspu_classifier.lua" "$tmp_dir/tspu_classifier.lua" 8 || true

    if [ ! -s "$tmp_dir/main.js" ] || [ ! -s "$tmp_dir/blockcheckw-helper" ]; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Ошибка скачивания файлов обновления с GitHub / CDN. Проверьте соединение с интернетом."}'
        return 1
    fi

    # Целостность: обрезанный main.js ломает весь интерфейс.
    local main_size=$(wc -c < "$tmp_dir/main.js" 2>/dev/null || echo 0)
    local helper_size=$(wc -c < "$tmp_dir/blockcheckw-helper" 2>/dev/null || echo 0)
    if [ "${main_size:-0}" -lt 100000 ] || ! grep -q 'view.extend' "$tmp_dir/main.js" 2>/dev/null; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Файл main.js скачался не полностью — обновление отменено, прежний интерфейс сохранён. Попробуйте ещё раз."}'
        return 1
    fi
    if [ "${helper_size:-0}" -lt 50000 ] || ! head -n 1 "$tmp_dir/blockcheckw-helper" 2>/dev/null | grep -q '^#!/bin/sh'; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Скрипт helper скачался не полностью — обновление отменено."}'
        return 1
    fi
    if ! grep -q '"version"' "$tmp_dir/version.json" 2>/dev/null; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"version.json скачался не полностью — обновление отменено."}'
        return 1
    fi
    # Новые файлы обновляем только если скачались целиком (старые рабочие не трогаем)
    if [ -s "$tmp_dir/zapret2wizard.initd" ] && ! head -n 1 "$tmp_dir/zapret2wizard.initd" | grep -q '^#!/bin/sh'; then
        rm -f "$tmp_dir/zapret2wizard.initd"
    fi
    if [ -s "$tmp_dir/tspu_catalog.txt" ] && [ "$(grep -c '^--lua-desync\|^--payload' "$tmp_dir/tspu_catalog.txt" 2>/dev/null)" -lt 20 ]; then
        rm -f "$tmp_dir/tspu_catalog.txt"
    fi
    if [ -s "$tmp_dir/tspu_classifier.lua" ] && ! grep -q 'luci.jsonc' "$tmp_dir/tspu_classifier.lua" 2>/dev/null; then
        rm -f "$tmp_dir/tspu_classifier.lua"
    fi

    mkdir -p /usr/bin /usr/share/blockcheckw /usr/share/luci/menu.d /usr/share/rpcd/acl.d /www/luci-static/resources/view/blockcheckw /usr/share/zapret2wizard
    chmod 755 /www/luci-static/resources/view/blockcheckw /usr/share/blockcheckw 2>/dev/null || true

    # Prepare file permissions before moving into place to prevent 403 in uhttpd
    chmod +x "$tmp_dir/blockcheckw-helper" "$tmp_dir/circular-builder.lua" 2>/dev/null || true
    chmod 644 "$tmp_dir/main.js" "$tmp_dir/zapret2_presets.json" "$tmp_dir/version.json" 2>/dev/null || true
    [ -f "$tmp_dir/menu.json" ] && chmod 644 "$tmp_dir/menu.json" 2>/dev/null || true
    [ -f "$tmp_dir/acl.json" ] && chmod 644 "$tmp_dir/acl.json" 2>/dev/null || true

    # Install the extracted owner before any caller that requires it.
    for probe_module in transfer_probe.lua hostlist_io.sh; do
        cp -f "$tmp_dir/$probe_module" "/usr/share/zapret2wizard/$probe_module.new" &&
            mv -f "/usr/share/zapret2wizard/$probe_module.new" "/usr/share/zapret2wizard/$probe_module" || {
            rm -rf "$tmp_dir"
            echo '{"success":false,"error":"Unable to install required helper module"}'
            return 1
        }
    done
    cp -f "$tmp_dir/lifecycle.sh" /usr/share/zapret2wizard/lifecycle.sh.new &&
        mv -f /usr/share/zapret2wizard/lifecycle.sh.new /usr/share/zapret2wizard/lifecycle.sh || {
            echo '{"success":false,"error":"cannot install lifecycle owner"}'; return 1;
        }
    # Install files atomically
    cp -f "$tmp_dir/engine.sh" /usr/share/zapret2wizard/engine.sh.new &&
        mv -f /usr/share/zapret2wizard/engine.sh.new /usr/share/zapret2wizard/engine.sh || {
            engine_reply 0 "Не удалось установить модуль совместимости движка"; return 1;
        }
    cp -f "$tmp_dir/blockcheckw-helper" /usr/bin/blockcheckw-helper
    cp -f "$tmp_dir/circular-builder.lua" /usr/bin/circular-builder.lua
    ln -sf /usr/bin/blockcheckw-helper /usr/bin/zapret2wizard 2>/dev/null || true
    cp -f "$tmp_dir/main.js" /www/luci-static/resources/view/blockcheckw/main.js
    cp -f "$tmp_dir/zapret2_presets.json" /usr/share/blockcheckw/zapret2_presets.json
    cp -f "$tmp_dir/version.json" /usr/share/blockcheckw/version.json
    [ -s "$tmp_dir/menu.json" ] && cp -f "$tmp_dir/menu.json" /usr/share/luci/menu.d/luci-app-blockcheckw.json
    [ -s "$tmp_dir/acl.json" ] && cp -f "$tmp_dir/acl.json" /usr/share/rpcd/acl.d/luci-app-blockcheckw.json
    # init.d: sed-правки не нужны, файл самодостаточный. Применяется при следующем
    # старте службы; modprobe veth делаем сразу — тесты клиента без него не идут.
    if [ -s "$tmp_dir/zapret2wizard.initd" ]; then
        cp -f "$tmp_dir/zapret2wizard.initd" /etc/init.d/zapret2wizard
        chmod 755 /etc/init.d/zapret2wizard
        modprobe veth 2>/dev/null || true
    fi
    [ -s "$tmp_dir/tspu_catalog.txt" ] && cp -f "$tmp_dir/tspu_catalog.txt" /usr/share/zapret2wizard/tspu_catalog.txt
    [ -s "$tmp_dir/tspu_classifier.lua" ] && cp -f "$tmp_dir/tspu_classifier.lua" /usr/share/zapret2wizard/tspu_classifier.lua
    chmod 644 /usr/share/zapret2wizard/tspu_catalog.txt /usr/share/zapret2wizard/tspu_classifier.lua 2>/dev/null || true

    chmod +x /usr/bin/blockcheckw-helper /usr/bin/circular-builder.lua
    chmod 644 /www/luci-static/resources/view/blockcheckw/main.js
    chmod 644 /usr/share/blockcheckw/* /usr/share/luci/menu.d/luci-app-blockcheckw.json /usr/share/rpcd/acl.d/luci-app-blockcheckw.json 2>/dev/null || true

    local new_ver="0.15"
    if [ -f "/usr/share/blockcheckw/version.json" ]; then
        new_ver=$(lua -e 'local j = require("luci.jsonc"); local f = io.open("/usr/share/blockcheckw/version.json", "r"); if f then local d = j.parse(f:read("*a")); f:close(); print(d and d.version or "0.15"); else print("0.15"); end' 2>/dev/null)
    fi

    # Clean caches and reload LuCI
    rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache*
    /etc/init.d/rpcd restart >/dev/null 2>&1
    ensure_all_hostlists
    rm -rf "$tmp_dir"

    # kmod-модули: обновление с кнопки обязано не только привезти файлы,
    # но и довести модули ядра до рабочего состояния (issue #6). Сначала
    # пробуем загрузить уже установленные; если их нет — доустанавливаем
    # в фоне (apk/opkg может качать пакет дольше таймаута RPC).
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
    local _upd_kmods_ok=0
    [ -e /proc/net/netfilter/nfnetlink_queue ] && _kmods_nftq_ok && _upd_kmods_ok=1
    local kmods_note=""
    if [ "$_upd_kmods_ok" != "1" ]; then
        rm -f /tmp/bcw_kmods.done
        ( /usr/bin/blockcheckw-helper kmods_install >/tmp/bcw_kmods.log 2>&1; echo done >/tmp/bcw_kmods.done; _svc_running || /etc/init.d/zapret2wizard start >/dev/null 2>&1 ) &
        echo $! > /tmp/bcw_kmods.pid
        kmods_note=". Модули ядра доустанавливаются в фоне (ход: blockcheckw-helper kmods_status)"
        history_add "kmods" "" "обновление: модули ядра доустанавливаются в фоне" >/dev/null 2>&1 || true
    fi

    # Выполняется НОВЫМ helper, не старым процессом обновления. Не считаем
    # загрузку файлов доказательством совместимости движка. UI опрашивает статус.
    /usr/bin/blockcheckw-helper engine_repair_bg >/dev/null 2>&1
    echo "[blockcheckw-helper] Files updated to version $new_ver; runtime verification started" >> "$LOG_FILE"
    printf '{"success":true,"version":"%s","message":"Служба успешно обновлена до версии %s!%s"}\n' "$new_ver" "$new_ver" "$kmods_note"
}

# Удаление наших следов: DNS-записи, Reject-QUIC, nft-таблица.
# Нужно и при uninstall, и как отдельная команда для уже удалённых установок.
# Безопасный перезапуск dnsmasq: при неудаче возвращаем /etc/config/dhcp,
# иначе один битый конфиг оставляет всю сеть без DNS.
safe_dns_restart() (
    local bak="/tmp/bcw_dhcp.safe.$$" i=0 a rp lock="/tmp/bcw_dns_restart.lock"
    # Сериализуем перезапуски dnsmasq: optimize/health/init могли делать это
    # одновременно, затирая бэкап друг друга и оставляя сеть без DNS.
    while ! mkdir "$lock" 2>/dev/null; do
        if [ -f "$lock/pid" ]; then
            local lpid
            lpid=$(cat "$lock/pid" 2>/dev/null)
            if [ -n "$lpid" ] && ! kill -0 "$lpid" 2>/dev/null; then
                rm -rf "$lock" 2>/dev/null || true
                continue
            fi
        fi
        i=$((i + 1))
        [ "$i" -gt 30 ] && { rm -rf "$lock" 2>/dev/null || true; break; }
        sleep 1
    done
    echo $$ > "$lock/pid" 2>/dev/null || true
    trap 'rm -rf "$lock" "$bak" 2>/dev/null || true' EXIT INT TERM
    i=0
    cp -f /etc/config/dhcp "$bak" 2>/dev/null || true
    ( eval "/etc/init.d/dnsmasq restart" ) >/dev/null 2>&1 &
    rp=$!
    while kill -0 "$rp" 2>/dev/null && [ "$i" -lt 15 ]; do sleep 1; i=$((i + 1)); done
    kill -9 "$rp" 2>/dev/null || true
    i=0
    while [ "$i" -lt 8 ]; do
        a=$(nslookup www.google.com 127.0.0.1 2>/dev/null | awk '/^Address: /{print $2}' | grep -E '^[0-9.]+$' | head -n1)
        if pidof dnsmasq >/dev/null 2>&1 && [ -n "$a" ]; then
            rm -rf "$lock" "$bak" 2>/dev/null || true
            trap - EXIT INT TERM
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    if [ -s "$bak" ]; then
        cp -f "$bak" /etc/config/dhcp 2>/dev/null || true
        uci -q commit dhcp 2>/dev/null || true
        ( eval "/etc/init.d/dnsmasq restart" ) >/dev/null 2>&1 &
        rp=$!
        i=0
        while kill -0 "$rp" 2>/dev/null && [ "$i" -lt 10 ]; do sleep 1; i=$((i + 1)); done
        kill -9 "$rp" 2>/dev/null || true
    fi
    logger -t zapret2wizard "dnsmasq restart failed — конфигурация DHCP возвращена"
    rm -rf "$lock" "$bak" 2>/dev/null || true
    trap - EXIT INT TERM
    return 1
)

# ==============================================================================
# Googlevideo dead clusters (issue #8): SYN-drop map -> instant TCP RST.
# Default off. Never changes the map when no alive IP was observed (freeze).
# ==============================================================================
DEAD_CLUSTERS_TABLE="dead_ggc"
DEAD_CLUSTERS_DIR="/etc/zapret2wizard"
DEAD_CLUSTERS_STATE="$DEAD_CLUSTERS_DIR/dead_clusters.meta"
DEAD_CLUSTERS_ELEMENTS="$DEAD_CLUSTERS_DIR/dead_clusters.elements"
DEAD_CLUSTERS_HOSTS="$DEAD_CLUSTERS_DIR/dead_ggc_hosts.txt"
DEAD_CLUSTERS_LOCK="/var/run/bcw_dead_clusters.lock"
DEAD_CLUSTERS_LOG="/tmp/bcw_dead_clusters.log"
DEAD_CLUSTERS_MODULE="/usr/share/zapret2wizard/dead_clusters.lua"
DEAD_CLUSTERS_SEED_VIDEOS="dQw4w9WgXcQ 9bZkp7q19f0 kJQP7kiw5Fk mxI7t_hpxEA aqz-KE-bpKQ jNQXAC9IVRw"

dead_clusters_log() {
    printf "%s %s\n" "$(date "+%m-%d %H:%M:%S" 2>/dev/null)" "$*" >> "$DEAD_CLUSTERS_LOG" 2>/dev/null || true
    if [ -f "$DEAD_CLUSTERS_LOG" ] && [ "$(wc -l < "$DEAD_CLUSTERS_LOG" 2>/dev/null || echo 0)" -gt 300 ]; then
        tail -n 200 "$DEAD_CLUSTERS_LOG" > "$DEAD_CLUSTERS_LOG.t" 2>/dev/null && mv "$DEAD_CLUSTERS_LOG.t" "$DEAD_CLUSTERS_LOG"
    fi
}

dead_clusters_enabled() {
    [ "$(uci -q get zapret2wizard.main.dead_clusters 2>/dev/null || echo 0)" = "1" ]
}

dead_clusters_interval() {
    local iv=$(uci -q get zapret2wizard.main.dead_clusters_interval 2>/dev/null || echo 60)
    case "$iv" in ""|*[!0-9]*) iv=60 ;; esac
    [ "$iv" -ge 5 ] || iv=5
    echo "$iv"
}

dead_clusters_element_count() {
    [ -s "$DEAD_CLUSTERS_ELEMENTS" ] || { echo 0; return 0; }
    grep -cE "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$" "$DEAD_CLUSTERS_ELEMENTS" 2>/dev/null || echo 0
}

dead_clusters_running() {
    local pid
    [ -d "$DEAD_CLUSTERS_LOCK" ] || return 1
    pid=$(cat "$DEAD_CLUSTERS_LOCK/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
    rm -rf "$DEAD_CLUSTERS_LOCK" 2>/dev/null || true
    return 1
}

dead_clusters_lock_acquire() {
    dead_clusters_running && return 1
    mkdir -p "$DEAD_CLUSTERS_LOCK" 2>/dev/null || return 1
    echo $$ > "$DEAD_CLUSTERS_LOCK/pid" 2>/dev/null || { rm -rf "$DEAD_CLUSTERS_LOCK"; return 1; }
    DEAD_CLUSTERS_LOCK_HELD=1
    return 0
}

dead_clusters_lock_release() {
    rm -rf "$DEAD_CLUSTERS_LOCK" 2>/dev/null || true
    DEAD_CLUSTERS_LOCK_HELD=0
}

dead_clusters_meta_reset() {
    local meta="$1"
    . "$meta" 2>/dev/null || true
}

cmd_dead_clusters_status() {
    local enabled=false running=false nft_active=false
    local last_scan=0 duration=0 alive=0 dead=0 hosts=0 pairs=0 subnets=0 singles=0 frozen=0 capped=0 error=""
    local elems=0 elems_json="[]" interval
    dead_clusters_enabled && enabled=true
    dead_clusters_running && running=true
    nft list table inet "$DEAD_CLUSTERS_TABLE" >/dev/null 2>&1 && nft_active=true
    if [ -r "$DEAD_CLUSTERS_STATE" ]; then . "$DEAD_CLUSTERS_STATE" 2>/dev/null || true; fi
    interval=$(dead_clusters_interval)
    case "$last_scan" in ""|*[!0-9]*) last_scan=0 ;; esac
    case "$duration" in ""|*[!0-9]*) duration=0 ;; esac
    for _v in alive dead hosts pairs subnets singles frozen capped; do eval "[ -n "\$$_v" ] || $_v=0"; done
    case "$frozen" in 0|1) ;; *) frozen=0 ;; esac
    case "$capped" in 0|1) ;; *) capped=0 ;; esac
    error=$(printf "%s" "${error:-}" | tr -cd "A-Za-z0-9._-")
    if [ -s "$DEAD_CLUSTERS_ELEMENTS" ]; then
        elems=$(dead_clusters_element_count)
        elems_json=$(awk "BEGIN{printf \"[\"} /^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(\\/[0-9]+)?$/ {gsub(/[^0-9.\\/]/,\"\"); printf \"%s\\\"%s\\\"\", (n++?\",\":\"\"), \$0} END{printf \"]\"}" "$DEAD_CLUSTERS_ELEMENTS" 2>/dev/null || true)
        [ -n "$elems_json" ] || elems_json="[]"
    fi
    printf '{"enabled":%s,"running":%s,"nft_active":%s,"elements_count":%s,"elements":%s,"last_scan":%s,"duration":%s,"alive":%s,"dead":%s,"hosts":%s,"pairs":%s,"subnets":%s,"singles":%s,"frozen":%s,"capped":%s,"error":"%s","interval":%s}\n' \
        "$enabled" "$running" "$nft_active" "$elems" "$elems_json" "$last_scan" "$duration" "$alive" "$dead" "$hosts" "$pairs" "$subnets" "$singles" "$frozen" "$capped" "$error" "$interval"
}

dead_clusters_apply_file() {
    local file="$1" n nft_file="/tmp/bcw_dead_ggc.nft" line
    n=$(grep -cE "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$" "$file" 2>/dev/null || true)
    [ -n "$n" ] || n=0
    if [ "$n" -eq 0 ]; then
        nft delete table inet "$DEAD_CLUSTERS_TABLE" 2>/dev/null || true
        return 0
    fi
    command -v nft >/dev/null 2>&1 || return 1
    {
        printf "table inet %s {\n" "$DEAD_CLUSTERS_TABLE"
        printf "\tset dead {\n\t\ttype ipv4_addr\n\t\tflags interval\n\t\tauto-merge\n\t\telements = {\n"
        while IFS= read -r line; do
            case "$line" in *[!0-9./]*) continue ;; esac
            printf "\t\t\t%s,\n" "$line"
        done < "$file"
        printf "\t\t}\n\t}\n"
        printf "\tchain forward {\n\t\ttype filter hook forward priority -5; policy accept;\n\t\tip daddr @dead tcp dport 443 reject with tcp reset\n\t}\n}\n"
    } > "$nft_file" || return 1
    if ! nft -c -f "$nft_file" >/dev/null 2>&1; then
        rm -f "$nft_file"
        return 1
    fi
    nft delete table inet "$DEAD_CLUSTERS_TABLE" 2>/dev/null || true
    if ! nft -f "$nft_file"; then
        rm -f "$nft_file"
        return 1
    fi
    rm -f "$nft_file"
    return 0
}

dead_clusters_write_meta() {
    local last_scan="$1" duration="$2" alive="$3" dead="$4" hosts="$5" pairs="$6" subnets="$7" singles="$8" frozen="$9" capped="${10}" error="${11}"
    local elems tmp="$DEAD_CLUSTERS_STATE.$$"
    elems=$(dead_clusters_element_count)
    printf "last_scan=%s\nduration=%s\nalive=%s\ndead=%s\nhosts=%s\npairs=%s\nsubnets=%s\nsingles=%s\nelements=%s\nfrozen=%s\ncapped=%s\nerror=%s\n" \
        "$last_scan" "$duration" "$alive" "$dead" "$hosts" "$pairs" "$subnets" "$singles" "$elems" "$frozen" "$capped" "$error" > "$tmp"
    mv "$tmp" "$DEAD_CLUSTERS_STATE"
}

cmd_dead_clusters_apply_state() {
    local n
    if ! dead_clusters_enabled; then
        nft delete table inet "$DEAD_CLUSTERS_TABLE" 2>/dev/null || true
        echo '{"applied":false,"reason":"disabled"}'
        return 0
    fi
    n=$(dead_clusters_element_count)
    if dead_clusters_apply_file "$DEAD_CLUSTERS_ELEMENTS"; then
        printf '{"applied":true,"elements":%s}\n' "$n"
        return 0
    fi
    echo '{"applied":false,"error":"nft"}'
    return 1
}

dead_clusters_cron_install() {
    local cron_file="/etc/crontabs/root"
    local line="17 * * * * /usr/bin/blockcheckw-helper dead_clusters_cron_run >/dev/null 2>&1 # bcw-deadggc"
    mkdir -p /etc/crontabs 2>/dev/null || true
    touch "$cron_file" 2>/dev/null || true
    sed -i "/bcw-deadggc/d" "$cron_file" 2>/dev/null || true
    echo "$line" >> "$cron_file"
    /etc/init.d/cron enable >/dev/null 2>&1 || true
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

dead_clusters_cron_remove() {
    local cron_file="/etc/crontabs/root"
    [ -f "$cron_file" ] || return 0
    sed -i "/bcw-deadggc/d" "$cron_file" 2>/dev/null || true
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

dead_clusters_resolve() {
    local host="$1" ip="" srv
    for srv in "" "1.1.1.1"; do
        if [ -n "$srv" ]; then
            ip=$(nslookup "$host" "$srv" 2>/dev/null | awk "/^Address: /{print \$2}" | grep -E "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$" | grep -vE "^(0\.|127\.|10\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)" | head -n1)
        else
            ip=$(nslookup "$host" 2>/dev/null | awk "/^Address: /{print \$2}" | grep -E "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$" | grep -vE "^(0\.|127\.|10\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)" | head -n1)
        fi
        [ -n "$ip" ] && { printf "%s" "$ip"; return 0; }
    done
    return 1
}

dead_clusters_probe() {
    local host="$1" ip="$2" attempt=1 tc
    while [ "$attempt" -le 2 ]; do
        tc=$(curl -4 -sS -k -o /dev/null -m 3 --connect-timeout 2 --resolve "$host:443:$ip" -w "%{time_connect}" "https://$host/" 2>/dev/null)
        case "$tc" in ""|0|0.000000) : ;; *) return 0 ;; esac
        [ "$attempt" -eq 1 ] && sleep 1
        attempt=$((attempt + 1))
    done
    return 1
}

cmd_dead_clusters_scan_bg() {
    dead_clusters_enabled || { echo '{"started":false,"error":"disabled"}'; return 1; }
    if dead_clusters_running; then echo '{"started":false,"busy":true}'; return 1; fi
    mkdir -p "$DEAD_CLUSTERS_DIR" 2>/dev/null || true
    : >> "$DEAD_CLUSTERS_LOG" 2>/dev/null || true
    if command -v setsid >/dev/null 2>&1; then
        setsid /usr/bin/blockcheckw-helper dead_clusters_scan </dev/null >>"$DEAD_CLUSTERS_LOG" 2>&1 &
    else
        /usr/bin/blockcheckw-helper dead_clusters_scan </dev/null >>"$DEAD_CLUSTERS_LOG" 2>&1 &
    fi
    echo $! > /tmp/bcw_dead_clusters.pid 2>/dev/null || true
    echo '{"started":true}'
}

cmd_dead_clusters_cron_run() {
    dead_clusters_enabled || return 0
    [ ! -e /var/run/bcw_service.stopped ] || return 0
    local now last iv
    now=$(date +%s)
    last=$(sed -n "s/^last_scan=//p" "$DEAD_CLUSTERS_STATE" 2>/dev/null | head -n1)
    case "$last" in ""|*[!0-9]*) last=0 ;; esac
    iv=$(dead_clusters_interval)
    if [ "$last" -gt 0 ] && [ $((now - last)) -lt $((iv * 60)) ]; then return 0; fi
    cmd_dead_clusters_scan_impl
}

cmd_dead_clusters_scan_impl() {
    dead_clusters_enabled || return 0
    command -v curl >/dev/null 2>&1 || return 1
    command -v lua >/dev/null 2>&1 || { dead_clusters_log "lua missing"; return 1; }
    [ -r "$DEAD_CLUSTERS_MODULE" ] || { dead_clusters_log "module missing"; return 1; }
    mkdir -p "$DEAD_CLUSTERS_DIR" 2>/dev/null || return 1
    dead_clusters_log "scan start"
    if ! dead_clusters_lock_acquire; then dead_clusters_log "scan busy"; return 0; fi
    local tmp tmpdir started finished hosts pairs alive dead now last_scan duration
    local alive_n=0 dead_n=0 subnets=0 singles=0 elems_n=0 frozen=0 capped=0 error=""
    local service_stopped=0
    [ ! -e /var/run/bcw_service.stopped ] || service_stopped=1
    tmpdir=$(mktemp -d /tmp/bcw_dead.XXXXXX 2>/dev/null) || { dead_clusters_lock_release; return 1; }
    tmp="$tmpdir"
    trap "rm -rf \"$tmpdir\"; dead_clusters_lock_release" EXIT INT TERM
    started=$(date +%s)
    : > "$tmp/found"
    for v in $DEAD_CLUSTERS_SEED_VIDEOS; do
        curl -4 -sS -m 10 "https://www.youtube.com/watch?v=$v" -o "$tmp/page" 2>/dev/null || true
        [ -s "$tmp/page" ] && lua "$DEAD_CLUSTERS_MODULE" hosts "$tmp/page" >> "$tmp/found" 2>/dev/null || true
    done
    touch "$DEAD_CLUSTERS_HOSTS" 2>/dev/null || true
    { cat "$DEAD_CLUSTERS_HOSTS" 2>/dev/null; cat "$tmp/found"; } | awk "NF && !seen[\$0]++" | tail -n 256 > "$tmp/hosts"
    mv "$tmp/hosts" "$DEAD_CLUSTERS_HOSTS" 2>/dev/null || true
    chmod 644 "$DEAD_CLUSTERS_HOSTS" 2>/dev/null || true
    hosts=$(grep -c . "$DEAD_CLUSTERS_HOSTS" 2>/dev/null || echo 0)
    dead_clusters_log "hosts=$hosts"
    if [ "$hosts" -eq 0 ]; then error="no_hosts"; frozen=1; fi
    : > "$tmp/pairs"
    if [ -z "$error" ]; then
        while IFS= read -r h; do
            [ -n "$h" ] || continue
            ip=$(dead_clusters_resolve "$h" 2>/dev/null || true)
            [ -n "$ip" ] && printf "%s %s\n" "$h" "$ip" >> "$tmp/pairs"
        done < "$DEAD_CLUSTERS_HOSTS"
        awk "NF==2 && !seen[\$2]++" "$tmp/pairs" | head -n 160 > "$tmp/pairs.u"
        pairs=$(grep -c . "$tmp/pairs.u" 2>/dev/null || echo 0)
        dead_clusters_log "pairs=$pairs"
        if [ "$pairs" -eq 0 ]; then error="no_pairs"; frozen=1; fi
    fi
    : > "$tmp/alive"; : > "$tmp/dead"
    if [ -z "$error" ]; then
        local n=0
        while IFS=" " read -r h ip; do
            [ -n "$h" ] && [ -n "$ip" ] || continue
            ( if dead_clusters_probe "$h" "$ip"; then echo "$ip" >> "$tmp/alive"; else echo "$ip" >> "$tmp/dead"; fi ) &
            n=$((n + 1))
            [ $((n % 8)) -eq 0 ] && wait
        done < "$tmp/pairs.u"
        wait
        alive_n=$(sort -u "$tmp/alive" 2>/dev/null | grep -c . || true)
        dead_n=$(sort -u "$tmp/dead" 2>/dev/null | grep -c . || true)
        [ -n "$alive_n" ] || alive_n=0
        [ -n "$dead_n" ] || dead_n=0
        dead_clusters_log "alive=$alive_n dead=$dead_n"
        if [ "$alive_n" -eq 0 ]; then error="no_alive"; frozen=1; fi
    fi
    if [ "$frozen" -eq 0 ] && [ -z "$error" ] && ! dead_clusters_enabled; then
        error="disabled"
    fi
    if [ "$frozen" -eq 0 ] && [ -z "$error" ]; then
        lua "$DEAD_CLUSTERS_MODULE" build "$tmp/dead" "$tmp/alive" 512 > "$tmp/build" 2>/dev/null || { error="build_failed"; frozen=1; }
        if [ "$frozen" -eq 0 ]; then
            alive=$(sed -n "s/^alive=//p" "$tmp/build" | head -n1); [ -n "$alive" ] && alive_n="$alive"
            dead=$(sed -n "s/^dead=//p" "$tmp/build" | head -n1); [ -n "$dead" ] && dead_n="$dead"
            subnets=$(sed -n "s/^subnets=//p" "$tmp/build" | head -n1); [ -n "$subnets" ] || subnets=0
            singles=$(sed -n "s/^singles=//p" "$tmp/build" | head -n1); [ -n "$singles" ] || singles=0
            elems_n=$(sed -n "s/^elements=//p" "$tmp/build" | head -n1); [ -n "$elems_n" ] || elems_n=0
            capped=$(sed -n "s/^capped=//p" "$tmp/build" | head -n1); [ -n "$capped" ] || capped=0
            sed -n "s/^element=//p" "$tmp/build" | grep -E "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$" > "$tmp/elements"
            if [ "$service_stopped" -eq 1 ] || [ -e /var/run/bcw_service.stopped ]; then
                error="service_stopped"
            elif ! dead_clusters_apply_file "$tmp/elements"; then
                error="nft_failed"
            else
                mv "$tmp/elements" "$DEAD_CLUSTERS_ELEMENTS" 2>/dev/null || true
                chmod 644 "$DEAD_CLUSTERS_ELEMENTS" 2>/dev/null || true
            fi
        fi
    fi
    finished=$(date +%s)
    duration=$((finished - started))
    last_scan=$finished
    dead_clusters_write_meta "$last_scan" "$duration" "$alive_n" "$dead_n" "$hosts" "${pairs:-0}" "$subnets" "$singles" "$frozen" "$capped" "$error"
    dead_clusters_log "done duration=${duration}s frozen=$frozen error=${error:-none} elements=$(dead_clusters_element_count)"
    trap - EXIT INT TERM
    rm -rf "$tmpdir"
    dead_clusters_lock_release
    return 0
}

cmd_dead_clusters_toggle() {
    local val="$1" now last iv cur
    case "$val" in 1|on|true) val=1 ;; 0|off|false) val=0 ;; *) echo '{"success":false,"error":"invalid value"}'; return 1 ;; esac
    cur=$(uci -q get zapret2wizard.main.dead_clusters 2>/dev/null || echo 0)
    # Idempotent: an old/cached UI (or a second tab) must not hammer uci/cron/nft.
    if [ "$cur" = "$val" ]; then
        if [ "$val" = "1" ]; then
            grep -q "bcw-deadggc" /etc/crontabs/root 2>/dev/null || dead_clusters_cron_install
            if ! nft list table inet "$DEAD_CLUSTERS_TABLE" >/dev/null 2>&1 && [ -s "$DEAD_CLUSTERS_ELEMENTS" ]; then
                cmd_dead_clusters_apply_state >/dev/null 2>&1 || true
            fi
            echo '{"success":true,"enabled":true,"unchanged":true}'
        else
            grep -q "bcw-deadggc" /etc/crontabs/root 2>/dev/null && dead_clusters_cron_remove
            nft list table inet "$DEAD_CLUSTERS_TABLE" >/dev/null 2>&1 && nft delete table inet "$DEAD_CLUSTERS_TABLE" 2>/dev/null || true
            echo '{"success":true,"enabled":false,"unchanged":true}'
        fi
        return 0
    fi
    uci -q set "zapret2wizard.main.dead_clusters=$val" || { echo '{"success":false,"error":"uci failed"}'; return 1; }
    uci -q commit zapret2wizard >/dev/null 2>&1 || true
    if [ "$val" = "1" ]; then
        dead_clusters_cron_install
        cmd_dead_clusters_apply_state >/dev/null 2>&1 || true
        now=$(date +%s)
        last=$(sed -n "s/^last_scan=//p" "$DEAD_CLUSTERS_STATE" 2>/dev/null | head -n1)
        case "$last" in ""|*[!0-9]*) last=0 ;; esac
        iv=$(dead_clusters_interval)
        if [ "$last" -eq 0 ] || [ $((now - last)) -ge $((iv * 60)) ]; then
            cmd_dead_clusters_scan_bg >/dev/null 2>&1 || true
        fi
        echo '{"success":true,"enabled":true}'
    else
        dead_clusters_cron_remove
        nft delete table inet "$DEAD_CLUSTERS_TABLE" 2>/dev/null || true
        echo '{"success":true,"enabled":false}'
    fi
}
cleanup_leftovers() {
    lifecycle_load || return 1
    if bcw_lifecycle_cleanup; then
        printf '{"cleaned":true,"dns_changed":%s}\n' "${BCW_LIFECYCLE_DNS_CHANGED:-0}"
    else
        echo '{"cleaned":false,"error":"owned resource cleanup failed"}'
        return 1
    fi
}

cmd_uninstall() {
    lifecycle_load || return 1
    if scan_busy; then
        echo '{"success":false,"error":"scan is active; stop the scan before uninstall"}'
        return 1
    fi
    bcw_lifecycle_remove_begin
}

# Privacy-safe evidence report for the public provider matrix (audit P0).
# Only aggregates and selected strategies; never hostlist contents, IPs or domains
# from user lists. JSON by default; --markdown renders a ready-to-paste report.
cmd_evidence() {
    local mode="json" info
    [ "$1" = "--markdown" ] && mode="markdown"
    info=$(mktemp /tmp/bcw-evidence-info.XXXXXX) || return 1
    cmd_info > "$info" 2>/dev/null
    EVIDENCE_INFO="$info" EVIDENCE_MODE="$mode" lua - <<'EVIDENCE_LUA'
local json = require "luci.jsonc"
local function read(path)
    local f = io.open(path, "r"); if not f then return nil end
    local s = f:read("*a"); f:close(); return s
end
local function parse(s)
    if not s or s == "" then return nil end
    local ok, d = pcall(json.parse, s)
    if ok and type(d) == "table" then return d end
    return nil
end
local function sh(cmd)
    local p = io.popen(cmd .. " 2>/dev/null"); if not p then return "" end
    local s = p:read("*a") or ""; p:close(); return s
end
local function trim(s)
    s = tostring(s or ""); return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end
local info = parse(read(os.getenv("EVIDENCE_INFO"))) or {}
local status = parse(read("/tmp/blockcheckw_status.json")) or {}
local tests = parse(read("/etc/zapret2wizard/tests.json")) or {}
local provider_file = trim(read("/etc/zapret2wizard/provider") or "")
local provider = trim(status.isp or "")
if provider_file ~= "" then provider = provider_file end
local asn = provider:match("AS%d+") or ""
local block_type = trim(status.block_type or "")
if block_type == "" then block_type = "unknown" end
local rel = read("/etc/openwrt_release") or ""
local function relval(k)
    return trim((rel:match("DISTRIB_" .. k .. "='([^']*)'") or ""))
end
local release = relval("RELEASE")
local target = relval("TARGET")
local arch = relval("ARCH")
if release == "" then release = trim(sh("cat /etc/openwrt_version")) end
local model = trim(read("/tmp/sysinfo/model") or "")
if model == "" then model = trim(read("/proc/device-tree/model") or "") end
local kernel = trim(sh("uname -r"))
local scanner = trim(sh("/usr/bin/blockcheckw --version"))
local pkg_manager, pkg_version = "", ""
local apk_out = sh("apk list -I 2>/dev/null | grep '^zapret2wizard'")
if apk_out ~= "" then pkg_manager = "apk"; pkg_version = trim(apk_out) else
    local opkg_out = sh("opkg list-installed 2>/dev/null | grep '^luci-app-blockcheckw '")
    if opkg_out ~= "" then pkg_manager = "opkg"; pkg_version = trim(opkg_out) end
end
local services = {}
for k, v in pairs(info.services or {}) do
    local script = trim(v.script or "")
    local technique = script:match("--lua%-desync=([%w_]+)") or ""
    services[#services + 1] = {
        target = k, section = v.section or "", enabled = v.enabled and true or false,
        technique = technique, script = script:sub(1, 400)
    }
end
table.sort(services, function(x, y) return x.target < y.target end)
local last_tests = {}
for k, v in pairs(tests) do
    last_tests[#last_tests + 1] = {
        target = k, status = v.status or "unknown", code = v.code or "", size = v.size or 0,
        speed = v.speed or 0, time = v.time or 0
    }
end
table.sort(last_tests, function(x, y) return x.target < y.target end)
local hostlists = {}
for _, hl in ipairs(info.hostlists or {}) do
    hostlists[#hostlists + 1] = { key = hl.key, count = hl.domains_count, attached = hl.attached, enabled = hl.enabled }
end
table.sort(hostlists, function(x, y) return tostring(x.key) < tostring(y.key) end)
local genomes = parse(read("/etc/zapret2wizard/genomes.json"))
local function count_args(x)
    local n = 0
    local function walk(v)
        if type(v) ~= "table" then return end
        if v.args then n = n + 1 end
        for _, item in pairs(v) do walk(item) end
    end
    walk(x); return n
end
local good = parse(read("/etc/zapret2wizard/good_history/entries.json"))
local good_count = (type(good) == "table" and type(good.entries) == "table") and #good.entries or 0
local evidence = {
    schema = 1,
    generated_at = os.date("%Y-%m-%d %H:%M:%S %z"),
    app_version = tostring(info.version or ""),
    scanner_version = scanner,
    zapret2_running = tostring(info.zapret2_running or ""),
    platform = { model = model, openwrt = release, target = target, arch = arch, kernel = kernel },
    package = { manager = pkg_manager, version = pkg_version },
    provider = { raw = provider, isp = trim(status.isp or ""), asn = asn },
    block_type = block_type,
    services = services,
    last_tests = last_tests,
    counts = { hostlists = hostlists, genomes = count_args(genomes), good_history = good_count },
    privacy = { hostlist_contents_included = false, telemetry = false }
}
if os.getenv("EVIDENCE_MODE") ~= "markdown" then
    print(json.stringify(evidence))
    os.exit(0)
end
local function esc(s) s = tostring(s or ""); return (s:gsub("|", "\\|"):gsub("\n", " ")) end
print("# Zapret2Wizard: отчёт для матрицы провайдеров")
print("")
print("- Дата: " .. evidence.generated_at)
print("- Версия: " .. evidence.app_version .. "; сканер: " .. (scanner ~= "" and scanner or "n/a"))
print("- Роутер: " .. (model ~= "" and model or "n/a") .. "; OpenWrt " .. release .. " (" .. target .. ", " .. arch .. "); ядро " .. kernel)
print("- Пакет: " .. (pkg_manager ~= "" and (pkg_manager .. " " .. pkg_version) or "bundle/manual"))
print("- Провайдер: " .. (provider ~= "" and provider or "не определён") .. "; ASN: " .. (asn ~= "" and asn or "n/a") .. "; тип блокировки: " .. block_type)
print("- Служба: " .. (info.zapret2_running or "unknown") .. "; nft: " .. (info.nft_table and "есть" or "нет"))
print("")
print("| Сервис | Включён | Техника | Стратегия |")
print("|---|---|---|---|")
for _, s in ipairs(services) do
    print("| " .. esc(s.target) .. " | " .. (s.enabled and "да" or "нет") .. " | " .. esc(s.technique) .. " | " .. esc(s.script) .. " |")
end
print("")
print("| Последняя проверка | Статус | HTTP | Байт | КБ/с |")
print("|---|---|---|---|---|")
for _, t in ipairs(last_tests) do
    print("| " .. esc(t.target) .. " | " .. esc(t.status) .. " | " .. esc(t.code) .. " | " .. tostring(t.size) .. " | " .. tostring(t.speed) .. " |")
end
print("")
local hparts = {}
for _, hl in ipairs(hostlists) do hparts[#hparts + 1] = hl.key .. "=" .. tostring(hl.count) end
print("Списки (количество): " .. table.concat(hparts, ", ") .. "; геномов: " .. count_args(genomes) .. "; хороших конфигураций: " .. good_count)
print("")
print("_Приватность: в отчёте нет доменов из пользовательских списков, IP и иных персональных данных; только агрегаты и выбранные стратегии. Отправка — только вручную._")
EVIDENCE_LUA
    rm -f "$info"
}

cmd_diag() {
    local as_json=false
    [ "$1" = "--json" ] && as_json=true

    lua - "$STATUS_FILE" "$LOG_FILE" "$VERSION_FILE" "$OUTPUT_SCAN" "$as_json" << 'EOF'
local json = require("luci.jsonc")
local status_file = arg[1]
local log_file = arg[2]
local version_file = arg[3]
local scan_file = arg[4]
local as_json = (arg[5] == "true")

local function run_cmd(cmd)
    local p = io.popen(cmd .. " 2>/dev/null", "r")
    if not p then return "" end
    local s = p:read("*a") or ""
    p:close()
    return s:gsub("^%s+", ""):gsub("%s+$", "")
end

local function read_file(path)
    local f = io.open(path, "r")
    if not f then return "" end
    local s = f:read("*a") or ""
    f:close()
    return s:gsub("^%s+", ""):gsub("%s+$", "")
end

local date_str = run_cmd("date '+%Y-%m-%d %H:%M:%S %Z'")
local uname_str = run_cmd("uname -a")
local model_str = read_file("/tmp/sysinfo/model")
if model_str == "" then model_str = read_file("/proc/device-tree/model") end
if model_str == "" then model_str = "OpenWrt Device" end

local os_release = read_file("/etc/openwrt_release")
local memory_str = run_cmd("free -m")
local loadavg_str = read_file("/proc/loadavg")
local disk_str = run_cmd("df -h / /tmp 2>/dev/null")

local app_version = "0.16.1"
local vf = io.open(version_file, "r")
if vf then
    local d = json.parse(vf:read("*a"))
    vf:close()
    if d and d.version then app_version = d.version end
end

local bcw_bin = run_cmd("which blockcheckw")
local bcw_ver = run_cmd("/usr/bin/blockcheckw --version")
local bcw_size = run_cmd("ls -lh /usr/bin/blockcheckw 2>/dev/null | awk '{print $5}'")
local bcw_md5 = run_cmd("md5sum /usr/bin/blockcheckw 2>/dev/null | awk '{print $1}'")

local zapret_status = run_cmd("/etc/init.d/zapret2wizard status 2>/dev/null")
if zapret_status == "" then zapret_status = run_cmd("/etc/init.d/zapret2 status 2>/dev/null") end
local zeroblock_status = run_cmd("/etc/init.d/zeroblock status 2>/dev/null")
local nfqws_procs = run_cmd("ps | grep -E 'nfqws2' | grep -v grep")
local bcw_procs = run_cmd("ps | grep -E 'blockcheckw' | grep -v grep")
local nft_tables = run_cmd("nft list tables 2>/dev/null")
local zapret_uci = run_cmd("uci show zapret2wizard 2>/dev/null | grep -E '\\.name=|\\.strategy=|\\.script=|\\.enabled=|\\.hostlist=|\\.dual_circuit=|\\.ports=' | head -n 35")
if zapret_uci == "" then
    zapret_uci = run_cmd("uci show zapret2 2>/dev/null | grep -E '\\.name=|\\.strategy=|\\.script=|\\.enabled=|\\.hostlist=|\\.dual_circuit=|\\.ports=' | head -n 35")
end
local dns_servers = run_cmd("cat /etc/resolv.conf 2>/dev/null | grep -E '^nameserver' | tr '\\n' ', '")
local ggc_diag = run_cmd("curl -4 -s -k --connect-timeout 2 -m 3 'https://redirector.googlevideo.com/report_mapping?di=no'")
local quic_target = run_cmd("uci -q get firewall.reject_quic.target")
local flow_offload_sw = run_cmd("uci -q get firewall.@defaults[0].flow_offloading")
local flow_offload_hw = run_cmd("uci -q get firewall.@defaults[0].flow_offloading_hw")
local flow_status = "Disabled"
if flow_offload_hw == "1" then
    flow_status = "Hardware (Fastpath HW NAT active, threshold >= 30 pkts)"
elseif flow_offload_sw == "1" then
    flow_status = "Software (Flow Offload active)"
end

local status_json = read_file(status_file)
local status_tbl = json.parse(status_json) or {}

local log_tail = ""
local lf = io.open(log_file, "r")
if lf then
    local lines = {}
    for line in lf:lines() do table.insert(lines, line) end
    lf:close()
    local start_idx = math.max(1, #lines - 80)
    local sub = {}
    for i = start_idx, #lines do table.insert(sub, lines[i]) end
    log_tail = table.concat(sub, "\n")
end

local report_lines = {
    "============================================================",
    "  ZAPRET2WIZARD DIAGNOSTIC REPORT (RouteRich / OpenWrt)",
    "============================================================",
    "Date:        " .. date_str,
    "Device:      " .. model_str,
    "Kernel/Arch: " .. uname_str,
    "Zapret2Wizard: App v" .. app_version .. " | Binary: " .. (bcw_ver ~= "" and bcw_ver or "NOT FOUND"),
    "Binary Path: " .. (bcw_bin ~= "" and bcw_bin or "N/A") .. " (size: " .. bcw_size .. ", md5: " .. bcw_md5 .. ")",
    "",
    "--- OpenWrt Release Info ---",
    os_release ~= "" and os_release or "N/A",
    "",
    "--- Hardware Resources ---",
    "Flow Offloading: " .. flow_status,
    "Load Average: " .. loadavg_str,
    memory_str,
    disk_str,
    "",
    "--- Zapret2 & Services ---",
    "Zapret2 status:   " .. (zapret_status ~= "" and zapret_status or "stopped"),
    "ZeroBlock status: " .. (zeroblock_status ~= "" and zeroblock_status or "not installed / stopped"),
    "Running nfqws2 processes:",
    nfqws_procs ~= "" and nfqws_procs or "  (none)",
    "Active scanner processes:",
    bcw_procs ~= "" and bcw_procs or "  (none)",
    "Nftables tables:",
    nft_tables ~= "" and nft_tables or "  (none)",
    "",
    "--- DNS & Resolvers ---",
    "Nameservers: " .. (dns_servers ~= "" and dns_servers or "N/A"),
    "",
    "--- Google Global Cache (GGC) & QUIC Telemetry ---",
    "GGC Cluster Mapping: " .. (ggc_diag ~= "" and ggc_diag or "Unavailable / Not detected"),
    "Reject-QUIC Status:  " .. (quic_target ~= "" and ("Active (target=" .. quic_target .. ")") or "Not configured in firewall"),
    "",
    "--- Configured Zapret2 Strategies (UCI) ---",
    zapret_uci ~= "" and zapret_uci or "  (none configured)",
    "",
    "--- Scanner State ---",
    "Status:     " .. tostring(status_tbl.status or "unknown"),
    "Percent:    " .. tostring(status_tbl.percent or 0) .. "%",
    "Phase:      " .. tostring(status_tbl.phase or "none"),
    "ISP:        " .. tostring(status_tbl.isp or "not detected"),
    "Block Type: " .. tostring(status_tbl.block_type or "not detected"),
    "",
    "--- Recent Run Log (Last 80 lines) ---",
    log_tail ~= "" and log_tail or "(log is empty)",
    "============================================================",
    "  END OF DIAGNOSTIC REPORT",
    "============================================================"
}

local report_text = table.concat(report_lines, "\n")

if as_json then
    print(json.stringify({ success = true, report = report_text }))
else
    print(report_text)
end
EOF
}

cmd_ensure_hostlists() {
    ensure_all_hostlists
    cmd_info
}

# Фоновая догрузка списков: без вывода и с уборкой маркера.
cmd_ensure_hostlists_bg() {
    ensure_all_hostlists >/dev/null 2>&1 || true
    rm -f /tmp/bcw_ensuring
}

# Единый маппинг «цель -> файл списка доменов». Держит пути в одном месте,
# чтобы add/remove/read/write не разъезжались между собой.
_hostlist_path() {
    case "$1" in
        youtube|preset_youtube) echo "/etc/zapret2wizard/ipset/zapret_hosts_youtube.txt" ;;
        discord|preset_discord) echo "/etc/zapret2wizard/ipset/zapret_hosts_discord.txt" ;;
        x|preset_x) echo "/etc/zapret2wizard/ipset/zapret_hosts_x.txt" ;;
        ytapi|preset_youtubei|youtubei) echo "/etc/zapret2wizard/ipset/zapret_hosts_ytapi.txt" ;;
        auto) echo "/etc/zapret2wizard/ipset/zapret_hosts_auto.txt" ;;
        instagram|preset_instagram) echo "/etc/zapret2wizard/ipset/zapret_hosts_instagram.txt" ;;
        twitch|preset_twitch) echo "/etc/zapret2wizard/ipset/zapret_hosts_twitch.txt" ;;
        user|general|builtin) echo "/etc/zapret2wizard/ipset/zapret_hosts_user.txt" ;;
        exclude|user_exclude|user-exclude|preset_user_exclude) echo "/etc/zapret2wizard/ipset/zapret_hosts_user_exclude.txt" ;;
        *) echo "" ;;
    esac
}

# Нормализация домена: обрезка пробелов, нижний регистр, снятие конечной точки.
_hl_sanitize() {
    printf '%s' "$1" | tr -d ' \t\r\n' | tr 'A-Z' 'a-z' | sed 's/\.$//'
}

# Проверка домена. Поддерживает отменяющую запись с префиксом «^».
# Возвращает 0 для валидного, 1 — для мусора.
_hl_valid() {
    local d="${1#^}"
    [ -n "$d" ] || return 1
    [ "${#d}" -le 253 ] || return 1
    case "$d" in
        *[!a-z0-9.-]*|.*|*.|*-) return 1 ;;
    esac
    printf '%s' "$d" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
}

# Canonical storage/count; private locks serialize cooperating read/modify/write calls.
_hl_info_json() {
    local key file count exists attached enabled running sec refs ref path first=1 cfg name
    running=false
    [ "$(get_dpi_service_status)" = running ] && running=true
    printf '['
    for key in youtube discord x instagram ytapi twitch user exclude; do
        file=$(_hostlist_path "$key"); name="$key"
        case "$key" in youtube) name=YouTube ;; discord) name=Discord ;; x) name='X (Twitter)' ;; instagram) name=Instagram ;; ytapi) name='YouTube API' ;; twitch) name=Twitch ;; user) name='Общие сайты (User)' ;; exclude) name='Исключения (не обходить)' ;; esac
        exists=false; [ -f "$file" ] && [ ! -L "$file" ] && exists=true
        count=$(_hl_count "$file" 2>/dev/null) || count=null
        attached=false; enabled=false; cfg=false
        for sec in $(uci -q show zapret2wizard 2>/dev/null | sed -n 's/^zapret2wizard\.\([^=]*\)=strategy$/\1/p'); do
            refs="$(uci -q get "zapret2wizard.$sec.hostlist") $(uci -q get "zapret2wizard.$sec.hostlist_exclude")"
            for ref in $refs; do
                path=$(uci -q get "zapret2wizard.$ref.path")
                [ "$path" = "$file" ] || continue
                cfg=true; attached=true
                case "$(uci -q get "zapret2wizard.$sec.enabled")" in 0) ;; *) enabled=true ;; esac
            done
        done
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"key":"%s","name":"%s","file":"%s","exists":%s,"domains_count":%s,"uci_configured":%s,"attached":%s,"enabled":%s,"service_running":%s,"runtime_verified":false}' "$key" "$name" "$file" "$exists" "$count" "$cfg" "$attached" "$enabled" "$running"
    done
    printf ']'
}

_hl_load() {
    command -v hostlist_io_save >/dev/null 2>&1 && return 0
    [ -r /usr/share/zapret2wizard/hostlist_io.sh ] || return 1
    . /usr/share/zapret2wizard/hostlist_io.sh
}
_hl_count() { _hl_load && hostlist_io_count "$1"; }
_hl_error() { printf '{"success":false,"saved":false,"error":"%s"}\n' "$1"; }
_hl_revision() {
    if [ -e "$1" ]; then
        local sum
        sum=$(sha256sum < "$1") || return 1
        sum=${sum%% *}
        [ "${#sum}" = 64 ] || return 1
        case "$sum" in *[!0-9a-f]*) return 1 ;; esac
        printf '%s\n' "$sum"
    else printf 'absent\n'; fi
}
_hl_begin() {
    _hl_load || { _hl_error storage_unavailable; return 1; }
    [ -n "$file" ] || { _hl_error unknown_target; return 1; }
    [ ! -L "$file" ] && { [ ! -e "$file" ] || [ -f "$file" ]; } && [ -d "${file%/*}" ] && [ ! -L "${file%/*}" ] || { _hl_error invalid_path; return 1; }
    # uci2config prefers gzip; do not claim an ignored txt edit was applied.
    [ ! -e "$file.gz" ] && [ ! -L "$file.gz" ] || { _hl_error compressed_list_requires_manual_update; return 1; }
    lock="$file.bcw-lock"
    mkdir "$lock" 2>/dev/null || { _hl_error hostlist_busy_retry; return 1; }
    trap 'rm -f "$lock/input" "$lock/content"; rmdir "$lock" 2>/dev/null' 0
    trap 'exit 1' HUP INT TERM
    count=$(_hl_count "$file") || { _hl_error read_failed; return 1; }
    revision=$(_hl_revision "$file") || { _hl_error read_failed; return 1; }
}
_hl_restart() {
    restart=not_requested; restart_started=false; restart_verified=false
    [ "$1" = "1" ] && return 0
    if scan_busy; then restart=deferred_scanner_busy; return 1; fi
    restart=failed
    # Keep activation below the LuCI RPC deadline; saved is already durable-visible.
    timeout -s KILL 10 /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || return 1
    restart_started=true
    wait_dpi_ready 5 >/dev/null 2>&1 || return 1
    restart=verified; restart_verified=true
}
_hl_result() {
    local ok=true
    _hl_restart "$no_restart" || ok=false
    printf '{"success":%s,"saved":true,"file":"%s","written":%s,"skipped":%s,"count":%s,"revision":"%s","restart":"%s","restart_started":%s,"restart_verified":%s' "$ok" "$file" "$written" "$skipped" "$count" "$revision" "$restart" "$restart_started" "$restart_verified"
    case "${op:-}" in add) printf ',"domain":"%s","added":true' "$domain" ;; remove) printf ',"domain":"%s","removed":true' "$domain" ;; esac
    [ "$ok" = true ] || printf ',"error":"saved_but_restart_failed"'
    printf '}\n'
    [ "$ok" = true ]
}
cmd_read_hostlist() (
    local file lock count revision
    file=$(_hostlist_path "${1:-user}")
    _hl_begin || exit 1
    BCW_HL_FILE="$file" BCW_HL_TARGET="${1:-user}" BCW_HL_COUNT="$count" BCW_HL_REVISION="$revision" lua -e '
        local jsonc = require "luci.jsonc"
        local file = os.getenv("BCW_HL_FILE")
        local list, exists = {}, os.getenv("BCW_HL_REVISION") ~= "absent"
        if exists then
            local f = io.open(file, "r")
            if not f then print(jsonc.stringify({success=false,error="read_failed"})); os.exit(1) end
            local content = f:read("*a")
            f:close()
            if not content then print(jsonc.stringify({success=false,error="read_failed"})); os.exit(1) end
            for line in (content .. "\n"):gmatch("([^\n]*)\n") do
                line = line:gsub("^%s+", ""):gsub("%s+$", "")
                if line ~= "" then table.insert(list, line) end
            end
        end
        local encoded = {}
        for _, line in ipairs(list) do encoded[#encoded + 1] = jsonc.stringify(line) end
        local result = jsonc.stringify({success=true,target=os.getenv("BCW_HL_TARGET"),file=file,exists=exists,
            count=tonumber(os.getenv("BCW_HL_COUNT")),revision=os.getenv("BCW_HL_REVISION")})
        print(result:sub(1, -2) .. ",\"domains\":[" .. table.concat(encoded, ",") .. "]}")
    '
)
_hl_mutate() (
    local op="$1" target="${2:-user}" domain="${3:-}" no_restart=0
    local file lock count revision tmp written=0 skipped=0 rc restart restart_started restart_verified
    [ "${4:-}" = --no-restart ] && no_restart=1
    file=$(_hostlist_path "$target")
    domain=$(_hl_sanitize "$domain")
    _hl_valid "$domain" || { _hl_error invalid_domain; exit 1; }
    _hl_begin || exit 1
    tmp="$lock/content"
    if [ -e "$file" ]; then cat "$file" > "$tmp" || { _hl_error read_failed; exit 1; }
    else : > "$tmp" || { _hl_error staging_failed; exit 1; }; fi
    grep -qxF -e "$domain" "$tmp"; rc=$?
    [ "$rc" -le 1 ] || { _hl_error read_failed; exit 1; }
    if { [ "$op" = add ] && [ "$rc" = 0 ]; } || { [ "$op" = remove ] && [ "$rc" = 1 ]; }; then
        printf '{"success":true,"saved":false,"file":"%s","domain":"%s","revision":"%s","already_%s":true,"count":%s,"restart":"not_requested","restart_started":false,"restart_verified":false}\n' "$file" "$domain" "$revision" "$([ "$op" = add ] && echo exists || echo absent)" "$count"
        exit 0
    fi
    if [ "$op" = add ]; then
        printf '\n%s\n' "$domain" >> "$tmp" || { _hl_error staging_failed; exit 1; }
    else
        awk -v domain="$domain" '$0 != domain {print}' "$tmp" > "$lock/input" && cat "$lock/input" > "$tmp" || { _hl_error staging_failed; exit 1; }
    fi
    count=$(_hl_count "$tmp") || { _hl_error count_failed; exit 1; }
    revision=$(_hl_revision "$tmp") || { _hl_error read_failed; exit 1; }
    hostlist_io_save "$tmp" "$file" || { _hl_error save_failed; exit 1; }
    written=$count
    _hl_result
)
cmd_add_hostlist_domain() { _hl_mutate add "$@"; }
cmd_remove_hostlist_domain() { _hl_mutate remove "$@"; }
_hl_collect() {
    local line rc
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(_hl_sanitize "$line") || return 1
        [ -n "$line" ] || continue
        case "$line" in "#"*) continue ;; esac
        if ! _hl_valid "$line"; then skipped=$((skipped + 1)); continue; fi
        grep -qxF -e "$line" "$tmp"; rc=$?
        [ "$rc" -le 1 ] || return 1
        [ "$rc" = 0 ] && continue
        printf '%s\n' "$line" >> "$tmp" || return 1
        written=$((written + 1))
    done
}
cmd_write_hostlist() (
    local target="${1:-user}" file lock count revision expected="" no_restart=0 src_file="" domains="" empty=0
    local tmp written=0 skipped=0 restart restart_started restart_verified
    shift 2>/dev/null || true
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-restart) no_restart=1 ;;
            --empty) empty=1 ;;
            --revision|--file)
                [ "$#" -ge 2 ] || { _hl_error missing_argument; exit 1; }
                if [ "$1" = --revision ]; then expected="$2"; else src_file="$2"; fi
                shift ;;
            *) domains="$domains
$1" ;;
        esac
        shift
    done
    file=$(_hostlist_path "$target")
    _hl_begin || exit 1
    [ -z "$expected" ] || [ "$expected" = "$revision" ] || { _hl_error stale_revision_reload; exit 1; }
    tmp="$lock/content"
    : > "$tmp" || { _hl_error staging_failed; exit 1; }
    if [ -n "$domains" ]; then
        _hl_collect <<EOF
$domains
EOF
    elif [ -n "$src_file" ]; then
        [ ! -L "$src_file" ] && [ -f "$src_file" ] && cat "$src_file" > "$lock/input" || { _hl_error source_read_failed; exit 1; }
        _hl_collect < "$lock/input"
    elif [ "$empty" = 1 ]; then :
    else
        cat > "$lock/input" || { _hl_error source_read_failed; exit 1; }
        _hl_collect < "$lock/input"
    fi
    [ "$?" = 0 ] || { _hl_error staging_failed; exit 1; }
    count=$(_hl_count "$tmp") || { _hl_error count_failed; exit 1; }
    revision=$(_hl_revision "$tmp") || { _hl_error read_failed; exit 1; }
    hostlist_io_save "$tmp" "$file" || { _hl_error save_failed; exit 1; }
    _hl_result
)

# Тестовый режим: source helper без запуска диспетчера.
if [ "${BCW_LIB_ONLY:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

# ============================================================
#  Классификатор «КЛАСС ТСПУ» (порт saitkul/tspu-class-test v2.5).
#  Прогоняет каталог из 34 стратегий через сканер и печатает вердикт
#  (L0-/L0/L2/особый/аномалия) отдельно по TLS 1.2 и TLS 1.3.
#  Служба на время прогона останавливается и возвращается сторожем.
# ============================================================
TSPU_CATALOG="/usr/share/zapret2wizard/tspu_catalog.txt"
TSPU_CLASSIFIER="/usr/share/zapret2wizard/tspu_classifier.lua"
TSPU_RESULT="/tmp/bcw_tspu_result.json"

tspu_running() {
    [ -f /tmp/bcw_tspu.pid ] && kill -0 "$(cat /tmp/bcw_tspu.pid 2>/dev/null)" 2>/dev/null
}

cmd_tspu_class() {
    local domain="${1:-www.youtube.com}"
    case "$domain" in
        *[!A-Za-z0-9.-]*|-) printf '{"ok":false,"error":"Некорректный домен"}\n'; return 0 ;;
    esac

    # Взаимоисключение: подбор и классификация оба трогают службу и очереди
    if tspu_running; then
        printf '{"ok":false,"error":"Классификация уже выполняется"}\n'
        return 0
    fi
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
        printf '{"ok":false,"error":"Идёт подбор - дождитесь его завершения"}\n'
        return 0
    fi
    if ps w | grep -qE '[b]lockcheckw-helper (start|apply) '; then
        printf '{"ok":false,"error":"Идёт подбор - дождитесь его завершения"}\n'
        return 0
    fi
    [ -f "$TSPU_CATALOG" ] || { printf '{"ok":false,"error":"Каталог ТСПУ не найден"}\n'; return 0; }
    [ -f "$TSPU_CLASSIFIER" ] || { printf '{"ok":false,"error":"Классификатор не найден"}\n'; return 0; }
    [ -x /usr/bin/blockcheckw ] || { printf '{"ok":false,"error":"Сканер не установлен"}\n'; return 0; }
    scan_preflight || return 0

    # Фоновый запуск: UI будет опрашивать tspu_class_status
    if [ "$2" = "bg" ]; then
        rm -f /tmp/bcw_tspu.stop
        : > /tmp/bcw_tspu_run.log
        /bin/sh -c "/usr/bin/blockcheckw-helper tspu_class_run '$domain' > /tmp/bcw_tspu_run.log 2>&1 &"
        sleep 1
        if tspu_running; then
            printf '{"ok":true,"started":true,"domain":"%s"}\n' "$domain"
        else
            printf '{"ok":false,"error":"не удалось запустить"}\n'
            head -n 5 /tmp/bcw_tspu_run.log 2>/dev/null
        fi
        return 0
    fi

    cmd_tspu_class_run "$domain"
}

cmd_tspu_class_run() {
    local domain="${1:-www.youtube.com}"
    echo $$ > /tmp/bcw_tspu.pid
    local was=0
    if _svc_running; then was=1; _svc_stop; fi
    : > /tmp/bcw_scan_paused
    # сторож: вернуть службу, если этот процесс умрёт (kill, перезагрузка UI)
    (
        i=0
        while [ -f /tmp/bcw_tspu.pid ] && [ "$i" -lt 40 ]; do
            sleep 15
            i=$((i + 1))
        done
        sleep 5
        if ! _svc_running; then
            _svc_start_bg
            logger -t zapret2wizard "сторож классификации: служба поднята"
        fi
    ) &

    local qnum=$(pick_scan_qnum)
    local scan_home=/tmp/bcw_scan_home
    local scan_dns=$(scan_dns_mode "$domain")
    local out="/tmp/bcw_tspu_scan.json"
    mkdir -p "$scan_home" 2>/dev/null || true
    rm -f "$out"
    printf '{"state":"running","percent":10,"phase":"Классификация ТСПУ: %s"}\n' "$domain" > /tmp/bcw_tspu_status.json

    echo "[blockcheckw-helper] TSPU class: прогон 34-стратегического каталога по $domain (queue $qnum)" >> "$LOG_FILE"
    HOME="$scan_home" /usr/bin/blockcheckw --qnum "$qnum" -w 2 scan -d "$domain" -p tls12,tls13 --dns "$scan_dns" --from-file "$TSPU_CATALOG" -o "$out" --auto --timeout 300 >> "$LOG_FILE" 2>&1

    printf '{"state":"running","percent":80,"phase":"Считаю вердикт класса ТСПУ..."}\n' > /tmp/bcw_tspu_status.json

    # Вернуть службу
    [ "$was" = "1" ] && _svc_start_bg
    rm -f /tmp/bcw_scan_paused
    rm -f /tmp/bcw_tspu.pid

    if [ ! -s "$out" ]; then
        printf '{"ok":false,"error":"Скан не дал результата (см. лог)"}\n' > "$TSPU_RESULT"
        printf '{"state":"error","percent":100,"phase":"Скан не дал результата"}\n' > /tmp/bcw_tspu_status.json
        cat "$TSPU_RESULT"
        return 0
    fi

    lua "$TSPU_CLASSIFIER" "$out" "$TSPU_CATALOG" > "$TSPU_RESULT" 2>/dev/null || {
        printf '{"ok":false,"error":"Ошибка классификатора"}\n' > "$TSPU_RESULT"
    }

    # Дописываем контекст для UI (domain/time)
    lua - "$TSPU_RESULT" "$domain" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local rf, df = arg[1], arg[2]
local f = io.open(rf, "r")
local d = f and json.parse(f:read("*a")) or { ok = false }
if f then f:close() end
d.domain = df
d.time = os.time()
if d.ok then
    local out = io.open(rf, "w")
    if out then out:write(json.stringify(d, true)); out:close() end
end
print(json.stringify(d))
EOF

    printf '{"state":"done","percent":100,"phase":"Готово"}\n' > /tmp/bcw_tspu_status.json
    local cls=$(sed -n 's/.*"verdict":"\([^"]*\)".*/\1/p' "$TSPU_RESULT" | head -n 1)
    history_add "tspu_class" "$domain" "${cls:-классификация завершена}" >/dev/null 2>&1 || true
    cat "$TSPU_RESULT"
}

cmd_tspu_class_status() {
    if tspu_running; then
        cat /tmp/bcw_tspu_status.json 2>/dev/null || printf '{"state":"running","percent":0,"phase":"..."}\n'
    else
        cat /tmp/bcw_tspu_status.json 2>/dev/null || printf '{"state":"idle"}\n'
    fi
}

cmd_tspu_class_report() {
    if [ -s "$TSPU_RESULT" ]; then
        cat "$TSPU_RESULT"
    else
        printf '{"ok":false,"error":"Классификация ещё не выполнялась"}\n'
    fi
}

# ============================================================
#  Мониторинг доступности: фоновый контроль живости текущей стратегии.
#  Каждые N секунд один запрос через живой Zapret2; история
#  ОК/СБОЙ в /tmp/bcw_canary.log (ротация 256 КБ -> старый файл).
#  Во время подбора/классификации проверки пропускаются.
# ============================================================
CANARY_PIDF="/tmp/bcw_canary.pid"
CANARY_STATUS="/tmp/bcw_canary.status"
CANARY_LOG="/tmp/bcw_canary.log"

canary_alive() {
    [ -f "$CANARY_PIDF" ] && kill -0 "$(cat "$CANARY_PIDF" 2>/dev/null)" 2>/dev/null
}

canary_stop_silent() {
    touch /tmp/bcw_canary.stop 2>/dev/null
    if canary_alive; then kill "$(cat "$CANARY_PIDF" 2>/dev/null)" 2>/dev/null; fi
    sleep 1
    if canary_alive; then kill -9 "$(cat "$CANARY_PIDF" 2>/dev/null)" 2>/dev/null; fi
    rm -f "$CANARY_PIDF"
}

cmd_canary_start() {
    lifecycle_load || return 1
    bcw_lifecycle_policy_run policy cmd_canary_start_locked "$@"
}
cmd_canary_start_locked() {
    [ ! -e /var/run/bcw_service.stopped ] || return 1
    local target="${1:-preset_youtube}"
    local interval="${2:-300}"
    case "$interval" in *[!0-9]*) interval=300 ;; esac
    [ "$interval" -lt 60 ] && interval=60
    [ "$interval" -gt 3600 ] && interval=3600
    local domain=$(target_domain "$target")
    [ -n "$domain" ] || domain="www.youtube.com"

    canary_stop_silent
    rm -f /tmp/bcw_canary.stop
    /bin/sh -c "/usr/bin/blockcheckw-helper canary_run '$domain' '$interval' > /tmp/bcw_canary_run.log 2>&1 &"
    sleep 1
    if canary_alive; then
        printf '{"ok":true,"started":true,"domain":"%s","interval":%s}\n' "$domain" "$interval"
        history_add "canary" "$domain" "мониторинг доступности запущен (каждые ${interval} с)" >/dev/null 2>&1 || true
    else
        printf '{"ok":false,"error":"не удалось запустить мониторинг доступности"}\n'
        head -n 3 /tmp/bcw_canary_run.log 2>/dev/null
    fi
}

cmd_canary_stop() {
    canary_stop_silent
    printf '{"ok":true,"stopped":true}\n'
}

cmd_canary_status() {
    local last_result="none"
    local last=""
    local dom=""
    if [ -s "$CANARY_STATUS" ]; then
        last_result=$(sed -n 's/^last_result=//p' "$CANARY_STATUS" 2>/dev/null | tail -n 1)
        last=$(sed -n 's/^last=//p' "$CANARY_STATUS" 2>/dev/null | tail -n 1)
        dom=$(sed -n 's/^dom=//p' "$CANARY_STATUS" 2>/dev/null | tail -n 1)
    fi
    local oks=0 fails=0 skips=0
    if [ -s "$CANARY_LOG" ]; then
        oks=$(grep -c "— ОК" "$CANARY_LOG" 2>/dev/null || true)
        fails=$(grep -c "— СБОЙ" "$CANARY_LOG" 2>/dev/null || true)
        skips=$(grep -c "— пропуск" "$CANARY_LOG" 2>/dev/null || true)
    fi
    local okn=$(echo "$oks" | tr -dc '0-9')
    local failn=$(echo "$fails" | tr -dc '0-9')
    local skipn=$(echo "$skips" | tr -dc '0-9')
    printf '{"alive":%s,"last_result":"%s","last":"%s","domain":"%s","ok":%s,"fail":%s,"skip":%s}\n' \
        "$(canary_alive && echo 1 || echo 0)" "$last_result" "$last" "$dom" \
        "${okn:-0}" "${failn:-0}" "${skipn:-0}"
}

cmd_canary_log() {
    if [ -s "$CANARY_LOG" ]; then
        tail -n "${1:-30}" "$CANARY_LOG" 2>/dev/null
    else
        echo "Проверок ещё не было."
    fi
}

cmd_canary_run() {
    local dom="$1" iv="$2"
    echo $$ > "$CANARY_PIDF"
    trap 'rm -f "$CANARY_PIDF"' EXIT
    trap 'rm -f "$CANARY_PIDF"; exit 0' INT TERM
    # Ротация: как у основного лога — 256 КБ, старый файл
    if [ -f "$CANARY_LOG" ] && [ "$(wc -c < "$CANARY_LOG" 2>/dev/null)" -gt 262144 ] 2>/dev/null; then
        mv -f "$CANARY_LOG" "$CANARY_LOG.old" 2>/dev/null || true
        : > "$CANARY_LOG"
        echo "$(date '+%Y-%m-%d %H:%M:%S') — (старые записи в $CANARY_LOG.old)" >> "$CANARY_LOG"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S') — мониторинг доступности запущен: домен $dom, проверка каждые ${iv} с" >> "$CANARY_LOG"
    local lastres="старт"
    while true; do
        # Во время подбора/классификации замер ничего не говорит о нашей стратегии
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') — пропуск: идёт подбор" >> "$CANARY_LOG"
            lastres="пропуск"
        elif tspu_running; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') — пропуск: идёт классификация" >> "$CANARY_LOG"
            lastres="пропуск"
        elif _svc_running; then
            local r
            r=$(curl -4 -k -s -o /dev/null --max-time 6 -w "%{http_code}|%{time_total}" "https://$dom/generate_204" 2>/dev/null)
            local code=$(echo "$r" | cut -d"|" -f1)
            local tt=$(echo "$r" | cut -d"|" -f2)
            if [ -n "$code" ] && [ "$code" != "000" ]; then
                echo "$(date '+%Y-%m-%d %H:%M:%S') — ОК (код=$code, ${tt:-?} с)" >> "$CANARY_LOG"
                lastres="ОК"
            else
                echo "$(date '+%Y-%m-%d %H:%M:%S') — СБОЙ (сайт не открылся)" >> "$CANARY_LOG"
                lastres="СБОЙ"
                history_add "canary" "$dom" "СБОЙ — стратегия не отвечает" >/dev/null 2>&1 || true
            fi
        else
            echo "$(date '+%Y-%m-%d %H:%M:%S') — пропуск: служба не запущена" >> "$CANARY_LOG"
            lastres="пропуск"
        fi
        printf 'last_result=%s\nlast=%s\ndom=%s\n' "$lastres" "$(date '+%Y-%m-%d %H:%M:%S')" "$dom" > "$CANARY_STATUS"
        local slept=0
        while [ "$slept" -lt "$iv" ]; do
            [ -f /tmp/bcw_canary.stop ] && { rm -f "$CANARY_PIDF"; exit 0; }
            sleep 1
            slept=$((slept + 1))
        done
    done
}

# Ограничиваем /tmp/blockcheckw_run.log: при интенсивном подборе он рос
# без предела. Ротация только при новом вызове, один старый файл.
if [ -f "$LOG_FILE" ]; then
    _log_sz=$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)
    if [ "${_log_sz:-0}" -gt 262144 ] 2>/dev/null; then
        mv -f "$LOG_FILE" "$LOG_FILE.old" 2>/dev/null || true
        : > "$LOG_FILE"
    fi
fi

