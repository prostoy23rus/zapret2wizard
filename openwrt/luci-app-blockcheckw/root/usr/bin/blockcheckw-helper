    logs) shift; cmd_logs "$@" ;;
    check_update) cmd_check_update ;;
    update) cmd_update ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    diag) shift; cmd_diag "$@" ;;
    ensure_hostlists) shift; cmd_ensure_hostlists "$@" ;;
    read_hostlist) shift; cmd_read_hostlist "$@" ;;
    add_hostlist_domain) shift; cmd_add_hostlist_domain "$@" ;;
    remove_hostlist_domain) shift; cmd_remove_hostlist_domain "$@" ;;
    write_hostlist) shift; cmd_write_hostlist "$@" ;;
    metrics) cmd_metrics ;;
    toggle) shift; cmd_toggle_service "$@" ;;
    conflicts) cmd_conflicts ;;
    doctor) shift; cmd_doctor "$@" ;;
    install_engine) cmd_install_engine ;;
    selftest) shift; cmd_selftest "$@" ;;
    class) shift; cmd_class "$@" ;;
    autosetup) shift; cmd_autosetup "$@" ;;
    evolve) shift; cmd_evolve "$@" ;;
    evolve_status) cmd_evolve_status ;;
    evolve_start) shift; cmd_evolve_start "$@" ;;
    evolve_nightly) cmd_evolve_nightly ;;
    evolve_export) shift; cmd_evolve_export "$@" ;;
    evolve_import) shift; cmd_evolve_import "$@" ;;
    catalog_fetch) shift; cmd_catalog_fetch "$@" ;;
    catalog_export) cmd_catalog_export ;;
    health_tick) cmd_health_tick ;;
    steer_sync|bypass_sync) shift; cmd_bypass "$@" ;;
    bypass) shift; cmd_bypass "$@" ;;
    bypass_warm) bp_resolve_ips ;;
    bypass_watch) cmd_bypass_watch ;;
    ensure_hostlists_bg) cmd_ensure_hostlists_bg ;;
    service) shift; cmd_service "$@" ;;
    svc_heal) _svc_heal ;;
