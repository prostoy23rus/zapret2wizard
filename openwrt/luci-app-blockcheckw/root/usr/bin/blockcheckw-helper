            lua - "$OUTPUT_SCAN" "$OUTPUT_VANILLA" > "$candidates" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local out, seen, fams = {}, {}, {}
local function add(a)
    if type(a) ~= "string" or a == "" then return false end
    a = a:gsub("^%s+", ""):gsub("%s+$", "")
    if a:sub(1, 2) ~= "--" or seen[a] then return false end
    local fam = a:match("lua%-desync=([%w_]+)") or "other"
    if fams[fam] then return false end
    fams[fam] = true
    seen[a] = true
    out[#out + 1] = a
    return true
end
-- issue #9c: ранг сканера детерминирован — при равном coverage один и тот
-- же кандидат выигрывал каждый прогон (петля memory seed → тот же победитель).
-- Топ по coverage сохраняем, равных перемешиваем, семьи техник не смешиваем.
local ranked = {}
local f = io.open(arg[1], "r")
if f then
    local d = json.parse(f:read("*a")) or {}
    f:close()
    for _, s in ipairs(d.strategies or {}) do
        local a = (type(s) == "table" and s.args) or s
        if type(a) == "string" and a:sub(1, 2) == "--" then
            local cov = 0
            if type(s) == "table" and s.coverage then cov = tonumber(s.coverage) or 0 end
            ranked[#ranked + 1] = { args = a, cov = cov }
        end
    end
end
-- BCW_CANDIDATE_SEED=0 отключает перемешивание (детерминированные тесты/CI),
-- 1+ — воспроизводимое перемешивание, пусто — случайное на каждый прогон.
local cand_seed = os.getenv("BCW_CANDIDATE_SEED")
local do_shuffle = cand_seed ~= "0"
if do_shuffle then
    local n_seed = tonumber(cand_seed or "")
    if n_seed and n_seed > 0 then
        pcall(math.randomseed, math.floor(n_seed) % 2147483647)
    else
        -- os.time() имеет разрешение в секунду: два прогона в одну секунду
        -- дали бы одинаковый порядок. Энтропия из /dev/urandom, запасной — time.
        local seed = nil
        local rf = io.open("/dev/urandom", "rb")
        if rf then
            local b = rf:read(4)
            rf:close()
            if b and #b == 4 then
                local b1, b2, b3, b4 = string.byte(b, 1, 4)
                seed = b1 + b2 * 256 + b3 * 65536 + b4 * 16777216
            end
        end
        -- randomseed в разных сборках Lua требует целое в 32-битном
        -- диапазоне; pcall чтобы кривой seed никогда не ломал подбор.
        local ok_seed = pcall(math.randomseed, math.floor((seed or os.time()) % 2147483647))
        if not ok_seed then pcall(math.randomseed, math.floor(os.time()) % 2147483647) end
    end
end
table.sort(ranked, function(x, y) return x.cov > y.cov end)
local i = 1
while do_shuffle and i <= #ranked do
    local j = i
    while j < #ranked and ranked[j + 1].cov == ranked[i].cov do j = j + 1 end
    for k = j, i + 1, -1 do
        local m = math.random(i, k)
        ranked[k], ranked[m] = ranked[m], ranked[k]
    end
    i = j + 1
end
for _, st in ipairs(ranked) do
    if add(st.args) and #out >= 3 then break end
end
if #out < 3 then
    local vf = io.open(arg[2], "r")
    if vf then
        local lines = {}
        for line in vf:lines() do
            local a = line:match(": nfqws2 (%-%-.*)$") or line:match("^%s*(%-%-.*)$")
            if a then lines[#lines + 1] = a end
        end
        vf:close()
        for k = #lines, 2, -1 do
            local m = math.random(1, k)
            lines[k], lines[m] = lines[m], lines[k]
        end
        for _, a in ipairs(lines) do
            if add(a) and #out >= 3 then break end
        end
    end
end
for _, a in ipairs(out) do print(a) end
EOF
            local cand tried=0 best_single=""
            local cfg_pkg=$(_strategy_pkg)
            local cfg_backup="/tmp/bcw_cfg_before_apply.$$"
            cp -f "/etc/config/$cfg_pkg" "$cfg_backup" 2>/dev/null || true

            while [ "$tried" -lt 3 ] && IFS= read -r cand; do
