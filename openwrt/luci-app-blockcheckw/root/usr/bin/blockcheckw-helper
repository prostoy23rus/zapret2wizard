#!/bin/sh
# демоны (start-stop-daemon) получают урезанный PATH
PATH=/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}
export PATH
# BlockcheckW Zapret2 Integration Helper for OpenWrt
# Bridges blockcheckw scanner with OpenWrt LuCI and Zapret2 configuration.

STATUS_FILE="/tmp/blockcheckw_status.json"
PID_FILE="/var/run/blockcheckw.pid"
LOG_FILE="/tmp/blockcheckw_run.log"
OUTPUT_VANILLA="/tmp/blockcheckw_vanilla.txt"
OUTPUT_SCAN="/tmp/blockcheckw_scan.json"
RESULTS_DIR="/tmp/bcw_results"
OUTPUT_CIRCULAR="/tmp/blockcheckw_circular.txt"
TURBO_FILE="/tmp/blockcheckw_turbo.txt"
PRESETS_FILE="/usr/share/blockcheckw/zapret2_presets.json"
CIRCULAR_BUILDER="/usr/bin/circular-builder.lua"

# Результаты последних проверок по сервисам и журнал событий для вкладок
# «Результаты» и «История». Обычные JSON-файлы, читаются командой metrics.
METRICS_FILE="/etc/zapret2wizard/tests.json"
HISTORY_FILE="/etc/zapret2wizard/history.jsonl"
HISTORY_LIMIT=200

VERSION_FILE="/usr/share/blockcheckw/version.json"
REPO_RAW="https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main"

fetch_file() {
    local rel_path="$1"
    local dest="$2"
    local timeout="${3:-12}"
    local tmp_file="${dest}.dl.$$"

    rm -f "$tmp_file"

    _save_download() {
        if [ -s "$tmp_file" ]; then
            # Verify file does not contain HTML error page
            if head -n 3 "$tmp_file" | grep -qiE 'not found|404|bad gateway|502|<html>|<head>|access denied'; then
                rm -f "$tmp_file"
                return 1
            fi
            mv -f "$tmp_file" "$dest"
            return 0
        fi
        rm -f "$tmp_file"
        return 1
    }

    # Ensure /etc/hosts maps raw.githubusercontent.com to Fastly anycast IP if local DNS sinkholes it to 127.0.0.1
    if ! grep -q 'raw.githubusercontent.com' /etc/hosts 2>/dev/null; then
        echo '185.199.108.133 raw.githubusercontent.com' >> /etc/hosts
        /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
    fi

    # Жёсткий бюджет на весь вызов: не даём установке и LuCI зависнуть.
    local tmo=5
    [ "$timeout" -lt 5 ] && tmo="$timeout"
    local deadline=$(( $(date +%s) + 14 ))

    # 1. Direct GitHub Raw (два адреса, не четыре)
    for gh_ip in 185.199.108.133 185.199.111.133; do
        [ "$(date +%s)" -ge "$deadline" ] && break
        curl -fsSL -k --connect-timeout 2 -m "$tmo" --resolve "raw.githubusercontent.com:443:$gh_ip" "https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/$rel_path" -o "$tmp_file" 2>/dev/null
        _save_download && return 0
    done

    # 2. jsDelivr (обычно доступен)
    [ "$(date +%s)" -lt "$deadline" ] && \
    curl -fsSL -k --connect-timeout 2 -m "$tmo" "https://cdn.jsdelivr.net/gh/prostoy23rus/zapret2wizard@main/$rel_path" -o "$tmp_file" 2>/dev/null
    _save_download && return 0

    # 3. Fastly jsDelivr
    [ "$(date +%s)" -lt "$deadline" ] && \
    curl -fsSL -k --connect-timeout 2 -m "$tmo" "https://fastly.jsdelivr.net/gh/prostoy23rus/zapret2wizard@main/$rel_path" -o "$tmp_file" 2>/dev/null
    _save_download && return 0

    rm -f "$tmp_file"
    return 1
}

is_scanner_running() {
    # 1. Exact match for compiled scanner binary
    if pidof blockcheckw >/dev/null 2>&1 || pgrep -x blockcheckw >/dev/null 2>&1; then
        return 0
    fi

    # 2. Check recorded child/background PID
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$pid" ] && [ "$pid" != "$$" ] && [ -d "/proc/$pid" ]; then
            local cmd=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\000' ' ')
            if echo "$cmd" | grep -q 'blockcheckw ' && ! echo "$cmd" | grep -q 'blockcheckw-hel'; then
                return 0
            fi
        fi
    fi

    # 3. Fallback: check process table excluding helper processes
    if ps -w | grep -v grep | grep -v 'blockcheckw-hel' | grep -qE '/usr/bin/blockcheckw\b'; then
        return 0
    fi
    return 1
}

ensure_json() {
    [ -f "$STATUS_FILE" ] || echo '{"status":"idle","percent":0,"phase":"Готов к работе","strategies":[],"log":""}' > "$STATUS_FILE"
}

_add_domains_if_missing() {
    local file="$1"
    shift
    touch "$file" 2>/dev/null
    local added=0
    for dom in "$@"; do
        [ -n "$dom" ] || continue
        local esc_dom=$(echo "$dom" | sed 's/\./\\./g')
        if ! grep -qiE "^[[:space:]]*${esc_dom}[[:space:]]*$" "$file" 2>/dev/null; then
            echo "$dom" >> "$file"
            added=1
        fi
    done
    chmod 644 "$file" 2>/dev/null
}

# One-time migration if zapret2wizard config does not exist
if [ ! -f /etc/config/zapret2wizard ] && [ -f /etc/config/zapret2 ]; then
    sed "s/config zapret2 'main'/config zapret2wizard 'main'/g; s|/opt/zapret2/ipset/|/etc/zapret2wizard/ipset/|g" /etc/config/zapret2 > /etc/config/zapret2wizard 2>/dev/null || true
fi

# Страховка: служба была остановлена на время подбора и не поднялась (скан убит,
# страница закрыта). Тогда поднимаем её и убираем маркер.
ensure_dpi_service() {
    [ -f /tmp/bcw_scan_paused ] || return 0
    # Пока подбор идёт (живой лок), службу не поднимаем: она перехватывает пробный трафик
    if [ -d /var/run/bcw_scan.lock ]; then
        local _sp=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        if [ -n "$_sp" ] && kill -0 "$_sp" 2>/dev/null; then
            return 0
        fi
    fi
    if get_dpi_service_status | grep -q running; then
        rm -f /tmp/bcw_scan_paused
        return 0
    fi
    _svc_start_bg
    rm -f /tmp/bcw_scan_paused
    logger -t zapret2wizard "служба была остановлена подбором и поднята автоматически"
}

restart_dpi_service() {
    [ -x /usr/share/zapret2wizard/uci2config ] && /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
    # Перезапуск в фоне: procd-lock может быть занят, и sync-вызов подвесил бы подбор.
    if [ -x /etc/init.d/zapret2wizard ]; then
        ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
    fi
}

# Быстрые операции со службой: procd/ubus может подвиснуть, а нам нужен отклик.
# Наши движки: только экземпляры службы (очереди 300/65300/65301).
# Чужие nfqws2 из других пакетов не трогаем — это и есть «без конфликтов».
our_engines() {
    local c p cmd
    for c in /proc/[0-9]*/comm; do
        [ -r "$c" ] || continue
        [ "$(cat "$c" 2>/dev/null)" = "nfqws2" ] || continue
        p=${c#/proc/}; p=${p%/comm}
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        case "$cmd" in
            *--qnum=300\ *|*--qnum=65300\ *|*--qnum=65301\ *) echo "$p" ;;
        esac
    done
}
_svc_running() { [ -n "$(our_engines)" ]; }

# Жив ли владелец scan-лока. Keeper — это "sleep 7200": он может пережить
# убитый скан и держать лок два часа, поэтому одного kill -0 недостаточно.
_scan_lock_alive() {
    local p="$1"
    [ -n "$p" ] || return 1
    kill -0 "$p" 2>/dev/null || return 1
    local cmd
    cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
    case "$cmd" in
        *blockcheckw*) return 0 ;;
    esac
    # keeper-sleep сам по себе ничего не значит: смотрим scan_pid (shell скана)
    # и реальный процесс сканера.
    local sp
    sp=$(cat /var/run/bcw_scan.lock/scan_pid 2>/dev/null)
    if [ -n "$sp" ] && kill -0 "$sp" 2>/dev/null; then
        cmd=$(tr '\0' ' ' < "/proc/$sp/cmdline" 2>/dev/null)
        case "$cmd" in
            *blockcheckw*) return 0 ;;
        esac
    fi
    local q qcmd
    for q in /proc/[0-9]*; do
        q="${q#/proc/}"
        qcmd=$(tr '\0' ' ' < "/proc/$q/cmdline" 2>/dev/null)
        case "$qcmd" in
            *"/usr/bin/blockcheckw "*|*"blockcheckw check"*|*"blockcheckw scan"*) return 0 ;;
        esac
    done
    return 1
}
_svc_stop() {
    # Останавливаем через procd: иначе respawn поднимет движок прямо во время подбора.
    # init stop иногда зависает (procd ждёт pidfile/движки) — ограничиваем 8 с,
    # иначе подбор навсегда застревает на фазе «Инициализация 10%».
    if [ -x /etc/init.d/zapret2wizard ]; then
        ( BCW_INTERNAL_STOP=1 /etc/init.d/zapret2wizard stop >/dev/null 2>&1 ) &
        local sp=$!
        local i=0
        while kill -0 "$sp" 2>/dev/null && [ "$i" -lt 8 ]; do
            sleep 1
            i=$((i + 1))
        done
        kill -9 "$sp" 2>/dev/null || true
    fi
    local p
    for p in $(our_engines); do kill "$p" 2>/dev/null; done
    sleep 1
    for p in $(our_engines); do kill -9 "$p" 2>/dev/null; done
    nft delete table inet zapret2wizard 2>/dev/null || true
}
_svc_start_bg() {
    local now=$(date +%s)
    local last=$(cat /tmp/bcw_svc_start.last 2>/dev/null || echo 0)
    if [ $((now - last)) -lt 20 ]; then
        return 0
    fi
    echo "$now" > /tmp/bcw_svc_start.last
    ( /etc/init.d/zapret2wizard start >/dev/null 2>&1 & )
}

# Самовосстановление: движки есть, а nft-таблицы нет — поднять заново.
_svc_heal() {
    _svc_running || return 0
    # дубли движков: должно быть ровно 3
    local n=$(our_engines | wc -l)
    if [ "${n:-0}" -gt 4 ]; then
        _svc_stop
        _svc_start_bg
        return 0
    fi
    nft list table inet zapret2wizard >/dev/null 2>&1 && return 0
    # сначала пробуем восстановить из снимка — это быстро и без procd
    if [ -s /etc/zapret2wizard/fw.nft ]; then
        if nft -f /etc/zapret2wizard/fw.nft >/dev/null 2>&1; then
            logger -t zapret2wizard "nft-таблица восстановлена из снимка"
            return 0
        fi
    fi
    _svc_start_bg
}

get_dpi_service_status() {
    # Не зовём init status: он ходит в ubus/procd и может подвиснуть.
    if [ -n "$(our_engines)" ]; then
        echo "running"
    else
        echo "inactive"
    fi
}

# Ждём реальной готовности службы: движки подняты И nft-таблица создана.
# Один sleep перед проверкой не годится: на медленных роутерах служба
# поднимается дольше, и тест стратегии падал на пустом месте.
wait_dpi_ready() {
    local limit="${1:-25}" i=0
    while [ "$i" -lt "$limit" ]; do
        if _svc_running && nft list table inet zapret2wizard >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

# Свободная очередь NFQUEUE для подбора. Раньше был жёсткий --qnum 400:
# на роутере, где этот номер занят чужим движком, пробы «слепли» и подбор
# заканчивался нулём. Теперь берём первый незанятый номер из 400..499.
pick_scan_qnum() {
    local used=" " q=400 i=0 c
    for d in /proc/[0-9]*/cmdline; do
        [ -r "$d" ] || continue
        c=$(tr '\0' '\n' < "$d" 2>/dev/null | grep -o '^--qnum=[0-9][0-9]*$' | cut -d= -f2)
        [ -n "$c" ] && used="$used$c "
    done
    while [ "$i" -lt 100 ]; do
        case "$used" in
            *" $q "*) q=$((q + 1)); i=$((i + 1)) ;;
            *) break ;;
        esac
    done
    echo "$q"
}

# Реальный пакет конфигурации: автономный zapret2wizard или старый zapret2.
_strategy_pkg() {
    if uci -q get "zapret2wizard.BlockcheckW_YouTube" >/dev/null 2>&1; then
        echo "zapret2wizard"
    elif uci -q get "zapret2.BlockcheckW_YouTube" >/dev/null 2>&1; then
        echo "zapret2"
    else
        echo "zapret2wizard"
    fi
}

get_active_uci_pkg() {
    echo "zapret2wizard"
}

sync_uci_commit() {
    uci commit zapret2wizard 2>/dev/null || true
}

_uci_set_list_if_missing() {
    local list_name="$1"
    local list_path="$2"
    if ! uci -q get "zapret2wizard.$list_name" >/dev/null; then
        uci set "zapret2wizard.$list_name=list"
        uci set "zapret2wizard.$list_name.path=$list_path"
    fi
}

# Обновление пресет-листов: объединяем поставку с /etc, сохраняя правки пользователя.
# Пользовательские user/user_exclude не трогаем: это его собственные списки.
cmd_hostlists_merge() {
    local share="/usr/share/zapret2wizard/ipset" etc="/etc/zapret2wizard/ipset"
    local b src dst tmp
    mkdir -p "$etc" 2>/dev/null || true
    local changed=0
    for b in zapret_hosts_youtube.txt zapret_hosts_discord.txt zapret_hosts_x.txt zapret_hosts_instagram.txt zapret_hosts_twitch.txt; do
        src="$share/$b"; dst="$etc/$b"
        [ -f "$src" ] || continue
        if [ ! -f "$dst" ]; then cp -f "$src" "$dst" 2>/dev/null && changed=1; continue; fi
        base="/tmp/bcw_hl_base_$$"; add="/tmp/bcw_hl_add_$$"; out="/tmp/bcw_hl_out_$$"
        # CRLF и дубли из старых поставок: нормализуем и схлопываем, иначе
        # union добавляет те же домены второй раз (discord 70 → 134).
        tr -d '\r' < "$dst" > "$base" 2>/dev/null || cp -f "$dst" "$base"
        tr -d '\r' < "$src" > "$add" 2>/dev/null || cp -f "$src" "$add"
        awk 'NR==FNR{seen[tolower($0)]=1; next} {d=tolower($0); if (d != "" && !(d in seen)) { print d; seen[d]=1 }}' "$base" "$add" > "$out" 2>/dev/null || true
        if [ -s "$out" ]; then cat "$out" >> "$base"; changed=1; fi
        awk '!seen[tolower($0)]++' "$base" > "$out" 2>/dev/null || true
        if [ -s "$out" ]; then
            cmp -s "$out" "$dst" || { cp -f "$out" "$dst"; changed=1; }
        fi
        rm -f "$base" "$add" "$out"
    done
    chmod 644 "$etc"/*.txt 2>/dev/null || true
    echo "{\"changed\":$changed}"
}
ensure_preset_hostlist() {
    local tgt="$1"
    local custom_dom="$2"
    local ipset_dir="/etc/zapret2wizard/ipset"
    [ -d "$ipset_dir" ] || ipset_dir="/opt/zapret2/ipset"
    mkdir -p "$ipset_dir" "/opt/zapret2/ipset" "/etc/zapret2wizard/ipset" 2>/dev/null || true

    case "$tgt" in
        preset_x|x)
            local x_file="$ipset_dir/zapret_hosts_x.txt"
            _add_domains_if_missing "$x_file" \
                "x.com" "twitter.com" "t.co" "twimg.com" "pbs.twimg.com" \
                "abs.twimg.com" "api.x.com" "api.twitter.com" "video.twimg.com" "ton.twitter.com"
            _uci_set_list_if_missing list_hosts_x "$x_file"
            ;;
        preset_instagram|instagram)
            local ig_file="$ipset_dir/zapret_hosts_instagram.txt"
            _add_domains_if_missing "$ig_file" \
                "instagram.com" "cdninstagram.com" "fbcdn.net" "facebook.com" \
                "threads.net" "gateway.instagram.com" "static.cdninstagram.com" \
                "graph.instagram.com" "i.instagram.com"
            _uci_set_list_if_missing list_hosts_instagram "$ig_file"
            ;;
        preset_twitch|twitch)
            local tw_file="$ipset_dir/zapret_hosts_twitch.txt"
            _add_domains_if_missing "$tw_file" \
                "twitch.tv" "ttvnw.net" "jtvnw.net" "usher.ttvnw.net" \
                "static-cdn.jtvnw.net" "gql.twitch.tv"
            _uci_set_list_if_missing list_hosts_twitch "$tw_file"
            ;;
        preset_youtube|youtube)
            local yt_file="$ipset_dir/zapret_hosts_youtube.txt"
            if [ ! -f "$yt_file" ] || [ ! -s "$yt_file" ]; then
                [ -f "$yt_file.default" ] && cp -f "$yt_file.default" "$yt_file" 2>/dev/null
            fi
            sed -i -E '/googleadservices|googletagmanager|googlesyndication|googletagservices/d' "$yt_file" 2>/dev/null || true
            _add_domains_if_missing "$yt_file" \
                "googlevideo.com" "youtube.com" "youtu.be" "ytimg.com" \
                "ggpht.com" "gvt1.com" "youtubei.googleapis.com" "dl.google.com" \
                "test.googlevideo.com" \
                "yt3.ggpht.com" "yt4.ggpht.com" "i.ytimg.com" "i9.ytimg.com" \
                "signaler-pa.youtube.com" "manifest.googlevideo.com" "yt3.googleusercontent.com"
            _uci_set_list_if_missing list_hosts_youtube "$yt_file"
            ;;
        preset_discord|discord)
            local dc_file="$ipset_dir/zapret_hosts_discord.txt"
            if grep -q 'googleapis\.comgateway\.discord\.gg' "$dc_file" 2>/dev/null; then
                sed -i 's/googleapis\.comgateway\.discord\.gg/googleapis.com\ngateway.discord.gg/g' "$dc_file" 2>/dev/null || true
            fi
            _add_domains_if_missing "$dc_file" \
                "discord.com" "discord.gg" "discord.media" "discordapp.com" \
                "discordapp.net" "discordstatus.com" "gateway.discord.gg" \
                "cdn.discordapp.com" "status.discord.com" "updates.discord.com" \
                "media.discordapp.net" "images-ext-1.discordapp.net" "images-ext-2.discordapp.net" \
                "dis.gd" "discord.co" "discord.app" "discord.dev" "discord.new" \
                "discord.gift" "discord.gifts" "discord.store" "discord.design" \
                "discordcdn.com" "discordsez.com" "discordsays.com" "discordmerch.com" \
                "discordpartygames.com" "discordactivities.com" "stable.dl2.discordapp.net" \
                "discord-attachments-uploads-prd.storage.googleapis.com"
            _uci_set_list_if_missing list_hosts_discord "$dc_file"
            ;;
        builtin|general|preset_builtin|preset_user)
            local u_file="$ipset_dir/zapret_hosts_user.txt"
            _add_domains_if_missing "$u_file" \
                "rutracker.org" "rutracker.cc" "nnmclub.to" "kinozal.tv" "rutor.info" \
                "lostfilm.tv" "hdrezka.ag" "flibusta.is" "pornhub.com" "xvideos.com" \
                "redtube.com" "torproject.org" "bbc.com" "bbc.co.uk" "meduza.io" \
                "dw.com" "svoboda.org" "currenttime.tv" "theins.ru" "novayagazeta.eu" \
                "linkedin.com" "notion.so" "canva.com" "medium.com" "soundcloud.com" \
                "spotify.com" "deezer.com" "openai.com" "chatgpt.com" "claude.ai" \
                "proton.me" "protonmail.com" "t.me"
            _uci_set_list_if_missing list_hosts_user "$u_file"
            ;;
        *)
            local u_file="$ipset_dir/zapret_hosts_user.txt"
            touch "$u_file" 2>/dev/null
            if [ -n "$custom_dom" ]; then
                local cd_clean=$(echo "$custom_dom" | tr 'A-Z' 'a-z' | sed -e 's|^https*://||' -e 's|/.*||' | tr -d '[:space:]')
                if [ -n "$cd_clean" ]; then
                    local esc_cd=$(echo "$cd_clean" | sed 's/\./\\./g')
                    if ! grep -qiE "^[[:space:]]*${esc_cd}[[:space:]]*$" "$u_file" 2>/dev/null; then
                        echo "$cd_clean" >> "$u_file"
                    fi
                fi
            fi
            _uci_set_list_if_missing list_hosts_user "$u_file"
            ;;
    esac
}

ensure_firewall_quic_reject() {
    local reload_needed=0
    if ! uci -q get firewall.reject_quic >/dev/null; then
        uci set firewall.reject_quic=rule
        uci set firewall.reject_quic.name='Reject-QUIC'
        uci set firewall.reject_quic.src='lan'
        uci set firewall.reject_quic.dest='wan'
        uci set firewall.reject_quic.proto='udp'
        uci set firewall.reject_quic.dest_port='443'
        uci set firewall.reject_quic.target='REJECT'
        reload_needed=1
    elif [ "$(uci -q get firewall.reject_quic.target)" != "REJECT" ]; then
        # Strictly enforce REJECT instead of DROP to eliminate 6-10 second video spinner delays
        uci set firewall.reject_quic.target='REJECT'
        reload_needed=1
    fi
    if [ "$reload_needed" = "1" ]; then
        uci commit firewall 2>/dev/null || true
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
}

# Ревизия набора списков по умолчанию. Поднимать при изменении пресетов,
# чтобы полная пересборка списков отработала один раз после обновления.
HOSTLISTS_REV="2026-11-13.1-ai-spotify"
HOSTLISTS_MARKER="/etc/zapret2wizard/.hostlists.rev"

# Память стратегий (L1 домен / L2 подсеть / L3 статистика / бан-маска).
MEM_LUA="/usr/share/zapret2wizard/strategy_memory.lua"
mem() { [ -f "$MEM_LUA" ] && lua "$MEM_LUA" "$@" 2>/dev/null; }
domain_ip() { nslookup -type=a "$1" 127.0.0.1 2>/dev/null | sed -n 's/Address: //p' | grep -E '^[0-9.]+$' | tail -1; }

# Быстрая проверка: все списки на месте, секции и правило QUIC заведены.
# Нужна, чтобы не гонять полный ensure на каждый вызов info из интерфейса.
_hostlists_ready() {
    local f
    for f in youtube discord x instagram twitch user user_exclude; do
        [ -s "/etc/zapret2wizard/ipset/zapret_hosts_$f.txt" ] || return 1
    done
    uci -q get zapret2wizard.list_hosts_user_exclude >/dev/null 2>&1 || return 1
    uci -q get firewall.reject_quic >/dev/null 2>&1 || return 1
    return 0
}

# Удалённые пресеты AI/Spotify: чистим секции и списки на существующих установках.
purge_removed_presets() {
    local marker="/etc/zapret2wizard/.removed_ai_spotify"
    local mem_marker="${marker}.mem"
    local pkg sec d
    if [ ! -f "$marker" ]; then
        for pkg in zapret2 zapret2wizard; do
            [ -f "/etc/config/$pkg" ] || continue
            for sec in $(uci -q show "$pkg" 2>/dev/null | sed -n "s/^$pkg\.\([A-Za-z0-9_]*\)=.*/\1/p" | grep -E '^(BlockcheckW_AI|BlockcheckW_AI_[0-9]+|BlockcheckW_Spotify|BlockcheckW_Spotify_[0-9]+|list_hosts_ai|list_hosts_spotify)$'); do
                uci -q delete "$pkg.$sec" 2>/dev/null || true
            done
            uci -q commit "$pkg" 2>/dev/null || true
        done
        rm -f /etc/zapret2wizard/ipset/zapret_hosts_ai.txt /etc/zapret2wizard/ipset/zapret_hosts_spotify.txt 2>/dev/null || true
        rm -f /usr/share/zapret2wizard/ipset/zapret_hosts_ai.txt /usr/share/zapret2wizard/ipset/zapret_hosts_spotify.txt 2>/dev/null || true
        [ -x /usr/share/zapret2wizard/uci2config ] && /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
        touch "$marker"
    fi
    if [ ! -f "$mem_marker" ]; then
        # Убираем из памяти домены и баны удалённых пресетов (отдельный маркер,
        # чтобы очистка выполнилась и на установках, уже прошедших purge секций).
        for d in chatgpt.com openai.com claude.ai anthropic.com gemini.google.com copilot.microsoft.com perplexity.ai deepseek.com open.spotify.com api.spotify.com i.scdn.co scdn.co pscdn.co; do
            mem forget "$d" >/dev/null 2>&1 || true
        done
        touch "$mem_marker"
    fi
}

ensure_all_hostlists() {
    purge_removed_presets
    if [ "$(cat "$HOSTLISTS_MARKER" 2>/dev/null)" = "$HOSTLISTS_REV" ] && _hostlists_ready; then
        return 0
    fi

    # Сначала разворачиваем полные списки из пакета (43/66/10/9/6 доменов),
    # иначе на чистой установке останутся только минимальные наборы.
    local ipset_seed="/etc/zapret2wizard/ipset"
    mkdir -p "$ipset_seed" 2>/dev/null
    local f src
    for f in youtube discord x instagram twitch user user_exclude; do
        [ -s "$ipset_seed/zapret_hosts_$f.txt" ] && continue
        for src in "/usr/share/zapret2wizard/ipset/zapret_hosts_$f.txt" "/usr/share/zapret2wizard/ipset/zapret_hosts_$f.txt.default"; do
            if [ -s "$src" ]; then
                cp -f "$src" "$ipset_seed/zapret_hosts_$f.txt" 2>/dev/null && break
            fi
        done
    done

    ensure_firewall_quic_reject
    local ipset_dir="/etc/zapret2wizard/ipset"
    mkdir -p "$ipset_dir" 2>/dev/null

    local before_changes=$(uci changes zapret2wizard 2>/dev/null)

    ensure_preset_hostlist "preset_youtube"
    ensure_preset_hostlist "preset_discord"
    ensure_preset_hostlist "preset_x"
    ensure_preset_hostlist "preset_instagram"
    ensure_preset_hostlist "preset_twitch"
    ensure_preset_hostlist "builtin"

    local excl_file="$ipset_dir/zapret_hosts_user_exclude.txt"
    if [ ! -f "$excl_file" ]; then
        if [ -f "$excl_file.default" ]; then
            cp -f "$excl_file.default" "$excl_file" 2>/dev/null
        else
            touch "$excl_file" 2>/dev/null
        fi
        chmod 644 "$excl_file" 2>/dev/null
    fi
    if ! uci -q get zapret2wizard.list_hosts_user_exclude >/dev/null; then
        uci set zapret2wizard.list_hosts_user_exclude=list
        uci set zapret2wizard.list_hosts_user_exclude.path="$excl_file"
    fi

    local after_changes=$(uci changes zapret2wizard 2>/dev/null)
    if [ "$before_changes" != "$after_changes" ] && [ -n "$after_changes" ]; then
        uci commit zapret2wizard 2>/dev/null || true
    fi

    printf '%s\n' "$HOSTLISTS_REV" > "$HOSTLISTS_MARKER" 2>/dev/null || true
}

write_status() {
    local status="$1"
    local percent="$2"
    local phase="$3"
    local extra_raw="$4"

    lua - "$STATUS_FILE" "$LOG_FILE" "$OUTPUT_CIRCULAR" "$OUTPUT_SCAN" "$status" "$percent" "$phase" "$extra_raw" "${SCAN_TARGET:-}" << 'EOF'
local json = require("luci.jsonc")
local status_file = arg[1]
local log_file = arg[2]
local circular_file = arg[3]
local scan_file = arg[4]
local status = arg[5] or "idle"
local percent = tonumber(arg[6]) or 0
local phase = arg[7] or ""
local extra_raw = arg[8] or ""
local scan_target = arg[9] or ""

local log_tail = ""
local lf = io.open(log_file, "r")
if lf then
    local lines = {}
    for line in lf:lines() do
        table.insert(lines, line)
    end
    lf:close()
    local start_idx = math.max(1, #lines - 45)
    local tail_lines = {}
    for i = start_idx, #lines do
        table.insert(tail_lines, lines[i])
    end
    log_tail = table.concat(tail_lines, "\n")
end

local circular = ""
local cf = io.open(circular_file, "r")
if cf then
    circular = cf:read("*a") or ""
    cf:close()
end

local isp = ""
local block_type = ""

if log_tail ~= "" then
    for line in log_tail:gmatch("[^\r\n]+") do
        local m = line:match("ISP:%s*(.+)")
        if m then
            isp = m:gsub("^%s+", ""):gsub("%s+$", "")
            break
        end
    end
end

local scf = io.open(scan_file, "r")
if scf then
    local sc = json.parse(scf:read("*a"))
    scf:close()
    if sc and sc.block_type then
        block_type = sc.block_type
    end
end
if block_type == "" and log_tail ~= "" then
    if log_tail:find("SNI blocked") or log_tail:find("BLOCKED") then
        block_type = "sni_blocked"
    elseif log_tail:find("IP blocked") then
        block_type = "ip_blocked"
    end
end

local obj = {
    status = status,
    percent = percent,
    phase = phase,
    log = log_tail,
    circular = circular,
    isp = isp,
    block_type = block_type,
    target = scan_target
}

if extra_raw and extra_raw:match("^%s*,") then
    local extra_parsed = json.parse("{" .. extra_raw:gsub("^%s*,", "") .. "}")
    if extra_parsed then
        for k, v in pairs(extra_parsed) do
            obj[k] = v
        end
    end
end

-- Read apply_result if saved by cmd_apply
local arf = io.open("/tmp/blockcheckw_apply_result.json", "r")
if arf then
    local ar = json.parse(arf:read("*a"))
    arf:close()
    if ar then
        obj.apply_result = ar
        if obj.auto_applied == nil and ar.success then
            obj.auto_applied = true
        end
    end
end

local dpf = io.open("/tmp/blockcheckw_dpi_fingerprint.json", "r")
if dpf then
    local dp = json.parse(dpf:read("*a"))
    dpf:close()
    if dp then obj.dpi_fingerprint = dp end
end

local tmp_file = status_file .. ".tmp"
local out = io.open(tmp_file, "w")
if out then
    out:write(json.stringify(obj))
    out:close()
    os.rename(tmp_file, status_file)
end
EOF
}

get_preset_param() {
    local preset="$1"
    local param="$2"
    lua -e '
        local json = require("luci.jsonc")
        local f = io.open("'"$PRESETS_FILE"'", "r")
        if not f then print("") return end
        local d = json.parse(f:read("*a"))
        f:close()
        if d and d.presets and d.presets["'"$preset"'"] then
            local val = d.presets["'"$preset"'"]["'"$param"'"]
            if type(val) == "table" then
                print(table.concat(val, ","))
            else
                print(tostring(val or ""))
            end
        else
            print("")
        end
    ' 2>/dev/null
}

generate_smart_probe_corpus() {
    local preset="$1"
    local domain="$2"
    local probe_file="$3"

    local is_discord=0
    case "$preset" in
        preset_discord|discord) is_discord=1 ;;
    esac

    # Genetic Fingerprinting Suite: 7 orthogonal DPI vulnerability families
    # Based on Geneva CCS'19, zapret2 Lua desync, and empirical ISP heuristics
    cat <<EOF > "$probe_file"
# --- Family 1: Geneva TCB Desync (CCS '19 8+4 multi-segmentation) ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=8,12
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=8,12
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=8,12
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:pos=8,12

# --- Family 2: Whitelisted Russian SNIs (Hostfake - Top White-SNI Pool) ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=esia.gosuslugi.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=sber.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=alfabank.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=rzd.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=vk.com:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=avito.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=ozon.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=yandex.ru:tcp_ts=-600000
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=t2.ru:tcp_ts=-600000

# --- Family 3: Sequence Overlap (Seqovl) ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=10:seqovl=1
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=10:seqovl=1
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=1,midsld:seqovl=1

# --- Family 4: Packet Disordering ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld,1220
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld,1220
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1

# --- Family 5: Synthetic Fake Payload & Badsum Drop ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:pos=1,midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:pos=1,midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:badsum:tcp_seq=-10000:repeats=2 --lua-desync=multisplit:pos=1,midsld

# --- Family 6: Out-of-Band (OOB) & SYN-Data Early Injection ---
curl_test_https_tls13 ipv4 $domain : nfqws2 --in-range=-s1 --lua-desync=oob:urp=b:char=0x00
curl_test_https_tls13 ipv4 $domain : nfqws2 --in-range=-s1 --lua-desync=oob:urp=e:byte=0
curl_test_https_tls13 ipv4 $domain : nfqws2 --lua-desync=syndata:blob=fake_default_tls:tls_mod=sni=www.google.com --payload=tls_client_hello --lua-desync=multisplit:pos=1,midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --lua-desync=syndata:blob=blob_tls_clienthello_www_google_com --payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld

# --- Family 7: TCP MD5 Option & Auto-TTL Injection (Routerich 2026 Core) ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_md5:repeats=6 --lua-desync=multisplit:pos=midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_md5:repeats=6 --lua-desync=multisplit:pos=midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_md5:repeats=6 --lua-desync=multidisorder:pos=midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:ip_autottl=-2,3-20:repeats=6
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=rst:ip_autottl=-2,3-20

# --- Family 8: seqovl с TLS-паттерном, маркеры позиций и ip_id (Routerich 2026) ---
# Смысл: перекрытие заполняется началом TLS-записи (16 03 03 ..), поэтому
# сборщик DPI видит валидный заголовок записи, а реальный ClientHello едет следом.
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=midsld:seqovl=2:seqovl_pattern=0x16030300
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=midsld:seqovl=2:seqovl_pattern=0x16030300
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=midsld:seqovl=681:seqovl_pattern=fake_default_tls
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=midsld:seqovl=sniext+1:seqovl_pattern=0x16030300
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1:seqovl=336:seqovl_pattern=fake_default_tls:ip_id=zero
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:repeats=3 --lua-desync=multisplit:pos=midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=tcpseg:pos=0,midsld:ip_id=rnd --lua-desync=multisplit:pos=sniext+1
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=www.google.com:tcp_md5:midhost=midsld:disorder_after:ip_id=zero
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=hostfakesplit:host=www.google.com:tcp_md5:midhost=midsld:disorder_after:ip_id=zero
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=midsld:seqovl=sniext+1:seqovl_pattern=0x16030300
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:ip_autottl=-2,3-20:ip_id=zero

# --- Family 9: Эталонные связки RU 2026 (Flowseal / Zapret-Manager) ---
curl_test_https_tls12 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=blob_tls_clienthello_www_google_com:ip_id=zero
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=blob_tls_clienthello_www_google_com:ip_id=zero
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x0F0F0F0F:tcp_seq=-10000:tcp_ack=-66000:badsum --lua-desync=multisplit:pos=2,sld:seqovl=620:seqovl_pattern=blob_tls_clienthello_www_google_com
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1

# --- Family 10: DataNoAck, 7-точечный md5, seqovl 210, bin_noise triple (tachyon-desync) ---
# PSH без ACK: DPI видит сегмент, но не связывает его с потоком; окно 16 КБ не встаёт.
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_flags_set=PSH:tcp_flags_unset=ACK:repeats=2 --lua-desync=multisplit:pos=sniext+1:seqovl=16
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1:tcp_md5
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=midsld:seqovl=210
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x0F0F0F0F:tcp_seq=-10000:tcp_ack=-66000:badsum:repeats=2 --lua-desync=multidisorder:pos=midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_ts_up:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:pos=1,midsld

# --- Family 11: IP-фрагментация (ipfrag) и обратный порядок (youtubeUnblock) ---
# DPI, который собирает TCP, но не IP, ломается на фрагментах; reverse меняет
# порядок частей, чтобы сборщик увидел хвост раньше заголовка.
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=midsld:ipfrag:ipfrag_pos_tcp=32
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=midsld:ipfrag:ipfrag_pos_tcp=32:ipfrag_disorder
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=1,midsld:ipfrag:ipfrag_pos_tcp=40:ipfrag_disorder
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=send:ipfrag:ipfrag_pos_tcp=32
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multidisorder:pos=midsld,1
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=multisplit:pos=midsld:send:delay=50
EOF

    # Family 7: Window Size Scaling (wssize) - STRICTLY for non-discord targets
    if [ "$is_discord" -eq 0 ]; then
        cat <<EOF >> "$probe_file"
curl_test_https_tls12 ipv4 $domain : nfqws2 --lua-desync=wssize:wsize=1:scale=6 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --lua-desync=wssize:wsize=1:scale=6 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --lua-desync=wssize:wsize=1:scale=6 --payload=tls_client_hello --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1
EOF
    fi

    # Append preset-specific turbo strategies
    lua - "$preset" "$domain" "$PRESETS_FILE" "$probe_file" "$is_discord" << 'EOF' 2>/dev/null
        local json = require("luci.jsonc")
        local p = arg[1]
        local domain = arg[2]
        local presets_file = arg[3]
        local probe_file = arg[4]
        local is_discord = (arg[5] == "1")

        local f = io.open(presets_file, "r")
        if not f then return end
        local d = json.parse(f:read("*a"))
        f:close()

        local obj = d and d.presets and (d.presets[p] or d.presets["preset_" .. p] or d.presets[p:gsub("^preset_", "")])
        local strats = obj and obj.turbo_strategies
        if strats and #strats > 0 then
            local out = io.open(probe_file, "a")
            if out then
                for _, s in ipairs(strats) do
                    -- Never append wssize to Discord probe
                    if not (is_discord and s:find("wssize")) then
                        local clean = s:gsub("^%s*nfqws2%s+", "")
                        out:write(string.format("curl_test_https_tls12 ipv4 %s : nfqws2 %s\n", domain, clean))
                        out:write(string.format("curl_test_https_tls13 ipv4 %s : nfqws2 %s\n", domain, clean))
                    end
                end
                out:close()
            end
        end
EOF

    # TTL-калибровка (идея AutoTTL из tachyon-desync): фейк должен пройти
    # транзитный узел, но умереть до сервера. Дистанцию хопов измеряем сами.
    local ttl=$(cmd_ttl_probe "$domain" 2>/dev/null | sed -n 's/.*"fake_ttl":\([0-9]*\).*/\1/p')
    if [ -n "$ttl" ]; then
        cat >> "$probe_file" <<EOF
# --- Family 11: TTL-калибровка (ip_ttl=$ttl) ---
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fake:blob=0x00000000:ip_ttl=$ttl:repeats=2 --lua-desync=multisplit:pos=1,midsld
curl_test_https_tls13 ipv4 $domain : nfqws2 --payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:ip_ttl=$ttl
EOF
    fi
}

generate_adaptive_corpus() {
    local preset="$1"
    local domain="$2"
    local protocols="$3"
    local probe_output="$4"
    local out_corpus="$5"

    lua - "$domain" "$probe_output" "$out_corpus" "$PRESETS_FILE" "$preset" << 'EOF'
        local json = require("luci.jsonc")
        local domain = arg[1]
        local probe_file = arg[2]
        local out_file = arg[3]
        local presets_file = arg[4]
        local preset = arg[5]

        local is_discord = (preset:lower():find("discord") ~= nil)

        local fams = {
            geneva = false,
            hostfake = false,
            seqovl = false,
            multidisorder = false,
            fake = false,
            oob = false,
            syndata = false,
            ipfrag = false,
            reverse = false,
            wssize = false,
            multisplit = false,
            tcp_md5 = false,
            autottl = false
        }

        local f_fp = io.open("/tmp/blockcheckw_dpi_fingerprint.json", "r")
        if f_fp then
            local fp = json.parse(f_fp:read("*a"))
            f_fp:close()
            if fp and fp.vulns then
                for _, v in ipairs(fp.vulns) do fams[v] = true end
            end
        end

        -- Check probe output directly as fallback
        local pf = io.open(probe_file, "r")
        if pf then
            local pdata = json.parse(pf:read("*a")) or {}
            pf:close()
            local pstrats = pdata.strategies or {}
            for _, s in ipairs(pstrats) do
                local a = (type(s) == "table" and s.args) or s
                local al = a:lower()
                if al:find("pos=8,12") or al:find("8,12") then fams.geneva = true end
                if al:find("hostfakesplit") or al:find("hostfake") then fams.hostfake = true end
                if al:find("seqovl") then fams.seqovl = true end
                if al:find("multidisorder") then fams.multidisorder = true end
                if al:find("fake:blob") or al:find("badsum") then fams.fake = true end
                if al:find("oob:") or al:find("urp=") then fams.oob = true end
                if al:find("syndata") then fams.syndata = true end
                if al:find("ipfrag") then fams.ipfrag = true end
                if al:find("multidisorder:pos=midsld,1") then fams.reverse = true end
                if al:find("wssize") then fams.wssize = true end
                if al:find("multisplit") then fams.multisplit = true end
                if al:find("tcp_md5") then fams.tcp_md5 = true end
                if al:find("autottl") then fams.autottl = true end
            end
        end

        -- If probe was completely blocked or empty, enable broad modern coverage
        local any_active = false
        for _, v in pairs(fams) do if v then any_active = true break end end
        if not any_active then
            fams.geneva = true
            fams.hostfake = true
            fams.seqovl = true
            fams.multidisorder = true
            fams.fake = true
            fams.multisplit = true
            if not is_discord then fams.wssize = true end
        end

        if is_discord then
            fams.wssize = false
        end

        local candidate_args = {}
        local function add_cand(str)
            table.insert(candidate_args, str)
        end

        -- 1. Geneva TCB mutations
        if fams.geneva then
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=1,8,12")
            add_cand("--payload=tls_client_hello --lua-desync=multidisorder:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=8,12:seqovl=1")
            add_cand("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multidisorder:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000 --lua-desync=multisplit:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=hostfakesplit:host=esia.gosuslugi.ru:tcp_ts=-600000 --lua-desync=multisplit:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=hostfakesplit:host=sber.ru:tcp_ts=-600000 --lua-desync=multisplit:pos=8,12")
            add_cand("--payload=tls_client_hello --lua-desync=hostfakesplit:host=t2.ru:tcp_ts=-600000 --lua-desync=multisplit:pos=8,12")
        end

        -- 2. Hostfake mutations (Curated Top White-SNI pool from dpi-detector)
        if fams.hostfake then
            local white_snis = {
                "gosuslugi.ru", "esia.gosuslugi.ru", "sber.ru", "alfabank.ru",
                "rzd.ru", "vk.com", "avito.ru", "ozon.ru", "yandex.ru", "t2.ru"
            }
            for _, h in ipairs(white_snis) do
                add_cand(string.format("--payload=tls_client_hello --lua-desync=hostfakesplit:host=%s:tcp_ts=-600000", h))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=hostfakesplit:host=%s:tcp_ts=0", h))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=hostfakesplit:host=%s:tcp_ts=-600000 --lua-desync=multisplit:pos=1,midsld", h))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=hostfakesplit:host=%s:tcp_ts=-600000 --lua-desync=multidisorder:pos=1,midsld,1220", h))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=hostfakesplit:host=%s:tcp_seq=0:tcp_ack=-66000:badsum", h))
            end
        end

        -- 3. Sequence Overlap (Seqovl) mutations
        if fams.seqovl then
            for _, seq in ipairs({ "seqovl=1", "seqovl=2", "seqovl=620" }) do
                add_cand(string.format("--payload=tls_client_hello --lua-desync=multisplit:pos=10:%s", seq))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=multisplit:pos=1,midsld:%s", seq))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=multisplit:pos=1,sniext+1:%s", seq))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=multisplit:pos=2,sld:%s", seq))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:pos=1,midsld:%s", seq))
            end
        end

        -- 4. Disordering mutations
        if fams.multidisorder then
            local pos_list = {
                "pos=1,midsld",
                "pos=1,midsld,1220",
                "pos=1,sniext+1,midsld-2,midsld,midsld+2,endhost-1",
                "pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1",
                "pos=2,midsld",
                "pos=midsld,1",
                "pos=sniext+1,host+1",
                "pos=1,host+1,midsld"
            }
            for _, p in ipairs(pos_list) do
                add_cand(string.format("--payload=tls_client_hello --lua-desync=multidisorder:%s", p))
            end
        end

        -- 5. Fake & Badsum mutations
        if fams.fake then
            for _, blob in ipairs({ "0x00000000", "blob_stun", "blob_tls_clienthello_www_google_com", "blob_tls_clienthello_gosuslugi_ru" }) do
                for _, p in ipairs({ "pos=1,midsld", "pos=1,midsld,1220", "pos=sniext+1" }) do
                    add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=%s:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multisplit:%s", blob, p))
                    add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=%s:tcp_seq=-10000:tcp_ack=-66000:repeats=2 --lua-desync=multidisorder:%s", blob, p))
                end
            end
            add_cand("--payload=tls_client_hello --lua-desync=fake:badsum:tcp_seq=-10000:repeats=2 --lua-desync=multisplit:pos=1,midsld")
            add_cand("--payload=tls_client_hello --lua-desync=fake:badsum:tcp_seq=-10000:repeats=2 --lua-desync=multidisorder:pos=1,midsld")
        end

        -- 6. OOB & SYN-Data mutations
        if fams.oob then
            add_cand("--in-range=-s1 --lua-desync=oob:urp=b:char=0x00")
            add_cand("--in-range=-s1 --lua-desync=oob:urp=e:byte=0")
            add_cand("--in-range=-s1 --lua-desync=oob:urp=b:byte=0")
            add_cand("--in-range=-s1 --lua-desync=oob:urp=e:char=0x00")
        end
        if fams.syndata then
            add_cand("--lua-desync=syndata:blob=fake_default_tls:tls_mod=sni=www.google.com --payload=tls_client_hello --lua-desync=multisplit:pos=1,midsld")
            add_cand("--lua-desync=syndata:blob=fake_default_tls --payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld")
            add_cand("--lua-desync=syndata:blob=blob_tls_clienthello_www_google_com --payload=tls_client_hello --lua-desync=multisplit:pos=midsld")
        end

        -- 6b. IP fragmentation (ipfrag) + reverse order
        if fams.ipfrag then
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=midsld:ipfrag:ipfrag_pos_tcp=32")
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=midsld:ipfrag:ipfrag_pos_tcp=32:ipfrag_disorder")
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=1,midsld:ipfrag:ipfrag_pos_tcp=40:ipfrag_disorder")
            add_cand("--payload=tls_client_hello --lua-desync=send:ipfrag:ipfrag_pos_tcp=32")
        end
        if fams.reverse then
            add_cand("--payload=tls_client_hello --lua-desync=multidisorder:pos=midsld,1")
            add_cand("--payload=tls_client_hello --lua-desync=multidisorder:pos=sniext+1,1")
        end

        -- 7. Window Size (wssize) - STRICTLY non-discord
        if fams.wssize and not is_discord then
            for _, scale in ipairs({ "scale=6", "scale=7" }) do
                for _, p in ipairs({ "pos=1,midsld", "pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1", "pos=1,midsld,1220" }) do
                    add_cand(string.format("--lua-desync=wssize:wsize=1:%s --payload=tls_client_hello --lua-desync=multidisorder:%s", scale, p))
                    add_cand(string.format("--lua-desync=wssize:wsize=1:%s --payload=tls_client_hello --lua-desync=multisplit:%s", scale, p))
                end
            end
        end

        -- 8. Routerich 2026 Core: TCP MD5 Signature & Auto-TTL & Fakeddisorder
        if fams.tcp_md5 or fams.autottl or fams.fake or not any_active then
            for _, p in ipairs({ "pos=midsld", "pos=1,midsld", "pos=sld", "pos=1,midsld,1220" }) do
                add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_md5:repeats=6 --lua-desync=multisplit:%s", p))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_md5:repeats=6 --lua-desync=multidisorder:%s", p))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=blob_tls_clienthello_www_google_com:tcp_md5:repeats=6 --lua-desync=multisplit:%s", p))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:ip_autottl=-2,3-20:repeats=6 --lua-desync=multisplit:%s", p))
                add_cand(string.format("--payload=tls_client_hello --lua-desync=fakeddisorder:%s:tcp_md5", p))
            end
            add_cand("--payload=tls_client_hello --lua-desync=rst:ip_autottl=-2,3-20")
            add_cand("--payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5")
            add_cand("--payload=tls_client_hello --lua-desync=fakeddisorder:pos=1,midsld:tcp_md5")
            add_cand("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:tcp_md5:repeats=6")
        end

        -- 9. Эталонные связки RU 2026 (Flowseal / Zapret-Manager, переведены
        --    в синтаксис zapret2). blob_tls_clienthello_www_google_com —
        --    реальный 681-байтный ClientHello www.google.com из комплекта.
        if fams.fake or fams.seqovl or not any_active then
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=1:seqovl=681:seqovl_pattern=blob_tls_clienthello_www_google_com:ip_id=zero")
            add_cand("--payload=tls_client_hello --lua-desync=multisplit:pos=1,sniext+1:seqovl=1")
            add_cand("--payload=tls_client_hello --lua-desync=fake:blob=0x0F0F0F0F:tcp_seq=-10000:tcp_ack=-66000:badsum --lua-desync=multisplit:pos=2,sld:seqovl=620:seqovl_pattern=blob_tls_clienthello_www_google_com")
            add_cand("--payload=tls_client_hello --lua-desync=fake:blob=blob_tls_clienthello_www_google_com:tcp_md5:repeats=6 --lua-desync=multisplit:pos=midsld")
            add_cand("--payload=tls_client_hello --lua-desync=multidisorder:pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1")
            add_cand("--payload=tls_client_hello --lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000")
            add_cand("--payload=tls_client_hello --lua-desync=multidisorder:pos=1,midsld:seqovl=2:seqovl_pattern=0x16030300")
            add_cand("--payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5")
            add_cand("--payload=tls_client_hello --lua-desync=fake:blob=0x00000000:ip_autottl=-2,3-20:repeats=6 --lua-desync=multisplit:pos=1,midsld")
        end

        -- Deduplicate candidates
        local seen = {}
        local unique = {}
        for _, c in ipairs(candidate_args) do
            if not seen[c] then
                seen[c] = true
                table.insert(unique, c)
            end
        end

        local out = io.open(out_file, "w")
        if out then
            for _, c in ipairs(unique) do
                out:write(string.format("curl_test_https_tls12 ipv4 %s : nfqws2 %s\n", domain, c))
                out:write(string.format("curl_test_https_tls13 ipv4 %s : nfqws2 %s\n", domain, c))
            end
            out:close()
        end
EOF
}

# Результаты подбора храним по цели: у каждого сервиса свой список, и при
# переключении в интерфейсе показывается именно он.
save_results() {
    local t="${1:-}" js="${2:-[]}"
    [ -n "$t" ] || return 0
    mkdir -p "$RESULTS_DIR" 2>/dev/null || true
    printf '{"target":"%s","ts":%s,"strategies":%s}\n' "$t" "$(date +%s)" "$js" \
        > "$RESULTS_DIR/$t.json" 2>/dev/null || true
}

cmd_results() {
    local t="${1:-}" f
    [ -n "$t" ] || { echo '{"target":"","strategies":[]}'; return 0; }
    f="$RESULTS_DIR/$t.json"
    if [ -f "$f" ]; then cat "$f"; else printf '{"target":"%s","strategies":[]}\n' "$t"; fi
}

# Провайдеры (РФ) отдают NXDOMAIN на заблокированные домены, и сканер
# падает с "DNS resolve failed" ещё до подбора. В таком случае переключаем
# сканер на DoH: резолв идёт по HTTPS и блокировка DNS его не ломает.
scan_dns_mode() {
    local d="$1" out
    [ -n "$d" ] || { echo auto; return 0; }
    out=$(nslookup "$d" 127.0.0.1 2>&1)
    case "$out" in
        *"can't find"*|*NXDOMAIN*|*SERVFAIL*|"") ;;
        *) echo auto; return 0 ;;
    esac
    out=$(nslookup "$d" 2>&1)
    case "$out" in
        *"can't find"*|*NXDOMAIN*|*SERVFAIL*|"")
            # Заодно чиним DNS для клиентов: иначе DPI-обход есть, а сайт
            # всё равно не открывается — провайдер отдаёт NXDOMAIN.
            dns_doh_ensure "$(dns_doh_base "$d")"
            echo doh
            ;;
        *) echo auto ;;
    esac
}

# Если домен заворачивается в туннель, честный подбор невозможен.
# Возвращает признак (fake-ip или имя интерфейса), иначе пусто.
scan_tunnel_service() {
    local d="$1" ip dev wan
    [ -n "$d" ] || return 0
    ip=$(nslookup "$d" 127.0.0.1 2>/dev/null | awk '/^Address: /{print $2; exit}')
    [ -n "$ip" ] || ip=$(nslookup "$d" 2>/dev/null | awk '/^Address: /{print $2; exit}')
    [ -n "$ip" ] || return 0
    case "$ip" in 198.18.*|198.19.*) echo "fake-ip"; return 0 ;; esac
    dev=$(ip route get "$ip" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)
    wan=$(ip -4 route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)
    [ -n "$dev" ] || return 0
    [ "$dev" = "$wan" ] && return 0
    echo "$dev"
}

# Проверка перед подбором: движок, модули ядра и nftables. Иначе сканер
# вернёт общее «предполётная проверка не прошла», по которому непонятно,
# что именно чинить.
scan_preflight() {
    local miss="" hint=""
    ensure_lua_layout
    command -v nft >/dev/null 2>&1 || { miss="$miss nftables"; hint="$hint; установите пакет nftables"; }
    [ -r /opt/zapret2/lua/zapret-lib.lua ] || { miss="$miss lua(zapret-lib.lua)"; hint="$hint; перезапустите службу или install.sh"; }
    if [ ! -x /usr/bin/nfqws2 ]; then
        miss="$miss nfqws2"; hint="$hint; переустановите службу или положите движок в /usr/bin/nfqws2"
    elif ! /usr/bin/nfqws2 --version >/dev/null 2>&1; then
        miss="$miss nfqws2(не запускается)"; hint="$hint; движок не для этой архитектуры"
    fi
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
    [ -d /sys/module/nfnetlink_queue ] || { miss="$miss модуль nfnetlink_queue"; hint="$hint; opkg install kmod-nfnetlink-queue"; }
    [ -d /sys/module/nft_queue ] || { miss="$miss модуль nft_queue"; hint="$hint; opkg install kmod-nft-queue"; }
    if [ -n "$miss" ]; then
        echo "[blockcheckw-helper] scan preflight failed:$miss" >> "$LOG_FILE" 2>/dev/null || true
        write_status "error" 0 "Проверка перед подбором не прошла:$miss$hint" ",\"strategies\":[]"
        printf '{"error":"Проверка перед подбором не прошла:%s%s"}\n' "$miss" "$hint"
        return 1
    fi
    return 0
}

cmd_start() {
    local target="youtube"
    local domain=""
    local mode="smart"
    local do_circular="1"
    local auto_apply="0"
    local workers="2"
    local pause_others="0"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --domain) domain="$2"; shift 2 ;;
            --mode) mode="$2"; shift 2 ;;
            --circular) do_circular="$2"; shift 2 ;;
            --auto-apply) auto_apply="$2"; shift 2 ;;
            --workers) workers="$2"; shift 2 ;;
            --pause-others) pause_others="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # Clean domain if user entered multiple or dirty string
    if [ -n "$domain" ]; then
        domain=$(echo "$domain" | tr ',' ' ' | awk '{print $1}')
    fi

    # Раньше сканер падал с общим «предполётная проверка не прошла»: проверяем
    # движок, модули и nftables сами и говорим, что именно поставить.
    scan_preflight || return 1

    # Clean up stale lock if no scanner is actually running
    if ! pgrep -f blockcheckw >/dev/null 2>&1; then
        rm -f /tmp/blockcheckw.lock 2>/dev/null || true
    fi

    # Check if already running with real process verification
    if is_scanner_running; then
        local cur_pid=$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
        echo "{\"error\":\"Сканер уже запущен (PID $cur_pid)\",\"pid\":$cur_pid}"
        return 1
    fi

    # Resolve target and domain
    local protocols="tls12,tls13"
    case "$target" in
        preset_youtube|youtube)
            domain=$(get_preset_param "preset_youtube" "domain")
            [ -n "$domain" ] || domain="googlevideo.com"
            protocols="tls12,tls13"
            ;;
        preset_discord|discord)
            domain=$(get_preset_param "preset_discord" "domain")
            [ -n "$domain" ] || domain="discord.com"
            protocols="tls12,tls13"
            ;;
        preset_twitch|twitch)
            domain=$(get_preset_param "preset_twitch" "domain")
            [ -n "$domain" ] || domain="twitch.tv"
            protocols="tls12,tls13"
            ;;
        preset_x|x)
            domain=$(get_preset_param "preset_x" "domain")
            [ -n "$domain" ] || domain="x.com"
            protocols="tls12,tls13"
            ;;
        preset_instagram|instagram)
            domain=$(get_preset_param "preset_instagram" "domain")
            [ -n "$domain" ] || domain="gateway.instagram.com"
            protocols="tls12,tls13"
            ;;
        tcp16)
            domain=$(get_preset_param "tcp16" "domain")
            [ -n "$domain" ] || domain="discord.com"
            protocols="tls12,tls13"
            ;;
        builtin|general)
            domain=$(get_preset_param "builtin" "domain")
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
        domains|custom)
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
        test_strategy)
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
        *)
            [ -n "$domain" ] || domain="rutracker.org"
            protocols="http,tls12,tls13"
            ;;
    esac

    rm -f "$OUTPUT_VANILLA" "$OUTPUT_SCAN" "$OUTPUT_CIRCULAR" "$TURBO_FILE" "$LOG_FILE" /tmp/blockcheckw_apply_result.json
    echo "" > "$LOG_FILE"
    SCAN_TARGET="$target"

    ensure_all_hostlists
    ensure_preset_hostlist "$target" "$domain"

    write_status "running" 10 "Инициализация сканирования ($domain)"

    # Run in background via child process detached from rpcd pipes
    (
        cleanup_subshell() {
            rm -f "$PID_FILE"
            [ -n "${SCAN_KEEPER:-}" ] && kill "$SCAN_KEEPER" 2>/dev/null
            rm -rf /var/run/bcw_scan.lock 2>/dev/null || true
            # Remove scanner priority bypass rule from fw4 output chain
            local handle=$(nft -a list chain inet fw4 output 2>/dev/null | grep '0x30000000' | awk '{print $NF}')
            [ -n "$handle" ] && nft delete rule inet fw4 output handle "$handle" 2>/dev/null || true

            # Возвращаем только те службы, которые остановили по явному запросу.
            if [ -f /tmp/bcw_paused_services ]; then
                while read -r _svc; do
                    [ -n "$_svc" ] && /etc/init.d/"$_svc" start >/dev/null 2>&1
                done < /tmp/bcw_paused_services
                rm -f /tmp/bcw_paused_services
            fi

            # Restore DPI service if not running — или если исчезла таблица nft:
            # сканер сносит inet zapret2wizard, но процессы nfqws2 при этом
            # остаются живыми, и проверка одного статуса пропускает восстановление.
            if ! get_dpi_service_status | grep -q running || ! nft list tables 2>/dev/null | grep -q 'inet zapret2wizard'; then
                restart_dpi_service
            fi
            rm -f /tmp/bcw_scan_paused
        }
        trap cleanup_subshell EXIT INT TERM

        # Осиротевшие проверки прошлых запусков (без pkill: его нет в busybox)
        for _p in /proc/[0-9]*; do
            [ -r "$_p/cmdline" ] || continue
            case "$(tr '\0' ' ' < "$_p/cmdline" 2>/dev/null)" in
                *"blockcheckw check"*) kill -9 "${_p#/proc/}" 2>/dev/null || true ;;
            esac
        done

        # Kill any zombie/orphan nfqws2 holding queue 200 from previous runs
        local stray_pids=$(ps -w | grep -E 'nfqws2.*--qnum=200' | grep -v grep | awk '{print $1}')
        if [ -n "$stray_pids" ]; then
            echo "[blockcheckw-helper] Cleaning stray nfqws2 holding queue 200 ($stray_pids)..." >> "$LOG_FILE"
            kill -9 $stray_pids 2>/dev/null || true
            sleep 1
        fi

        # Чужие прокси/туннели не трогаем. Если домен идёт через туннель,
        # замер через него недостоверен: говорим прямо, но никого не гасим.
        local tunnel_svc
        tunnel_svc=$(scan_tunnel_service "$domain")
        if [ -n "$tunnel_svc" ] && [ "$pause_others" != "1" ]; then
            write_status "error" 0 "Домен $domain идёт через туннель ($tunnel_svc): подбор через туннель недостоверен. Остановите службу вручную или запустите подбор с --pause-others 1"
            echo "[blockcheckw-helper] scan aborted: $domain via $tunnel_svc (чужие службы не тронуты)" >> "$LOG_FILE"
            exit 1
        fi
        if [ "$pause_others" = "1" ]; then
            : > /tmp/bcw_paused_services
            for _svc in zeroblock sing-box mihomo xray openclash passwall; do
                [ -x "/etc/init.d/$_svc" ] || continue
                "/etc/init.d/$_svc" status 2>/dev/null | grep -qiE 'running|active' || continue
                echo "[blockcheckw-helper] $_svc остановлена по запросу (--pause-others)" >> "$LOG_FILE"
                "/etc/init.d/$_svc" stop >/dev/null 2>&1 && echo "$_svc" >> /tmp/bcw_paused_services
            done
        fi

        # Flush DNS cache in case Fake-IP pool (198.18.x.x) was cached by dnsmasq
        killall -HUP dnsmasq 2>/dev/null || true

        # Add top priority rule in fw4 output to bypass any residual transparent proxy / redirect rules
        nft insert rule inet fw4 output priority -250 meta mark and 0x30000000 != 0 accept 2>/dev/null || true

        if [ ! -x "/usr/bin/blockcheckw" ]; then
            write_status "error" 0 "Ошибка: бинарный файл /usr/bin/blockcheckw не найден или нет прав на исполнение"
            echo "[blockcheckw-helper] Error: /usr/bin/blockcheckw missing or not executable" >> "$LOG_FILE"
            exit 1
        fi

        # Лок подбора снимаем в конце (trap), а берём его первым делом:
        # иначе два одновременных запуска успевают пройти проверки до создания лока.
        SCAN_LOCK="/var/run/bcw_scan.lock"
        sleep 7200 &
        SCAN_KEEPER=$!
        if ! mkdir "$SCAN_LOCK" 2>/dev/null; then
            _old=$(cat "$SCAN_LOCK/pid" 2>/dev/null)
            # Пустой pid — лок только что создан другим процессом: даём 2 с и
            # перепроверяем, иначе второй скан угоняет лок у первого.
            [ -n "$_old" ] || { sleep 2; _old=$(cat "$SCAN_LOCK/pid" 2>/dev/null); }
            if [ -n "$_old" ] && _scan_lock_alive "$_old"; then
                kill "$SCAN_KEEPER" 2>/dev/null
                write_status "error" 0 "Подбор уже выполняется. Дождитесь завершения."
                echo '{"success":false,"error":"Подбор уже выполняется. Дождитесь завершения."}'
                exit 1
            fi
            # Лок осиротел (keeper-sleep пережил убитый скан) — снимаем.
            [ -n "$_old" ] && kill -9 "$_old" 2>/dev/null
            rm -rf "$SCAN_LOCK"
            mkdir "$SCAN_LOCK" 2>/dev/null || true
        fi
        echo "$SCAN_KEEPER" > "$SCAN_LOCK/pid" 2>/dev/null || true
        # PID самого shell-скана (subshell): по нему отличаем живой скан от
        # осиротевшего keeper-sleep.
        local _scan_self=""
        read -r _scan_self _ < /proc/self/stat 2>/dev/null || true
        [ -n "$_scan_self" ] && echo "$_scan_self" > "$SCAN_LOCK/scan_pid" 2>/dev/null || true

        echo "[blockcheckw-helper] Starting Unified Smart Scan for $domain (target=$target, workers=$workers, auto_apply=$auto_apply)..." >> "$LOG_FILE"
        history_add "scan_start" "$(metric_target_key "$target")" "Начат подбор для $domain"
        # На время подбора службу останавливаем: иначе её правила перехватывают
        # пробный трафик и сканер видит искажённую картину.
        if _svc_running; then
            _svc_stop
            echo "[blockcheckw-helper] Служба остановлена на время подбора" >> "$LOG_FILE"
            history_add "scan_pause" "$(metric_target_key "$target")" "Служба остановлена на время подбора"
        fi
        : > /tmp/bcw_scan_paused

        # AI/Spotify: базовый домен может открываться без обхода, а CDN —
        # нет. Сканер по базовому домену скажет "not_blocked" и не станет
        # искать. Проверяем все эндпоинты пресета и при необходимости
        # переключаем домен сканирования на заблокированный CDN.

            # Сторож: если процесс подбора умрёт (перезагрузка страницы, kill), служба
            # всё равно вернётся. Без этого пользователь оставался без обхода.
            (
                i=0
                while [ -f "$PID_FILE" ] && [ "$i" -lt 60 ]; do
                    sleep 15
                    i=$((i + 1))
                done
                sleep 5
                if ! _svc_running; then
                    _svc_start_bg
                    logger -t zapret2wizard "сторож подбора: служба поднята после завершения сканирования"
                fi
            ) &

        write_status "running" 15 "Фаза 1: Экспресс-тест векторов DPI ($domain)..."

        local probe_corpus="/tmp/blockcheckw_probe_corpus.txt"
        local probe_output="/tmp/blockcheckw_probe_output.txt"
        rm -f "$probe_corpus" "$probe_output"

        generate_smart_probe_corpus "$target" "$domain" "$probe_corpus"

        # L1/L2: если для домена или его /24 уже есть проверенная стратегия —
        # ставим её первой; забаненные для домена рецепты из корпуса убираем.
        local dom_ip=$(domain_ip "$domain")
        local seed_json=$(mem get "$domain" "$dom_ip")
        local seed_recipe=$(printf '%s' "$seed_json" | sed -n 's/.*"recipe":"\([^"]*\)".*/\1/p')
        if [ -n "$seed_recipe" ]; then
            local seed_src=$(printf '%s' "$seed_json" | sed -n 's/.*"source":"\([^"]*\)".*/\1/p')
            local seed_tmp="$probe_corpus.seed"
            { echo "# --- $seed_src memory seed ---"; \
              echo "curl_test_https_tls12 ipv4 $domain : nfqws2 $seed_recipe"; \
              echo "curl_test_https_tls13 ipv4 $domain : nfqws2 $seed_recipe"; \
              cat "$probe_corpus"; } > "$seed_tmp" && mv -f "$seed_tmp" "$probe_corpus"
            echo "[blockcheckw-helper] Memory seed ($seed_src): $seed_recipe" >> "$LOG_FILE"
        fi
        local mem_removed=$(mem filter "$domain" "$probe_corpus" | sed -n 's/.*"removed":\([0-9]*\).*/\1/p')
        [ -n "$mem_removed" ] && [ "$mem_removed" -gt 0 ] && echo "[blockcheckw-helper] Memory ban: убрано $mem_removed кандидатов" >> "$LOG_FILE"
        # L3: кандидаты с лучшим success-rate из памяти идут раньше.
        local mem_ranked=$(mem rank "$probe_corpus" | sed -n 's/.*"ranked":\([0-9]*\).*/\1/p')
        [ -n "$mem_ranked" ] && echo "[blockcheckw-helper] Memory L3: ранжировано $mem_ranked кандидатов" >> "$LOG_FILE"
        local mem_slow=$(mem ewma_filter "$probe_corpus" 3000 | sed -n 's/.*"removed":\([0-9]*\).*/\1/p')
        [ -n "$mem_slow" ] && [ "$mem_slow" -gt 0 ] && echo "[blockcheckw-helper] Memory EWMA: отсечено $mem_slow медленных кандидатов" >> "$LOG_FILE"
        true

        # Сканер хранит «память прошлых запусков» в $HOME/.config/blockcheckw.
        # Унаследованные от ручных прогонов умолчания (domain_list, dns) молча
        # ломали подбор на другом роутере. Свой HOME на прогон это отсекает.
        local scan_qnum=$(pick_scan_qnum)
        local scan_home=/tmp/bcw_scan_home
        local scan_dns=$(scan_dns_mode "$domain")
        # Не все сборки сканера знают --profiles-per-instance: ставим флаг только
        # если он реально есть, иначе вторая фаза падала с ошибкой аргументов.
        local profiles_opt=""
        if /usr/bin/blockcheckw scan --help 2>/dev/null | grep -q 'profiles-per-instance'; then
            profiles_opt="--profiles-per-instance 64"
        fi
        [ "$scan_dns" = "doh" ] && echo "[blockcheckw-helper] DNS заблокирован провайдером — подбор через DoH" >> "$LOG_FILE"
        mkdir -p "$scan_home" 2>/dev/null || true
        echo "[blockcheckw-helper] Очередь подбора: $scan_qnum" >> "$LOG_FILE"

        # Phase 1: Fast diagnostic probe (3-6s)
        HOME="$scan_home" /usr/bin/blockcheckw --qnum "$scan_qnum" -w "$workers" scan -d "$domain" -p "$protocols" --dns "$scan_dns" --from-file "$probe_corpus" -o "$probe_output" --auto --timeout 120 >> "$LOG_FILE" 2>&1

        local probe_eval=$(lua - "$probe_output" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local f = io.open(arg[1], "r")
if not f then print('{"count":0,"families":0,"vulns":[],"labels":{},"summary":""}') return end
local content = f:read("*a")
f:close()

local count = 0
local fams = {
    geneva = false,
    hostfake = false,
    seqovl = false,
    multidisorder = false,
    fake = false,
    oob = false,
    syndata = false,
    wssize = false,
    multisplit = false,
    tcp_md5 = false,
    autottl = false
}

local parsed = json.parse(content)
local strats = {}
if parsed and parsed.strategies then
    strats = parsed.strategies
else
    for line in content:gmatch("[^\r\n]+") do
        local clean = line:match("^%s*(%-%-[^\r\n]+)")
        if clean and not clean:match("^%-%-%s*#") then
            table.insert(strats, clean)
        end
    end
end

for _, s in ipairs(strats) do
    local a = (type(s) == "table" and s.args) or s
    if a and a ~= "" then
        count = count + 1
        local al = a:lower()
        if al:find("pos=8,12") or al:find("8,12") then fams.geneva = true end
        if al:find("hostfakesplit") or al:find("hostfake") then fams.hostfake = true end
        if al:find("seqovl") then fams.seqovl = true end
        if al:find("multidisorder") then fams.multidisorder = true end
        if al:find("fake:blob") or al:find("badsum") then fams.fake = true end
        if al:find("oob:") or al:find("urp=") then fams.oob = true end
        if al:find("syndata") then fams.syndata = true end
        if al:find("wssize") then fams.wssize = true end
        if al:find("multisplit") then fams.multisplit = true end
        if al:find("tcp_md5") then fams.tcp_md5 = true end
        if al:find("autottl") then fams.autottl = true end
    end
end

local active_vulns = {}
local labels = {
    geneva = "Geneva 8+4 TCB Desync",
    hostfake = "Hostfake (RU SNI)",
    seqovl = "Seqovl Overlap",
    multidisorder = "Packet Disordering",
    fake = "Fake Injection",
    oob = "OOB Out-of-Band",
    syndata = "SYN-Data Early Injection",
    wssize = "Window Clamping (wssize)",
    multisplit = "Multi-segmentation",
    tcp_md5 = "TCP MD5 Option (Routerich)",
    autottl = "Auto-TTL Calibration"
}

for k, active in pairs(fams) do
    if active then table.insert(active_vulns, k) end
end
table.sort(active_vulns)

local summary_parts = {}
for _, v in ipairs(active_vulns) do
    if labels[v] then table.insert(summary_parts, labels[v]) end
end
local summary = table.concat(summary_parts, ", ")

local fp = {
    count = count,
    families = #active_vulns,
    vulns = active_vulns,
    labels = labels,
    summary = summary
}

print(json.stringify(fp))
EOF
)
        echo "$probe_eval" > /tmp/blockcheckw_dpi_fingerprint.json 2>/dev/null || true

        local probe_count=$(echo "$probe_eval" | grep -oE '"count":[0-9]+' | head -n 1 | awk -F: '{print $2}')
        local probe_fams=$(echo "$probe_eval" | grep -oE '"families":[0-9]+' | head -n 1 | awk -F: '{print $2}')
        local probe_summary=$(echo "$probe_eval" | grep -oE '"summary":"[^"]*"' | head -n 1 | cut -d'"' -f4)
        [ -z "$probe_count" ] && probe_count=0
        [ -z "$probe_fams" ] && probe_fams=0

        echo "[blockcheckw-helper] [DPI Genetic Fingerprint] Detected $probe_count working profiles across $probe_fams vulnerability families: $probe_summary" >> "$LOG_FILE"

        local latest_scan=$(ls -t /root/*_scan.json 2>/dev/null | head -n 1)
        if [ -n "$latest_scan" ] && [ -f "$latest_scan" ]; then
            cp -f "$latest_scan" "$OUTPUT_SCAN"
        fi

        local exit_code=0
        local adaptive_output=""

        # Phase 2: If probe yielded fewer than 4 strategies or fewer than 3 vector families, deepen adaptively
        if [ "$probe_count" -lt 4 ] || [ "$probe_fams" -lt 3 ]; then
            echo "[blockcheckw-helper] [Smart Scan] Deepening search into adaptive vector matrix (probe hits: $probe_count, families: $probe_fams)..." >> "$LOG_FILE"
            local adapt_phase="Фаза 2: Адаптивный подбор под DPI"
            [ -n "$probe_summary" ] && adapt_phase="Фаза 2: Адаптивный подбор ($probe_summary)"
            write_status "running" 35 "$adapt_phase..."

            local adaptive_corpus="/tmp/blockcheckw_adaptive_corpus.txt"
            adaptive_output="/tmp/blockcheckw_adaptive_output.txt"
            rm -f "$adaptive_corpus" "$adaptive_output"

            generate_adaptive_corpus "$target" "$domain" "$protocols" "$probe_output" "$adaptive_corpus"
            mem filter "$domain" "$adaptive_corpus" >/dev/null 2>&1 || true
            mem rank "$adaptive_corpus" >/dev/null 2>&1 || true
            mem ewma_filter "$adaptive_corpus" 3000 >/dev/null 2>&1 || true

            local adapt_cnt=$(grep -c '^curl_test_' "$adaptive_corpus" 2>/dev/null || echo 0)
            echo "[blockcheckw-helper] [Smart Scan] Generated $adapt_cnt targeted permutations for DPI vector matrix." >> "$LOG_FILE"

            HOME="$scan_home" /usr/bin/blockcheckw --qnum "$scan_qnum" $profiles_opt -w "$workers" scan -d "$domain" -p "$protocols" --dns "$scan_dns" --timeout 600 --from-file "$adaptive_corpus" -o "$adaptive_output" --auto --progress >> "$LOG_FILE" 2>&1 &
            local bcw_child=$!
            echo "$bcw_child" > "$PID_FILE"

            local cur_pct=38
            local cur_phase="Адаптивный подбор стратегий..."
            while kill -0 "$bcw_child" 2>/dev/null; do
                sleep 1.5

                if [ -f "$LOG_FILE" ]; then
                    local tail_text=$(tail -n 35 "$LOG_FILE" 2>/dev/null)
                    local p_done=$(echo "$tail_text" | grep -oE '"done":[0-9]+' | tail -n 1 | awk -F: '{print $2}')
                    local p_total=$(echo "$tail_text" | grep -oE '"total":[0-9]+' | tail -n 1 | awk -F: '{print $2}')
                    if [ -z "$p_done" ] || [ -z "$p_total" ] || [ "$p_total" -eq 0 ]; then
                        local slash_progress=$(echo "$tail_text" | grep -oE '[0-9]+/[0-9]+' | tail -n 1)
                        if [ -n "$slash_progress" ]; then
                            p_done=$(echo "$slash_progress" | awk -F/ '{print $1}')
                            p_total=$(echo "$slash_progress" | awk -F/ '{print $2}')
                        fi
                    fi

                    if [ -n "$p_done" ] && [ -n "$p_total" ] && [ "$p_total" -gt 0 ]; then
                        local sub_pct=$(( p_done * 100 / p_total ))
                        cur_pct=$(( 35 + p_done * 50 / p_total ))
                        cur_phase="Адаптивный подбор под DPI: $p_done / $p_total (${sub_pct}%)"
                    fi

                    local succ=$(echo "$tail_text" | grep -oE 'success: [0-9]+' | tail -n 1 | awk '{print $2}')
                    if [ -n "$succ" ] && [ "$succ" -gt 0 ]; then
                        cur_phase="$cur_phase [найдено: $succ]"
                    fi

                    write_status "running" "$cur_pct" "$cur_phase"
                fi
            done

            wait "$bcw_child"
            exit_code=$?

            latest_scan=$(ls -t /root/*_scan.json 2>/dev/null | head -n 1)
            if [ -n "$latest_scan" ] && [ -f "$latest_scan" ]; then
                cp -f "$latest_scan" "$OUTPUT_SCAN"
            fi
        fi

        # Merge Phase 1 probe and Phase 2 adaptive outputs so no working strategies are lost
        lua - "$OUTPUT_SCAN" "$probe_output" "$adaptive_output" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local scan_file = arg[1]
local p_file = arg[2]
local a_file = arg[3]

local base_data = { strategies = {} }
local sf = io.open(scan_file, "r")
if sf then
    base_data = json.parse(sf:read("*a")) or { strategies = {} }
    sf:close()
end
if not base_data.strategies then base_data.strategies = {} end

-- Сканер возвращает один и тот же профиль по нескольку раз (по раундам и
-- протоколам), а merge только добавлял новое, не схлопывая сам base. Из-за
-- этого в отчёте было 76 записей при 58 реально разных: список выглядел
-- раздутым, circular получал дубликаты. Схлопываем всё, что уже есть, и
-- заодно собираем протоколы одного и того же args в одну строку.
local seen = {}
local order = {}
local function norm_proto(p)
    if not p then return nil end
    p = p:gsub("^HTTPS/", "")
    p = p:gsub("^%s+", ""):gsub("%s+$", "")
    if p == "" then return nil end
    return p
end
local function add(s)
    local a = (type(s) == "table" and s.args) or s
    if not a or a == "" then return end
    local key = a:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    local p = (type(s) == "table") and norm_proto(s.protocol) or nil
    if not seen[key] then
        seen[key] = { entry = s, protos = {} }
        if p then seen[key].protos[p] = true end
        table.insert(order, key)
    elseif p then
        seen[key].protos[p] = true
    end
end

for _, s in ipairs(base_data.strategies) do add(s) end

local function add_from_file(path)
    if not path or path == "" then return end
    local f = io.open(path, "r")
    if not f then return end
    local content = f:read("*a")
    f:close()
    local parsed = json.parse(content)
    if parsed and parsed.strategies then
        for _, s in ipairs(parsed.strategies) do add(s) end
    else
        for line in content:gmatch("[^\r\n]+") do
            local clean = line:match("^%s*(%-%-[^\r\n]+)")
            if clean and not clean:match("^%-%-%s*#") then
                add({ args = clean, protocol = "HTTPS/TLS1.3", coverage = 1 })
            end
        end
    end
end

add_from_file(p_file)
add_from_file(a_file)

local merged = {}
for _, key in ipairs(order) do
    local rec = seen[key]
    local entry = rec.entry
    if type(entry) == "table" then
        local protos = {}
        for p in pairs(rec.protos) do table.insert(protos, p) end
        table.sort(protos)
        if #protos > 0 then entry.protocol = table.concat(protos, " + ") end
    end
    table.insert(merged, entry)
end

base_data.strategies = merged
base_data.working = #merged
base_data.outcome = (#merged > 0) and "found" or "not_found"

local out_f = io.open(scan_file, "w")
if out_f then
    out_f:write(json.stringify(base_data, true))
    out_f:close()
end
EOF

        # Locate latest scan vanilla report in /root if needed
        local latest_vanilla=$(ls -t /root/*_report_vanilla.txt 2>/dev/null | head -n 1)
        if [ -n "$latest_vanilla" ] && [ -f "$latest_vanilla" ]; then
            cp -f "$latest_vanilla" "$OUTPUT_VANILLA"
        fi

        # Deduplicate and extract strategy list for JSON output and circular builder
        local strats_json="[]"
        local top_strategy=""
        local found_count=0
        if [ -f "$OUTPUT_SCAN" ]; then
            strats_json=$(lua - "$OUTPUT_SCAN" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local scan_file = arg[1]
local f = io.open(scan_file, "r")
if not f then print("[]") return end
local d = json.parse(f:read("*a"))
f:close()
if not d or not d.strategies then print("[]") return end

local list = {}
local seen = {}
for _, s in ipairs(d.strategies) do
    local a = (type(s) == "table" and s.args) or s
    if a and a ~= "" then
        if not seen[a] then
            local item = { args = a, protocols = {} }
            if type(s) == "table" and s.protocol then
                local p = (s.protocol:gsub("^HTTPS/", ""))
                table.insert(item.protocols, p)
            end
            seen[a] = item
            table.insert(list, item)
        else
            if type(s) == "table" and s.protocol then
                local p = (s.protocol:gsub("^HTTPS/", ""))
                local exists = false
                for _, ex in ipairs(seen[a].protocols) do
                    if ex == p then exists = true break end
                end
                if not exists then
                    table.insert(seen[a].protocols, p)
                end
            end
        end
    end
end
print(json.stringify(list))
EOF
)
            found_count=$(lua - "$strats_json" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local d = json.parse(arg[1] or "[]")
print(d and #d or 0)
EOF
)
            top_strategy=$(lua - "$strats_json" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local d = json.parse(arg[1] or "[]")
if d and d[1] then
    print(d[1].args or d[1])
end
EOF
)
        fi

        # Circular — не галочка ради галочки. Связку собираем и применяем
        # только тогда, когда служба доказала серией проверок, что одиночная
        # стратегия не держит нагрузку. Решение принимается здесь, в службе.
        local apply_info=""
        local apply_ok="0"
        local apply_res=""
        local apply_restored="0"
        local circular_used="0"
        local circular_members="0"
        local circular_reason="circular выключен"
        local stab_single=""
        local stab_circ=""
        local single_ok=0 single_total=0

        if [ "$auto_apply" = "1" ] && [ "$found_count" -gt 0 ]; then
            write_status "running" 90 "Применяю лучшую стратегию..."

            local candidates="/tmp/blockcheckw_candidates.$$"
            lua - "$OUTPUT_SCAN" "$OUTPUT_VANILLA" > "$candidates" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local out, seen, fams = {}, {}, {}
local function add(a)
    if type(a) ~= "string" or a == "" then return false end
    a = a:gsub("^%s+", ""):gsub("%s+$", "")
    if a:sub(1, 2) ~= "--" or seen[a] then return false end
    local fam = a:match("lua%-desync=([%w_]+)") or "other"
    if fams[fam] then return false end
    fams[fam] = true
    seen[a] = true
    out[#out + 1] = a
    return true
end
local f = io.open(arg[1], "r")
if f then
    local d = json.parse(f:read("*a")) or {}
    f:close()
    for _, s in ipairs(d.strategies or {}) do
        local a = (type(s) == "table" and s.args) or s
        if add(a) and #out >= 3 then break end
    end
end
if #out < 3 then
    local vf = io.open(arg[2], "r")
    if vf then
        for line in vf:lines() do
            local a = line:match(": nfqws2 (%-%-.*)$") or line:match("^%s*(%-%-.*)$")
            if add(a) and #out >= 3 then break end
        end
        vf:close()
    end
end
for _, a in ipairs(out) do print(a) end
EOF
            local cand tried=0 best_single=""
            local cfg_pkg=$(_strategy_pkg)
            local cfg_backup="/tmp/bcw_cfg_before_apply.$$"
            cp -f "/etc/config/$cfg_pkg" "$cfg_backup" 2>/dev/null || true

            while [ "$tried" -lt 3 ] && IFS= read -r cand; do
                [ -n "$cand" ] || continue
                tried=$((tried + 1))
                [ -z "$best_single" ] && best_single="$cand"
                echo "[blockcheckw-helper] Авто-применение: кандидат $tried — $cand" >> "$LOG_FILE"
                apply_res=$(cmd_apply --target "$target" --script "$cand" 2>/dev/null)
                if printf '%s' "$apply_res" | grep -q '"all_ok":true'; then
                    apply_ok="1"
                    break
                fi
            done < "$candidates"
            rm -f "$candidates"

            # Серия независимых проверок: один удачный запрос — ещё не стабильность.
            if [ "$apply_ok" = "1" ]; then
                local _s=$(cmd_stability "$target" 3 2>/dev/null)
                single_ok=$(printf '%s' "$_s" | grep -o '"ok":[0-9]*' | cut -d: -f2)
                single_total=$(printf '%s' "$_s" | grep -o '"total":[0-9]*' | cut -d: -f2)
                [ -n "$single_ok" ] || single_ok=0
                [ -n "$single_total" ] || single_total=3
                stab_single="$single_ok/$single_total"
            fi

            # Решение службы: когда Circular реально нужен, а когда это лишний риск.
            local need_circ="0"
            case "$do_circular" in
                0) circular_reason="circular выключен" ;;
                force) need_circ=1; circular_reason="включён принудительно" ;;
                *)
                    if [ "$apply_ok" != "1" ]; then
                        need_circ=1; circular_reason="одиночная не прошла проверку"
                    elif [ "$single_ok" -lt "$single_total" ]; then
                        need_circ=1; circular_reason="одиночная нестабильна ($stab_single)"
                    else
                        circular_reason="одиночная стабильна ($stab_single) — связка не нужна"
                    fi
                    ;;
            esac

            if [ "$need_circ" = "1" ]; then
                write_status "running" 93 "Сборка Circular-связки: $circular_reason"
                lua "$CIRCULAR_BUILDER" "$OUTPUT_SCAN" 2 15 4 loop tls_client_hello "$target" > "$OUTPUT_CIRCULAR" 2>> "$LOG_FILE"
                local circ_text=$(tr '\n' ' ' < "$OUTPUT_CIRCULAR" 2>/dev/null)
                circular_members=$(printf '%s' "$circ_text" | grep -o 'strategy=[0-9]*' | sort -u | wc -l)
                circular_members=$(printf '%s' "$circular_members" | tr -d ' ')
                [ -n "$circular_members" ] || circular_members=0
                if [ "$circular_members" -ge 2 ]; then
                    echo "[blockcheckw-helper] Circular: $circular_members техники ($circular_reason)" >> "$LOG_FILE"
                    local circ_res=$(cmd_apply --target "$target" --script "$circ_text" 2>/dev/null)
                    if printf '%s' "$circ_res" | grep -q '"all_ok":true'; then
                        local _c=$(cmd_stability "$target" 3 2>/dev/null)
                        local circ_ok=$(printf '%s' "$_c" | grep -o '"ok":[0-9]*' | cut -d: -f2)
                        local circ_total=$(printf '%s' "$_c" | grep -o '"total":[0-9]*' | cut -d: -f2)
                        [ -n "$circ_ok" ] || circ_ok=0
                        [ -n "$circ_total" ] || circ_total=3
                        stab_circ="$circ_ok/$circ_total"
                        if [ "$circ_ok" -ge "$single_ok" ]; then
                            circular_used="1"
                            apply_ok="1"
                            apply_res="$circ_res"
                            circular_reason="связка $circular_members техник: $stab_circ (одиночная $stab_single)"
                        else
                            circular_reason="связка хуже ($stab_circ), оставлена одиночная ($stab_single)"
                        fi
                    else
                        circular_reason="связка не прошла проверку"
                    fi
                else
                    circular_reason="меньше двух независимых техник — связка невозможна"
                fi
            fi

            # Попытка связки затирает конфиг: если связку не оставили,
            # возвращаем проверенную одиночную стратегию.
            if [ "$need_circ" = "1" ] && [ "$circular_used" != "1" ] && [ -n "$best_single" ]; then
                local back=$(cmd_apply --target "$target" --script "$best_single" 2>/dev/null)
                if printf '%s' "$back" | grep -q '"all_ok":true'; then
                    apply_ok="1"
                    apply_res="$back"
                fi
            fi

            if [ "$apply_ok" = "1" ]; then
                local rec_recipe="$best_single"
                [ "$circular_used" = "1" ] && rec_recipe="$circ_text"
                [ -n "$rec_recipe" ] || rec_recipe="$circ_text"
                if [ -n "$rec_recipe" ]; then
                    local rec_ms=$(cmd_test "$target" "" 2>/dev/null | awk -F'"time_sec":"' '{if (NF>1) {split($2,a,"\""); print int(a[1]*1000)}}' | head -1)
                    [ -n "$rec_ms" ] || rec_ms=0
                    local rec_json=$(mem put "$domain" "$(domain_ip "$domain")" "$rec_recipe" 1 "$rec_ms")
                    echo "[blockcheckw-helper] Memory L1/L2(ewma=${rec_ms}ms): $rec_json" >> "$LOG_FILE"
                fi
                # Приложение YouTube использует отдельный SNI youtubei.googleapis.com;
                # если он закрыт — добавляем отдельный профиль YTApi (проверено на МТС).
                case "$target" in
                    preset_youtube|youtube) cmd_fix_ytapi >/dev/null 2>&1 || true ;;
                esac
                apply_info=",\"auto_applied\":true,\"tried_candidates\":$tried,\"circular_used\":$circular_used,\"circular_members\":$circular_members"
                [ -n "$stab_single" ] && apply_info="$apply_info,\"stability_single\":\"$stab_single\""
                [ -n "$stab_circ" ] && apply_info="$apply_info,\"stability_circular\":\"$stab_circ\""
                apply_info="$apply_info,\"circular_reason\":\"$circular_reason\""
            elif [ "$tried" -gt 0 ]; then
                [ -n "${best_single:-}" ] && mem ban "$domain" "$best_single" "применение не подтвердилось" >/dev/null 2>&1 || true
                [ -n "${circ_text:-}" ] && mem ban "$domain" "$circ_text" "circular не прошла проверку" >/dev/null 2>&1 || true
                if [ -s "$cfg_backup" ]; then
                    cp -f "$cfg_backup" "/etc/config/$cfg_pkg"
                    rm -f /tmp/blockcheckw_apply_result.json
                    echo "[blockcheckw-helper] Проверка не прошла — прежняя конфигурация восстановлена" >> "$LOG_FILE"
                    ( /etc/init.d/zapret2wizard restart >/dev/null 2>&1 & )
                    wait_dpi_ready 20
                    apply_restored="1"
                fi
                if [ "$apply_restored" = "1" ]; then
                    apply_info=",\"apply_warning\":\"Стратегия не подтвердила трафик, прежняя конфигурация возвращена\",\"tried_candidates\":$tried"
                else
                    apply_info=",\"apply_warning\":\"Стратегия записана, но трафик не подтвердился\",\"tried_candidates\":$tried"
                fi
            else
                apply_info=",\"apply_warning\":\"В отчёте не нашлось стратегии для применения\""
            fi
            rm -f "$cfg_backup"
        fi

        local dns_err=$(grep -E 'DNS resolve failed|no IPv4 addresses found|DNS resolution error' "$LOG_FILE" 2>/dev/null | tail -n 1)
        if [ -n "$dns_err" ]; then
            write_status "error" 0 "Ошибка DNS: $dns_err" ",\"strategies\":[]"
            echo "[blockcheckw-helper] Scan failed with DNS error: $dns_err" >> "$LOG_FILE"
        elif [ "$found_count" -gt 0 ]; then
            local final_msg="Найдено рабочих стратегий: $found_count"
            if [ "$auto_apply" = "1" ]; then
                if [ "$apply_ok" = "1" ]; then
                    final_msg="$final_msg (применена и проверена в Zapret2)"
                elif [ "$apply_restored" = "1" ]; then
                    final_msg="$final_msg (применение не подтвердилось, прежняя настройка возвращена)"
                elif [ -n "$apply_res" ]; then
                    final_msg="$final_msg (применена, но полный тест не пройден)"
                fi
            fi
            save_results "$target" "$strats_json"
            write_status "done" 100 "$final_msg" ",\"strategies\":$strats_json,\"scan_found\":$found_count,\"tried\":$found_count$apply_info"
            echo "[blockcheckw-helper] Finished successfully. Found $found_count working strategies." >> "$LOG_FILE"
            history_add "scan_done" "$(metric_target_key "$target")" "Найдено рабочих стратегий: $found_count"
            [ "$apply_ok" = "1" ] && history_add "apply" "$(metric_target_key "$target")" "Стратегия применена и проверена в Zapret2"
        else
            if [ "$exit_code" -ne 0 ]; then
                local last_err=$(tail -n 5 "$LOG_FILE" 2>/dev/null | grep -E 'error|Error|failed|FATAL' | tail -n 1)
                # Самая частая причина на чистом роутере — нет модуля ядра nfnetlink_queue.
                local kmod_err=$(grep -E 'nfq_unbind_pf|nfq_bind_pf|nfq_open\(' "$LOG_FILE" 2>/dev/null | tail -n 1)
                [ -n "$kmod_err" ] && last_err=""
                if [ -z "$last_err" ] && [ -n "$kmod_err" ]; then
                    last_err="Нет модуля ядра nfnetlink_queue. Установите: opkg install kmod-nfnetlink-queue && modprobe nfnetlink_queue"
                fi
                if [ -z "$last_err" ]; then
                    case "$exit_code" in
                        6) last_err="Предполётная проверка не прошла: нет движка nfqws2, модулей nfqueue или nftables. Запустите blockcheckw-helper doctor" ;;
                        *) last_err="Код ошибки $exit_code — запустите blockcheckw-helper doctor для диагностики" ;;
                    esac
                fi
                write_status "error" 0 "Ошибка подбора: $last_err" ",\"strategies\":[]"
                echo "[blockcheckw-helper] Scan failed with exit code $exit_code: $last_err" >> "$LOG_FILE"
            else
                # Новых вариантов нет — но это не значит, что обход не работает:
                # ранее применённая стратегия остаётся в конфиге. Проверяем её.
                _svc_running || _svc_start_bg
                local cur_test=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
                if printf '%s' "$cur_test" | grep -q '"all_ok":true'; then
                    save_results "$target" "[]"
                    write_status "done" 100 "Новых стратегий не найдено — текущая конфигурация уже работает" ",\"strategies\":[],\"current_ok\":true"
                    echo "[blockcheckw-helper] 0 новых, текущая стратегия рабочая" >> "$LOG_FILE"
                else
                    save_results "$target" "[]"
                    write_status "done" 100 "Поиск завершен. Ничего не подошло, попробуйте глубокий скан." ",\"strategies\":[],\"current_ok\":false"
                    echo "[blockcheckw-helper] Scan completed with 0 matches." >> "$LOG_FILE"
                fi
            fi
        fi

        rm -f "$PID_FILE"
        kill "$SCAN_KEEPER" 2>/dev/null
        rm -rf "$SCAN_LOCK" /var/run/bcw_scan.active 2>/dev/null
    ) </dev/null >/dev/null 2>&1 &

    local pid=$!
    echo "$pid" > "$PID_FILE"
    echo '{"status":"started","pid":'"$pid"',"domain":"'"$domain"'","mode":"'"$mode"'","auto_apply":'"$auto_apply"'}'
}

cmd_status() {
    ensure_json
    local is_running=false
    if is_scanner_running; then
        is_running=true
    fi
    # Живой лок подбора важнее эвристики «процесс не найден»: в фазе
    # применения сканер — это shell, а не бинарь blockcheckw, и сторож
    # успевал объявить «done 100%», пока подбор ещё работал.
    local lock_alive=0
    if [ -d /var/run/bcw_scan.lock ]; then
        local _lp=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        if [ -n "$_lp" ] && kill -0 "$_lp" 2>/dev/null; then
            lock_alive=1
        fi
    fi

    lua - "$STATUS_FILE" "$LOG_FILE" "$OUTPUT_SCAN" "$is_running" "$lock_alive" << 'EOF'
local json = require("luci.jsonc")
local status_file = arg[1]
local log_file = arg[2]
local scan_file = arg[3]
local is_running = (arg[4] == "true")
local lock_alive = (arg[5] == "1")

local st = {}
local sf = io.open(status_file, "r")
if sf then
    st = json.parse(sf:read("*a")) or {}
    sf:close()
end

if not st.status then
    st.status = is_running and "running" or "idle"
    st.percent = is_running and 25 or 0
    st.phase = is_running and "Сканирование выполняется..." or "Готов к работе"
    st.strategies = {}
end

-- Process death watchdog: only trigger if really not running and status is stuck in running
if not is_running and not lock_alive and st.status == "running" then
    if (st.strategies and #st.strategies > 0) or st.auto_applied then
        st.status = "done"
        st.percent = 100
        st.phase = "Сканирование завершено"
    else
        local nixio = require("nixio")
        local attr = nixio.fs.stat(status_file)
        local is_stale = true
        if attr and attr.mtime and (os.time() - attr.mtime < 25) then
            is_stale = false
        end
        if is_stale then
            local finished = false
            local lf = io.open(log_file, "r")
            if lf then
                local content = lf:read("*a") or ""
                lf:close()
                if content:find("Summary for") or content:find("OK scan report") or
                   content:find("Finished successfully") or content:find("Auto%-applied strategy") or
                   content:find("Restoring zapret2") or content:find("Scan completed") or
                   content:find("успешно создана") or content:find("working strategies") then
                    finished = true
                end
            end
            if not finished then
                st.status = "error"
                st.phase = "Процесс сканера завершился неожиданно (нехватка RAM или сбой)."
            else
                st.status = "done"
                st.percent = 100
                st.phase = "Сканирование завершено"
            end
            local tmp = status_file .. ".tmp"
            local out = io.open(tmp, "w")
            if out then
                out:write(json.stringify(st))
                out:close()
                os.rename(tmp, status_file)
            end
        end
    end
end

-- Enrich with ISP from log if missing
if not st.isp or st.isp == "" then
    local lf = io.open(log_file, "r")
    if lf then
        for line in lf:lines() do
            local isp_match = line:match("ISP:%s*(.+)")
            if isp_match then
                st.isp = isp_match:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^%s+", "")
                break
            end
        end
        lf:close()
    end
end

-- Enrich with block_type from scan or log if missing
if not st.block_type or st.block_type == "" then
    local scf = io.open(scan_file, "r")
    if scf then
        local sc = json.parse(scf:read("*a")) or {}
        scf:close()
        if sc.block_type then
            st.block_type = sc.block_type
        end
    end
end

if not st.block_type or st.block_type == "" then
    local lf = io.open(log_file, "r")
    if lf then
        local content = lf:read("*a") or ""
        lf:close()
        local bt = content:match('"block_type":%s*"([^"]+)"')
        if bt then
            st.block_type = bt
        elseif content:find("SNI blocked") or content:find("BLOCKED") then
            st.block_type = "sni_blocked"
        elseif content:find("IP blocked") then
            st.block_type = "ip_blocked"
        end
    end
end

if not st.apply_result then
    local arf = io.open("/tmp/blockcheckw_apply_result.json", "r")
    if arf then
        local ar = json.parse(arf:read("*a"))
        arf:close()
        if ar then
            st.apply_result = ar
            if st.auto_applied == nil and ar.success then
                st.auto_applied = true
            end
        end
    end
end

if not st.dpi_fingerprint then
    local dpf = io.open("/tmp/blockcheckw_dpi_fingerprint.json", "r")
    if dpf then
        local dp = json.parse(dpf:read("*a"))
        dpf:close()
        if dp then st.dpi_fingerprint = dp end
    end
end

print(json.stringify(st))
EOF
}

# Запуск подбора в фоне: rpcd/uhttpd не ждут многоминутный скан.
cmd_start_bg() {
    exec 2>>/tmp/bcw_sb_trace.log
    echo "=== $(date +%H:%M:%S) start_bg begin ===" >> /tmp/bcw_sb_trace.log
    # Атомарный засов на время проверки и запуска: два одновременных клика
    # UI иначе успевают проскочить до создания лока подбора и запускают два скана.
    if command -v flock >/dev/null 2>&1; then
        exec 9>/var/run/bcw_start.lock
        if ! flock -n 9; then
            echo '{"ok":false,"error":"Подбор уже запускается"}'
            return 0
        fi
    fi
    set -x
    # Не даём запускать второй подбор: флаг, лок и живые процессы
    if [ -d /var/run/bcw_scan.lock ]; then
        local _p=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null; then
            echo '{"ok":false,"error":"Подбор уже выполняется"}'
            return 0
        fi
    fi
    if ps w | grep -qE '[b]lockcheckw-helper (start|apply) '; then
        echo '{"ok":false,"error":"Подбор уже выполняется"}'
        return 0
    fi
    # Быстрая синхронная проверка: UI сразу получает понятную причину.
    scan_preflight || return 1

    local quoted=""
    local a
    for a in "$@"; do
        quoted="$quoted '$a'"
    done
    if command -v setsid >/dev/null 2>&1; then
        : > /tmp/bcw_scan_bg.log
        setsid /bin/sh -c "exec /usr/bin/blockcheckw-helper start$quoted" </dev/null >>/tmp/bcw_scan_bg.log 2>&1 &
    else
        start-stop-daemon -S -b -x /bin/sh -- -c "/usr/bin/blockcheckw-helper start$quoted" >/dev/null 2>&1 \
            || ( /bin/sh -c "/usr/bin/blockcheckw-helper start$quoted" >/dev/null 2>&1 & )
    fi
    set +x
    echo "=== $(date +%H:%M:%S) start_bg end ===" >> /tmp/bcw_sb_trace.log
    echo '{"ok":true,"started":true}'
}

cmd_stop() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$pid" ]; then
            kill -TERM "$pid" 2>/dev/null
            sleep 1
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
    fi
    killall -9 blockcheckw blockcheckw-helper 2>/dev/null
    # Keeper-лок мог пережить скан: гасим его явно.
    if [ -d /var/run/bcw_scan.lock ]; then
        local _kp=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        [ -n "$_kp" ] && kill -9 "$_kp" 2>/dev/null
    fi
    rm -f /tmp/blockcheckw.lock
    rm -rf /var/run/bcw_scan.lock 2>/dev/null || true
    rm -f /tmp/bcw_scan_paused /tmp/bcw_paused_services 2>/dev/null || true
    nft delete table inet blockcheckw 2>/dev/null
    # Остановили службу — снимаем и Reject-QUIC, иначе YouTube-видео
    # остаётся без UDP/443 даже при работе другого обхода.
    if uci -q get firewall.reject_quic >/dev/null 2>&1; then
        uci -q set firewall.reject_quic.enabled=0
        uci -q commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    sh /usr/share/zapret2wizard/quic_reject.sh remove >/dev/null 2>&1 || true
    restart_dpi_service
    write_status "idle" 0 "Остановлено пользователем"
    echo '{"status":"stopped"}'
}

cmd_apply() {
    local target=""
    local script_text=""
    local script_file=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --script) script_text="$2"; shift 2 ;;
            --file) script_file="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -n "$script_file" ] && [ -f "$script_file" ]; then
        script_text=$(cat "$script_file")
    fi

    # Иногда в файл попадает целая строка лога blockcheck2 вида
    # "curl_test_https_tls12 ipv4 discord.com : nfqws2 --payload=...". Оставляем только аргументы.
    case "$script_text" in
        *" : nfqws2 "*) script_text="${script_text##* : nfqws2 }" ;;
    esac
    script_text=$(printf '%s' "$script_text" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

    # Неполная стратегия (обрывок вроде "--payload=tls_client_hello") ломает обход.
    if [ -n "$script_text" ] && ! printf '%s' "$script_text" | grep -q -- '--lua-desync\|--new\|--filter'; then
        echo '{"success":false,"error":"Стратегия неполная: нет --lua-desync"}'
        return 1
    fi

    if [ -z "$target" ] || [ -z "$script_text" ]; then
        echo '{"success":false,"error":"Missing --target or --script argument"}'
        return 1
    fi

    # Backup zapret2 config
    local ts=$(date +%Y%m%d_%H%M%S)
    local _bpkg=$(_strategy_pkg)
    cp -f "/etc/config/$_bpkg" "/etc/config/$_bpkg.bak.$ts" 2>/dev/null || true

    # Снимок конфигов для авто-отката: apply меняет обе возможные секции.
    local rb_dir="/tmp/bcw_apply_rollback"
    rm -rf "$rb_dir"; mkdir -p "$rb_dir"
    local _rpkg
    for _rpkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$_rpkg" ] && cp -f "/etc/config/$_rpkg" "$rb_dir/$_rpkg"
    done

    # Map target to base strategy section
    local base_sec=""
    local port="443"
    local l7="tls"
    local hostlist=""
    local test_url=""

    case "$target" in
        preset_youtube|youtube)
            base_sec="BlockcheckW_YouTube"
            port="443"
            l7="tls"
            hostlist="list_hosts_youtube"
            test_url="https://googlevideo.com"
            ;;
        preset_discord|discord)
            base_sec="BlockcheckW_Discord"
            port="443"
            l7="tls discord"
            hostlist="list_hosts_discord"
            test_url="https://discord.com"
            ;;
        preset_twitch|twitch)
            base_sec="BlockcheckW_Twitch"
            port="443"
            l7="tls"
            hostlist="list_hosts_twitch"
            test_url="https://twitch.tv"
            ;;
        preset_x|x)
            base_sec="BlockcheckW_X"
            port="443"
            l7="tls"
            hostlist="list_hosts_x"
            test_url="https://x.com"
            ;;
        preset_instagram|instagram)
            base_sec="BlockcheckW_Instagram"
            port="443"
            l7="tls"
            hostlist="list_hosts_instagram"
            test_url="https://gateway.instagram.com"
            ;;
        tcp16)
            base_sec="BlockcheckW_TCP16"
            port="443"
            l7="tls"
            hostlist="list_hosts_discord"
            test_url="https://discord.com"
            ;;
        builtin|general)
            base_sec="BlockcheckW_General"
            port="80,443"
            l7="tls http"
            hostlist="list_hosts_user"
            test_url="https://rutracker.org"
            ;;
        *)
            local safe_t=$(echo "$target" | tr -c 'a-zA-Z0-9_' '_')
            base_sec="BlockcheckW_$safe_t"
            port="443"
            l7="tls"
            hostlist="list_hosts_user"
            test_url="https://$target"
            ;;
    esac

    # Всегда пишем в базовую секцию: старые нумерованные отключаются ниже,
    # иначе конфиг разрастается, а интерфейс показывает устаревшую стратегию.
    local sec_name="$base_sec"
    local pkg=$(_strategy_pkg)

    # Disable previously active strategies for this target to prevent desync/filter conflicts,
    # keeping all older strategies safely stored in /etc/config/zapret2 & /etc/config/zapret2wizard
    for pkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$pkg" ] || continue
        uci -q set "$pkg.$base_sec.enabled=0"
        for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.$base_sec\_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
            uci -q set "$pkg.$s.enabled=0"
        done
        if [ "$base_sec" = "BlockcheckW_YouTube" ] || [ "$base_sec" = "MyTube" ]; then
            uci -q set "$pkg.MyTube.enabled=0"
            uci -q set "$pkg.Youtube_circular.enabled=0"
            for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.(MyTube_|BlockcheckW_YouTube_)" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                uci -q set "$pkg.$s.enabled=0"
            done
        elif [ "$base_sec" = "BlockcheckW_Discord" ]; then
            uci -q set "$pkg.Discord_circular.enabled=0"
            uci -q set "$pkg.BlockcheckW_Discord_Voice.enabled=0"
            for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.BlockcheckW_Discord_Voice_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                uci -q set "$pkg.$s.enabled=0"
            done
        elif [ "$base_sec" = "BlockcheckW_General" ]; then
            uci -q set "$pkg.Routerich_circular.enabled=0"
        fi

        # Create new strategy section
        uci set "$pkg.$sec_name=strategy"
        uci set "$pkg.$sec_name.enabled=1"
        uci set "$pkg.$sec_name.port=$port"
        uci set "$pkg.$sec_name.protocol=tcp"
        uci -q delete "$pkg.$sec_name.filter_l3"
        uci -q delete "$pkg.$sec_name.filter_l7"
        uci -q delete "$pkg.$sec_name.hostlist"
        uci -q delete "$pkg.$sec_name.hostlist_exclude"
        uci add_list "$pkg.$sec_name.filter_l3=ipv4"
        for proto in $l7; do
            uci add_list "$pkg.$sec_name.filter_l7=$proto"
        done
        uci add_list "$pkg.$sec_name.hostlist=$hostlist"
        if [ "$target" = "preset_youtube" ] || [ "$target" = "youtube" ] || [ "$target" = "builtin" ] || [ "$target" = "general" ]; then
            uci add_list "$pkg.$sec_name.hostlist_exclude=list_hosts_user_exclude"
        fi
        uci set "$pkg.$sec_name.script=$script_text"

        if [ "$base_sec" = "BlockcheckW_Discord" ]; then
            uci -q set "$pkg.blob_stun.enabled=1"
            local v_idx=$(echo "$sec_name" | grep -oE '_[0-9]+$')
            voice_sec_name="BlockcheckW_Discord_Voice${v_idx}"

            uci set "$pkg.$voice_sec_name=strategy"
            uci set "$pkg.$voice_sec_name.enabled=1"
            uci set "$pkg.$voice_sec_name.port=50000-65535,19294-19344"
            uci set "$pkg.$voice_sec_name.protocol=udp"
            uci -q delete "$pkg.$voice_sec_name.filter_l3"
            uci -q delete "$pkg.$voice_sec_name.filter_l7"
            uci add_list "$pkg.$voice_sec_name.filter_l3=ipv4"
            uci add_list "$pkg.$voice_sec_name.filter_l7=discord"
            uci add_list "$pkg.$voice_sec_name.filter_l7=stun"
            uci set "$pkg.$voice_sec_name.script=--payload=discord_ip_discovery,stun --lua-desync=circular:fails=3:maxtime=20 --lua-desync=fake:blob=blob_stun:repeats=2:strategy=1 --lua-desync=udplen:increment=2:strategy=2 --lua-desync=fake:blob=blob_stun:repeats=4:strategy=3"
        fi
    done

    sync_uci_commit

    # Restart DPI service
    restart_dpi_service

    # Ждём, пока служба реально поднимется: иначе тест всегда падает
    local _w=0
    while [ "$_w" -lt 25 ]; do
        if _svc_running && nft list table inet zapret2wizard >/dev/null 2>&1; then
            break
        fi
        sleep 1
        _w=$((_w + 1))
    done
    sleep 2
    local zapret_running=$(get_dpi_service_status)

    # Test connectivity with curl (Multi-Domain and Data Flow validation)
    local curl_status=0
    local http_code="200"
    local all_ok_val=false
    local multi_res=""
    local _try
    for _try in 1 2 3; do
        multi_res=$(cmd_test "$target" "$test_url" 2>/dev/null)
        if echo "$multi_res" | grep -q '"all_ok":true'; then
            break
        fi
        sleep 3
    done
    if [ -n "$multi_res" ]; then
        if echo "$multi_res" | grep -q '"accessible":true'; then
            curl_status=1
        fi
        if echo "$multi_res" | grep -q '"all_ok":true'; then
            all_ok_val=true
        fi
        local extracted_code=$(echo "$multi_res" | grep -o '"http_code":"[^"]*"' | head -n 1 | cut -d'"' -f4)
        [ -n "$extracted_code" ] && http_code="$extracted_code"
    fi

    # Если трафик не подтвердился — возвращаем конфиг, который был до apply.
    local rolled_back=false
    local out_msg="Новая запись стратегии ($sec_name) успешно создана в Zapret2, активирована и проверена!"
    if [ "$all_ok_val" != "true" ]; then
        local _restored=0
        for _rpkg in zapret2 zapret2wizard; do
            if [ -f "$rb_dir/$_rpkg" ]; then
                cp -f "$rb_dir/$_rpkg" "/etc/config/$_rpkg"
                uci -q commit "$_rpkg" 2>/dev/null || true
                _restored=1
            fi
        done
        if [ "$_restored" = "1" ]; then
            restart_dpi_service
            local _rw=0
            while [ "$_rw" -lt 20 ]; do
                if _svc_running && nft list table inet zapret2wizard >/dev/null 2>&1; then
                    break
                fi
                sleep 1
                _rw=$((_rw + 1))
            done
            rolled_back=true
            out_msg="Стратегия не подтвердила трафик — прежняя конфигурация восстановлена"
        fi
    fi
    rm -rf "$rb_dir"

    local res_json=$(cat <<EOF
{
  "success": true,
  "message": "$out_msg",
  "target": "$target",
  "section": "$sec_name",
  "zapret2_status": "$zapret_running",
  "test_url": "$test_url",
  "http_code": "$http_code",
  "connected": $([ "$curl_status" = "1" ] && echo "true" || echo "false"),
  "all_ok": $all_ok_val,
  "rolled_back": $rolled_back,
  "multi_domain": ${multi_res:-"{}"}
}
EOF
)
    echo "$res_json" > /tmp/blockcheckw_apply_result.json
    echo "$res_json"
}

cmd_activate() {
    local target=""
    local section=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --section) section="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$section" ]; then
        echo '{"success":false,"error":"Missing --section argument"}'
        return 1
    fi

    if ! uci -q get "$pkg.$section" >/dev/null; then
        echo "{\"success\":false,\"error\":\"Strategy section '$section' not found in zapret2\"}"
        return 1
    fi

    local base_sec=""
    case "$target" in
        preset_youtube|youtube) base_sec="BlockcheckW_YouTube" ;;
        preset_discord|discord) base_sec="BlockcheckW_Discord" ;;
        preset_twitch|twitch) base_sec="BlockcheckW_Twitch" ;;
        preset_x|x) base_sec="BlockcheckW_X" ;;
        preset_instagram|instagram) base_sec="BlockcheckW_Instagram" ;;
        tcp16) base_sec="BlockcheckW_TCP16" ;;
        builtin|general) base_sec="BlockcheckW_General" ;;
        *)
            if [ -n "$target" ]; then
                base_sec="BlockcheckW_$(echo "$target" | tr -c 'a-zA-Z0-9_' '_')"
            else
                base_sec=$(echo "$section" | sed -E 's/_[0-9]+$//')
            fi
            ;;
    esac

    # Disable all other sections for this target in both configs
    for pkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$pkg" ] || continue
        if [ -n "$base_sec" ]; then
            uci -q set "$pkg.$base_sec.enabled=0"
            for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.$base_sec\_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                uci -q set "$pkg.$s.enabled=0"
            done
            if [ "$base_sec" = "BlockcheckW_YouTube" ] || [ "$base_sec" = "MyTube" ]; then
                uci -q set "$pkg.MyTube.enabled=0"
                uci -q set "$pkg.Youtube_circular.enabled=0"
                for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.(MyTube_|BlockcheckW_YouTube_)" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                    uci -q set "$pkg.$s.enabled=0"
                done
            fi
            if [ "$base_sec" = "BlockcheckW_Discord" ]; then
                uci -q set "$pkg.Discord_circular.enabled=0"
                uci -q set "$pkg.BlockcheckW_Discord_Voice.enabled=0"
                for s in $(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.BlockcheckW_Discord_Voice_" | grep '=strategy$' | cut -d'.' -f2 | cut -d'=' -f1); do
                    uci -q set "$pkg.$s.enabled=0"
                done
            fi
            [ "$base_sec" = "BlockcheckW_General" ] && uci -q set "$pkg.Routerich_circular.enabled=0"
        fi

        # Enable target section
        uci set "$pkg.$section.enabled=1"

        # Synchronize Discord VoiceFlow strategy
        if [ "$base_sec" = "BlockcheckW_Discord" ]; then
            uci -q set "$pkg.blob_stun.enabled=1"
            local v_idx=$(echo "$section" | grep -oE '_[0-9]+$')
            local target_voice="BlockcheckW_Discord_Voice${v_idx}"
            if uci -q get "$pkg.$target_voice" >/dev/null; then
                uci set "$pkg.$target_voice.enabled=1"
            elif uci -q get "$pkg.BlockcheckW_Discord_Voice" >/dev/null; then
                uci set "$pkg.BlockcheckW_Discord_Voice.enabled=1"
            fi
        fi
    done

    sync_uci_commit
    restart_dpi_service
    sleep 1
    local zapret_running=$(get_dpi_service_status)

    echo "{\"success\":true,\"message\":\"Стратегия $section успешно активирована в Zapret2Wizard!\",\"section\":\"$section\",\"zapret2_status\":\"$zapret_running\"}"
}

cmd_delete_strategy() {
    local section="$1"
    if [ -z "$section" ]; then
        echo '{"success":false,"error":"Missing section name"}'
        return 1
    fi
    for pkg in zapret2 zapret2wizard; do
        [ -f "/etc/config/$pkg" ] || continue
        uci -q delete "$pkg.$section"
    done
    sync_uci_commit
    restart_dpi_service
    echo "{\"success\":true,\"message\":\"Запись $section удалена.\"}"
}

cmd_test_impl() {
    local target_or_url="${1:-preset_youtube}"
    local custom_url="$2"

    lua - "$target_or_url" "$custom_url" "$PRESETS_FILE" << 'EOF'
local json = require("luci.jsonc")
local arg1 = arg[1] or "preset_youtube"
local arg2 = arg[2] or ""
local presets_file = arg[3]

local p = arg1:gsub("^preset_", "")
local preset_key = "preset_" .. p
if arg1 == "builtin" or arg1 == "general" then preset_key = "builtin" end

local pf = io.open(presets_file, "r")
local presets_data = {}
if pf then
    presets_data = json.parse(pf:read("*a")) or {}
    pf:close()
end

local preset_obj = presets_data.presets and (presets_data.presets[preset_key] or presets_data.presets[arg1])
local endpoints = {}

if preset_obj and preset_obj.validation_endpoints and #preset_obj.validation_endpoints > 0 then
    for _, ep in ipairs(preset_obj.validation_endpoints) do
        table.insert(endpoints, {
            name = ep.name,
            url = ep.url,
            range = ep.range or "0-16383",
            type = ep.type or "http",
            host = ep.host,
            port = ep.port
        })
    end
else
    local test_url = (arg2 and arg2 ~= "") and arg2 or (preset_obj and (preset_obj.test_url or preset_obj.domain)) or arg1
    if not test_url:match("^https?://") then
        test_url = "https://" .. test_url
    end
    local host_label = test_url:gsub("^https?://", ""):gsub("/.*$", "")
    table.insert(endpoints, { name = "Основной узел (" .. host_label .. ")", url = test_url, range = "0-32767", type = "http" })
end

local results = {}
local total_ok = 0
local main_ok = false
local total_speed_kbs = 0

for idx, ep in ipairs(endpoints) do
    if ep.type == "stun" then
        local nixio = require("nixio")
        local t0 = nixio.nanotime and nixio.nanotime() or 0
        local host = ep.host or "stun.l.google.com"
        local port = tonumber(ep.port) or 19302
        local ai = nixio.getaddrinfo(host, "inet")
        local ip = ai and ai[1] and ai[1].address
        local s_ok = false
        local dt_ms = 0
        local s_code = "000"
        if ip then
            local s = nixio.socket("inet", "dgram")
            if s then
                s:setopt("socket", "rcvtimeo", 2)
                local req = string.char(0x00, 0x01, 0x00, 0x00, 0x21, 0x12, 0xa4, 0x42,
                                        0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c)
                s:sendto(req, ip, port)
                local buf = s:recvfrom(512)
                dt_ms = nixio.nanotime and math.floor((nixio.nanotime() - t0) / 1000000) or 15
                s:close()
                if buf and #buf >= 20 then
                    local b1, b2, b3, b4, b5, b6, b7, b8 = buf:byte(1, 8)
                    if b1 == 0x01 and b2 == 0x01 and b5 == 0x21 and b6 == 0x12 and b7 == 0xa4 and b8 == 0x42 then
                        s_ok = true
                        s_code = "STUN-200"
                    else
                        s_ok = true
                        s_code = "STUN-OK"
                    end
                else
                    s_code = "TIMEOUT"
                end
            else
                s_code = "SOCK-ERR"
            end
        else
            s_code = "DNS-FAIL"
        end

        if s_ok then
            total_ok = total_ok + 1
            if idx == 1 then main_ok = true end
        end

        table.insert(results, {
            name = ep.name,
            url = ep.url or ("stun://" .. host .. ":" .. port),
            http_code = s_code,
            accessible = s_ok,
            data_flow = s_ok,
            size_bytes = s_ok and 32 or 0,
            speed_kbs = 0,
            time_sec = string.format("%.3f", dt_ms / 1000)
        })
    else
        local range_opt = (ep.range and ep.range ~= "") and ("--range " .. ep.range) or "--range 0-16383"
        local exp_bytes = 0
        if ep.range and ep.range ~= "" then
            local ra, rb = tostring(ep.range):match("^(%d+)%-(%d+)$")
            if ra and rb then exp_bytes = tonumber(rb) - tonumber(ra) + 1 end
        end
        -- Для больших страниц ждём дольше 6 с: иначе реальный 16-КБ cap ТСПУ
        -- обрывается по таймауту и выглядит как обычный 000, а не как обрезка.
        local mopt = (exp_bytes >= 32768) and "20" or "6"
        local cmd = string.format("curl -4 -k -s -L %s -w '%%{http_code}|%%{size_download}|%%{speed_download}|%%{time_total}' -o /dev/null --connect-timeout 4 -m %s '%s' 2>/dev/null", range_opt, mopt, ep.url)
        local pipe = io.popen(cmd)
        local out = pipe and pipe:read("*a") or ""
        if pipe then pipe:close() end

        local code, size, speed, elapsed = out:match("([^|]+)|([^|]+)|([^|]+)|([^|]+)")
        code = code or "000"
        size = tonumber(size) or 0
        speed = tonumber(speed) or 0
        elapsed = tonumber(elapsed) or 0.0

        local code_num = tonumber(code) or 0
        local is_ok = false
        local is_truncated = false
        local stall_reason = ""

        -- Таймаут с частично принятым телом 14..32 КБ — это тот самый 16-КБ cap:
        -- сервер отдал начало, дальше ТСПУ молча держит поток.
        if code_num == 0 and size >= 14336 and size < 32768 and elapsed >= 15 then
            is_truncated = true
            stall_reason = "16k_cap"
        end

        if (code_num >= 200 and code_num < 400) then
            if code_num == 204 then
                is_ok = (elapsed < 5.0)
                if not is_ok then stall_reason = "204_slow" end
            else
                -- Валидация потока против обрыва ТСПУ: 16 КБ cap, недобор тела,
                -- зависание. Порог 14..32 КБ + 15 с — эвристика tachyon-desync:
                -- сервер отдал начало, дальше DPI молча держит поток.
                if size > 0 then
                    is_ok = (elapsed < 5.5)
                    if not is_ok then stall_reason = "slow_body" end
                    if size >= 14336 and size < 32768 and elapsed >= 15.0 then
                        is_ok = false
                        is_truncated = true
                        stall_reason = "16k_cap"
                    end
                    -- Крупный запрос, а пришло меньше половины — ТСПУ оборвал поток.
                    if exp_bytes >= 100000 and size < exp_bytes * 0.5 then
                        is_ok = false
                        is_truncated = true
                        if stall_reason == "" or stall_reason == "slow_body" then stall_reason = "short_body" end
                    end
                    -- Короткая чистая транзакция (JSON API, WebSocket upgrade, картинка)
                    -- не должна считаться обрывом, если объём ожидаем для эндпоинта.
                    if size >= 96 and size < 32768 and elapsed < 5.5 and code_num ~= 204
                       and (exp_bytes < 100000 or size >= exp_bytes * 0.5) then
                        is_ok = true
                        is_truncated = false
                        if stall_reason == "slow_body" or stall_reason == "short_body" then stall_reason = "" end
                    end
                else
                    is_ok = false
                    is_truncated = true
                    stall_reason = "zero_body"
                end
            end
        elseif (code_num == 403 or code_num == 404) then
            is_ok = (elapsed < 4.5)
            if not is_ok then stall_reason = "auth_slow" end
        else
            stall_reason = "http_" .. tostring(code)
        end

        local speed_kbs = math.floor(speed / 1024)
        total_speed_kbs = total_speed_kbs + speed_kbs

        if is_ok then
            total_ok = total_ok + 1
            if idx == 1 then main_ok = true end
        end

        table.insert(results, {
            name = ep.name,
            url = ep.url,
            http_code = code,
            accessible = is_ok,
            truncated = is_truncated,
            stall_reason = stall_reason,
            data_flow = ((size > 0 or code_num == 204 or code_num == 403 or code_num == 404) and is_ok),
            size_bytes = size,
            speed_kbs = speed_kbs,
            time_sec = string.format("%.2f", elapsed)
        })
    end
end

local has_truncated = false
local has_cap16 = false
local cap16_name = ""
for _, r in ipairs(results) do
    if r.truncated then has_truncated = true end
    if r.stall_reason == "16k_cap" then has_cap16 = true; cap16_name = r.name end
end

local all_ok = (total_ok == #endpoints and #endpoints > 0)
local overall_status = "blocked"
local status_msg = "✗ Сервис не отвечает (заблокирован ТСПУ или ошибка сети)."

if all_ok then
    overall_status = "optimal"
    status_msg = "✓ Все компоненты сервиса доступны, данные передаются без помех (" .. #endpoints .. "/" .. #endpoints .. ")"
elseif has_cap16 then
    overall_status = "degraded"
    status_msg = "⚠️ ТСПУ обрывает поток на ~16 КБ (" .. cap16_name .. "): соединение есть, данные не идут."
elseif has_truncated then
    overall_status = "degraded"
    status_msg = "⚠️ Обнаружен скрытый троттлинг ТСПУ: соединение установлено, но передача потока данных заблокирована (0 байт)!"
elseif main_ok then
    overall_status = "degraded"
    if preset_key == "preset_discord" then
        status_msg = "⚠️ Частичная доступность: чат и API отвечают, но голосовой RTC канал Discord заблокирован ТСПУ!"
    else
        status_msg = "⚠️ Частичная доступность: основной сайт отвечает, но часть медиа/видеопотоков заблокирована ТСПУ!"
    end
end

local avg_speed = (#endpoints > 0) and math.floor(total_speed_kbs / #endpoints) or 0

local resp = {
    target = arg1,
    url = (endpoints[1] and endpoints[1].url) or "",
    http_code = (results[1] and results[1].http_code) or "000",
    accessible = main_ok,
    all_ok = all_ok,
    overall_status = overall_status,
    message = status_msg,
    avg_speed_kbs = avg_speed,
    endpoints = results
}

print(json.stringify(resp))
EOF
}

# Нормализует идентификатор цели к ключу сервиса в интерфейсе.
metric_target_key() {
    case "$1" in
        preset_youtube|youtube) echo "youtube" ;;
        preset_discord|discord) echo "discord" ;;
        preset_instagram|instagram) echo "instagram" ;;
        preset_x|x) echo "x" ;;
        preset_twitch|twitch) echo "twitch" ;;
        builtin|general|user) echo "general" ;;
        *) echo "$1" ;;
    esac
}

# Домен, по которому проверяется/запоминается сервис.
target_domain() {
    case "$1" in
        preset_youtube|youtube) echo "www.youtube.com" ;;
        preset_discord|discord) echo "discord.com" ;;
        preset_twitch|twitch) echo "twitch.tv" ;;
        preset_x|x) echo "x.com" ;;
        preset_instagram|instagram) echo "gateway.instagram.com" ;;
        builtin|general) echo "rutracker.org" ;;
        *) echo "" ;;
    esac
}

# Записывает результат проверки в tests.json и строку в историю.
record_test_metrics() {
    local raw="$1"
    local key=$(metric_target_key "${2:-unknown}")
    [ -n "$raw" ] || return 0
    local tmp="/tmp/.bcw_test_$$.json"
    printf '%s' "$raw" > "$tmp" 2>/dev/null || return 0
    lua - "$METRICS_FILE" "$HISTORY_FILE" "$key" "$HISTORY_LIMIT" "$tmp" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local metrics_file, history_file, key, limit, raw_file = arg[1], arg[2], arg[3], tonumber(arg[4]) or 200, arg[5]
local raw = ""
local rf = io.open(raw_file, "r")
if rf then raw = rf:read("*a") or ""; rf:close() end
local resp = json.parse(raw)
if not resp or type(resp) ~= "table" then return end

local f = io.open(metrics_file, "r")
local store = {}
if f then store = json.parse(f:read("*a")) or {}; f:close() end
if type(store) ~= "table" then store = {} end

local total_size = 0
if type(resp.endpoints) == "table" then
    for _, ep in ipairs(resp.endpoints) do total_size = total_size + (tonumber(ep.size_bytes) or 0) end
end
store[key] = {
    time = os.time(),
    status = resp.overall_status or "unknown",
    code = tostring(resp.http_code or ""),
    size = total_size,
    speed = tonumber(resp.avg_speed_kbs or 0) or 0
}
local out = io.open(metrics_file, "w")
if out then out:write(json.stringify(store)); out:close() end

local size_kb = math.floor((store[key].size or 0) / 1024)
local st = store[key].status
local text = (st == "optimal" and "проверка пройдена" or (st == "degraded" and "частично доступно" or "недоступно"))
    .. (size_kb > 0 and (" · " .. size_kb .. " КБ") or "")

local line = json.stringify({ t = os.time(), type = "test", target = key, status = st, text = text })
local h = io.open(history_file, "a")
if h then h:write(line, "\n"); h:close() end

-- подрезаем историю, чтобы файл не рос бесконечно
local hf = io.open(history_file, "r")
if hf then
    local lines = {}
    for l in hf:lines() do if l ~= "" then table.insert(lines, l) end end
    hf:close()
    if #lines > limit then
        local trimmed = io.open(history_file, "w")
        if trimmed then
            for i = #lines - limit + 1, #lines do trimmed:write(lines[i], "\n") end
            trimmed:close()
        end
    end
end
EOF
    rm -f "$tmp" 2>/dev/null || true
}

# Универсальная запись события в историю: history_add <type> <target> <text>
history_add() {
    local etype="${1:-event}" etarget="${2:-}" etext="${3:-}"
    lua - "$HISTORY_FILE" "$etype" "$etarget" "$etext" "$HISTORY_LIMIT" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local file, etype, etarget, etext, limit = arg[1], arg[2], arg[3], arg[4], tonumber(arg[5]) or 200
local line = json.stringify({ t = os.time(), type = etype, target = etarget, text = etext })
local h = io.open(file, "a")
if h then h:write(line, "\n"); h:close() end
local hf = io.open(file, "r")
if hf then
    local lines = {}
    for l in hf:lines() do if l ~= "" then table.insert(lines, l) end end
    hf:close()
    if #lines > limit then
        local trimmed = io.open(file, "w")
        if trimmed then
            for i = #lines - limit + 1, #lines do trimmed:write(lines[i], "\n") end
            trimmed:close()
        end
    end
end
EOF
}

cmd_test() {
    ensure_dpi_service
    local out
    out=$(cmd_test_impl "$@")
    # Метрики печатаем ПЕРВЫМИ: все вызывающие берут `cmd_test | tail -1`
    # и ждут JSON проверки. Раньше последней строкой шла запись истории,
    # из-за чего selftest и стабильность всегда видели 000/неудачу.
    record_test_metrics "$out" "${1:-preset_youtube}"
    printf '%s\n' "$out"
}

# Серия независимых проверок одного и того же канала. Один удачный curl ещё
# не значит «стабильно»: DPI может пропускать через раз. Именно по этой
# серии служба решает, нужна ли Circular-связка.
# Возвращает {"ok":N,"total":M}.
cmd_stability() {
    local target="${1:-preset_youtube}"
    local rounds="${2:-3}"
    local i=1 ok=0 total=0
    while [ "$i" -le "$rounds" ]; do
        local one=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
        total=$((total + 1))
        if printf '%s' "$one" | grep -q '"all_ok":true'; then
            ok=$((ok + 1))
        fi
        i=$((i + 1))
    done
    printf '{"ok":%d,"total":%d,"target":"%s"}\n' "$ok" "$total" "$target"
}

# Отдаёт метрики последних проверок и журнал событий одним JSON.
cmd_metrics() {
    lua - "$METRICS_FILE" "$HISTORY_FILE" << 'EOF' 2>/dev/null
local json = require("luci.jsonc")
local mf, hf = arg[1], arg[2]
local tests = {}
local f = io.open(mf, "r")
if f then tests = json.parse(f:read("*a")) or {}; f:close() end
if type(tests) ~= "table" then tests = {} end

local history = {}
local h = io.open(hf, "r")
if h then
    for l in h:lines() do
        if l ~= "" then
            local o = json.parse(l)
            if o then table.insert(history, o) end
        end
    end
    h:close()
end

local out = {}
local start = math.max(1, #history - 59)
for i = #history, start, -1 do table.insert(out, history[i]) end
print(json.stringify({ tests = tests, history = out }))
EOF
}

cmd_speedtest() {
    local target_or_url="preset_youtube"
    local custom_url=""

    if [ "$1" = "--target" ]; then
        target_or_url="${2:-preset_youtube}"
        custom_url="$3"
    else
        target_or_url="${1:-preset_youtube}"
        custom_url="$2"
    fi

    lua - "$target_or_url" "$custom_url" "$PRESETS_FILE" << 'EOF'
local json = require("luci.jsonc")
local arg1 = arg[1] or "preset_youtube"
local arg2 = arg[2] or ""
local presets_file = arg[3]

local p = arg1:gsub("^preset_", "")
local preset_key = "preset_" .. p
if arg1 == "builtin" or arg1 == "general" then preset_key = "builtin" end

local pf = io.open(presets_file, "r")
local presets_data = {}
if pf then
    presets_data = json.parse(pf:read("*a")) or {}
    pf:close()
end

local preset_obj = presets_data.presets and (presets_data.presets[preset_key] or presets_data.presets[arg1])

local test_endpoint = "https://dl.google.com/chrome/install/ChromeStandaloneSetup64.exe"
local test_range = "0-2097151" -- 2 MB chunk from Google Edge CDN
local test_name = "Google Video & Media CDN (2 МБ чанк)"
local test_extra = ""
local fallback_endpoint = ""
local fallback_range = ""
local fallback_extra = ""

if preset_key == "preset_youtube" then
    test_endpoint = "https://test.googlevideo.com/v2/cimg/android/blobs/sha256:6fd8bdac3da660bde7bd0b6f2b6a46e1b686afb74b9a4614def32532b73f5eaa"
    test_range = "0-2097151"
    test_extra = "--connect-to ::google.com -H 'Host: mirror.gcr.io'"
    test_name = "YouTube Video Stream (SNI: test.googlevideo.com 2 МБ)"
    fallback_endpoint = "https://dl.google.com/chrome/install/ChromeStandaloneSetup64.exe"
    fallback_range = "0-2097151"
    fallback_extra = ""
elseif preset_key == "preset_discord" then
    test_endpoint = "https://stable.dl2.discordapp.net/distro/app/stable/win/x86/1.0.9059/DiscordSetup.exe"
    test_range = "0-2097151"
    test_name = "Discord Media & Updates CDN (2 МБ чанк)"
    fallback_endpoint = "https://cdn.discordapp.com/embed/avatars/0.png"
elseif preset_key == "preset_twitch" then
    test_endpoint = "https://www.twitch.tv"
    test_range = ""
    test_name = "Twitch Portal & Streams (220 КБ поток)"
elseif preset_key == "preset_x" then
    test_endpoint = "https://pbs.twimg.com/profile_images/1683325380441128960/yRsRRjGO_400x400.jpg"
    test_range = ""
    test_name = "X / Twitter CDN (Медиапоток)"
    fallback_endpoint = "https://x.com"
elseif preset_key == "preset_instagram" then
    test_endpoint = "https://www.instagram.com/static/images/ico/favicon.ico/36b35e95d3cb.ico"
    test_range = ""
    test_name = "Instagram Web & CDN (Медиапоток)"
    fallback_endpoint = "https://gateway.instagram.com"
else
    local custom = (arg2 and arg2 ~= "") and arg2 or (preset_obj and (preset_obj.test_url or preset_obj.domain)) or arg1
    if not custom:match("^https?://") then custom = "https://" .. custom end
    test_endpoint = custom
    test_range = "0-1048575"
    test_name = "Пользовательский узел (" .. custom:gsub("^https?://", ""):gsub("/.*$", "") .. ")"
end

local function do_curl(ep, rg, extra_args)
    local range_opt = (rg and rg ~= "") and ("--range " .. rg) or ""
    local extra = (extra_args and extra_args ~= "") and (" " .. extra_args) or ""
    local cmd = string.format("curl -4 -k -s -L %s%s -w '%%{http_code}|%%{size_download}|%%{speed_download}|%%{time_total}|%%{time_connect}|%%{time_starttransfer}' -o /dev/null --connect-timeout 4 -m 8 '%s' 2>/dev/null", range_opt, extra, ep)
    local pipe = io.popen(cmd)
    local out = pipe and pipe:read("*a") or ""
    if pipe then pipe:close() end
    local c, sz, sp, tt, tc, ts = out:match("([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)")
    return {
        code = c or "000",
        size = tonumber(sz) or 0,
        speed = tonumber(sp) or 0,
        total_time = tonumber(tt) or 0.0,
        time_connect = tonumber(tc) or 0.0,
        time_start = tonumber(ts) or 0.0
    }
end

local res = do_curl(test_endpoint, test_range, test_extra)
local code_num = tonumber(res.code) or 0
local is_success = ((code_num >= 200 and code_num < 400) or code_num == 403 or code_num == 404) and (res.size > 0 or res.total_time < 5.0)

if not is_success and fallback_endpoint ~= "" then
    local res_fb = do_curl(fallback_endpoint, fallback_range, fallback_extra)
    local fb_code = tonumber(res_fb.code) or 0
    if ((fb_code >= 200 and fb_code < 400) or fb_code == 403 or fb_code == 404) then
        res = res_fb
        test_endpoint = fallback_endpoint
        test_name = test_name .. " (резерв: dl.google.com)"
        code_num = fb_code
        is_success = true
    end
end

if not is_success and preset_key == "preset_youtube" then
    local res_yt = do_curl("https://www.youtube.com", "0-1048575", "")
    local yt_code = tonumber(res_yt.code) or 0
    if yt_code >= 200 and yt_code < 400 then
        res = res_yt
        test_endpoint = "https://www.youtube.com"
        test_name = test_name .. " (резерв: youtube.com)"
        code_num = yt_code
        is_success = true
    end
end

local code = res.code
local size = res.size
local speed = res.speed
local total_time = res.total_time
local time_connect = res.time_connect
local time_start = res.time_start

local code_num = tonumber(code) or 0
local is_success = ((code_num >= 200 and code_num < 400) or code_num == 403 or code_num == 404) and (size > 0 or total_time < 5.0)

local speed_kbs = math.floor(speed / 1024)
local transfer_time = math.max(0.005, total_time - time_start)
if is_success then
    if size > 0 then
        if speed_kbs == 0 or size < 65536 then
            local calc_kbs = math.floor((size / transfer_time) / 1024)
            if size < 65536 and transfer_time < 0.3 then
                speed_kbs = math.max(speed_kbs, calc_kbs, 1200)
            elseif calc_kbs > speed_kbs then
                speed_kbs = calc_kbs
            end
        end
    elseif (code_num == 200 or code_num == 204 or code_num == 206) and total_time < 2.0 then
        speed_kbs = 1500
        size = 32768
    end
end

local speed_mbs = math.floor((speed_kbs / 1024) * 100) / 100
local speed_mbps = math.floor(((speed_kbs * 8) / 1000) * 10) / 10
local latency_ms = math.floor(time_connect * 1000)
local ttfb_ms = math.floor(time_start * 1000)

local rating = "unknown"
local rating_badge = "neutral"
local rating_title = "Не определено"
local throttled = false
local verdict = ""

if not is_success or speed_kbs == 0 then
    rating = "blocked"
    rating_badge = "cbi-color-red"
    rating_title = "Заблокировано ТСПУ"
    throttled = true
    verdict = "ТСПУ блокирует передачу данных или соединение сброшено. Требуется запустить подбор стратегии в Zapret2."
elseif speed_kbs < 250 then
    rating = "throttled"
    rating_badge = "cbi-color-red"
    rating_title = "144p - 240p (Троттлинг)"
    throttled = true
    verdict = "Обнаружен жесткий DPI-троттлинг ТСПУ! Скорость искусственно занижена до " .. speed_kbs .. " КБ/с. Видео будет застревать на буферизации."
elseif speed_kbs < 1000 then
    rating = "480p"
    rating_badge = "cbi-color-yellow"
    rating_title = "360p - 480p SD"
    throttled = false
    verdict = "Базовая скорость передачи. Достаточно для невысокого качества (SD), возможны паузы при переключении на HD."
elseif speed_kbs < 3000 then
    rating = "720p"
    rating_badge = "cbi-color-yellow"
    rating_title = "720p HD"
    throttled = false
    verdict = "Стабильная скорость для 720p HD видео. Плавный просмотр без зависаний."
elseif speed_kbs < 10000 then
    rating = "1080p"
    rating_badge = "cbi-color-green"
    rating_title = "1080p Full HD"
    throttled = false
    verdict = "Отличная скорость! Видео 1080p Full HD (60fps) загружается моментально без задержек и буферизации."
elseif speed_kbs < 25000 then
    rating = "2k"
    rating_badge = "cbi-color-green"
    rating_title = "1440p / 2K QHD"
    throttled = false
    verdict = "Высокая пропускная способность! Потоки 2K QHD и 60fps воспроизводятся плавно."
else
    rating = "4k"
    rating_badge = "cbi-color-green"
    rating_title = "4K Ultra HD"
    throttled = false
    verdict = "Максимальная скорость CDN (" .. speed_mbps .. " Мбит/с)! Потоки 4K UHD и многопоточный просмотр без малейших задержек."
end

local ggc_info = nil
if preset_key == "preset_youtube" or arg1 == "preset_youtube" or arg1:find("youtube") then
    local p_ggc = io.popen("curl -4 -s -k --connect-timeout 3 -m 4 'https://redirector.googlevideo.com/report_mapping?di=no' 2>/dev/null", "r")
    if p_ggc then
        local ggc_out = p_ggc:read("*a") or ""
        p_ggc:close()
        ggc_out = ggc_out:gsub("^%s+", ""):gsub("%s+$", "")
        local ip, cluster, subnet = ggc_out:match("([%d%.]+)%s*=>%s*([%w%-_]+)%s*%(([^%)]+)%)")
        if not cluster then
            ip, cluster = ggc_out:match("([%d%.]+)%s*=>%s*([%w%-_]+)")
        end
        if cluster then
            local operator = "Google CDN"
            local city = "Региональный узел"
            local is_local = true

            local op_part, loc_part = cluster:match("^([%a]+)%-(%a+)%d*")
            if not op_part then
                loc_part = cluster:match("^(%a%a%a)%d+")
            end

            local op_names = {
                rostelecom = "Ростелеком",
                vimpelcom = "билайн (Вымпелком)",
                megafon = "МегаФон",
                comstar = "МТС",
                ertelecom = "Дом.ру (Эр-Телеком)",
                transtelecom = "ТТК (Транстелеком)",
                netbynet = "NetByNet"
            }
            if op_part and op_names[op_part] then
                operator = op_names[op_part]
            end

            local cities_map = {
                krr = "Краснодар",
                svo = "Москва (Шереметьево)",
                dme = "Москва (Домодедово)",
                vko = "Москва (Внуково)",
                led = "Санкт-Петербург (Пулково)",
                goj = "Нижний Новгород (Стригино)",
                skx = "Саранск",
                ovb = "Новосибирск (Толмачёво)",
                aer = "Сочи (Адлер)",
                kzn = "Казань",
                sam = "Самара (Курумоч)",
                rov = "Ростов-на-Дону (Платов)",
                svx = "Екатеринбург (Кольцово)",
                ufa = "Уфа",
                kja = "Красноярск (Емельяново)",
                vvo = "Владивосток (Кневичи)",
                khv = "Хабаровск (Новый)",
                oms = "Омск (Центральный)",
                cek = "Челябинск (Баландино)",
                pee = "Пермь (Большое Савино)",
                vgv = "Вологда",
                iar = "Ярославль (Туношна)",
                vst = "Стокгольм (Швеция)",
                arn = "Стокгольм (Швеция)",
                fra = "Франкфурт (Германия)",
                ams = "Амстердам (Нидерланды)",
                hel = "Хельсинки (Финляндия)",
                waw = "Варшава (Польша)"
            }

            if loc_part and cities_map[loc_part:lower()] then
                city = cities_map[loc_part:lower()]
            end

            if cluster:find("^fra") or cluster:find("^ams") or cluster:find("^arn") or cluster:find("^hel") or cluster:find("^waw") or cluster:find("^vst") then
                is_local = false
            end

            ggc_info = {
                raw = ggc_out,
                cluster = cluster,
                operator = operator,
                city = city,
                subnet = subnet or "",
                is_local = is_local
            }
        end
    end
end

local result = {
    success = is_success,
    target = arg1,
    test_endpoint = test_endpoint,
    test_name = test_name,
    http_code = code,
    size_bytes = size,
    size_mb = string.format("%.2f", size / (1024 * 1024)),
    speed_kbs = speed_kbs,
    speed_mbs = speed_mbs,
    speed_mbps = speed_mbps,
    total_time_sec = string.format("%.2f", total_time),
    latency_ms = latency_ms,
    ttfb_ms = ttfb_ms,
    rating = rating,
    rating_badge = rating_badge,
    rating_title = rating_title,
    throttled = throttled,
    verdict = verdict,
    ggc_mapping = ggc_info
}

print(json.stringify(result))
EOF
}

# Включает/выключает обход для сервиса, не удаляя стратегию.
# toggle_service <target> -> {"success":true,"enabled":0|1}
cmd_toggle_service() {
    local target="${1:-}"
    local base_sec=""
    case "$target" in
        preset_youtube|youtube) base_sec="BlockcheckW_YouTube" ;;
        preset_discord|discord) base_sec="BlockcheckW_Discord" ;;
        preset_twitch|twitch) base_sec="BlockcheckW_Twitch" ;;
        preset_x|x) base_sec="BlockcheckW_X" ;;
        preset_instagram|instagram) base_sec="BlockcheckW_Instagram" ;;
        builtin|general|user) base_sec="BlockcheckW_General" ;;
        *) printf '{"success":false,"error":"Unknown target: %s"}\n' "$target"; return 1 ;;
    esac

    local pkg="zapret2"
    [ -f /etc/config/zapret2 ] || pkg="zapret2wizard"

    local sections=$(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.${base_sec}(_[0-9]+)?=" | cut -d'.' -f2 | cut -d'=' -f1)
    if [ "$base_sec" = "BlockcheckW_Discord" ]; then
        local voice=$(uci show "$pkg" 2>/dev/null | grep -E "^$pkg\.BlockcheckW_Discord_Voice(_[0-9]+)?=" | cut -d'.' -f2 | cut -d'=' -f1)
        sections="$sections $voice"
    fi

    if [ -z "$sections" ]; then
        printf '{"success":false,"error":"No strategy for %s"}\n' "$target"
        return 1
    fi

    local any_on=0 s
    for s in $sections; do
        [ "$(uci -q get "$pkg.$s.enabled")" = "1" ] && any_on=1
    done

    local new_state=1
    [ "$any_on" = "1" ] && new_state=0

    for s in $sections; do
        uci -q set "$pkg.$s.enabled=$new_state"
        if [ -f /etc/config/zapret2wizard ] && [ "$pkg" = "zapret2" ]; then
            uci -q set "zapret2wizard.$s.enabled=$new_state"
        fi
    done

    uci commit "$pkg" 2>/dev/null || true
    [ -f /etc/config/zapret2wizard ] && uci commit zapret2wizard 2>/dev/null || true

    restart_dpi_service
    history_add "toggle" "$(metric_target_key "$target")" "$([ "$new_state" = "1" ] && echo 'Обход включён' || echo 'Обход выключен')"

    printf '{"success":true,"target":"%s","enabled":%s,"section":"%s"}\n' "$target" "$new_state" "$base_sec"
}

# Проверка конфликтов: чужие DPI-службы, посторонние движки, автозапуск.
cmd_conflicts() {
    local services="" svc run svc_running=0
    for svc in zapret2 zapret zapret-manager blockcheck; do
        [ -x "/etc/init.d/$svc" ] || continue
        run=0
        /etc/init.d/"$svc" running >/dev/null 2>&1 && run=1
        [ "$run" = "1" ] && svc_running=1
        services="$services{\"name\":\"$svc\",\"running\":$run},"
    done
    services="[${services%,}]"

    local ours=0 foreign=0 scanner=0 c p cmd name
    for c in /proc/[0-9]*/comm; do
        [ -r "$c" ] || continue
        name=$(cat "$c" 2>/dev/null)
        case "$name" in
            nfqws|nfqws2) ;;
            *) continue ;;
        esac
        p=${c#/proc/}
        p=${p%/comm}
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)
        case "$cmd" in
            *zapret2wizard*) ours=$((ours + 1)) ;;
            *--uid=65534*) scanner=$((scanner + 1)) ;;
            *) foreign=$((foreign + 1)) ;;
        esac
    done

    local table=0 autostart=0
    nft list tables 2>/dev/null | grep -q 'inet zapret2wizard' && table=1
    ls /etc/rc.d/ 2>/dev/null | grep -q 'zapret2wizard' && autostart=1

    local ok=true
    # Чужие движки — информация, а не ошибка: мы их не трогаем.
    [ "$svc_running" -eq 0 ] || ok=false
    [ "$table" -eq 1 ] || ok=false
    [ "$autostart" -eq 1 ] || ok=false

    printf '{"success":true,"services":%s,"engines":{"ours":%s,"foreign":%s,"scanner":%s},"nft_table":%s,"autostart":%s,"conflict_running":%s,"ok":%s}\n' \
        "$services" "$ours" "$foreign" "$scanner" "$table" "$autostart" "$svc_running" "$ok"
}

# Доустановка модулей ядра, без которых nfqws2 не стартует.
# Нужна установщику и кнопке в UI; doctor зовёт modprobe напрямую.
# Только modprobe: безопасно вызывать из postinst, где менеджер пакетов
# держит свой lock (вложенный opkg/apk завис бы или не взял блокировку).
cmd_kmods_modprobe() {
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
    local nfq=0 nftq=0
    [ -e /proc/net/netfilter/nfnetlink_queue ] && nfq=1
    _kmods_nftq_ok && nftq=1
    if [ "$nfq" = "1" ] && [ "$nftq" = "1" ]; then
        echo '{"ok":true}'
    else
        local pkg="opkg install"; command -v apk >/dev/null 2>&1 && pkg="apk add"
        echo "{\"ok\":false,\"nfnetlink_queue\":$nfq,\"nft_queue\":$nftq,\"error\":\"нет модулей: $pkg kmod-nfnetlink-queue kmod-nft-queue && modprobe nfnetlink_queue nft_queue\"}"
    fi
}

# Проверка «правило queue реально работает» (модуль nft_queue жив).
_kmods_nftq_ok() {
    local ok=0
    if nft add table inet bcw_probe_p 2>/dev/null; then
        nft add chain inet bcw_probe_p c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_p c queue num 65000 2>/dev/null && ok=1
        nft delete table inet bcw_probe_p 2>/dev/null || true
    fi
    [ "$ok" = "1" ]
}

# Резервный путь, когда в фиде провайдера нет kmod: берём пакет из
# официального фида OpenWrt под точную версию релиза/target/ядра.
# [rel] [target] [kernel] [dry] — аргументы нужны для тестов резолвера.
_kmods_fetch_official() {
    local rel="${1:-}" tgt="${2:-}" kv="${3:-}" dry="${4:-}"
    if [ -z "$rel" ] && [ -f /etc/openwrt_release ]; then
        rel=$(sed -n "s/^DISTRIB_RELEASE='\(.*\)'/\1/p" /etc/openwrt_release | head -1)
        tgt=$(sed -n "s/^DISTRIB_TARGET='\(.*\)'/\1/p" /etc/openwrt_release | head -1)
    fi
    [ -n "$kv" ] || kv=$(uname -r)
    [ -n "$rel" ] && [ -n "$tgt" ] || return 1
    local base="https://downloads.openwrt.org/releases/$rel/targets/$tgt/kmods"
    local idx dir list pkg file
    idx=$(curl -fsSL -m 20 "$base/" 2>/dev/null) || return 1
    dir=$(printf '%s' "$idx" | grep -oE "href=\"${kv}[^\"/]*/\"" | head -1 | sed 's/^href="//; s/"$//')
    [ -n "$dir" ] || return 1
    echo "[kmods] официальный фид: $base/$dir" >> /tmp/bcw_kmods.log
    [ "$dry" = "dry" ] && echo "$base/$dir"
    list=$(curl -fsSL -m 20 "$base/$dir" 2>/dev/null) || return 1
    for pkg in kmod-nft-queue kmod-nfnetlink-queue; do
        file=$(printf '%s' "$list" | grep -oE "${pkg}[-_][^\"]*\.(apk|ipk)" | head -1)
        [ -n "$file" ] || continue
        [ "$dry" = "dry" ] && echo "$file"
        echo "[kmods] качаю $file" >> /tmp/bcw_kmods.log
        curl -fsSL -m 60 "$base/$dir/$file" -o "/tmp/$file" 2>>/tmp/bcw_kmods.log || continue
        if [ "$dry" != "dry" ]; then
            if command -v apk >/dev/null 2>&1; then
                apk add --allow-untrusted --force-overwrite "/tmp/$file" >>/tmp/bcw_kmods.log 2>&1 || apk fix --allow-untrusted "/tmp/$file" >>/tmp/bcw_kmods.log 2>&1 || tar -xzf "/tmp/$file" -C / >>/tmp/bcw_kmods.log 2>&1 || true
            elif command -v opkg >/dev/null 2>&1; then
                opkg install --force-reinstall --force-depends --force-overwrite "/tmp/$file" >>/tmp/bcw_kmods.log 2>&1 || true
            fi
        fi
        rm -f "/tmp/$file"
    done
    [ "$dry" = "dry" ] && return 0
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
}

cmd_kmods_install() {
    modprobe nfnetlink_queue 2>/dev/null || true
    modprobe nft_queue 2>/dev/null || true
    local need_nfq=0 need_nftq=0
    [ -e /proc/net/netfilter/nfnetlink_queue ] || need_nfq=1
    if nft add table inet bcw_probe_i 2>/dev/null; then
        nft add chain inet bcw_probe_i c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_i c queue num 65000 2>/dev/null || need_nftq=1
        nft delete table inet bcw_probe_i 2>/dev/null || true
    else
        need_nftq=1
    fi
    if [ "$need_nfq" = "1" ] || [ "$need_nftq" = "1" ]; then
        # Менеджер пакетов может залипнуть на сети: ограничиваем 90 секундами.
        (
            if command -v apk >/dev/null 2>&1; then
                apk add --no-cache kmod-nfnetlink-queue kmod-nft-queue || { apk update && apk add --no-cache kmod-nfnetlink-queue kmod-nft-queue; }
            elif command -v opkg >/dev/null 2>&1; then
                opkg install --force-reinstall kmod-nfnetlink-queue kmod-nft-queue || {
                    opkg update && opkg install kmod-nfnetlink-queue kmod-nft-queue
                }
            fi
        ) >>/tmp/bcw_kmods.log 2>&1 &
        local ipid=$!
        ( sleep 90; kill -9 "$ipid" 2>/dev/null ) &
        local wpid=$!
        wait "$ipid" 2>/dev/null
        kill "$wpid" 2>/dev/null
        modprobe nfnetlink_queue 2>/dev/null || true
        modprobe nft_queue 2>/dev/null || true
    fi
    # Если в фиде провайдера пакета нет — пробуем официальный фид OpenWrt.
    if [ ! -e /proc/net/netfilter/nfnetlink_queue ] || ! _kmods_nftq_ok; then
        _kmods_fetch_official
    fi
    cmd_kmods_modprobe
}

cmd_kmods_install_bg() {
    rm -f /tmp/bcw_kmods.done
    ( /usr/bin/blockcheckw-helper kmods_install >/tmp/bcw_kmods.log 2>&1; echo done >/tmp/bcw_kmods.done ) &
    echo $! > /tmp/bcw_kmods.pid
    echo '{"ok":true,"started":true,"log":"/tmp/bcw_kmods.log"}'
}

cmd_kmods_status() {
    local running=0 nfq=0 nftq=0 pid=$(cat /tmp/bcw_kmods.pid 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && running=1
    [ -e /proc/net/netfilter/nfnetlink_queue ] && nfq=1
    if nft add table inet bcw_probe_s 2>/dev/null; then
        nft add chain inet bcw_probe_s c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_s c queue num 65000 2>/dev/null && nftq=1
        nft delete table inet bcw_probe_s 2>/dev/null || true
    fi
    local logt=$(tail -n 2 /tmp/bcw_kmods.log 2>/dev/null | tr '\n' ' ' | tr -d '"')
    printf '{"running":%d,"nfnetlink_queue":%d,"nft_queue":%d,"log":"%s"}\n' "$running" "$nfq" "$nftq" "$logt"
}

# Проверка QUIC-пути (UDP/443) без QUIC-клиента: Version Negotiation.
# DNS-оптимизация: уникальные rr*.googlevideo.com идут через DoH-прокси
# (dns-failsafe сначала ждёт медленный upstream ~1 c, из-за чего Shorts
# стартуют с задержкой). Трогаем только если DoH реально слушает 5053.
# Направить домен в локальный DoH-прокси (https-dns-proxy на 127.0.0.1#5053).
# Провайдер отдаёт NXDOMAIN на заблокированные домены, и без этой записи
# клиенты не могут даже открыть сайт, хотя DPI-обход уже настроен.
# Второй DoH-резолвер (cloudflare) на 5055: штатный https-dns-proxy может
# сам фильтровать домены (xbox-dns.ru отдавал NXDOMAIN на instagram.com).
dns_doh_cloudflare_port() {
    netstat -ln 2>/dev/null | grep -q '127.0.0.1:5055' && { echo 5055; return 0; }
    command -v https-dns-proxy >/dev/null 2>&1 || return 1
    uci -q get https-dns-proxy.config >/dev/null 2>&1 || return 1
    if ! uci -q get 'https-dns-proxy.@https-dns-proxy[1]' >/dev/null 2>&1; then
        uci add https-dns-proxy https-dns-proxy >/dev/null 2>&1 || return 1
        uci set 'https-dns-proxy.@https-dns-proxy[1].resolver_url=https://cloudflare-dns.com/dns-query' 2>/dev/null || return 1
        uci set 'https-dns-proxy.@https-dns-proxy[1].listen_port=5055' 2>/dev/null || return 1
        uci commit https-dns-proxy 2>/dev/null || return 1
        /etc/init.d/https-dns-proxy restart >/dev/null 2>&1 || true
        sleep 2
    fi
    netstat -ln 2>/dev/null | grep -q '127.0.0.1:5055' && echo 5055
}

dns_doh_ensure() {
    local dom="$1" port=5053 out
    [ -n "$dom" ] || return 0
    case "$dom" in *[!a-zA-Z0-9.-]*) return 0 ;; esac
    uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || return 0
    netstat -ln 2>/dev/null | grep -q '127.0.0.1:5053' || return 0
    if uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/"; then return 0; fi
    uci add_list dhcp.@dnsmasq[0].server="/$dom/127.0.0.1#5053" 2>/dev/null || return 0
    uci commit dhcp 2>/dev/null || return 0
    /etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
    # Если штатный DoH сам фильтрует домен — переключаем на cloudflare.
    out=$(nslookup -type=a "$dom" 127.0.0.1 2>&1)
    case "$out" in
        *"can't find"*|*NXDOMAIN*|*SERVFAIL*)
            local alt
            alt=$(dns_doh_cloudflare_port)
            if [ -n "$alt" ]; then
                uci del_list dhcp.@dnsmasq[0].server="/$dom/127.0.0.1#5053" 2>/dev/null || true
                uci add_list dhcp.@dnsmasq[0].server="/$dom/127.0.0.1#$alt" 2>/dev/null || true
                uci commit dhcp 2>/dev/null || true
                /etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
                port="$alt"
            fi
            ;;
    esac
    echo "[blockcheckw-helper] DNS: $dom через DoH (127.0.0.1#$port)" >> "$LOG_FILE" 2>/dev/null || true
}

dns_doh_base() {
    echo "$1" | awk -F. '{ if (NF > 2) print $(NF-1) "." $NF; else print $0 }'
}

# Часть IP Instagram заблокирована на уровне сети: DNS (через DoH) отдаёт
# такой адрес, и сайт висит, хотя DPI-обход работает. Проверяем адреса и
# закрепляем рабочий для www.instagram.com через host-record dnsmasq.
dns_pin_host() {
    local host="$1" ip="$2" cur e new=""
    # OpenWrt dnsmasq не поддерживает host-record через uci, а address= —
    # поддерживает: /www.instagram.com/1.2.3.4 отвечает A и для поддоменов.
    cur=$(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null)
    for e in $cur; do
        case "$e" in "/$host/"*) ;; *) new="$new $e" ;; esac
    done
    uci -q delete dhcp.@dnsmasq[0].address 2>/dev/null
    for e in $new; do
        uci add_list dhcp.@dnsmasq[0].address="$e" 2>/dev/null || true
    done
    uci add_list dhcp.@dnsmasq[0].address="/$host/$ip" 2>/dev/null || return 1
    uci commit dhcp 2>/dev/null || return 1
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
    echo "[blockcheckw-helper] DNS: $host закреплён за рабочим IP $ip" >> "$LOG_FILE" 2>/dev/null || true
}

dns_ip_works() {
    local host="$1" ip="$2" code
    code=$(curl -4 -sk -o /dev/null -m 6 -w '%{http_code}' --resolve "$host:443:$ip" "https://$host/" 2>/dev/null)
    case "$code" in 2*|3*) return 0 ;; *) return 1 ;; esac
}

dns_fix_instagram() {
    uci -q get zapret2wizard.BlockcheckW_Instagram.enabled 2>/dev/null | grep -q '^1$' || return 0
    local host code ip ips h
    for host in www.instagram.com instagram.com; do
        code=$(curl -4 -sk -o /dev/null -m 6 -w '%{http_code}' "https://$host/" 2>/dev/null)
        case "$code" in 2*|3*) continue ;; esac
        ips=""
        for h in instagram.com i.instagram.com; do
            ips="$ips $(curl -sk -m 6 -H 'accept: application/dns-json' "https://cloudflare-dns.com/dns-query?name=$h&type=A" 2>/dev/null | sed -n 's/.*"data":"\([0-9.]*\)".*/\1/p')"
        done
        ips="$ips 31.13.71.174 157.240.241.174 157.240.205.63 31.13.72.53"
        for ip in $ips; do
            case "$ip" in *[!0-9.]*|"") continue ;; esac
            if dns_ip_works "$host" "$ip"; then
                dns_pin_host "$host" "$ip"
                break
            fi
        done
        [ -n "$ip" ] || echo "[blockcheckw-helper] DNS: рабочий IP для $host не найден" >> "$LOG_FILE" 2>/dev/null || true
    done
    return 0
}

# Fallback без DoH: нестандартные порты публичных резолверов (идея tachyon-desync
# clean DNS). Провайдер часто перехватывает UDP/53, но 1253/5353 проходят.
dns_alt_ensure() {
    local dom="$1" srv out
    [ -n "$dom" ] || return 1
    case "$dom" in *[!a-zA-Z0-9.-]*) return 1 ;; esac
    out=$(nslookup "$dom" 127.0.0.1 2>&1)
    case "$out" in *"can't find"*|*NXDOMAIN*|*SERVFAIL*|"") ;; *) return 0 ;; esac
    for srv in "77.88.8.8#1253" "208.67.222.222#5353"; do
        uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/$srv" && return 0
        uci add_list dhcp.@dnsmasq[0].server="/$dom/$srv" 2>/dev/null || continue
        uci commit dhcp 2>/dev/null || true
        /etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
        if nslookup "$dom" 127.0.0.1 2>&1 | grep -q "Name:"; then
            echo "[blockcheckw-helper] DNS: $dom через $srv (без DoH)" >> "$LOG_FILE" 2>/dev/null || true
            return 0
        fi
        uci del_list dhcp.@dnsmasq[0].server="/$dom/$srv" 2>/dev/null || true
        uci commit dhcp 2>/dev/null || true
    done
    return 1
}
# Проверка достижимости IP и подмена googlevideo на рабочий Google-edge.
# GGC-адреса вида 87.245.x у части провайдеров не отвечают, из-за чего
# YouTube-плеер зависает на старте (SYN без ответа).
_gv_ip_reachable() {
    local ip="$1" code
    [ -n "$ip" ] || return 1
    code=$(curl -4 -s -o /dev/null -m 4 --resolve "redirector.googlevideo.com:443:$ip" -w '%{http_code}' https://redirector.googlevideo.com/ 2>/dev/null)
    [ -n "$code" ] && [ "$code" != "000" ]
}

cmd_gv_fix() {
    local cur ip dns_ip e canary cip
    cur=$(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null | tr ' ' '\n' | sed -n 's#^/googlevideo\.com/##p' | head -1)
    # Канарейка: типичный CDN-хост, который выдаёт этот провайдер.
    canary="rr1---sn-gxuo03g-ig3s.googlevideo.com"
    # Канарейку спрашиваем у upstream, а не у dnsmasq: иначе видим свой же
    # address=override, считаем DNS здоровым и снимаем его (петля).
    local upstream
    upstream=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
    cip=$(nslookup "$canary" "${upstream:-8.8.8.8}" 2>/dev/null | awk '/^Address: /{print $2; exit}')
    if [ -z "$cip" ]; then
        cip=$(nslookup "$canary" 8.8.8.8 2>/dev/null | awk '/^Address: /{print $2; exit}')
    fi
    if [ -n "$cip" ] && _gv_ip_reachable "$cip"; then
        if [ -n "$cur" ]; then
            for e in $(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null); do
                case "$e" in /googlevideo.com/*) uci -q del_list dhcp.@dnsmasq[0].address="$e" 2>/dev/null ;; esac
            done
            uci commit dhcp 2>/dev/null || true
            /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
        fi
        echo "{\"ok\":true,\"ip\":\"$cip\",\"source\":\"dns\"}"
        return 0
    fi
    [ -n "$cip" ] || { echo '{"ok":true,"source":"no-canary"}'; return 0; }
    [ -n "$cur" ] && _gv_ip_reachable "$cur" && { echo "{\"ok\":true,\"ip\":\"$cur\",\"source\":\"existing\"}"; return 0; }
    dns_ip=$(nslookup redirector.googlevideo.com 127.0.0.1 2>/dev/null | awk '/^Address: /{print $2; exit}')
    for ip in "$dns_ip" 142.250.178.46 192.178.183.102 142.250.74.138 142.251.156.4; do
        [ -n "$ip" ] || continue
        if _gv_ip_reachable "$ip"; then
            for e in $(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null); do
                case "$e" in /googlevideo.com/*) uci -q del_list dhcp.@dnsmasq[0].address="$e" 2>/dev/null ;; esac
            done
            uci add_list dhcp.@dnsmasq[0].address="/googlevideo.com/$ip" 2>/dev/null
            uci commit dhcp 2>/dev/null || true
            /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
            echo "{\"ok\":true,\"ip\":\"$ip\",\"source\":\"fallback\"}"
            return 0
        fi
    done
    echo '{"ok":false}'
}

cmd_optimize_dns() {
    local changed=0 entry dom cs
    # Один прогон за раз: при старте службы оптимизация запускается в фоне,
    # и несколько параллельных копий дёргали dnsmasq и пиннили Instagram.
    local dns_lock="/tmp/bcw_opt_dns.lock"
    if ! mkdir "$dns_lock" 2>/dev/null; then
        local dns_owner=$(cat "$dns_lock/pid" 2>/dev/null)
        if [ -n "$dns_owner" ] && kill -0 "$dns_owner" 2>/dev/null; then
            echo '{"skipped":"busy"}'
            return 0
        fi
        rm -rf "$dns_lock"
        mkdir "$dns_lock" 2>/dev/null || { echo '{"skipped":"busy"}'; return 0; }
    fi
    echo $$ > "$dns_lock/pid"
    trap 'rm -rf "$dns_lock"' EXIT INT TERM
    uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || { rm -rf "$dns_lock"; return 0; }
    if ! netstat -ln 2>/dev/null | grep -q '127.0.0.1:5053'; then
        # DoH нет: чиним DNS для заблокированных домен через альтернативные порты.
        local alt=0 d
        for d in instagram.com cdninstagram.com discord.com twitch.tv x.com; do
            dns_alt_ensure "$d" && alt=1
        done
        echo "{\"changed\":$alt}"
        return 0
    fi
    for dom in googlevideo.com ytimg.com ggpht.com; do
        entry="/$dom/127.0.0.1#5053"
        if ! uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/"; then
            uci add_list dhcp.@dnsmasq[0].server="$entry"
            changed=1
        fi
    done
    # Домены, которые провайдер режет по DNS (NXDOMAIN): без DoH-записи
    # клиент не откроет их даже с рабочей стратегией.
    for dom in instagram.com cdninstagram.com discord.com twitch.tv x.com; do
        out=$(nslookup "$dom" 127.0.0.1 2>&1)
        case "$out" in
            *"can't find"*|*NXDOMAIN*|*SERVFAIL*|*"no address"*)
                if ! uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | grep -q "/$dom/"; then
                    uci add_list dhcp.@dnsmasq[0].server="/$dom/127.0.0.1#5053"
                    changed=1
                fi
                ;;
        esac
    done
    cs=$(uci -q get dhcp.@dnsmasq[0].cachesize 2>/dev/null)
    case "$cs" in ''|*[!0-9]*) uci set dhcp.@dnsmasq[0].cachesize='2000'; changed=1 ;; *) [ "$cs" -lt 1000 ] && { uci set dhcp.@dnsmasq[0].cachesize='2000'; changed=1; } ;; esac
    if [ "$changed" = "1" ]; then
        uci commit dhcp
        /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
    fi
    dns_fix_instagram >/dev/null 2>&1 || true
    cmd_gv_fix >/dev/null 2>&1 || true
    echo "{\"changed\":$changed}"
}

cmd_quic_probe() {
    local ips
    ips=$(nslookup www.youtube.com 2>/dev/null | awk '/^Address: /{print $2}' | head -3 | tr '\n' ' ')
    [ -n "$ips" ] || ips="142.250.74.138 172.217.117.4"
    lua /usr/share/zapret2wizard/quicprobe.lua "$ips" >/dev/null 2>&1
}

# Политика QUIC:
#   auto   — разрешаем, если QUIC реально проходит, иначе reject с быстрым ICMP;
#   allow  — не трогаем UDP/443;
#   reject — режем UDP/443, приложение быстро падает на TCP;
#   fake   — не режем, а подмешиваем fake QUIC Initial (blob Google) перед
#            настоящим. Это техника Flowseal: DPI видит «чужой» Initial,
#            а реальный QUIC продолжает работать. Если не помогло — reject.
cmd_quic_mode() {
    local mode="${1:-$(uci -q get zapret2wizard.main.quic_mode 2>/dev/null || echo auto)}"
    [ -n "$mode" ] || mode="auto"
    case "$mode" in
        allow|reject|fake|auto) ;;
        *) mode="auto" ;;
    esac
    # Явный аргумент — сразу сохраняем в UCI, чтобы режим пережил reboot.
    if [ -n "${1:-}" ] && command -v uci >/dev/null 2>&1; then
        uci -q set zapret2wizard.main.quic_mode="$mode"
        uci -q commit zapret2wizard
    fi
    local want=1 fake=0 restart=0
    local blob="${BCW_QUIC_BLOB:-/usr/share/zapret2wizard/fake/quic_initial_www_google_com.bin}"
    case "$mode" in
        allow) want=0 ;;
        reject) want=1 ;;
        fake)
            if [ -f "$blob" ] && command -v uci >/dev/null 2>&1; then
                want=0; fake=1
            else
                want=1; mode="reject"
            fi
            ;;
        *) cmd_quic_probe && want=0 || want=1 ;;
    esac

    local cur=$(uci -q get firewall.reject_quic.enabled 2>/dev/null)
    [ -n "$cur" ] || cur=1
    if [ "$want" != "$cur" ] && uci -q get firewall.reject_quic >/dev/null 2>&1; then
        uci set firewall.reject_quic.enabled="$want"
        uci commit firewall
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    # Штатное fw4-правило стоит после established и не режет уже открытые
    # QUIC-потоки. Держим раннюю таблицу bcw_quic (priority -10).
    if [ "$want" = "1" ]; then
        sh /usr/share/zapret2wizard/quic_reject.sh apply >/dev/null 2>&1 || true
    else
        sh /usr/share/zapret2wizard/quic_reject.sh remove >/dev/null 2>&1 || true
    fi

    if command -v uci >/dev/null 2>&1; then
        if [ "$fake" = "1" ]; then
            uci -q set zapret2wizard.blob_quic_google=blob
            uci -q set zapret2wizard.blob_quic_google.path="$blob"
            uci -q set zapret2wizard.blob_quic_google.enabled=1
            uci -q set zapret2wizard.BlockcheckW_QUIC=strategy
            uci -q set zapret2wizard.BlockcheckW_QUIC.enabled=1
            uci -q set zapret2wizard.BlockcheckW_QUIC.port=443
            uci -q set zapret2wizard.BlockcheckW_QUIC.protocol=udp
            uci -q delete zapret2wizard.BlockcheckW_QUIC.filter_l3
            uci -q add_list zapret2wizard.BlockcheckW_QUIC.filter_l3=ipv4
            uci -q delete zapret2wizard.BlockcheckW_QUIC.filter_l7
            uci -q add_list zapret2wizard.BlockcheckW_QUIC.filter_l7=quic
            uci -q set zapret2wizard.BlockcheckW_QUIC.script='--payload=quic_initial --lua-desync=fake:blob=blob_quic_google:repeats=6'
            uci -q commit zapret2wizard
        elif uci -q get zapret2wizard.BlockcheckW_QUIC >/dev/null 2>&1; then
            # удаляем только свой профиль, чужой QUIC-профиль не трогаем
            case "$(uci -q get zapret2wizard.BlockcheckW_QUIC.script 2>/dev/null)" in
                *quic_initial*)
                    uci -q delete zapret2wizard.BlockcheckW_QUIC
                    uci -q commit zapret2wizard
                    ;;
            esac
        fi
        if [ -x /usr/share/zapret2wizard/uci2config ]; then
            /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
        fi
        if [ "$BCW_QUIC_NO_RESTART" != "1" ] && _svc_running; then
            restart_dpi_service
            restart=1
        fi
    fi

    sysctl -w net.ipv4.icmp_ratelimit=0 >/dev/null 2>&1 || true
    echo "{\"reject_quic\":$want,\"mode\":\"$mode\",\"fake_quic\":$fake,\"restart\":$restart}"
}

# Приложение YouTube ходит в youtubei.googleapis.com, который МТС блокирует
# отдельным SNI. Если этот хост не открывается, добавляем отдельную секцию
# YTApi со своим desync и исключаем хост из основной секции.
cmd_fix_ytapi() {
    local hl_dir=/etc/zapret2wizard/ipset
    local hl="$hl_dir/zapret_hosts_ytapi.txt"
    local main_sec="BlockcheckW_YouTube"
    printf 'youtubei.googleapis.com\n' > "$hl" 2>/dev/null || return 1
    uci -q set zapret2wizard.hl_ytapi=hostlist
    uci -q set zapret2wizard.hl_ytapi.path="$hl"
    uci -q delete zapret2wizard.$main_sec.hostlist_exclude
    uci -q add_list zapret2wizard.$main_sec.hostlist_exclude=list_hosts_user_exclude
    uci -q add_list zapret2wizard.$main_sec.hostlist_exclude=hl_ytapi
    local cand y w
    # gosuslugi первым: на живом тесте Shorts с ним открывались за ~2.2 c,
    # а с host=www.google.com — за ~4.3 c (fake-пакет дольше держит API).
    for cand in \
        'hostfakesplit:host=gosuslugi.ru:tcp_ts=-600000' \
        'hostfakesplit:host=www.google.com:tcp_ts=-600000' \
        'multisplit:pos=1,sniext+1:seqovl=1'; do
        uci -q set zapret2wizard.YTApi=strategy
        uci -q set zapret2wizard.YTApi.enabled=1
        uci -q set zapret2wizard.YTApi.port=443
        uci -q set zapret2wizard.YTApi.protocol=tcp
        uci -q delete zapret2wizard.YTApi.filter_l3
        uci -q delete zapret2wizard.YTApi.filter_l7
        uci -q delete zapret2wizard.YTApi.hostlist
        uci -q add_list zapret2wizard.YTApi.filter_l3=ipv4
        uci -q add_list zapret2wizard.YTApi.filter_l7=tls
        uci -q add_list zapret2wizard.YTApi.hostlist=hl_ytapi
        uci -q set zapret2wizard.YTApi.script="--lua-desync=$cand"
        uci -q commit zapret2wizard
        /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
        /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || true
        wait_dpi_ready 15
        # После restart движок поднимается не мгновенно: одна проба 000
        # ничего не доказывает. Проверяем несколько раз, прежде чем
        # объявить кандидата нерабочим (из-за этого API ошибочно отключался).
        y=000; w=""
        for _try in 1 2 3 4 5; do
            y=$(curl -4 -s -o /dev/null -m 7 -w '%{http_code}' https://youtubei.googleapis.com/ 2>/dev/null)
            w=$(curl -4 -s -o /dev/null -m 7 -w '%{http_code}' https://www.youtube.com/ 2>/dev/null)
            [ "$y" != "000" ] && [ -n "$y" ] && break
            sleep 2
        done
        logger -t zapret2wizard "YTApi $cand: api=$y www=$w"
        if [ "$y" != "000" ] && [ -n "$y" ]; then
            echo "{\"success\":true,\"api\":\"$y\",\"www\":\"$w\",\"strategy\":\"$cand\"}"
            return 0
        fi
    done
    # Не смогли подобрать — снимаем исключение, чтобы youtubei снова
    # обрабатывался основной стратегией, а не оставался без обхода.
    uci -q del_list zapret2wizard.$main_sec.hostlist_exclude=hl_ytapi 2>/dev/null || true
    uci -q set zapret2wizard.YTApi.enabled=0
    uci -q commit zapret2wizard
    /usr/share/zapret2wizard/uci2config >/dev/null 2>&1 || true
    /etc/init.d/zapret2wizard restart >/dev/null 2>&1 || true
    echo '{"success":false,"error":"youtubei остался закрыт"}'
    return 1
}

# При старте службы: если YouTube-стратегия включена, а API закрыт и профиля
# YTApi нет — создаём его. Lock защищает от рекурсии (fix_ytapi перезапускает
# службу, а restart снова вызывает ensure_ytapi).
cmd_ensure_ytapi() {
    local code
    [ -f /tmp/bcw_ytapi.lock ] && return 0
    uci -q get zapret2wizard.BlockcheckW_YouTube.enabled 2>/dev/null | grep -q '^1$' || return 0
    code=$(curl -4 -s -o /dev/null -m 6 -w '%{http_code}' https://youtubei.googleapis.com/ 2>/dev/null)
    [ "$code" = "000" ] || return 0
    : > /tmp/bcw_ytapi.lock
    cmd_fix_ytapi >/dev/null 2>&1 || true
    rm -f /tmp/bcw_ytapi.lock
    return 0
}

# nfqws2 ищет Lua рядом с собой: /opt/zapret2/nfq2/nfqws2 → /opt/zapret2/lua.
# Установщик кладёт файлы в /usr/share/zapret2wizard/lua, поэтому здесь
# делаем раскладку /opt/zapret2/lua идемпотентно: симлинк на каталог, а если
# там уже реальный каталог (остался от старой установки) — симлинки на файлы.
LUA_SRC_DIR=/usr/share/zapret2wizard/lua
ensure_lua_layout() {
    local src="$LUA_SRC_DIR" f dst
    [ -d "$src" ] || return 0
    mkdir -p /opt/zapret2/nfq2 2>/dev/null || true
    # Цель зависит от того, где лежит движок: /opt/zapret2/... → /opt/zapret2/lua
    for dst in /opt/zapret2/lua; do
        if [ -L "$dst" ]; then
            [ "$(readlink "$dst")" = "$src" ] || ln -sfn "$src" "$dst" 2>/dev/null || true
        elif [ -d "$dst" ]; then
            for f in "$src"/*.lua; do
                [ -f "$f" ] && ln -sf "$f" "$dst/$(basename "$f")" 2>/dev/null || true
            done
        else
            ln -sfn "$src" "$dst" 2>/dev/null || true
        fi
    done
    chmod 755 /opt /opt/zapret2 /opt/zapret2/nfq2 2>/dev/null || true
    chmod 755 /usr/share/zapret2wizard /usr/share/zapret2wizard/lua 2>/dev/null || true
    chmod 755 /opt/zapret2/lua 2>/dev/null || true
    chmod 644 "$src"/*.lua 2>/dev/null || true
}

cmd_ensure_lua() {
    ensure_lua_layout
    if [ -r /opt/zapret2/lua/zapret-lib.lua ]; then
        echo '{"ok":true,"path":"/opt/zapret2/lua"}'
        return 0
    fi
    echo '{"ok":false,"error":"/opt/zapret2/lua/zapret-lib.lua недоступен"}'
    return 1
}

# Авто-калибровка TTL для фейковых пакетов (идея tachyon-desync AutoTTL):
# фейк должен пройти транзитный узел ТСПУ, но умереть до сервера. Оцениваем
# дистанцию хопов и берём TTL на 1–2 меньше, чтобы сервер не получил фейк.
# Диагностика/тест fallback-резолвера: dns_alt <домен>.
cmd_dns_alt() {
    local d="${1:-instagram.com}"
    if dns_alt_ensure "$d"; then
        printf '{"ok":true,"domain":"%s"}\n' "$d"
    else
        printf '{"ok":false,"domain":"%s"}\n' "$d"
    fi
}

cmd_ttl_probe() {
    local domain="${1:-www.youtube.com}"
    local ip="" hops="" ttl t=2
    ip=$(nslookup -type=a "$domain" 127.0.0.1 2>/dev/null | sed -n "s/Address: //p" | tail -1)
    [ -n "$ip" ] || ip=$(nslookup "$domain" 2>/dev/null | sed -n "s/Address: //p" | tail -1)
    if [ -n "$ip" ] && command -v traceroute >/dev/null 2>&1; then
        hops=$(traceroute -n -m 12 -q 1 -w 2 "$ip" 2>/dev/null | awk 'NF >= 2 && $1 ~ /^[0-9]+$/ { h = $1 } END { print h }')
    fi
    if [ -z "$hops" ] && [ -n "$ip" ] && command -v ping >/dev/null 2>&1; then
        while [ "$t" -le 12 ]; do
            if ping -c1 -W1 -t "$t" "$ip" >/dev/null 2>&1; then hops="$t"; break; fi
            t=$((t + 1))
        done
    fi
    [ -n "$hops" ] || hops=6
    ttl=$((hops - 2))
    [ "$ttl" -lt 2 ] && ttl=2
    [ "$ttl" -gt 9 ] && ttl=9
    printf '{"ok":true,"domain":"%s","ip":"%s","hops":%s,"fake_ttl":%s}\n' "$domain" "${ip:-}" "$hops" "$ttl"
}
cmd_doctor() {
    local ok=1
    local checks=""
    local quiet=0
    [ "$1" = "--json" ] && quiet=1

    add_check() {
        local name="$1" state="$2" detail="$3" hint="$4"
        [ "$state" = "1" ] || ok=0
        if [ "$quiet" = "0" ]; then
            printf '  %-28s %s  %s\n' "$name" "$([ "$state" = "1" ] && echo OK || echo FAIL)" "$detail"
            if [ "$state" != "1" ] && [ -n "$hint" ]; then
                printf '      → %s\n' "$hint"
            fi
        fi
        checks="$checks{\"name\":\"$name\",\"ok\":$([ "$state" = "1" ] && echo true || echo false),\"detail\":\"$detail\",\"hint\":\"$hint\"},"
    }

    local arch=$(uname -m)
    if [ "$quiet" = "0" ]; then
        echo "=== Zapret2Wizard doctor ==="
        echo "  платформа: $arch, версия $(grep -o '"version": *"[^"]*"' /usr/share/blockcheckw/version.json 2>/dev/null | head -1 | cut -d'"' -f4)"
    fi

    if command -v nft >/dev/null 2>&1; then add_check "nftables" 1 "$(command -v nft)" ""; else add_check "nftables" 0 "nft не найден" "Установите nftables (пакет nftables)"; fi

    # Без nfnetlink_queue nfqws2 падает с "nfq_unbind_pf(AF_INET): Invalid argument",
    # а без nft_queue нельзя добавить правило queue. На чистых роутерах этих
    # kmod-пакетов часто нет — проверяем и подсказываем, что доустановить.
    modprobe nfnetlink_queue >/dev/null 2>&1 || true
    modprobe nft_queue >/dev/null 2>&1 || true
    local kmod_add="opkg install"
    command -v apk >/dev/null 2>&1 && kmod_add="apk add"
    if [ -e /proc/net/netfilter/nfnetlink_queue ]; then
        add_check "модуль nfnetlink_queue" 1 "загружен" ""
    else
        add_check "модуль nfnetlink_queue" 0 "не загружен — nfqws2 не запустится" "$kmod_add kmod-nfnetlink-queue; modprobe nfnetlink_queue"
    fi
    local q_ok=0
    if nft add table inet bcw_probe_q 2>/dev/null; then
        nft add chain inet bcw_probe_q c "{ type filter hook output priority 0; }" 2>/dev/null || true
        nft add rule inet bcw_probe_q c queue num 65000 2>/dev/null && q_ok=1
        nft delete table inet bcw_probe_q 2>/dev/null || true
    fi
    if [ "$q_ok" = "1" ]; then
        add_check "модуль nft_queue" 1 "очередь nftables доступна" ""
    else
        add_check "модуль nft_queue" 0 "правило queue недоступно" "$kmod_add kmod-nft-queue; modprobe nft_queue"
    fi

    local eng_ours=0 ec en
    for ec in /proc/[0-9]*/comm; do
        [ -r "$ec" ] || continue
        en=$(cat "$ec" 2>/dev/null)
        case "$en" in nfqws2|nfqws) ;; *) continue ;; esac
        local ep=${ec#/proc/}; ep=${ep%/comm}
        case "$(tr '\0' ' ' < "/proc/$ep/cmdline" 2>/dev/null)" in
            *zapret2wizard*) eng_ours=$((eng_ours + 1)) ;;
        esac
    done
    if [ "$eng_ours" -ge 1 ]; then
        add_check "наши движки" 1 "$eng_ours запущено" ""
    elif [ -d /var/run/bcw_scan.lock ]; then
        add_check "наши движки" 1 "подбор идёт на своей очереди" ""
    else
        add_check "наши движки" 0 "ни один экземпляр nfqws2 не запущен" "Перезапустите службу и проверьте лог: logread | grep -i nfqws | tail -20"
    fi

    local fo=$(uci -q get firewall.@defaults[0].flow_offloading)
    local fohw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
    if [ "$fo" = "1" ] || [ "$fohw" = "1" ]; then
        add_check "flow offloading" 0 "включён — обход не будет работать" "Перезапустите службу: /etc/init.d/zapret2wizard restart"
    else
        add_check "flow offloading" 1 "отключён" ""
    fi

    local engine=""
    for p in /usr/bin/nfqws2 /opt/zapret2/nfq2/nfqws2 /usr/bin/nfqws; do
        [ -x "$p" ] && { engine="$p"; break; }
    done
    if [ -n "$engine" ]; then add_check "движок nfqws2" 1 "$engine" ""; else add_check "движок nfqws2" 0 "бинарник не найден" "Переустановите службу: install.sh скачает nfqws2 под вашу архитектуру"; fi

    # nfqws2 из /opt/zapret2/nfq2 ищет zapret-lib.lua в /opt/zapret2/lua.
    # Без этого сканер падает на предполётной проверке (exit code 6).
    ensure_lua_layout
    if [ -r /opt/zapret2/lua/zapret-lib.lua ]; then
        add_check "lua-библиотеки" 1 "/opt/zapret2/lua" ""
    else
        add_check "lua-библиотеки" 0 "нет /opt/zapret2/lua/zapret-lib.lua" "Перезапустите службу или выполните install.sh: nfqws2 не найдёт Lua"
    fi

    # Память стратегий (L1 домен / L2 /24 / бан-маска): просто показываем размер.
    local mem_stats=$(mem stats 2>/dev/null)
    local mem_domains=$(printf '%s' "$mem_stats" | sed -n 's/.*"domains":\([0-9]*\).*/\1/p')
    [ -n "$mem_domains" ] || mem_domains=0
    local mem_banned=$(printf '%s' "$mem_stats" | sed -n 's/.*"banned":\([0-9]*\).*/\1/p')
    [ -n "$mem_banned" ] || mem_banned=0
    add_check "память стратегий" 1 "$mem_domains доменов, $mem_banned банов" ""

    if [ -x /usr/bin/blockcheckw ]; then add_check "сканер blockcheckw" 1 "$(/usr/bin/blockcheckw --version 2>/dev/null | head -1)" ""; else add_check "сканер blockcheckw" 0 "бинарник не найден" "Переустановите службу через install.sh"; fi

    if [ -f /etc/config/zapret2wizard ]; then add_check "конфигурация" 1 "/etc/config/zapret2wizard" ""; else add_check "конфигурация" 0 "нет /etc/config/zapret2wizard" "Запустите /etc/init.d/zapret2wizard restart — файл создаётся при старте"; fi

    local strategies=$(uci show zapret2wizard 2>/dev/null | grep -c '=strategy')
    add_check "стратегии в конфиге" 1 "$strategies шт." ""

    if _svc_running; then
        add_check "служба" 1 "работает" ""
    elif [ -d /var/run/bcw_scan.lock ]; then
        add_check "служба" 1 "идёт подбор — служба приостановлена" ""
    else
        add_check "служба" 0 "остановлена" "Запустите: /etc/init.d/zapret2wizard start"
    fi

    if nft list tables 2>/dev/null | grep -q 'inet zapret2wizard'; then add_check "nft-таблица" 1 "inet zapret2wizard" ""; else add_check "nft-таблица" 0 "отсутствует" "Служба не установила правила — проверьте лог: logread -e zapret2wizard"; fi

    if ls /etc/rc.d/ 2>/dev/null | grep -q zapret2wizard; then add_check "автозапуск" 1 "включён" ""; else add_check "автозапуск" 0 "выключен" "Включите: /etc/init.d/zapret2wizard enable"; fi

    local foreign=$(blockcheckw-helper conflicts 2>/dev/null | grep -o '"foreign":[0-9]*' | cut -d: -f2)
    add_check "чужие движки" 1 "${foreign:-0} шт. — не трогаем" ""

    checks="[${checks%,}]"
    printf '{"ok":%s,"arch":"%s","checks":%s}\n' "$([ "$ok" = "1" ] && echo true || echo false)" "$arch" "$checks"
    [ "$ok" = "1" ]
}

# Определяет каталог бинарников zapret2 под архитектуру роутера.
_engine_arch_dir() {
    case "$(uname -m)" in
        aarch64|arm64) echo "linux-arm64" ;;
        armv7*|armv6*|arm) echo "linux-arm" ;;
        x86_64|amd64) echo "linux-x86_64" ;;
        i386|i686) echo "linux-x86" ;;
        mips64*) echo "linux-mips64" ;;
        mips) echo "linux-mips" ;;
        mipsel) echo "linux-mipsel" ;;
        riscv64) echo "linux-riscv64" ;;
        ppc|powerpc) echo "linux-ppc" ;;
        *) echo "" ;;
    esac
}

# Скачивает и устанавливает движок nfqws2 с зеркал GitHub.
cmd_install_engine() {
    if [ -x /usr/bin/nfqws2 ]; then
        printf '{"success":true,"already":true,"path":"/usr/bin/nfqws2"}\n'
        return 0
    fi

    local dir
    dir=$(_engine_arch_dir)
    if [ -z "$dir" ]; then
        printf '{"success":false,"error":"Unsupported architecture: %s"}\n' "$(uname -m)"
        return 1
    fi

    local tag="v1.0.7"
    local tarball="zapret2-${tag}.tar.gz"
    local url="https://github.com/bol-van/zapret2/releases/download/${tag}/${tarball}"
    local work="/tmp/bcw_engine_$$"
    mkdir -p "$work" 2>/dev/null

    local attempt mirror got=""
    local raw_engine="https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/openwrt/engine/nfqws2-${dir}"

    # 1. Свой репозиторий: тот же канал raw, которым работает обновление.
    for attempt in 1 2 3; do
        rm -f "$work/nfqws2"
        curl -fsSL -k --connect-timeout 6 -m 120 "$raw_engine?_t=$(date +%s)" -o "$work/nfqws2" 2>/dev/null
        if [ "$(wc -c < "$work/nfqws2" 2>/dev/null || echo 0)" -gt 50000 ]; then
            got="repo-raw"
            break
        fi
        sleep 2
    done

    # 2. Если raw недоступен — архив релиза zapret2 с зеркал.
    if [ -z "$got" ]; then
        for attempt in 1 2 3; do
            for mirror in "$url" "https://ghproxy.net/$url" "https://gh-proxy.com/$url"; do
                rm -f "$work/pkg.tgz" "$work/nfqws2"
                if ! curl -fsSL -k --connect-timeout 8 -m 180 "$mirror" -o "$work/pkg.tgz" 2>/dev/null; then
                    continue
                fi
                [ -s "$work/pkg.tgz" ] || continue

                tar -xz -O --wildcards "*/binaries/${dir}/nfqws2" < "$work/pkg.tgz" > "$work/nfqws2" 2>/dev/null
                if [ "$(wc -c < "$work/nfqws2" 2>/dev/null || echo 0)" -lt 50000 ]; then
                    rm -rf "$work/x"
                    mkdir -p "$work/x"
                    tar -xzf "$work/pkg.tgz" -C "$work/x" 2>/dev/null
                    local found
                    found=$(find "$work/x" -path "*/binaries/${dir}/nfqws2" -type f 2>/dev/null | head -1)
                    [ -n "$found" ] && cp -f "$found" "$work/nfqws2" 2>/dev/null
                fi

                if [ "$(wc -c < "$work/nfqws2" 2>/dev/null || echo 0)" -gt 50000 ]; then
                    got="$mirror"
                    break
                fi
            done
            [ -n "$got" ] && break
            sleep 2
        done
    fi

    if [ -z "$got" ]; then
        rm -rf "$work"
        printf '{"success":false,"error":"Не удалось скачать nfqws2 ни с одного зеркала","arch":"%s"}\n' "$dir"
        return 1
    fi

    cp -f "$work/nfqws2" /usr/bin/nfqws2
    chmod +x /usr/bin/nfqws2
    mkdir -p /opt/zapret2/nfq2 2>/dev/null
    [ -e /opt/zapret2/nfq2/nfqws2 ] || ln -sf /usr/bin/nfqws2 /opt/zapret2/nfq2/nfqws2 2>/dev/null
    local size=$(wc -c < /usr/bin/nfqws2 2>/dev/null || echo 0)
    rm -rf "$work"

    history_add "engine" "" "Установлен движок nfqws2 ($dir)"
    printf '{"success":true,"installed":true,"arch":"%s","size":%s,"mirror":"%s"}\n' "$dir" "$size" "$got"
}

# Компактный отчёт: состояние службы + живая проверка сервиса.
cmd_selftest() {
    local target="${1:-preset_youtube}"
    local ver=$(grep -o '"version": *"[^"]*"' /usr/share/blockcheckw/version.json 2>/dev/null | head -1 | cut -d'"' -f4)
    local engines=0 c name
    for c in /proc/[0-9]*/comm; do
        [ -r "$c" ] || continue
        name=$(cat "$c" 2>/dev/null)
        case "$name" in nfqws2|nfqws) engines=$((engines + 1)) ;; esac
    done
    # «работает» — только если движки реально есть: pgrep -f ловил обёртки
    # сканера, в чьей командной строке встречалось nfqws2, и врал при 0 движков
    local svc_state="остановлена"
    [ "$engines" -gt 0 ] && svc_state="работает"

    echo "=== Zapret2Wizard selftest ==="
    echo "версия:            ${ver:-?}"
    echo "платформа:         $(uname -m)"
    echo "служба:            $svc_state"
    echo "движки nfqws2:     $engines"
    echo "nft-таблица:       $(nft list tables 2>/dev/null | grep -c 'inet zapret2wizard')"
    echo "стратегий:         $(uci show zapret2wizard 2>/dev/null | grep -c '=strategy')"
    echo "lua-модулей:       $(ls /usr/share/zapret2wizard/lua/*.lua 2>/dev/null | wc -l)"
    echo "fake-блобов:       $(ls /usr/share/zapret2wizard/fake/*.bin 2>/dev/null | wc -l)"
    echo "доменов в списках: $(cat /etc/zapret2wizard/ipset/zapret_hosts_*.txt 2>/dev/null | grep -vc '^#')"
    echo
    echo "flow offloading:   $(uci -q get firewall.@defaults[0].flow_offloading)/$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
    echo
    echo "--- живая проверка ($target) ---"
    local out
    out=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
    local status=$(printf '%s' "$out" | grep -o '"overall_status":"[a-z]*"' | head -1 | cut -d'"' -f4)
    # Служба могла ещё подниматься после restart/установки — один повтор через 3 с.
    if [ "$status" != "optimal" ] && [ "$engines" -gt 0 ]; then
        sleep 3
        out=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
        status=$(printf '%s' "$out" | grep -o '"overall_status":"[a-z]*"' | head -1 | cut -d'"' -f4)
    fi
    local code=$(printf '%s' "$out" | grep -o '"http_code":"[0-9]*"' | head -1 | cut -d'"' -f4)
    local size=$(printf '%s' "$out" | grep -o '"size_bytes":[0-9]*' | head -1 | cut -d: -f2)
    echo "статус:            ${status:-нет ответа}"
    echo "http-код:          ${code:-?}"
    echo "получено байт:     ${size:-0}"
    echo
    echo "--- контроль: обычный сайт и DNS ---"
    local ctrl_code ctrl_time
    ctrl_code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' https://ya.ru 2>/dev/null || echo 000)
    echo "ya.ru (контроль):  ${ctrl_code}"
    local yt_ip
    yt_ip=$(nslookup www.youtube.com 2>/dev/null | awk '/^Address: /{print $2; exit}')
    echo "DNS youtube.com:   ${yt_ip:-не резолвится}"
    case "$yt_ip" in
        0.0.0.0|127.*|8.6.*|8.47.*) echo "                   ВНИМАНИЕ: похоже на подмену DNS провайдером" ;;
    esac

    echo "--- ошибки движка ---"
    logread 2>/dev/null | grep -iE 'nfqws|zapret2wizard' | tail -5 || echo "(нет записей)"
    logread 2>/dev/null | grep -iE 'lua|blob|no such file' | tail -4 || true

    echo "--- последние строки лога ---"
    tail -n 6 /tmp/blockcheckw_run.log 2>/dev/null || echo "(лог пуст)"
}

# Матрица «класс ТСПУ»: 9 базовых приёмов desync (как в tspu-class-test).
# Показывает, какие механики провайдер пропускает, и подсказывает класс блокировки.
cmd_class() {
    local target="${1:-preset_youtube}"
    local sec="" domain=""
    case "$target" in
        preset_discord|discord) sec="BlockcheckW_Discord"; domain="discord.com" ;;
        builtin|user) sec="BlockcheckW_General"; domain="rutracker.org" ;;
        *) sec="BlockcheckW_YouTube"; domain="www.youtube.com" ;;
    esac

    local backup=$(uci -q get "zapret2wizard.$sec.script")
    local n=0 passed=0 name args res passed_list=""
    echo "=== Класс ТСПУ: $domain ==="
    while IFS='|' read -r name args; do
        [ -n "$name" ] || continue
        n=$((n + 1))
        printf '%s\n' "$args" > /tmp/bcw_class.txt
        res=$(cmd_apply --target "$target" --file /tmp/bcw_class.txt 2>/dev/null)
        if printf '%s' "$res" | grep -q '"all_ok":true'; then
            passed=$((passed + 1))
            passed_list="$passed_list $n"
            echo "  OK   $n. $name"
        else
            echo "  --   $n. $name"
        fi
    done <<'CLASSLIST'
1. multidisorder midsld|--payload=tls_client_hello --lua-desync=multidisorder:pos=midsld
2. multisplit midsld|--payload=tls_client_hello --lua-desync=multisplit:pos=midsld
3. multidisorder sld|--payload=tls_client_hello --lua-desync=multidisorder:pos=sld
4. fake (autottl)|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:ip_autottl=-2,3-20:repeats=6
5. fake + multisplit|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=6 --lua-desync=multisplit:pos=midsld
6. fake + multidisorder|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=6 --lua-desync=multidisorder:pos=midsld
7. fakeddisorder|--payload=tls_client_hello --lua-desync=fakeddisorder:pos=midsld:tcp_md5
8. rst (autottl)|--payload=tls_client_hello --lua-desync=rst:ip_autottl=-2,3-20
9. fake (tcp_md5)|--payload=tls_client_hello --lua-desync=fake:blob=fake_default_tls:tcp_md5:repeats=6
CLASSLIST

    if [ -n "$backup" ]; then
        printf '%s\n' "$backup" > /tmp/bcw_class.txt
        cmd_apply --target "$target" --file /tmp/bcw_class.txt >/dev/null 2>&1
    fi
    rm -f /tmp/bcw_class.txt
    echo "--- прошло: $passed из $n ---"
    if [ "$passed" -eq 0 ]; then
        echo "Ни один приём не прошёл: вероятен блок по IP или по отпечатку клиента."
        echo "Проверьте: DNS не подменён (selftest), VPN выключен, домен резолвится."
    elif printf '%s' "$passed_list" | grep -qE ' (5|6|7) '; then
        echo "Класс: нужны фейки вместе с нарезкой. Рабочие варианты: fakeddisorder, fake+multisplit, fake+multidisorder."
    elif printf '%s' "$passed_list" | grep -qE ' (1|2|3) '; then
        echo "Класс: ТСПУ не собирает сегменты. Достаточно нарезки: multidisorder или multisplit по midsld."
    elif printf '%s' "$passed_list" | grep -qE ' (4|8|9) '; then
        echo "Класс: ТСПУ реагирует на поддельные пакеты. Стратегия: fake с ip_autottl или rst."
    fi
}

# Сетевая классификация в духе dpi-checkers: что именно мешает —
# CIDR-whitelist, обрезка на 16 КБ, подмена DNS или интернета нет вовсе.
# Дешёвые проверки, без внешних API: только curl/nslookup.
_net_code() {
    command -v curl >/dev/null 2>&1 || { echo 000; return; }
    # curl печатает код и при ошибке (000), поэтому "|| echo 000" нельзя:
    # получалось "000\n000", и вызов считался успешным.
    curl -4 -s -o /dev/null -m 6 -w '%{http_code}' "$1" 2>/dev/null
}

_net_dns() {
    nslookup "$1" "$2" 2>/dev/null | awk '
        /^Name:/ { s=1; next }
        s && /^Address[ \t]*[0-9]*:/ { print $3 }
        s && /^Address:/ { print $2 }
    ' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | sort -u
}

cmd_netcheck() {
    local wl=0 rg=0 code blocking=none dns=unknown advice="ok"
    local l="" p="" common="" bytes=0
    if ! command -v curl >/dev/null 2>&1; then
        echo '{"ok":false,"error":"curl not installed"}'
        return 1
    fi
    for u in https://max.ru/ https://ya.ru/ https://vk.ru/; do
        code=$(_net_code "$u")
        [ "$code" != "000" ] && wl=1
    done
    for u in https://github.com/ https://www.google.com/ https://ru.wikipedia.org/; do
        code=$(_net_code "$u")
        [ "$code" != "000" ] && rg=1
    done
    if [ "$rg" = "1" ]; then
        blocking=none
    elif [ "$wl" = "1" ]; then
        blocking=cidr_whitelist
    else
        blocking=no_internet
    fi

    # Обрезка ответа на ~16 КБ: качаем диапазон и смотрим, сколько отдали.
    bytes=$(curl -4 -s -o /dev/null -m 15 -r 0-65535 -w '%{size_download}' https://www.youtube.com/ 2>/dev/null)
    case "$bytes" in ''|*[!0-9]*) bytes=0 ;; *) bytes=$((bytes + 0)) ;; esac
    if [ "$blocking" = "none" ] && [ "$bytes" -gt 0 ] && [ "$bytes" -lt 60000 ]; then
        blocking=throttle_16k
    fi

    # Подмена DNS: локальный резолвер против 1.1.1.1 (best effort).
    l=$(_net_dns www.youtube.com 127.0.0.1)
    p=$(_net_dns www.youtube.com 1.1.1.1)
    if [ -n "$l" ] && [ -n "$p" ]; then
        common=$(printf '%s\n%s\n' "$l" "$p" | sort | uniq -d)
        if [ -z "$common" ]; then
            dns=spoof
            [ "$blocking" = "none" ] && blocking=dns_spoof
        else
            dns=ok
        fi
    fi

    case "$blocking" in
        none) advice="ok" ;;
        cidr_whitelist) advice="whitelist: обход только по домену/SNI, проверьте стратегию" ;;
        no_internet) advice="нет интернета: WAN/DNS/шлюз" ;;
        throttle_16k) advice="обрезка на 16 КБ: сканер должен проверять полной загрузкой" ;;
        dns_spoof) advice="DNS подменён: включите DoH/DoT и проверьте optimize_dns" ;;
    esac

    printf '{"ok":%s,"blocking":"%s","cidr_whitelist":%s,"regular":%s,"dns":"%s","bytes_16k":%s,"advice":"%s"}\n' \
        "$([ "$blocking" = none ] && echo true || echo false)" \
        "$blocking" "$wl" "$rg" "$dns" "$bytes" "$advice"
}

# Ключ сервиса по имени секции (для интерфейса и отчётов).
_info_sec_key() {
    case "$1" in
        BlockcheckW_YouTube) echo youtube ;;
        BlockcheckW_Discord) echo discord ;;
        BlockcheckW_Discord_Voice) echo discord_voice ;;
        BlockcheckW_Twitch) echo twitch ;;
        BlockcheckW_X) echo x ;;
        BlockcheckW_Instagram) echo instagram ;;
        BlockcheckW_General) echo builtin ;;
        BlockcheckW_User*) echo user ;;
        *) echo custom ;;
    esac
}

# Резервный сборщик info: работает без Lua-модуля uci (на минимальных сборках
# OpenWrt он отсутствует, и тогда интерфейс показывал нули).
_info_json_shell() {
    local running=$(get_dpi_service_status | head -n 1)
    local ver=$(grep -o '"version": *"[^"]*"' "$VERSION_FILE" 2>/dev/null | head -n 1 | cut -d'"' -f4)
    local svc="" strat="" first_s=1 first_a=1
    for sec in $(uci -q show zapret2wizard 2>/dev/null | sed -n 's/^zapret2wizard\.\([^=]*\)=strategy$/\1/p'); do
        local en_raw=$(uci -q get "zapret2wizard.$sec.enabled")
        local en=false; [ "$en_raw" = "1" ] && en=true
        local script=$(uci -q get "zapret2wizard.$sec.script")
        local port=$(uci -q get "zapret2wizard.$sec.port")
        local proto=$(uci -q get "zapret2wizard.$sec.protocol")
        local l7=$(uci -q get "zapret2wizard.$sec.filter_l7")
        local hl=$(uci -q get "zapret2wizard.$sec.hostlist")
        local key=$(_info_sec_key "$sec")
        local cnt=0
        case "$hl" in
            list_hosts_*)
                local f="/etc/zapret2wizard/ipset/zapret_hosts_${hl#list_hosts_}.txt"
                if [ -f "$f" ]; then cnt=$(grep -vc '^#' "$f" 2>/dev/null); fi
                cnt=${cnt:-0}
                ;;
        esac
        local esc=$(printf '%s' "$script" | sed 's/\\/\\\\/g; s/"/\\"/g')
        local obj="\"$key\":{\"section\":\"$sec\",\"enabled\":$en,\"script\":\"$esc\",\"port\":\"$port\",\"protocol\":\"$proto\",\"filter_l7\":\"$l7\",\"hostlist\":\"$hl\",\"domain_count\":$cnt}"
        local aobj="{\"section\":\"$sec\",\"service_key\":\"$key\",\"enabled\":$en,\"script\":\"$esc\",\"port\":\"$port\",\"protocol\":\"$proto\",\"hostlist\":\"$hl\",\"domain_count\":$cnt}"
        if [ "$first_s" = "1" ]; then svc="$obj"; first_s=0; else svc="$svc,$obj"; fi
        if [ "$first_a" = "1" ]; then strat="$aobj"; first_a=0; else strat="$strat,$aobj"; fi
    done
    local hl_json="" first_h=1
    for f in /etc/zapret2wizard/ipset/zapret_hosts_*.txt; do
        [ -f "$f" ] || continue
        local k=$(basename "$f" .txt); k=${k#zapret_hosts_}
        local c=$(grep -vc '^#' "$f" 2>/dev/null)
        c=${c:-0}
        local used=$(uci -q show zapret2wizard 2>/dev/null | grep -c "hostlist.*list_hosts_$k")
        local cfg=false; [ "$used" -gt 0 ] && cfg=true
        local hobj="{\"key\":\"$k\",\"name\":\"$k\",\"domains_count\":$c,\"uci_configured\":$cfg}"
        if [ "$first_h" = "1" ]; then hl_json="$hobj"; first_h=0; else hl_json="$hl_json,$hobj"; fi
    done
    local nft_ok=false
    nft list table inet zapret2wizard >/dev/null 2>&1 && nft_ok=true
    printf '{"zapret2_running":"%s","nft_table":%s,"version":"%s","services":{%s},"all_strategies":[%s],"hostlists":[%s]}\n' \
        "$running" "$nft_ok" "$ver" "$svc" "$strat" "$hl_json"
}

# ASN провайдера (для каталога геномов).
cmd_asn() {
    if [ -f /etc/zapret2wizard/provider ]; then
        local p=$(cat /etc/zapret2wizard/provider 2>/dev/null)
        local a=$(printf '%s' "$p" | grep -o 'AS[0-9]*' | head -n 1)
        [ -n "$a" ] && { echo "$a"; return 0; }
    fi
    local a=$(lua /usr/share/zapret2wizard/evolve.lua asn /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$a" ] || a="AS0"
    echo "$a"
}

# Сохранить провайдера (с ASN), если он есть в отчёте сканера.
cmd_provider_save() {
    local isp=""
    if [ -f /tmp/blockcheckw_status.json ]; then
        isp=$(grep -o '"isp": *"[^"]*"' /tmp/blockcheckw_status.json 2>/dev/null | head -n 1 | cut -d'"' -f4)
    fi
    if [ -n "$isp" ]; then
        mkdir -p /etc/zapret2wizard 2>/dev/null || true
        printf '%s\n' "$isp" > /etc/zapret2wizard/provider
        echo "{\"saved\":true,\"isp\":\"$isp\"}"
    else
        echo '{"saved":false}'
    fi
}

# Забрать геномы из общего каталога по ASN и слить с локальной памятью.
cmd_catalog_fetch() {
    local asn="${1:-}"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"

    [ -n "$asn" ] || asn=$(cmd_asn)
    if [ -z "$asn" ] || [ "$asn" = "AS0" ]; then
        echo '{"ok":false,"error":"не удалось определить ASN провайдера"}'
        return 1
    fi

    local url="https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/genomes/${asn}.json"
    local tmp="/tmp/bcw_catalog.json"
    curl -fsSL -k -m 30 "$url" -o "$tmp" 2>/dev/null || wget -q -O "$tmp" "$url" 2>/dev/null || true

    if [ ! -s "$tmp" ]; then
        echo "{\"ok\":false,\"error\":\"в каталоге пока нет геномов для ${asn}\",\"asn\":\"${asn}\"}"
        rm -f "$tmp"
        return 1
    fi

    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"
    local res
    res=$(lua "$evo" import "$genomes" "$provider" "$tmp" 2>/dev/null)
    rm -f "$tmp"
    echo "$res"
}

# Экспорт для отправки в каталог: JSON + подсказка куда положить.
cmd_catalog_export() {
    local asn=$(cmd_asn)
    [ -n "$asn" ] || asn="AS0"
    local out="/tmp/bcw_catalog_export.json"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"

    lua "$evo" export "$genomes" "$provider" 1 "$asn" > "$out" 2>/dev/null
    local count=$(grep -o '"count":[0-9]*' "$out" | head -n 1 | cut -d: -f2)
    echo "{\"ok\":true,\"asn\":\"$asn\",\"count\":${count:-0},\"file\":\"$out\",\"target\":\"genomes/${asn}.json\"}"
}

# Дневной триггер: если сервис деградировал два замера подряд — эволюция.
cmd_health_tick() {
    local counter="/etc/zapret2wizard/.health_fail"
    local last="/etc/zapret2wizard/.health_last"
    local now=$(date +%s)

    # не чаще одного авто-прогона в 6 часов
    if [ -f "$last" ]; then
        local prev=$(cat "$last" 2>/dev/null)
        if [ -n "$prev" ] && [ $((now - prev)) -lt 21600 ]; then
            echo '{"skipped":true,"reason":"throttled"}'
            return 0
        fi
    fi

    if scan_busy || [ -f /tmp/bcw_scan_paused ]; then
        echo '{"skipped":true,"reason":"busy"}'
        return 0
    fi

    # Закреплённый IP Instagram мог умереть: перепроверяем при каждом тике,
    # не дожидаясь ночной эволюции (сама проверка стоит один curl с -m 6).
    dns_fix_instagram >/dev/null 2>&1 || true
    cmd_gv_fix >/dev/null 2>&1 || true

    # Проверяем все включённые сервисы, а не только YouTube: два сбоя
    # подряд по сервису → L1-запись помечается непроверенной, /24 снимается,
    # запускается переобучение именно этого сервиса.
    local any_fail=0 spawned=0 tgt sec cfile n dom mres
    for tgt in preset_youtube preset_discord preset_twitch preset_x preset_instagram; do
        sec=$(_strategy_section "$tgt")
        [ -n "$sec" ] || continue
        uci -q get "zapret2wizard.$sec.enabled" 2>/dev/null | grep -q '^1$' || continue
        if cmd_test "$tgt" "" > /tmp/bcw_health.json 2>/dev/null && grep -q '"all_ok":true' /tmp/bcw_health.json; then
            echo 0 > "/etc/zapret2wizard/.health_fail_${tgt#preset_}"
            continue
        fi
        any_fail=1
        cfile="/etc/zapret2wizard/.health_fail_${tgt#preset_}"
        n=$(cat "$cfile" 2>/dev/null || echo 0)
        n=$((n + 1))
        echo "$n" > "$cfile"
        if [ "$n" -ge 2 ]; then
            echo 0 > "$cfile"
            dom=$(target_domain "$tgt")
            mres=$(mem fail "$dom")
            echo "[health] $tgt/$dom: $mres" >> /tmp/bcw_evolve.log 2>/dev/null || true
            if [ "$spawned" = "0" ] && ! scan_busy; then
                ( /usr/bin/blockcheckw-helper evolve --target "$tgt" --count 8 --verify 2 --tests 2 --sleep 2 >>/tmp/bcw_evolve.log 2>&1 & ) || true
                spawned=1
            fi
        fi
    done
    rm -f /tmp/bcw_health.json
    if [ "$any_fail" = "0" ]; then
        echo 0 > "$counter"
        echo '{"healthy":true}'
        return 0
    fi
    echo 0 > "$counter"
    echo "$now" > "$last"
    echo "{\"healthy\":false,\"relearn\":$spawned}"
}

# Экспорт рабочих геномов провайдера в JSON (для обмена).
cmd_evolve_export() {
    local min_ok="${1:-1}"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"
    lua "$evo" export "$genomes" "$provider" "$min_ok" 2>/dev/null
}

# Импорт геномов из файла или URL.
cmd_evolve_import() {
    local src="$1"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local tmp="/tmp/bcw_import.json"

    if [ -z "$src" ]; then
        echo '{"ok":false,"error":"укажите файл или URL"}'
        return 1
    fi

    case "$src" in
        http://*|https://*)
            curl -fsSL -k -m 30 "$src" -o "$tmp" 2>/dev/null || wget -q -O "$tmp" "$src" 2>/dev/null || true
            ;;
        *)
            cp -f "$src" "$tmp" 2>/dev/null || true
            ;;
    esac

    if [ ! -s "$tmp" ]; then
        echo '{"ok":false,"error":"не удалось получить файл геномов"}'
        rm -f "$tmp"
        return 1
    fi

    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"
    lua "$evo" import "$genomes" "$provider" "$tmp" 2>/dev/null
    rm -f "$tmp"
}

# ---- Проверка доступности YouTube (без вмешательства в маршрутизацию) ----

# Комплексная проверка «YouTube глазами роутера»: веб, превью, API, CDN.
# Ничего не меняет и не трогает чужие службы — только измеряет.
_yt_probe() {
    if command -v curl >/dev/null 2>&1; then
        curl -4 -s -o /dev/null -m 8 -w '%{http_code} %{size_download} %{time_total}' "$1" 2>/dev/null
    else
        printf '000 0 0'
    fi
}

# Диагностика: идёт ли домен через туннель (без остановки служб).
cmd_tunnel_check() {
    local d="${1:-youtube.com}" t
    t=$(scan_tunnel_service "$d")
    if [ -n "$t" ]; then
        printf '{"domain":"%s","tunneled":true,"via":"%s"}\n' "$d" "$t"
    else
        printf '{"domain":"%s","tunneled":false}\n' "$d"
    fi
}

cmd_youtube_audit() {
    local score=0 total=0 checks="" name url code bytes sec ok advice="ok" advice_text="всё в порядке"
    local qm qr i=0
    # Сразу после restart/prepare движки поднимаются не мгновенно: без ожидания
    # аудит честно получает 000 и пугает пользователя ложной ошибкой.
    while [ "$i" -lt 10 ] && [ -z "$(our_engines)" ]; do
        sleep 1
        i=$((i + 1))
    done
    for pair in \
        "www|https://www.youtube.com/" \
        "img|https://i.ytimg.com/vi/dQw4w9WgXcQ/default.jpg" \
        "api|https://youtubei.googleapis.com/" \
        "cdn|https://redirector.googlevideo.com/report_mapping?di=no"; do
        name=${pair%%|*}; url=${pair#*|}
        set -- $(_yt_probe "$url")
        code="$1"; bytes="$2"; sec="$3"
        # На медленном канале первый запрос может не уложиться в таймаут —
        # повторяем один раз, прежде чем считать точку недоступной.
        if [ "$code" = "000" ]; then
            sleep 1
            set -- $(_yt_probe "$url")
            code="$1"; bytes="$2"; sec="$3"
        fi
        total=$((total + 1))
        local point_ok=0 point_reason=""
        if [ "$code" != "000" ] && [ -n "$code" ]; then point_ok=1; fi
        # 16 КБ cap: код 200, тело 14..32 КБ и ожидание — ТСПУ держит поток.
        if [ "$point_ok" = "1" ] && [ "$name" = "www" ]; then
            local b=${bytes:-0} s=${sec:-0}
            if [ "$b" -gt 0 ] && [ "$b" -lt 32768 ] && awk "BEGIN{exit !($s >= 5)}" 2>/dev/null; then
                point_ok=0; point_reason="cap16"
            elif [ "$b" -eq 0 ]; then
                point_ok=0; point_reason="zero_body"
            fi
        fi
        [ "$point_ok" = "1" ] && score=$((score + 1))
        checks="${checks:+$checks,}{\"name\":\"$name\",\"code\":\"$code\",\"bytes\":${bytes:-0},\"time\":${sec:-0},\"ok\":$([ "$point_ok" = "1" ] && echo true || echo false),\"reason\":\"$point_reason\"}"
        [ "$name" = "api" ] && [ "$code" = "000" ] && { advice="fix_ytapi"; advice_text="API YouTube не открывается — примените профиль YTApi"; }
        [ "$name" = "cdn" ] && [ "$code" = "000" ] && { advice="rescan_youtube"; advice_text="CDN YouTube не отвечает — запустите подбор заново"; }
        [ "$name" = "www" ] && [ "$point_reason" = "cap16" ] && { advice="rescan_youtube"; advice_text="ТСПУ обрывает поток YouTube на ~16 КБ — стратегия не держит поток, запустите подбор заново"; }
    done
    qm=$(uci -q get zapret2wizard.main.quic_mode); [ -n "$qm" ] || qm=auto
    qr=$(uci -q get firewall.reject_quic.enabled); [ -n "$qr" ] || qr=?
    ok=false
    [ "$score" -ge "$total" ] && ok=true
    printf '{"ok":%s,"score":%s,"total":%s,"advice":"%s","advice_text":"%s","checks":[%s],"quic":{"mode":"%s","reject":%s}}\n' \
        "$ok" "$score" "$total" "$advice" "$advice_text" "$checks" "$qm" "$qr"
}


# Полные аргументы генома (для копирования).
cmd_genome_args() {
    local id="$1"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"
    lua "$evo" args "$genomes" "$provider" "$id" 2>/dev/null
}

# Применить стратегию из генома к выбранному сервису.
cmd_genome_apply() {
    local id="$1"
    local target="${2:-preset_youtube}"
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"

    local json=$(lua "$evo" args "$genomes" "$provider" "$id" 2>/dev/null)
    # аргументы без кавычек — берём до первой закрывающей кавычки
    local args=$(printf '%s' "$json" | sed -n 's/.*"args":"\([^"]*\)".*/\1/p')
    [ -n "$args" ] || { echo '{"ok":false,"error":"геном не найден"}'; return 1; }

    case "$target" in
        preset_youtube|youtube) sec="BlockcheckW_YouTube" ;;
        preset_discord|discord) sec="BlockcheckW_Discord" ;;
        preset_x|x)             sec="BlockcheckW_X" ;;
        preset_instagram|instagram) sec="BlockcheckW_Instagram" ;;
        preset_twitch|twitch)   sec="BlockcheckW_Twitch" ;;
        *)                      sec="BlockcheckW_General" ;;
    esac

    local pkg=$(_strategy_pkg)
    uci -q set "$pkg.$sec.script=$args" || { echo '{"ok":false,"error":"нет секции"}'; return 1; }
    uci -q commit "$pkg" || true

    # перезапуск в фоне: не блокируем интерфейс
    _svc_stop
    _svc_start_bg
    echo "{\"ok\":true,\"queued\":true,\"section\":\"$sec\",\"target\":\"$target\"}"
}

# Прочитать стратегию сервиса.
_strategy_section() {
    case "$1" in
        preset_youtube|youtube) echo "BlockcheckW_YouTube" ;;
        preset_discord|discord) echo "BlockcheckW_Discord" ;;
        preset_twitch|twitch) echo "BlockcheckW_Twitch" ;;
        preset_x|x) echo "BlockcheckW_X" ;;
        preset_instagram|instagram) echo "BlockcheckW_Instagram" ;;
        builtin|general|domains) echo "BlockcheckW_General" ;;
        *) echo "" ;;
    esac
}

cmd_strategy_get() {
    local target="$1"
    local sec=$(_strategy_section "$target")
    [ -n "$sec" ] || { echo '{"ok":false}'; return 1; }
    local pkg=$(_strategy_pkg)
    local sc=$(uci -q get "$pkg.$sec.script" 2>/dev/null)
    sc=$(printf '%s' "$sc" | sed 's/\\/\\\\/g; s/"/\\"/g')
    echo "{\"ok\":true,\"section\":\"$sec\",\"script\":\"$sc\"}"
}

# Записать свою стратегию nfqws2 и применить.
cmd_strategy_set() {
    local target="$1"
    shift
    local text="$*"
    local sec=$(_strategy_section "$target")
    [ -n "$sec" ] || { echo '{"ok":false,"error":"неизвестный сервис"}'; return 1; }
    if ! printf '%s' "$text" | grep -q -- '--lua-desync\|--new'; then
        echo '{"ok":false,"error":"в стратегии нет --lua-desync"}'
        return 1
    fi
    local pkg=$(_strategy_pkg)
    uci -q set "$pkg.$sec.script=$text" || { echo '{"ok":false,"error":"не удалось записать"}'; return 1; }
    uci -q commit "$pkg" || true
    _svc_stop
    _svc_start_bg
    echo "{\"ok\":true,\"queued\":true,\"section\":\"$sec\"}"
}

# Статус эволюции для LuCI: провайдер, история, топ геномов.
cmd_evolve_status() {
    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"
    lua "$evo" status "$genomes" "$provider" 2>/dev/null || echo '{"provider":"default","running":false,"history":[],"top":[]}'
}

# Запуск эволюции в фоне (для кнопки в LuCI).
cmd_evolve_start() {
    local target="${1:-preset_youtube}"
    if [ -f /tmp/bcw_evolve.running ]; then
        local pid=$(cat /tmp/bcw_evolve.running 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo '{"success":false,"error":"Эволюция уже выполняется"}'
            return 1
        fi
        rm -f /tmp/bcw_evolve.running
    fi
    ( /usr/bin/blockcheckw-helper evolve --target "$target" --count 12 --verify 3 --tests 3 --sleep 2 >/tmp/bcw_evolve.log 2>&1 & ) || true
    sleep 1
    echo '{"success":true,"target":"'"$target"'"}'
}

# Ночное самообучение: один прогон в сутки, цель выбирается по дню.
# Подбор/эволюция/health-тест не должны пересекаться: каждый из них
# останавливает службу и запускает свой сканер.
scan_busy() {
    local p
    if [ -d /var/run/bcw_scan.lock ]; then
        p=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null)
        [ -n "$p" ] || { sleep 1; p=$(cat /var/run/bcw_scan.lock/pid 2>/dev/null); }
        if [ -n "$p" ] && _scan_lock_alive "$p"; then return 0; fi
        [ -n "$p" ] && kill -9 "$p" 2>/dev/null
        rm -rf /var/run/bcw_scan.lock 2>/dev/null
    fi
    if [ -f /tmp/bcw_evolve.running ]; then
        p=$(cat /tmp/bcw_evolve.running 2>/dev/null)
        if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then return 0; fi
        rm -f /tmp/bcw_evolve.running 2>/dev/null
    fi
    ps w 2>/dev/null | grep -qE '[b]lockcheckw-helper (start|apply) ' && return 0
    return 1
}
cmd_evolve_nightly() {
    local marker="/etc/zapret2wizard/.evolve_last"
    local today=$(date +%Y-%m-%d)
    if [ -f "$marker" ] && [ "$(cat "$marker" 2>/dev/null)" = "$today" ]; then
        echo '{"skipped":true,"reason":"already ran today"}'
        return 0
    fi

    local evo="/usr/share/zapret2wizard/evolve.lua"
    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"

    # «свободный канал»: по дню выбираем сервис с наименьшим числом проверок
    local doy=$(date +%j | sed 's/^0*//')
    local target="preset_youtube"
    case $((doy % 3)) in
        1) target="preset_discord" ;;
        2) target="preset_youtube" ;;
        *) target="preset_youtube" ;;
    esac

    if scan_busy || [ -f /tmp/bcw_scan_paused ]; then
        echo '{"skipped":true,"reason":"busy"}'
        return 0
    fi

    # Адаптивность: если сервис сейчас здоров — ночью не трогаем (кроме воскресенья).
    cmd_test "$target" "" > /tmp/bcw_night_test.json 2>/dev/null
    local healthy=0
    grep -q '"all_ok":true' /tmp/bcw_night_test.json && healthy=1
    rm -f /tmp/bcw_night_test.json
    local dow=$(date +%u)
    if [ "$healthy" = "1" ] && [ "$dow" != "7" ]; then
        echo '{"skipped":true,"reason":"service healthy"}'
        return 0
    fi

    mkdir -p /etc/zapret2wizard 2>/dev/null || true
    echo "$today" > "$marker"

    echo "{\"started\":true,\"target\":\"$target\",\"provider\":\"$provider\",\"healthy\":$healthy}"
    /usr/bin/blockcheckw-helper evolve --target "$target" --count 8 --verify 2 --tests 2 --sleep 2 >>/tmp/bcw_evolve.log 2>&1
}

# Установка cron-задачи ночного самообучения.
cmd_cron_install() {
    local cron_dir="/etc/crontabs"
    local cron_file="$cron_dir/root"
    local line="10 6 * * * /usr/bin/blockcheckw-helper evolve_nightly >/dev/null 2>&1 # bcw-evolve"
    mkdir -p "$cron_dir" 2>/dev/null || true
    touch "$cron_file" 2>/dev/null || true
    # Чистим старые задачи (bypass_sync из 0.19.x, прежнее время эволюции),
    # иначе они продолжают дёргать helper каждые 2 минуты после обновления.
    sed -i '/bcw-bypass/d;/bcw-health/d;/bcw-evolve/d' "$cron_file" 2>/dev/null || true
    echo "$line" >> "$cron_file"
    echo "*/30 * * * * /usr/bin/blockcheckw-helper health_tick >/dev/null 2>&1 # bcw-health" >> "$cron_file"
    /etc/init.d/cron enable >/dev/null 2>&1 || true
    /etc/init.d/cron restart >/dev/null 2>&1 || true
    echo '{"success":true}'
}

# Первый запуск: если стратегий нет — подобрать для YouTube и Discord.
cmd_autosetup() {
    ensure_all_hostlists >/dev/null 2>&1 || true
    _svc_start_bg

    local have=$(uci show zapret2wizard 2>/dev/null | grep -c '=strategy')
    if [ "${have:-0}" -gt 0 ]; then
        echo "{\"success\":true,\"skipped\":true,\"strategies\":$have}"
        return 0
    fi

    local log="/tmp/bcw_autosetup.log"
    echo "[autosetup] старт $(date)" > "$log"
    local target
    for target in preset_youtube preset_discord; do
        echo "[autosetup] подбор для $target" >> "$log"
        cmd_start --target "$target" --mode smart --circular 1 --auto-apply 1 >> "$log" 2>&1 || true
        local i=0 st=""
        while [ "$i" -lt 80 ]; do
            sleep 15
            i=$((i + 1))
            st=$(grep -o '"status": *"[a-z]*"' "$STATUS_FILE" 2>/dev/null | head -n 1 | sed 's/.*"\([a-z]*\)"$/\1/')
            case "$st" in done|error) break ;; esac
        done
        echo "[autosetup] $target завершён: ${st:-timeout}" >> "$log"
    done

    _svc_start_bg
    local done_n=$(uci show zapret2wizard 2>/dev/null | grep -c '=strategy')
    echo "{\"success\":true,\"strategies\":$done_n}"
}

# Эволюционный подбор: синтезирует новые комбинации примитивов zapret2,
# проверяет их и запоминает результаты по провайдеру между запусками.
# Управление службой без ubus/procd: быстро и предсказуемо.
cmd_service() {
    case "${1:-status}" in
        stop)
            for p in $(our_engines); do
                kill "$p" 2>/dev/null
            done
            sleep 1
            for p in $(our_engines); do
                kill -9 "$p" 2>/dev/null
            done
            nft delete table inet zapret2wizard 2>/dev/null || true
            echo '{"ok":true,"service":"stopped"}'
            ;;
        start)
            ( _svc_start_bg & )
            echo '{"ok":true,"service":"starting"}'
            ;;
        restart)
            for p in $(our_engines); do kill "$p" 2>/dev/null; done
            sleep 1
            nft delete table inet zapret2wizard 2>/dev/null || true
            ( _svc_start_bg & )
            echo '{"ok":true,"service":"restarting"}'
            ;;
        *)
            get_dpi_service_status | sed 's/^/{"service":"/; s/$/"}/'
            ;;
    esac
}

cmd_evolve() {
    local target="preset_youtube" count=16 verify_n=3 tests=3 pause=2
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --target) target="$2"; shift 2 ;;
            --count) count="$2"; shift 2 ;;
            --verify) verify_n="$2"; shift 2 ;;
            --tests) tests="$2"; shift 2 ;;
            --sleep) pause="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local domain="www.youtube.com"
    case "$target" in
        preset_discord|discord) domain="discord.com" ;;
        preset_twitch|twitch) domain="twitch.tv" ;;
        preset_x|x) domain="x.com" ;;
        preset_instagram|instagram) domain="instagram.com" ;;
    esac

    local evo="/usr/share/zapret2wizard/evolve.lua"
    if [ ! -f "$evo" ]; then
        echo '{"success":false,"error":"нет evolve.lua - переустановите службу"}'
        return 1
    fi

    local genomes="/etc/zapret2wizard/genomes.json"
    local provider=$(lua "$evo" provider /tmp/blockcheckw_status.json 2>/dev/null)
    [ -n "$provider" ] || provider="default"

    local corpus="/tmp/bcw_evolve_corpus.txt"
    local scan="/tmp/bcw_evolve_scan.json"
    local verified="/tmp/bcw_evolve_verified.txt"

    # Эволюция тоже останавливает службу и запускает сканер: без лока она',
    # пересекается с ручным подбором (ровно этот баг ловили на живом роутере).
    if scan_busy; then
        echo '{"success":false,"error":"уже идёт подбор или эволюция"}'
        return 1
    fi
    if ! mkdir /var/run/bcw_scan.lock 2>/dev/null; then
        echo '{"success":false,"error":"уже идёт подбор или эволюция"}'
        return 1
    fi
    echo $$ > /var/run/bcw_scan.lock/pid 2>/dev/null || true
    echo $$ > /tmp/bcw_evolve.running 2>/dev/null || true
    trap 'rm -f /tmp/bcw_evolve.running; rm -rf /var/run/bcw_scan.lock; _svc_running || _svc_start_bg' EXIT INT TERM

    echo "=== Эволюционный подбор ==="
    echo "  провайдер:  $provider"
    echo "  домен:      $domain"
    echo "  кандидатов: $count, проверка до $verify_n, тестов на стабильность: $tests"

    if _svc_running; then
        _svc_stop
    fi
    : > /tmp/bcw_scan_paused

    local gen_out gen_err=/tmp/bcw_evolve_gen.err
    gen_out=$(lua "$evo" gen "$genomes" "$provider" "$corpus" "$domain" "$count" 2>"$gen_err")
    if [ ! -s "$corpus" ]; then
        # один ретрай: генератор мог упасть на кривом геноме в памяти
        sleep 1
        gen_out=$(lua "$evo" gen "$genomes" "$provider" "$corpus" "$domain" "$count" 2>>"$gen_err")
    fi
    local gen_count=$(printf '%s' "$gen_out" | grep -o '"generated":[0-9]*' | head -n 1 | cut -d: -f2)
    local gen_crossed=$(printf '%s' "$gen_out" | grep -o '"crossed":[0-9]*' | head -n 1 | cut -d: -f2)
    local gen_exploit=$(printf '%s' "$gen_out" | grep -o '"exploit":[0-9]*' | head -n 1 | cut -d: -f2)
    [ -n "$gen_count" ] || gen_count=$count
    [ -n "$gen_crossed" ] || gen_crossed=0
    [ -n "$gen_exploit" ] || gen_exploit=0
    if [ ! -s "$corpus" ]; then
        local gerr=$(tail -n 2 "$gen_err" 2>/dev/null | tr '\n' ' ' | tr -d '"')
        echo "  ОШИБКА: не удалось сгенерировать кандидатов"
        [ -n "$gerr" ] && echo "  причина: $gerr"
        echo "[evolve] gen failed: $gerr" >> /tmp/bcw_evolve.log
        _svc_start_bg
        rm -f /tmp/bcw_scan_paused
        return 1
    fi

    # Подсеваем проверенные стратегии из последнего поиска: эволюция не должна
    # стартовать с нуля и обязана иметь заведомо рабочие кандидаты.
    if [ -s "$OUTPUT_SCAN" ]; then
        lua - "$OUTPUT_SCAN" "$corpus" "$corpus.candidates" "$domain" << 'EVOSEED' 2>/dev/null
local json = require("luci.jsonc")
local scan_path, corpus_path, cand_path, domain = arg[1], arg[2], arg[3], arg[4]
local function hash(s)
    local h = 5381
    for i = 1, #s do h = (h * 31 + s:byte(i)) % 2147483647 end
    return string.format("%08x", math.floor(h))
end
local cands = {}
local cf = io.open(cand_path, "r")
if cf then cands = json.parse(cf:read("*a")) or {}; cf:close() end
if type(cands) ~= "table" then cands = {} end
local seen = {}
for _, c in ipairs(cands) do seen[c.args] = true end
local sf = io.open(scan_path, "r")
if not sf then return end
local d = json.parse(sf:read("*a")) or {}
sf:close()
local out = io.open(corpus_path, "a")
local added = 0
for _, s in ipairs(d.strategies or {}) do
    local a = (type(s) == "table" and s.args) or s
    if a and a ~= "" and not seen[a] then
        seen[a] = true
        if out then out:write("curl_test_https_tls13 ipv4 ", domain, " : nfqws2 ", a, "\n") end
        cands[#cands + 1] = { id = hash(a), args = a }
        added = added + 1
        if added >= 6 then break end
    end
end
if out then out:close() end
local wf = io.open(cand_path, "w")
if wf then wf:write(json.stringify(cands)); wf:close() end
EVOSEED
    fi

    local evo_qnum=$(pick_scan_qnum)
    local evo_home=/tmp/bcw_evolve_home
    mkdir -p "$evo_home" 2>/dev/null || true
    echo "  проба (scan), очередь $evo_qnum..."
    HOME="$evo_home" /usr/bin/blockcheckw --qnum "$evo_qnum" -w 2 scan -d "$domain" -p tls12,tls13 --dns "$(scan_dns_mode "$domain")" \
        --from-file "$corpus" -o "$scan" --auto --timeout 600 >/tmp/bcw_evolve_scan.log 2>&1 || true
    # scan пишет либо JSON, либо текстовый список "--payload=..." — считаем оба
    local scan_found=$(grep -c '^--' "$scan" 2>/dev/null)
    [ "${scan_found:-0}" -eq 0 ] && scan_found=$(grep -o '"args"' "$scan" 2>/dev/null | wc -l)
    echo "  стратегий прошло пробу: $scan_found"
    if [ "$scan_found" -eq 0 ]; then
        echo "  ВНИМАНИЕ: проба не нашла рабочих кандидатов — память не пополнится"
    fi

    local shortlist
    shortlist=$(lua "$evo" shortlist "$corpus.candidates" "$scan" "$verify_n" 2>/dev/null)

    local verified_lines="" applied=0 stable_count=0
    while IFS='|' read -r id args; do
        [ -n "$id" ] || continue
        [ -n "$args" ] || continue
        printf '%s\n' "$args" > /tmp/bcw_ev_try.txt
        local res okruns=0 minbytes=0 t=0
        res=$(cmd_apply --target "$target" --file /tmp/bcw_ev_try.txt 2>/dev/null)
        local b
        b=$(printf '%s' "$res" | grep -o '"size_bytes":[0-9]*' | head -n 1 | cut -d: -f2)
        [ -n "$b" ] && minbytes=$b

        # серия замеров: стабильность важнее одного удачного ответа
        while [ "$t" -lt "$tests" ]; do
            t=$((t + 1))
            local r s
            r=$(cmd_test "$target" "" 2>/dev/null | tail -n 1)
            s=$(printf '%s' "$r" | grep -o '"size_bytes":[0-9]*' | head -n 1 | cut -d: -f2)
            if printf '%s' "$r" | grep -q '"all_ok":true'; then
                okruns=$((okruns + 1))
                if [ -n "$s" ] && { [ "$minbytes" -eq 0 ] || [ "$s" -lt "$minbytes" ]; }; then
                    minbytes=$s
                fi
            fi
            [ "$t" -lt "$tests" ] && sleep "$pause"
        done

        local stable=0
        [ $((okruns * 2)) -ge "$tests" ] && stable=1
        [ "$stable" = "1" ] && stable_count=$((stable_count + 1))
        verified_lines="${verified_lines}${id}|${stable}|${minbytes}|${tests}|${okruns}
"
        if [ "$stable" = "1" ]; then
            echo "  OK   ${okruns}/${tests} · ${minbytes} Б · $args"
            # запоминаем лучший стабильный, но продолжаем собирать данные
            if [ "$applied" = "0" ] || [ "$minbytes" -gt "${best_bytes:-0}" ]; then
                applied=1
                best_bytes=$minbytes
                best_args="$args"
            fi
        else
            echo "  --   ${okruns}/${tests} · ${minbytes} Б · $args"
        fi
    done <<EVOLIST
$shortlist
EVOLIST
    rm -f /tmp/bcw_ev_try.txt
    printf '%s' "$verified_lines" > "$verified"

    # применяем лучший стабильный кандидат (если он не последний применённый)
    if [ "$applied" = "1" ] && [ -n "$best_args" ]; then
        printf '%s\n' "$best_args" > /tmp/bcw_ev_best.txt
        cmd_apply --target "$target" --file /tmp/bcw_ev_best.txt >/dev/null 2>&1 || true
        rm -f /tmp/bcw_ev_best.txt
    fi

    local stats
    stats=$(lua "$evo" update "$genomes" "$provider" "$corpus.candidates" "$scan" "$verified" 2>/dev/null)
    echo "  память: $stats"

    local stats_file="/tmp/bcw_evolve_stats.txt"
    {
        echo "generated=$gen_count"
        echo "crossed=$gen_crossed"
        echo "exploit=$gen_exploit"
        echo "stable=$stable_count"
        echo "applied=$best_args"
    } > "$stats_file"
    lua "$evo" history "$genomes" "$provider" "$stats_file" >/dev/null 2>&1 || true
    rm -f "$stats_file"

    _svc_start_bg
    rm -f /tmp/bcw_scan_paused

    echo "---"
    if [ "$applied" = "1" ]; then
        echo "Применена новая стратегия. Память: $genomes"
    else
        echo "Рабочих кандидатов не найдено. Память обновлена."
    fi
}

cmd_info() {
    ensure_dpi_service
    # Списки догружаем в фоне: сеть может быть недоступна, а интерфейс ждать не должен.
    if ! _hostlists_ready 2>/dev/null; then
        if [ ! -f /tmp/bcw_ensuring ]; then
            : > /tmp/bcw_ensuring
            start-stop-daemon -S -b -x /usr/bin/blockcheckw-helper -- ensure_hostlists_bg >/dev/null 2>&1 \
                || ( /usr/bin/blockcheckw-helper ensure_hostlists_bg >/dev/null 2>&1 & )
        fi
    fi
    local zapret_running=$(get_dpi_service_status)

    # На минимальных сборках OpenWrt нет Lua-модуля uci — тогда отчёт собираем через uci CLI.
    if ! lua -e 'require("uci")' >/dev/null 2>&1; then
        _info_json_shell
        return 0
    fi

    lua -e '
        local uci = require("uci").cursor()
        local json = require("luci.jsonc")

        local res = {
            zapret2_running = "'"$zapret_running"'",
            nft_table = ("'"$(nft list table inet zapret2wizard >/dev/null 2>&1 && echo true || echo false)"'" == "true"),
            services = {}
        }

        local cfg = "zapret2wizard"
        if not uci:get(cfg, "main") then
            cfg = "zapret2"
        end

        local vf = io.open("'"$VERSION_FILE"'", "r")
        if vf then
            local vj = json.parse(vf:read("*a"))
            vf:close()
            if vj then
                res.version = vj.version
                res.changelog = vj.changelog
            end
        end
        if not res.version then res.version = "0.15.12" end

        local hostlists_info = {
            { key = "youtube", name = "YouTube", fname = "zapret_hosts_youtube.txt", uci_sec = "list_hosts_youtube" },
            { key = "discord", name = "Discord", fname = "zapret_hosts_discord.txt", uci_sec = "list_hosts_discord" },
            { key = "x", name = "X (Twitter)", fname = "zapret_hosts_x.txt", uci_sec = "list_hosts_x" },
            { key = "instagram", name = "Instagram", fname = "zapret_hosts_instagram.txt", uci_sec = "list_hosts_instagram" },
            { key = "twitch", name = "Twitch", fname = "zapret_hosts_twitch.txt", uci_sec = "list_hosts_twitch" },
            { key = "user", name = "Общие сайты (User)", fname = "zapret_hosts_user.txt", uci_sec = "list_hosts_user" },
            { key = "exclude", name = "Исключения (не обходить)", fname = "zapret_hosts_user_exclude.txt", uci_sec = "list_hosts_user_exclude" }
        }
        local hl_res = {}
        for _, hl in ipairs(hostlists_info) do
            local file = "/etc/zapret2wizard/ipset/" .. hl.fname
            local f = io.open(file, "r")
            if not f then
                file = "/opt/zapret2/ipset/" .. hl.fname
                f = io.open(file, "r")
            end
            local count = 0
            if f then
                for l in f:lines() do
                    l = l:gsub("^%s+", ""):gsub("%s+$", "")
                    if l ~= "" and not l:match("^#") then
                        count = count + 1
                    end
                end
                f:close()
            end
            local has_uci = (uci:get(cfg, hl.uci_sec) ~= nil) or (uci:get("zapret2", hl.uci_sec) ~= nil)
            table.insert(hl_res, {
                key = hl.key,
                name = hl.name,
                file = file,
                exists = (count > 0 or f ~= nil),
                domains_count = count,
                uci_configured = has_uci
            })
        end
        res.hostlists = hl_res

        local all_strats = {}
        uci:foreach(cfg, "strategy", function(s)
            local name = s[".name"]
            if name then
                table.insert(all_strats, {
                    section = name,
                    enabled = (s.enabled == "1" or s.enabled == 1),
                    port = s.port or "443",
                    script = s.script or "",
                    is_circular = (s.script and s.script:find("circular") ~= nil) or false
                })
            end
        end)
        if #all_strats == 0 and cfg ~= "zapret2" then
            uci:foreach("zapret2", "strategy", function(s)
                local name = s[".name"]
                if name then
                    table.insert(all_strats, {
                        section = name,
                        enabled = (s.enabled == "1" or s.enabled == 1),
                        port = s.port or "443",
                        script = s.script or "",
                        is_circular = (s.script and s.script:find("circular") ~= nil) or false
                    })
                end
            end)
        end
        res.all_strategies = all_strats

        local targets = {
            builtin = { base = "BlockcheckW_General", fallback = "Routerich_circular", name = "Встроенные хосты (33)" },
            general = { base = "BlockcheckW_General", fallback = "Routerich_circular", name = "Встроенные хосты (33)" },
            preset_youtube = { base = "BlockcheckW_YouTube", fallback = "MyTube", name = "Предустановленный список YouTube (3)" },
            youtube = { base = "BlockcheckW_YouTube", fallback = "MyTube", name = "YouTube" },
            preset_discord = { base = "BlockcheckW_Discord", fallback = "Discord_circular", name = "Предустановленный список Discord (3)" },
            discord = { base = "BlockcheckW_Discord", fallback = "Discord_circular", name = "Discord" },
            preset_twitch = { base = "BlockcheckW_Twitch", name = "Предустановленный список Twitch (3)" },
            twitch = { base = "BlockcheckW_Twitch", name = "Twitch" },
            preset_x = { base = "BlockcheckW_X", name = "Предустановленный список X (3)" },
            x = { base = "BlockcheckW_X", name = "X (Twitter)" },
            preset_instagram = { base = "BlockcheckW_Instagram", name = "Предустановленный список Instagram (2)" },
            instagram = { base = "BlockcheckW_Instagram", name = "Instagram" },
            tcp16 = { base = "BlockcheckW_TCP16", name = "Лимит данных (16 КБ)" },
            domains = { base = "BlockcheckW_Custom", name = "Свои домены" },
            custom = { base = "BlockcheckW_Custom", name = "Свои домены" },
            test_strategy = { base = "BlockcheckW_General", name = "Тест стратегии" }
        }

        for key, info in pairs(targets) do
            local base = info.base
            local fallback = info.fallback

            local matching = {}
            for _, st in ipairs(all_strats) do
                if st.section == base or st.section:match("^" .. base .. "_%d+$") then
                    table.insert(matching, st)
                elseif fallback and st.section == fallback then
                    table.insert(matching, st)
                end
            end

            table.sort(matching, function(a, b)
                local num_a = tonumber(a.section:match("_(%d+)$")) or (a.section == base and 1 or 0)
                local num_b = tonumber(b.section:match("_(%d+)$")) or (b.section == base and 1 or 0)
                return num_a > num_b
            end)

            local active = nil
            for _, st in ipairs(matching) do
                if st.enabled then
                    active = st
                    break
                end
            end
            if not active and #matching > 0 then
                active = matching[1]
            end

            local vers = {}
            for _, m in ipairs(matching) do
                table.insert(vers, {
                    section = m.section,
                    enabled = m.enabled,
                    port = m.port,
                    is_circular = m.is_circular,
                    script = m.script
                })
            end

            if active then
                res.services[key] = {
                    section = active.section,
                    name = info.name,
                    enabled = active.enabled,
                    port = active.port,
                    script = active.script,
                    is_circular = active.is_circular,
                    versions_count = #vers,
                    versions = vers
                }
            else
                res.services[key] = {
                    section = base,
                    name = info.name,
                    enabled = false,
                    port = "443",
                    script = "",
                    is_circular = false,
                    versions_count = 0,
                    versions = {}
                }
            end

            if (key == "preset_discord" or key == "discord") and res.services[key] then
                res.services[key].dual_circuit = true
                local voice_active = nil
                for _, st in ipairs(all_strats) do
                    if st.section:match("^BlockcheckW_Discord_Voice") and st.enabled then
                        voice_active = st
                        break
                    end
                end
                if not voice_active then
                    for _, st in ipairs(all_strats) do
                        if st.section:match("^BlockcheckW_Discord_Voice") then
                            voice_active = st
                            break
                        end
                    end
                end
                if voice_active then
                    res.services[key].voice_circuit = {
                        section = voice_active.section,
                        enabled = voice_active.enabled,
                        port = voice_active.port or "50000-65535,19294-19344",
                        protocol = "udp",
                        script = voice_active.script or ""
                    }
                end
            end
        end

        print(json.stringify(res))
    ' 2>/dev/null
}

cmd_logs() {
    local zapret_log=""
    if ubus list log >/dev/null 2>&1; then
        zapret_log=$(logread -e zapret2 2>/dev/null | tail -n 40 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    elif [ -f /var/log/messages ]; then
        zapret_log=$(grep -i zapret2 /var/log/messages 2>/dev/null | tail -n 40 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    fi
    local scan_log=""
    if [ -f "$LOG_FILE" ]; then
        scan_log=$(tail -n 60 "$LOG_FILE" | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')
    fi
    local daemons=$(ps -w | grep -E 'nfqws2|blockcheckw' | grep -v grep | head -n 10 | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}')

    cat <<EOF
{
  "scanner_log": "$scan_log",
  "zapret2_log": "$zapret_log",
  "daemons": "$daemons"
}
EOF
}

cmd_check_update() {
    local cur_ver="0.15.12"
    if [ -f "$VERSION_FILE" ]; then
        cur_ver=$(lua -e 'local j = require("luci.jsonc"); local f = io.open("'"$VERSION_FILE"'", "r"); if f then local d = j.parse(f:read("*a")); f:close(); print(d and d.version or "0.15.12"); else print("0.15.12"); end' 2>/dev/null)
    fi

    local tmp_ver="/tmp/bcw_remote_ver.json"
    local tmp_api="/tmp/bcw_remote_api.json"
    rm -f "$tmp_ver" "$tmp_api"

    # 1. GitHub API (не кэшируется CDN, отдаёт актуальный файл напрямую).
    curl -fsSL -k --connect-timeout 4 -m 10 \
        -H "Accept: application/vnd.github.raw" \
        -H "Cache-Control: no-cache" \
        "https://api.github.com/repos/prostoy23rus/zapret2wizard/contents/openwrt/version.json?ref=main&t=$(date +%s)" \
        -o "$tmp_api" 2>/dev/null

    # 2. GitHub Raw с обходом кэша (запасной путь).
    for gh_ip in 185.199.108.133 185.199.111.133 185.199.109.133 185.199.110.133; do
        curl -fsSL -k --connect-timeout 2 -m 4 \
            -H "Cache-Control: no-cache" -H "Pragma: no-cache" \
            --resolve "raw.githubusercontent.com:443:$gh_ip" \
            "https://raw.githubusercontent.com/prostoy23rus/zapret2wizard/main/openwrt/version.json?_t=$(date +%s)" \
            -o "$tmp_ver" 2>/dev/null
        if [ -s "$tmp_ver" ] && ! head -n 3 "$tmp_ver" | grep -qiE '404|not found|<html>'; then
            break
        fi
        rm -f "$tmp_ver"
    done

    # 3. Если CDN отдал устаревшую версию, а API — свежую, берём API.
    if [ -s "$tmp_api" ] && head -n 3 "$tmp_api" | grep -q '"version"'; then
        local api_v raw_v
        api_v=$(grep -o '"version"[^,]*' "$tmp_api" | head -1 | grep -o '[0-9][0-9.]*')
        raw_v=$(grep -o '"version"[^,]*' "$tmp_ver" 2>/dev/null | head -1 | grep -o '[0-9][0-9.]*')
        if [ -z "$raw_v" ] || [ "$(printf '%s\n%s\n' "$api_v" "$raw_v" | sort -V | tail -1)" = "$api_v" ]; then
            cp -f "$tmp_api" "$tmp_ver"
        fi
    fi
    rm -f "$tmp_api"

    # 2. If direct GitHub was unreachable, purge jsDelivr and fetch via mirrors
    if [ ! -s "$tmp_ver" ]; then
        curl -fsSL -k --connect-timeout 2 -m 3 "https://purge.jsdelivr.net/gh/prostoy23rus/zapret2wizard@main/openwrt/version.json" >/dev/null 2>&1 || true
        fetch_file "openwrt/version.json" "$tmp_ver" 5
    fi

    lua - "$cur_ver" "$tmp_ver" "$VERSION_FILE" << 'EOF'
local json = require("luci.jsonc")
local cur_ver = arg[1] or "0.15.12"
local file = arg[2]
local local_file = arg[3]

local function ver_to_tuple(v)
    local t = {}
    for part in string.gmatch(v or "0", "%d+") do
        table.insert(t, tonumber(part) or 0)
    end
    return t
end

local function is_newer(v1, v0)
    local t1 = ver_to_tuple(v1)
    local t0 = ver_to_tuple(v0)
    local len = math.max(#t1, #t0)
    for i = 1, len do
        local n1 = t1[i] or 0
        local n0 = t0[i] or 0
        if n1 > n0 then return true end
        if n1 < n0 then return false end
    end
    return false
end

local local_cl = {}
local local_date = ""
if local_file then
    local lf = io.open(local_file, "r")
    if lf then
        local ld = json.parse(lf:read("*a"))
        lf:close()
        if ld then
            local_cl = ld.changelog or {}
            local_date = ld.release_date or ""
        end
    end
end

local f = io.open(file, "r")
if not f then
    local res = {
        success = false,
        current_version = cur_ver,
        current_changelog = local_cl,
        current_release_date = local_date,
        changelog = local_cl,
        has_update = false,
        error = "Не удалось связаться с GitHub"
    }
    print(json.stringify(res))
    return
end

local content = f:read("*a")
f:close()

local rem = json.parse(content)
if type(rem) ~= "table" or not rem.version then
    local res = {
        success = false,
        current_version = cur_ver,
        current_changelog = local_cl,
        current_release_date = local_date,
        changelog = local_cl,
        has_update = false,
        error = "Неверный ответ GitHub"
    }
    print(json.stringify(res))
    return
end

local has_update = is_newer(rem.version, cur_ver)
local res = {
    success = true,
    current_version = cur_ver,
    current_changelog = local_cl,
    current_release_date = local_date,
    latest_version = rem.version,
    has_update = has_update,
    changelog = rem.changelog or local_cl,
    release_date = rem.release_date or "",
    repo = rem.repo or "prostoy23rus/zapret2wizard"
}
print(json.stringify(res))
EOF
    rm -f "$tmp_ver"
}

# Свежий version.json: GitHub API не кэшируется, raw — запасной путь.
fetch_remote_version() {
    local dest="$1" api="/tmp/bcw_api_ver.$$"
    rm -f "$api" "$dest"
    curl -fsSL -k --connect-timeout 4 -m 12 \
        -H "Accept: application/vnd.github.raw" \
        -H "Cache-Control: no-cache" \
        "https://api.github.com/repos/prostoy23rus/zapret2wizard/contents/openwrt/version.json?ref=main&t=$(date +%s)" \
        -o "$api" 2>/dev/null
    if [ -s "$api" ] && grep -q '"version"' "$api" 2>/dev/null; then
        cp -f "$api" "$dest"
        rm -f "$api"
        return 0
    fi
    rm -f "$api"
    fetch_file "openwrt/version.json" "$dest" 8
}

cmd_update() {
    local tmp_dir="/tmp/bcw_update_$$"
    mkdir -p "$tmp_dir"
    echo "[blockcheckw-helper] Starting update from $REPO_RAW..." >> "$LOG_FILE"

    # Download updated files via CDN / mirror fallbacks
    local ok=1
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/bin/blockcheckw-helper" "$tmp_dir/blockcheckw-helper" 8 || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/bin/circular-builder.lua" "$tmp_dir/circular-builder.lua" 8 || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/www/luci-static/resources/view/blockcheckw/main.js" "$tmp_dir/main.js" 8 || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/blockcheckw/zapret2_presets.json" "$tmp_dir/zapret2_presets.json" 8 || fetch_file "strategies/zapret2_presets.json" "$tmp_dir/zapret2_presets.json" 8 || ok=0
    fetch_remote_version "$tmp_dir/version.json" || ok=0
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/luci/menu.d/luci-app-blockcheckw.json" "$tmp_dir/menu.json" 8 || true
    fetch_file "openwrt/luci-app-blockcheckw/root/usr/share/rpcd/acl.d/luci-app-blockcheckw.json" "$tmp_dir/acl.json" 8 || true

    if [ ! -s "$tmp_dir/main.js" ] || [ ! -s "$tmp_dir/blockcheckw-helper" ]; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Ошибка скачивания файлов обновления с GitHub / CDN. Проверьте соединение с интернетом."}'
        return 1
    fi

    # Целостность: обрезанный main.js ломает весь интерфейс.
    local main_size=$(wc -c < "$tmp_dir/main.js" 2>/dev/null || echo 0)
    local helper_size=$(wc -c < "$tmp_dir/blockcheckw-helper" 2>/dev/null || echo 0)
    if [ "${main_size:-0}" -lt 100000 ] || ! grep -q 'view.extend' "$tmp_dir/main.js" 2>/dev/null; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Файл main.js скачался не полностью — обновление отменено, прежний интерфейс сохранён. Попробуйте ещё раз."}'
        return 1
    fi
    if [ "${helper_size:-0}" -lt 50000 ] || ! head -n 1 "$tmp_dir/blockcheckw-helper" 2>/dev/null | grep -q '^#!/bin/sh'; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"Скрипт helper скачался не полностью — обновление отменено."}'
        return 1
    fi
    if ! grep -q '"version"' "$tmp_dir/version.json" 2>/dev/null; then
        rm -rf "$tmp_dir"
        echo '{"success":false,"error":"version.json скачался не полностью — обновление отменено."}'
        return 1
    fi

    mkdir -p /usr/bin /usr/share/blockcheckw /usr/share/luci/menu.d /usr/share/rpcd/acl.d /www/luci-static/resources/view/blockcheckw
    chmod 755 /www/luci-static/resources/view/blockcheckw /usr/share/blockcheckw 2>/dev/null || true

    # Prepare file permissions before moving into place to prevent 403 in uhttpd
    chmod +x "$tmp_dir/blockcheckw-helper" "$tmp_dir/circular-builder.lua" 2>/dev/null || true
    chmod 644 "$tmp_dir/main.js" "$tmp_dir/zapret2_presets.json" "$tmp_dir/version.json" 2>/dev/null || true
    [ -f "$tmp_dir/menu.json" ] && chmod 644 "$tmp_dir/menu.json" 2>/dev/null || true
    [ -f "$tmp_dir/acl.json" ] && chmod 644 "$tmp_dir/acl.json" 2>/dev/null || true

    # Install files atomically
    cp -f "$tmp_dir/blockcheckw-helper" /usr/bin/blockcheckw-helper
    cp -f "$tmp_dir/circular-builder.lua" /usr/bin/circular-builder.lua
    ln -sf /usr/bin/blockcheckw-helper /usr/bin/zapret2wizard 2>/dev/null || true
    cp -f "$tmp_dir/main.js" /www/luci-static/resources/view/blockcheckw/main.js
    cp -f "$tmp_dir/zapret2_presets.json" /usr/share/blockcheckw/zapret2_presets.json
    cp -f "$tmp_dir/version.json" /usr/share/blockcheckw/version.json
    [ -s "$tmp_dir/menu.json" ] && cp -f "$tmp_dir/menu.json" /usr/share/luci/menu.d/luci-app-blockcheckw.json
    [ -s "$tmp_dir/acl.json" ] && cp -f "$tmp_dir/acl.json" /usr/share/rpcd/acl.d/luci-app-blockcheckw.json

    chmod +x /usr/bin/blockcheckw-helper /usr/bin/circular-builder.lua
    chmod 644 /www/luci-static/resources/view/blockcheckw/main.js
    chmod 644 /usr/share/blockcheckw/* /usr/share/luci/menu.d/luci-app-blockcheckw.json /usr/share/rpcd/acl.d/luci-app-blockcheckw.json 2>/dev/null || true

    local new_ver="0.15"
    if [ -f "/usr/share/blockcheckw/version.json" ]; then
        new_ver=$(lua -e 'local j = require("luci.jsonc"); local f = io.open("/usr/share/blockcheckw/version.json", "r"); if f then local d = j.parse(f:read("*a")); f:close(); print(d and d.version or "0.15"); else print("0.15"); end' 2>/dev/null)
    fi

    # Clean caches and reload LuCI
    rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache*
    /etc/init.d/rpcd restart >/dev/null 2>&1
    ensure_all_hostlists
    rm -rf "$tmp_dir"

    echo "[blockcheckw-helper] Successfully updated to version $new_ver" >> "$LOG_FILE"
    echo '{"success":true,"version":"'"$new_ver"'","message":"Служба успешно обновлена до версии '"$new_ver"'!"}'
}

# Удаление наших следов: DNS-записи, Reject-QUIC, nft-таблица.
# Нужно и при uninstall, и как отдельная команда для уже удалённых установок.
cleanup_leftovers() {
    local changed=0 s
    if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
        for s in $(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null); do
            case "$s" in
                /googlevideo.com/*|/ytimg.com/*|/ggpht.com/*|/instagram.com/*|/cdninstagram.com/*|/discord.com/*|/twitch.tv/*|/x.com/*)
                    case "$s" in
                        *127.0.0.1#5053*|*127.0.0.1#5055*|*77.88.8.8#1253*|*208.67.222.222#5353*)
                            uci -q del_list dhcp.@dnsmasq[0].server="$s" 2>/dev/null && changed=1
                            ;;
                    esac
                    ;;
            esac
        done
        for s in $(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null); do
            case "$s" in
                /instagram.com/*|/cdninstagram.com/*|/www.instagram.com/*)
                    uci -q del_list dhcp.@dnsmasq[0].address="$s" 2>/dev/null && changed=1
                    ;;
            esac
        done
        if [ "$changed" = "1" ]; then
            uci commit dhcp 2>/dev/null || true
            /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
        fi
    fi
    if uci -q get firewall.reject_quic >/dev/null 2>&1; then
        uci -q delete firewall.reject_quic 2>/dev/null || true
        uci commit firewall 2>/dev/null || true
        /etc/init.d/firewall reload >/dev/null 2>&1 || true
    fi
    nft delete table inet zapret2wizard 2>/dev/null || true
    echo "{\"cleaned\":true,\"dns_changed\":$changed}"
}

cmd_uninstall() {
    local remove_quic="$1"

    # Убираем свои следы всегда, а не только с --remove-quic: иначе после
    # удаления остаются DNS-записи на мёртвый DoH и Reject-QUIC, из-за
    # которых YouTube не грузит видео даже через ZeroBlock.
    cleanup_leftovers >/dev/null 2>&1 || true

    # Stop active scanning processes
    killall -9 blockcheckw 2>/dev/null || true

    # Prepare background cleanup runner
    cat << 'EOF' > /tmp/bcw_uninstall_exec.sh
#!/bin/sh
sleep 1
killall -9 blockcheckw-helper 2>/dev/null || true

rm -f /usr/bin/blockcheckw
rm -f /usr/bin/blockcheckw-helper
rm -f /usr/bin/zapret2wizard
rm -f /usr/bin/circular-builder.lua
rm -rf /usr/share/blockcheckw
rm -f /usr/share/luci/menu.d/luci-app-blockcheckw.json
rm -f /usr/share/rpcd/acl.d/luci-app-blockcheckw.json
rm -rf /www/luci-static/resources/view/blockcheckw

rm -f /tmp/blockcheckw_*
rm -f /etc/blockcheckw_watchdog.json /var/log/blockcheckw_watchdog.log
sed -i '/watchdog/d' /etc/crontabs/root 2>/dev/null || true
rm -f /var/run/blockcheckw.pid
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache*

/etc/init.d/rpcd restart >/dev/null 2>&1 || true
/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
ubus call luci reload >/dev/null 2>&1 || true

rm -f /tmp/bcw_uninstall_exec.sh
EOF
    chmod +x /tmp/bcw_uninstall_exec.sh

    /tmp/bcw_uninstall_exec.sh </dev/null >/dev/null 2>&1 &

    echo '{"success":true,"message":"Служба Zapret2Wizard и веб-интерфейс LuCI успешно удалены с роутера"}'
}

cmd_diag() {
    local as_json=false
    [ "$1" = "--json" ] && as_json=true

    lua - "$STATUS_FILE" "$LOG_FILE" "$VERSION_FILE" "$OUTPUT_SCAN" "$as_json" << 'EOF'
local json = require("luci.jsonc")
local status_file = arg[1]
local log_file = arg[2]
local version_file = arg[3]
local scan_file = arg[4]
local as_json = (arg[5] == "true")

local function run_cmd(cmd)
    local p = io.popen(cmd .. " 2>/dev/null", "r")
    if not p then return "" end
    local s = p:read("*a") or ""
    p:close()
    return s:gsub("^%s+", ""):gsub("%s+$", "")
end

local function read_file(path)
    local f = io.open(path, "r")
    if not f then return "" end
    local s = f:read("*a") or ""
    f:close()
    return s:gsub("^%s+", ""):gsub("%s+$", "")
end

local date_str = run_cmd("date '+%Y-%m-%d %H:%M:%S %Z'")
local uname_str = run_cmd("uname -a")
local model_str = read_file("/tmp/sysinfo/model")
if model_str == "" then model_str = read_file("/proc/device-tree/model") end
if model_str == "" then model_str = "OpenWrt Device" end

local os_release = read_file("/etc/openwrt_release")
local memory_str = run_cmd("free -m")
local loadavg_str = read_file("/proc/loadavg")
local disk_str = run_cmd("df -h / /tmp 2>/dev/null")

local app_version = "0.16.1"
local vf = io.open(version_file, "r")
if vf then
    local d = json.parse(vf:read("*a"))
    vf:close()
    if d and d.version then app_version = d.version end
end

local bcw_bin = run_cmd("which blockcheckw")
local bcw_ver = run_cmd("/usr/bin/blockcheckw --version")
local bcw_size = run_cmd("ls -lh /usr/bin/blockcheckw 2>/dev/null | awk '{print $5}'")
local bcw_md5 = run_cmd("md5sum /usr/bin/blockcheckw 2>/dev/null | awk '{print $1}'")

local zapret_status = run_cmd("/etc/init.d/zapret2wizard status 2>/dev/null")
if zapret_status == "" then zapret_status = run_cmd("/etc/init.d/zapret2 status 2>/dev/null") end
local zeroblock_status = run_cmd("/etc/init.d/zeroblock status 2>/dev/null")
local nfqws_procs = run_cmd("ps | grep -E 'nfqws2' | grep -v grep")
local bcw_procs = run_cmd("ps | grep -E 'blockcheckw' | grep -v grep")
local nft_tables = run_cmd("nft list tables 2>/dev/null")
local zapret_uci = run_cmd("uci show zapret2wizard 2>/dev/null | grep -E '\\.name=|\\.strategy=|\\.script=|\\.enabled=|\\.hostlist=|\\.dual_circuit=|\\.ports=' | head -n 35")
if zapret_uci == "" then
    zapret_uci = run_cmd("uci show zapret2 2>/dev/null | grep -E '\\.name=|\\.strategy=|\\.script=|\\.enabled=|\\.hostlist=|\\.dual_circuit=|\\.ports=' | head -n 35")
end
local dns_servers = run_cmd("cat /etc/resolv.conf 2>/dev/null | grep -E '^nameserver' | tr '\\n' ', '")
local ggc_diag = run_cmd("curl -4 -s -k --connect-timeout 2 -m 3 'https://redirector.googlevideo.com/report_mapping?di=no'")
local quic_target = run_cmd("uci -q get firewall.reject_quic.target")
local flow_offload_sw = run_cmd("uci -q get firewall.@defaults[0].flow_offloading")
local flow_offload_hw = run_cmd("uci -q get firewall.@defaults[0].flow_offloading_hw")
local flow_status = "Disabled"
if flow_offload_hw == "1" then
    flow_status = "Hardware (Fastpath HW NAT active, threshold >= 30 pkts)"
elseif flow_offload_sw == "1" then
    flow_status = "Software (Flow Offload active)"
end

local status_json = read_file(status_file)
local status_tbl = json.parse(status_json) or {}

local log_tail = ""
local lf = io.open(log_file, "r")
if lf then
    local lines = {}
    for line in lf:lines() do table.insert(lines, line) end
    lf:close()
    local start_idx = math.max(1, #lines - 80)
    local sub = {}
    for i = start_idx, #lines do table.insert(sub, lines[i]) end
    log_tail = table.concat(sub, "\n")
end

local report_lines = {
    "============================================================",
    "  ZAPRET2WIZARD DIAGNOSTIC REPORT (RouteRich / OpenWrt)",
    "============================================================",
    "Date:        " .. date_str,
    "Device:      " .. model_str,
    "Kernel/Arch: " .. uname_str,
    "Zapret2Wizard: App v" .. app_version .. " | Binary: " .. (bcw_ver ~= "" and bcw_ver or "NOT FOUND"),
    "Binary Path: " .. (bcw_bin ~= "" and bcw_bin or "N/A") .. " (size: " .. bcw_size .. ", md5: " .. bcw_md5 .. ")",
    "",
    "--- OpenWrt Release Info ---",
    os_release ~= "" and os_release or "N/A",
    "",
    "--- Hardware Resources ---",
    "Flow Offloading: " .. flow_status,
    "Load Average: " .. loadavg_str,
    memory_str,
    disk_str,
    "",
    "--- Zapret2 & Services ---",
    "Zapret2 status:   " .. (zapret_status ~= "" and zapret_status or "stopped"),
    "ZeroBlock status: " .. (zeroblock_status ~= "" and zeroblock_status or "not installed / stopped"),
    "Running nfqws2 processes:",
    nfqws_procs ~= "" and nfqws_procs or "  (none)",
    "Active scanner processes:",
    bcw_procs ~= "" and bcw_procs or "  (none)",
    "Nftables tables:",
    nft_tables ~= "" and nft_tables or "  (none)",
    "",
    "--- DNS & Resolvers ---",
    "Nameservers: " .. (dns_servers ~= "" and dns_servers or "N/A"),
    "",
    "--- Google Global Cache (GGC) & QUIC Telemetry ---",
    "GGC Cluster Mapping: " .. (ggc_diag ~= "" and ggc_diag or "Unavailable / Not detected"),
    "Reject-QUIC Status:  " .. (quic_target ~= "" and ("Active (target=" .. quic_target .. ")") or "Not configured in firewall"),
    "",
    "--- Configured Zapret2 Strategies (UCI) ---",
    zapret_uci ~= "" and zapret_uci or "  (none configured)",
    "",
    "--- Scanner State ---",
    "Status:     " .. tostring(status_tbl.status or "unknown"),
    "Percent:    " .. tostring(status_tbl.percent or 0) .. "%",
    "Phase:      " .. tostring(status_tbl.phase or "none"),
    "ISP:        " .. tostring(status_tbl.isp or "not detected"),
    "Block Type: " .. tostring(status_tbl.block_type or "not detected"),
    "",
    "--- Recent Run Log (Last 80 lines) ---",
    log_tail ~= "" and log_tail or "(log is empty)",
    "============================================================",
    "  END OF DIAGNOSTIC REPORT",
    "============================================================"
}

local report_text = table.concat(report_lines, "\n")

if as_json then
    print(json.stringify({ success = true, report = report_text }))
else
    print(report_text)
end
EOF
}

cmd_ensure_hostlists() {
    ensure_all_hostlists
    cmd_info
}

# Фоновая догрузка списков: без вывода и с уборкой маркера.
cmd_ensure_hostlists_bg() {
    ensure_all_hostlists >/dev/null 2>&1 || true
    rm -f /tmp/bcw_ensuring
}

# Единый маппинг «цель -> файл списка доменов». Держит пути в одном месте,
# чтобы add/remove/read/write не разъезжались между собой.
_hostlist_path() {
    case "$1" in
        youtube|preset_youtube) echo "/etc/zapret2wizard/ipset/zapret_hosts_youtube.txt" ;;
        discord|preset_discord) echo "/etc/zapret2wizard/ipset/zapret_hosts_discord.txt" ;;
        x|preset_x) echo "/etc/zapret2wizard/ipset/zapret_hosts_x.txt" ;;
        instagram|preset_instagram) echo "/etc/zapret2wizard/ipset/zapret_hosts_instagram.txt" ;;
        twitch|preset_twitch) echo "/etc/zapret2wizard/ipset/zapret_hosts_twitch.txt" ;;
        user|general|builtin) echo "/etc/zapret2wizard/ipset/zapret_hosts_user.txt" ;;
        exclude) echo "/etc/zapret2wizard/ipset/zapret_hosts_user_exclude.txt" ;;
        *) echo "" ;;
    esac
}

# Нормализация домена: обрезка пробелов, нижний регистр, снятие конечной точки.
_hl_sanitize() {
    printf '%s' "$1" | tr -d ' \t\r\n' | tr 'A-Z' 'a-z' | sed 's/\.$//'
}

# Проверка домена. Поддерживает отменяющую запись с префиксом «^».
# Возвращает 0 для валидного, 1 — для мусора.
_hl_valid() {
    local d="${1#^}"
    [ -n "$d" ] || return 1
    [ "${#d}" -le 253 ] || return 1
    case "$d" in
        *[!a-z0-9.-]*|.*|*.|*-) return 1 ;;
    esac
    printf '%s' "$d" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
}

# Перезапуск службы после правки списков (если не передан --no-restart).
_hl_restart() {
    [ "$1" = "1" ] && return 0
    /etc/init.d/zapret2wizard restart >/dev/null 2>&1 &
    return 0
}

# Счётчик значимых строк списка (без пустых и комментариев).
_hl_count() {
    local file="$1"
    [ -f "$file" ] || { echo 0; return 0; }
    grep -vcE '^[[:space:]]*(#|$)' "$file" 2>/dev/null || echo 0
}

cmd_read_hostlist() {
    local target="${1:-user}"
    local file
    file=$(_hostlist_path "$target")
    if [ -z "$file" ]; then
        echo '{"success":false,"error":"Unknown hostlist target"}'
        return 1
    fi
    BCW_HL_FILE="$file" BCW_HL_TARGET="$target" lua -e '
        local jsonc = require "luci.jsonc"
        local file = os.getenv("BCW_HL_FILE")
        local list = {}
        local f = io.open(file, "r")
        local exists = (f ~= nil)
        if f then
            for line in f:lines() do
                line = line:gsub("^%s+", ""):gsub("%s+$", "")
                if line ~= "" then table.insert(list, line) end
            end
            f:close()
        end
        print(jsonc.stringify({
            success = true,
            target = os.getenv("BCW_HL_TARGET"),
            file = file,
            exists = exists,
            count = #list,
            domains = list
        }))
    '
}

cmd_add_hostlist_domain() {
    local target="${1:-user}"
    local domain="${2:-}"
    local no_restart=0
    case "${3:-}" in --no-restart) no_restart=1 ;; esac

    local file
    file=$(_hostlist_path "$target")
    [ -n "$file" ] || file=$(_hostlist_path user)

    domain=$(_hl_sanitize "$domain")
    if [ -z "$domain" ]; then
        echo '{"success":false,"error":"Domain is empty"}'
        return 1
    fi
    if ! _hl_valid "$domain"; then
        echo "{\"success\":false,\"error\":\"Invalid domain\",\"domain\":\"$domain\"}"
        return 1
    fi

    mkdir -p "${file%/*}" 2>/dev/null
    [ -f "$file" ] || : > "$file" 2>/dev/null

    if grep -qxF -e "$domain" "$file" 2>/dev/null; then
        echo "{\"success\":true,\"domain\":\"$domain\",\"file\":\"$file\",\"already_exists\":true,\"count\":$(_hl_count "$file")}"
        return 0
    fi

    printf '%s\n' "$domain" >> "$file"
    _hl_restart "$no_restart"
    echo "{\"success\":true,\"domain\":\"$domain\",\"file\":\"$file\",\"added\":true,\"count\":$(_hl_count "$file")}"
}

cmd_remove_hostlist_domain() {
    local target="${1:-user}"
    local domain="${2:-}"
    local no_restart=0
    case "${3:-}" in --no-restart) no_restart=1 ;; esac

    local file
    file=$(_hostlist_path "$target")
    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo '{"success":false,"error":"Hostlist not found"}'
        return 1
    fi

    domain=$(_hl_sanitize "$domain")
    if [ -z "$domain" ]; then
        echo '{"success":false,"error":"Domain is empty"}'
        return 1
    fi

    if ! grep -qxF -e "$domain" "$file" 2>/dev/null; then
        echo "{\"success\":true,\"domain\":\"$domain\",\"file\":\"$file\",\"already_absent\":true,\"count\":$(_hl_count "$file")}"
        return 0
    fi

    local tmp="$file.tmp.$$"
    grep -vxF -e "$domain" "$file" > "$tmp" 2>/dev/null
    cat "$tmp" > "$file" 2>/dev/null
    rm -f "$tmp"
    _hl_restart "$no_restart"
    echo "{\"success\":true,\"domain\":\"$domain\",\"file\":\"$file\",\"removed\":true,\"count\":$(_hl_count "$file")}"
}

cmd_write_hostlist() {
    # Полная замена списка. Источники (по приоритету): аргументы-домены,
    # --file <путь>, иначе stdin. Мусор и дубликаты отбрасываются.
    local target="${1:-user}"
    shift 2>/dev/null || true
    local no_restart=0 src_file=""
    local domains=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-restart) no_restart=1 ;;
            --file) src_file="${2:-}"; shift ;;
            *) domains="$domains
$1" ;;
        esac
        shift
    done

    local file
    file=$(_hostlist_path "$target")
    if [ -z "$file" ]; then
        echo '{"success":false,"error":"Unknown hostlist target"}'
        return 1
    fi
    if [ -n "$src_file" ] && [ ! -f "$src_file" ]; then
        echo "{\"success\":false,\"error\":\"Source file not found\",\"file\":\"$src_file\"}"
        return 1
    fi

    mkdir -p "${file%/*}" 2>/dev/null
    local tmp="$file.tmp.$$"
    : > "$tmp" 2>/dev/null
    local written=0 skipped=0 line

    _hl_collect() {
        while IFS= read -r line; do
            line=$(_hl_sanitize "$line")
            [ -n "$line" ] || continue
            case "$line" in "#"*) continue ;; esac
            if ! _hl_valid "$line"; then
                skipped=$((skipped + 1))
                continue
            fi
            grep -qxF -e "$line" "$tmp" 2>/dev/null && continue
            printf '%s\n' "$line" >> "$tmp"
            written=$((written + 1))
        done
    }

    if [ -n "$domains" ]; then
        # heredoc, а не pipe: функция должна менять счётчики в текущем шелле
        _hl_collect <<EOF
$domains
EOF
    elif [ -n "$src_file" ]; then
        _hl_collect < "$src_file"
    else
        _hl_collect
    fi

    cat "$tmp" > "$file" 2>/dev/null
    rm -f "$tmp"
    _hl_restart "$no_restart"
    echo "{\"success\":true,\"file\":\"$file\",\"written\":$written,\"skipped\":$skipped,\"count\":$(_hl_count "$file")}"
}

# Тестовый режим: source helper без запуска диспетчера.
if [ "${BCW_LIB_ONLY:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

